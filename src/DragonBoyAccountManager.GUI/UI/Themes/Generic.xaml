<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:DragonBoyAccountManager.GUI.UI.Controls"
    xmlns:converters="clr-namespace:DragonBoyAccountManager.GUI.UI.Converters">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/DragonBoyAccountManager.GUI;component/UI/Themes/Colors.xaml" />
        <ResourceDictionary Source="pack://application:,,,/DragonBoyAccountManager.GUI;component/UI/Themes/Buttons.xaml" />
        <ResourceDictionary Source="pack://application:,,,/DragonBoyAccountManager.GUI;component/UI/Themes/Inputs.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <converters:StatusToBrushConverter x:Key="StatusToBrushConverter" />

    <!-- ========================================== -->
    <!--  1. GameCard Style & Template              -->
    <!-- ========================================== -->
    <Style TargetType="{x:Type controls:GameCard}">
        <Setter Property="Background" Value="{DynamicResource GameBgLightBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GameBorderBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="HighlightBrush" Value="{DynamicResource GamePanelHighlightBrush}" />
        <Setter Property="ShadowBrush" Value="{DynamicResource GamePanelShadowBrush}" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:GameCard}">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        SnapsToDevicePixels="True">
                        <Grid>
                            <!-- Viền sáng nổi 3D ở mép trên -->
                            <Border
                                Height="6"
                                VerticalAlignment="Top"
                                Background="{TemplateBinding HighlightBrush}"
                                CornerRadius="5,5,0,0"
                                IsHitTestVisible="False" />

                            <!-- Viền đổ bóng chìm ở mép đáy -->
                            <Border
                                Height="3"
                                VerticalAlignment="Bottom"
                                Background="{TemplateBinding ShadowBrush}"
                                CornerRadius="0,0,5,5"
                                IsHitTestVisible="False" />

                            <!-- Nội dung Card (Header + Body) -->
                            <DockPanel Margin="{TemplateBinding Padding}">
                                <!-- Header nếu có Header hoặc Title -->
                                <Border
                                    x:Name="PART_HeaderContainer"
                                    Margin="0,0,0,8"
                                    DockPanel.Dock="Top">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Header, RelativeSource={RelativeSource AncestorType=controls:GameCard}, Converter={x:Null}}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <ContentPresenter
                                            ContentSource="Header"
                                            RecognizesAccessKey="True"
                                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                                            <ContentPresenter.Resources>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontSize" Value="12" />
                                                    <Setter Property="FontWeight" Value="ExtraBold" />
                                                    <Setter Property="Foreground" Value="{DynamicResource GameTextDarkBrush}" />
                                                </Style>
                                            </ContentPresenter.Resources>
                                        </ContentPresenter>

                                        <ContentPresenter
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Content="{TemplateBinding HeaderAction}" />
                                    </Grid>
                                </Border>

                                <!-- Phần thân Content -->
                                <ContentPresenter
                                    ContentSource="Content"
                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            </DockPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasHeader" Value="True">
                            <Setter TargetName="PART_HeaderContainer" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========================================== -->
    <!--  2. GameButton Style & Template            -->
    <!-- ========================================== -->
    <Style TargetType="{x:Type controls:GameButton}" BasedOn="{StaticResource GameSecondaryButton}">
        <Style.Triggers>
            <Trigger Property="Variant" Value="Primary">
                <Setter Property="Template" Value="{StaticResource GamePrimaryButtonTemplate}" />
                <Setter Property="Foreground" Value="{DynamicResource GameBtnTanTextBrush}" />
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="MinWidth" Value="80" />
                <Setter Property="Height" Value="28" />
            </Trigger>
            <Trigger Property="Variant" Value="Secondary">
                <Setter Property="Template" Value="{StaticResource GameSecondaryButtonTemplate}" />
                <Setter Property="Foreground" Value="{DynamicResource GameBtnTanTextBrush}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="MinWidth" Value="72" />
                <Setter Property="Height" Value="28" />
            </Trigger>
            <Trigger Property="Variant" Value="Danger">
                <Setter Property="Template" Value="{StaticResource GameDangerButtonTemplate}" />
                <Setter Property="Foreground" Value="#FFEAEA" />
                <Setter Property="MinWidth" Value="72" />
                <Setter Property="Height" Value="28" />
            </Trigger>
            <Trigger Property="Variant" Value="Success">
                <Setter Property="Template" Value="{StaticResource GameSuccessButtonTemplate}" />
                <Setter Property="Foreground" Value="#FFFFFF" />
                <Setter Property="MinWidth" Value="80" />
                <Setter Property="Height" Value="28" />
            </Trigger>
            <Trigger Property="Variant" Value="Ghost">
                <Setter Property="Template" Value="{StaticResource GameGhostButtonTemplate}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Padding" Value="0" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ========================================== -->
    <!--  3. GameTextBox Style & Template           -->
    <!-- ========================================== -->
    <Style TargetType="{x:Type controls:GameTextBox}">
        <Setter Property="Background" Value="{DynamicResource GameBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GameBorderDarkBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="Foreground" Value="{DynamicResource GameTextDarkBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="Height" Value="28" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:GameTextBox}">
                    <Border
                        x:Name="RootBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        SnapsToDevicePixels="True">
                        <Grid>
                            <TextBlock
                                x:Name="PlaceholderText"
                                Margin="{TemplateBinding Padding}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                FontSize="{TemplateBinding FontSize}"
                                Foreground="{DynamicResource GameTextMutedBrush}"
                                IsHitTestVisible="False"
                                Opacity="0.6"
                                Text="{TemplateBinding Placeholder}"
                                Visibility="Collapsed" />
                            <ScrollViewer
                                x:Name="PART_ContentHost"
                                Focusable="False"
                                HorizontalScrollBarVisibility="Hidden"
                                VerticalScrollBarVisibility="Hidden" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Text" Value="" />
                                <Condition Property="IsKeyboardFocused" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible" />
                        </MultiTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RootBorder" Property="BorderBrush" Value="{DynamicResource GameBorderHighlightBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="RootBorder" Property="BorderBrush" Value="{DynamicResource GameBtnOrangeFaceTopBrush}" />
                            <Setter TargetName="RootBorder" Property="BorderThickness" Value="2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========================================== -->
    <!--  4. GamePasswordBox Style & Template       -->
    <!-- ========================================== -->
    <Style TargetType="{x:Type controls:GamePasswordBox}">
        <Setter Property="Background" Value="{DynamicResource GameInputNormalBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GameInputNormalBorderBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="Foreground" Value="{DynamicResource GameInputNormalTextBrush}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="8,1,25,1" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:GamePasswordBox}">
                    <Grid Height="{TemplateBinding Height}">
                        <PasswordBox
                            x:Name="PART_PasswordBox"
                            VerticalAlignment="Stretch"
                            HorizontalAlignment="Stretch"
                            Padding="{TemplateBinding Padding}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            FontSize="{TemplateBinding FontSize}"
                            FontWeight="{TemplateBinding FontWeight}"
                            Style="{StaticResource GamePasswordBoxStyle}" />

                        <TextBox
                            x:Name="PART_TextBox"
                            VerticalAlignment="Stretch"
                            HorizontalAlignment="Stretch"
                            Padding="{TemplateBinding Padding}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            FontSize="{TemplateBinding FontSize}"
                            FontWeight="{TemplateBinding FontWeight}"
                            Style="{StaticResource GameTextBoxStyle}"
                            Visibility="Collapsed" />

                        <Button
                            x:Name="PART_ToggleButton"
                            Width="20"
                            Height="20"
                            Margin="0,0,5,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Style="{StaticResource GameEyeButtonStyle}"
                            ToolTip="Hiện / Ẩn mật khẩu">
                            <Control
                                Width="13"
                                Height="13"
                                Focusable="False"
                                IsHitTestVisible="False"
                                Template="{StaticResource DragonBallPasswordIconTemplate}" />
                        </Button>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========================================== -->
    <!--  5. GameStatusOrb Style & Template         -->
    <!-- ========================================== -->
    <Style TargetType="{x:Type controls:GameStatusOrb}">
        <Setter Property="Size" Value="14" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:GameStatusOrb}">
                    <Grid Width="{TemplateBinding Size}" Height="{TemplateBinding Size}" SnapsToDevicePixels="True">
                        <!-- Vòng hào quang sáng ngoài -->
                        <Ellipse
                            x:Name="orbHalo"
                            Fill="#00FA0B"
                            Opacity="0.35"
                            Stretch="Uniform">
                            <Ellipse.Effect>
                                <BlurEffect Radius="3" />
                            </Ellipse.Effect>
                        </Ellipse>

                        <!-- Viền ngọc ngoài -->
                        <Ellipse
                            x:Name="orbRim"
                            Fill="#008E08"
                            Stroke="#36C2FB"
                            StrokeThickness="1.0"
                            Stretch="Uniform" />

                        <!-- Thân ngọc cầu gradient -->
                        <Ellipse x:Name="orbBody" Margin="1.2" Stretch="Uniform">
                            <Ellipse.Fill>
                                <RadialGradientBrush Center="0.35,0.35" GradientOrigin="0.32,0.3" RadiusX="0.68" RadiusY="0.68">
                                    <GradientStop Offset="0.0" Color="#FFFFFF" />
                                    <GradientStop Offset="0.25" Color="#42FF4F" />
                                    <GradientStop Offset="0.55" Color="#00FA0B" />
                                    <GradientStop Offset="1.0" Color="#009605" />
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>

                        <!-- Đốm sáng phản quang ở góc trên bên trái -->
                        <Ellipse
                            x:Name="orbGlint"
                            Width="3"
                            Height="3"
                            Margin="2.5,2.2,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Fill="#FFFFFF"
                            Opacity="0.9" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Running -->
                        <Trigger Property="StatusKey" Value="Running">
                            <Setter TargetName="orbHalo" Property="Fill" Value="#FA9C00" />
                            <Setter TargetName="orbRim" Property="Fill" Value="#8D5901" />
                            <Setter TargetName="orbRim" Property="Stroke" Value="#9DBF6A" />
                            <Setter TargetName="orbBody" Property="Fill">
                                <Setter.Value>
                                    <RadialGradientBrush Center="0.35,0.35" GradientOrigin="0.32,0.3" RadiusX="0.68" RadiusY="0.68">
                                        <GradientStop Offset="0.0" Color="#FFFFFF" />
                                        <GradientStop Offset="0.25" Color="#FFCA28" />
                                        <GradientStop Offset="0.55" Color="#FA9C00" />
                                        <GradientStop Offset="1.0" Color="#A06300" />
                                    </RadialGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <!-- LoggingIn -->
                        <Trigger Property="StatusKey" Value="LoggingIn">
                            <Setter TargetName="orbHalo" Property="Fill" Value="#0091EA" />
                            <Setter TargetName="orbRim" Property="Fill" Value="#01579B" />
                            <Setter TargetName="orbRim" Property="Stroke" Value="#81D4FA" />
                            <Setter TargetName="orbBody" Property="Fill">
                                <Setter.Value>
                                    <RadialGradientBrush Center="0.35,0.35" GradientOrigin="0.32,0.3" RadiusX="0.68" RadiusY="0.68">
                                        <GradientStop Offset="0.0" Color="#FFFFFF" />
                                        <GradientStop Offset="0.25" Color="#80D8FF" />
                                        <GradientStop Offset="0.55" Color="#0091EA" />
                                        <GradientStop Offset="1.0" Color="#01579B" />
                                    </RadialGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <!-- Waiting -->
                        <Trigger Property="StatusKey" Value="Waiting">
                            <Setter TargetName="orbHalo" Property="Fill" Value="#AB47BC" />
                            <Setter TargetName="orbRim" Property="Fill" Value="#4A148C" />
                            <Setter TargetName="orbRim" Property="Stroke" Value="#CE93D8" />
                            <Setter TargetName="orbBody" Property="Fill">
                                <Setter.Value>
                                    <RadialGradientBrush Center="0.35,0.35" GradientOrigin="0.32,0.3" RadiusX="0.68" RadiusY="0.68">
                                        <GradientStop Offset="0.0" Color="#FFFFFF" />
                                        <GradientStop Offset="0.25" Color="#E1BEE7" />
                                        <GradientStop Offset="0.55" Color="#AB47BC" />
                                        <GradientStop Offset="1.0" Color="#6A1B9A" />
                                    </RadialGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <!-- Offline -->
                        <Trigger Property="StatusKey" Value="Offline">
                            <Setter TargetName="orbHalo" Property="Fill" Value="#757575" />
                            <Setter TargetName="orbHalo" Property="Opacity" Value="0.2" />
                            <Setter TargetName="orbRim" Property="Fill" Value="#474747" />
                            <Setter TargetName="orbRim" Property="Stroke" Value="#AFAFAF" />
                            <Setter TargetName="orbBody" Property="Fill">
                                <Setter.Value>
                                    <RadialGradientBrush Center="0.35,0.35" GradientOrigin="0.32,0.3" RadiusX="0.68" RadiusY="0.68">
                                        <GradientStop Offset="0.0" Color="#FFFFFF" />
                                        <GradientStop Offset="0.25" Color="#BDBDBD" />
                                        <GradientStop Offset="0.6" Color="#757575" />
                                        <GradientStop Offset="1.0" Color="#424242" />
                                    </RadialGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <!-- Banned -->
                        <Trigger Property="StatusKey" Value="Banned">
                            <Setter TargetName="orbHalo" Property="Fill" Value="#FF1744" />
                            <Setter TargetName="orbRim" Property="Fill" Value="#990000" />
                            <Setter TargetName="orbRim" Property="Stroke" Value="#FF7878" />
                            <Setter TargetName="orbBody" Property="Fill">
                                <Setter.Value>
                                    <RadialGradientBrush Center="0.35,0.35" GradientOrigin="0.32,0.3" RadiusX="0.68" RadiusY="0.68">
                                        <GradientStop Offset="0.0" Color="#FFFFFF" />
                                        <GradientStop Offset="0.25" Color="#FF8A80" />
                                        <GradientStop Offset="0.55" Color="#FF1744" />
                                        <GradientStop Offset="1.0" Color="#B71C1C" />
                                    </RadialGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <!-- Error -->
                        <Trigger Property="StatusKey" Value="Error">
                            <Setter TargetName="orbHalo" Property="Fill" Value="#FF1744" />
                            <Setter TargetName="orbRim" Property="Fill" Value="#990000" />
                            <Setter TargetName="orbRim" Property="Stroke" Value="#FF7878" />
                            <Setter TargetName="orbBody" Property="Fill">
                                <Setter.Value>
                                    <RadialGradientBrush Center="0.35,0.35" GradientOrigin="0.32,0.3" RadiusX="0.68" RadiusY="0.68">
                                        <GradientStop Offset="0.0" Color="#FFFFFF" />
                                        <GradientStop Offset="0.25" Color="#FF8A80" />
                                        <GradientStop Offset="0.55" Color="#FF1744" />
                                        <GradientStop Offset="1.0" Color="#B71C1C" />
                                    </RadialGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <!-- Warning -->
                        <Trigger Property="StatusKey" Value="Warning">
                            <Setter TargetName="orbHalo" Property="Fill" Value="#FA9C00" />
                            <Setter TargetName="orbRim" Property="Fill" Value="#8D5901" />
                            <Setter TargetName="orbRim" Property="Stroke" Value="#FFCA28" />
                            <Setter TargetName="orbBody" Property="Fill">
                                <Setter.Value>
                                    <RadialGradientBrush Center="0.35,0.35" GradientOrigin="0.32,0.3" RadiusX="0.68" RadiusY="0.68">
                                        <GradientStop Offset="0.0" Color="#FFFFFF" />
                                        <GradientStop Offset="0.25" Color="#FFCA28" />
                                        <GradientStop Offset="0.55" Color="#FA9C00" />
                                        <GradientStop Offset="1.0" Color="#A06300" />
                                    </RadialGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========================================== -->
    <!--  6. GameBadge Style & Template             -->
    <!-- ========================================== -->
    <Style TargetType="{x:Type controls:GameBadge}">
        <Setter Property="Padding" Value="6,2.5" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="BorderThickness" Value="1.2" />
        <Setter Property="Background" Value="{DynamicResource GameBgAltBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GameBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource GameTextDarkBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:GameBadge}">
                    <Border
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            RecognizesAccessKey="True" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
