<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:DragonBoyAccountManager.GUI.UI.Controls"
    xmlns:converters="clr-namespace:DragonBoyAccountManager.GUI.UI.Converters">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/DragonBoyAccountManager.GUI;component/UI/Themes/Colors.xaml" />
        <ResourceDictionary Source="pack://application:,,,/DragonBoyAccountManager.GUI;component/UI/Themes/Buttons.xaml" />
        <ResourceDictionary Source="pack://application:,,,/DragonBoyAccountManager.GUI;component/UI/Themes/Inputs.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <converters:StatusToBrushConverter x:Key="StatusToBrushConverter" />

    <!-- ========================================== -->
    <!--  1. GameCard Style & Template              -->
    <!-- ========================================== -->
    <Style TargetType="{x:Type controls:GameCard}">
        <Setter Property="Background" Value="{DynamicResource GameBgLightBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GameBorderBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="HighlightBrush" Value="{DynamicResource GamePanelHighlightBrush}" />
        <Setter Property="ShadowBrush" Value="{DynamicResource GamePanelShadowBrush}" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:GameCard}">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        SnapsToDevicePixels="True">
                        <Grid>
                            <!-- Viền sáng nổi 3D ở mép trên -->
                            <Border
                                Height="6"
                                VerticalAlignment="Top"
                                Background="{TemplateBinding HighlightBrush}"
                                CornerRadius="5,5,0,0"
                                IsHitTestVisible="False" />

                            <!-- Viền đổ bóng chìm ở mép đáy -->
                            <Border
                                Height="3"
                                VerticalAlignment="Bottom"
                                Background="{TemplateBinding ShadowBrush}"
                                CornerRadius="0,0,5,5"
                                IsHitTestVisible="False" />

                            <!-- Nội dung Card (Header + Body) -->
                            <DockPanel Margin="{TemplateBinding Padding}">
                                <!-- Header nếu có Header hoặc Title -->
                                <Border
                                    x:Name="PART_HeaderContainer"
                                    Margin="0,0,0,8"
                                    DockPanel.Dock="Top">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Header, RelativeSource={RelativeSource AncestorType=controls:GameCard}, Converter={x:Null}}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <ContentPresenter
                                            ContentSource="Header"
                                            RecognizesAccessKey="True"
                                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                                            <ContentPresenter.Resources>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontSize" Value="12" />
                                                    <Setter Property="FontWeight" Value="ExtraBold" />
                                                    <Setter Property="Foreground" Value="{DynamicResource GameTextDarkBrush}" />
                                                </Style>
                                            </ContentPresenter.Resources>
                                        </ContentPresenter>

                                        <ContentPresenter
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Content="{TemplateBinding HeaderAction}" />
                                    </Grid>
                                </Border>

                                <!-- Phần thân Content -->
                                <ContentPresenter
                                    ContentSource="Content"
                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            </DockPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasHeader" Value="True">
                            <Setter TargetName="PART_HeaderContainer" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========================================== -->
    <!--  2. GameButton Style & Template            -->
    <!-- ========================================== -->
    <Style TargetType="{x:Type controls:GameButton}" BasedOn="{StaticResource GameSecondaryButton}" />

    <!-- ========================================== -->
    <!--  3. GameTextBox Style & Template           -->
    <!-- ========================================== -->
    <Style TargetType="{x:Type controls:GameTextBox}">
        <Setter Property="Background" Value="{DynamicResource GameBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GameBorderDarkBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="Foreground" Value="{DynamicResource GameTextDarkBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="Height" Value="28" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:GameTextBox}">
                    <Border
                        x:Name="RootBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        SnapsToDevicePixels="True">
                        <Grid>
                            <TextBlock
                                x:Name="PlaceholderText"
                                Margin="{TemplateBinding Padding}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                FontSize="{TemplateBinding FontSize}"
                                Foreground="{DynamicResource GameTextMutedBrush}"
                                IsHitTestVisible="False"
                                Opacity="0.6"
                                Text="{TemplateBinding Placeholder}"
                                Visibility="Collapsed" />
                            <ScrollViewer
                                x:Name="PART_ContentHost"
                                Focusable="False"
                                HorizontalScrollBarVisibility="Hidden"
                                VerticalScrollBarVisibility="Hidden" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Text" Value="" />
                                <Condition Property="IsKeyboardFocused" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible" />
                        </MultiTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RootBorder" Property="BorderBrush" Value="{DynamicResource GameBorderHighlightBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="RootBorder" Property="BorderBrush" Value="{DynamicResource GameBtnOrangeFaceTopBrush}" />
                            <Setter TargetName="RootBorder" Property="BorderThickness" Value="2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========================================== -->
    <!--  4. GamePasswordBox Style & Template       -->
    <!-- ========================================== -->
    <Style TargetType="{x:Type controls:GamePasswordBox}">
        <Setter Property="Background" Value="{DynamicResource GameInputNormalBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GameInputNormalBorderBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="Foreground" Value="{DynamicResource GameInputNormalTextBrush}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="8,1,25,1" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:GamePasswordBox}">
                    <Grid Height="{TemplateBinding Height}">
                        <PasswordBox
                            x:Name="PART_PasswordBox"
                            VerticalAlignment="Stretch"
                            HorizontalAlignment="Stretch"
                            Padding="{TemplateBinding Padding}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            FontSize="{TemplateBinding FontSize}"
                            FontWeight="{TemplateBinding FontWeight}"
                            Style="{StaticResource GamePasswordBoxStyle}" />

                        <TextBox
                            x:Name="PART_TextBox"
                            VerticalAlignment="Stretch"
                            HorizontalAlignment="Stretch"
                            Padding="{TemplateBinding Padding}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            FontSize="{TemplateBinding FontSize}"
                            FontWeight="{TemplateBinding FontWeight}"
                            Style="{StaticResource GameTextBoxStyle}"
                            Visibility="Collapsed" />

                        <Button
                            x:Name="PART_ToggleButton"
                            Width="20"
                            Height="20"
                            Margin="0,0,5,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Style="{StaticResource GameEyeButtonStyle}"
                            ToolTip="Hiện / Ẩn mật khẩu">
                            <Control
                                Width="13"
                                Height="13"
                                Focusable="False"
                                IsHitTestVisible="False"
                                Template="{StaticResource DragonBallPasswordIconTemplate}" />
                        </Button>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========================================== -->
    <!--  5. GameStatusOrb Style & Template         -->
    <!-- ========================================== -->
    <Style TargetType="{x:Type controls:GameStatusOrb}">
        <Setter Property="Size" Value="12" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:GameStatusOrb}">
                    <Grid Width="{TemplateBinding Size}" Height="{TemplateBinding Size}">
                        <!-- Vòng hào quang sáng ngoài -->
                        <Ellipse
                            Fill="{TemplateBinding OrbBrush}"
                            Opacity="0.45"
                            Stretch="Uniform">
                            <Ellipse.Effect>
                                <BlurEffect Radius="4" />
                            </Ellipse.Effect>
                        </Ellipse>

                        <!-- Thân ngọc cầu -->
                        <Ellipse Margin="1.2" Stretch="Uniform">
                            <Ellipse.Fill>
                                <RadialGradientBrush Center="0.35,0.35" GradientOrigin="0.35,0.35" RadiusX="0.65" RadiusY="0.65">
                                    <GradientStop Offset="0.0" Color="#FFFFFF" />
                                    <GradientStop Offset="0.45" Color="#FFE082" />
                                    <GradientStop Offset="1.0" Color="#C62828" />
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>

                        <!-- Đốm sáng phản quang ở góc 10h -->
                        <Ellipse
                            Width="{Binding Size, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Null}}"
                            Height="3"
                            Margin="2,2,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Fill="#FFFFFF"
                            Opacity="0.85" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Khi có OrbBrush riêng thì phủ lên thân ngọc -->
                        <Trigger Property="OrbBrush" Value="{x:Null}">
                            <!-- Dùng Status để lấy màu qua Converter nếu có -->
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========================================== -->
    <!--  6. GameBadge Style & Template             -->
    <!-- ========================================== -->
    <Style TargetType="{x:Type controls:GameBadge}">
        <Setter Property="Padding" Value="6,2.5" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="BorderThickness" Value="1.2" />
        <Setter Property="Background" Value="{DynamicResource GameBgAltBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GameBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource GameTextDarkBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:GameBadge}">
                    <Border
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            RecognizesAccessKey="True" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
