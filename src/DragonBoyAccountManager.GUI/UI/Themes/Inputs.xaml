<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:DragonBoyAccountManager.GUI.UI.Controls"
    xmlns:models="clr-namespace:DragonBoyAccountManager.GUI.Models">

    <Style x:Key="GameTextBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource GameInputNormalBgBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource GameInputNormalTextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GameInputNormalBorderBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource GameInputNormalTextBrush}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Padding" Value="8,1" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Hidden" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border
                        x:Name="outerGlow"
                        Padding="1"
                        Background="{DynamicResource GameInputRimBrush}"
                        CornerRadius="5"
                        SnapsToDevicePixels="True">
                        <Border
                            x:Name="innerBox"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1.5"
                            CornerRadius="4"
                            SnapsToDevicePixels="True">
                            <ScrollViewer
                                x:Name="PART_ContentHost"
                                VerticalAlignment="Stretch"
                                Focusable="False"
                                HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}" />
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="innerBox" Property="Background" Value="{DynamicResource GameInputFocusBgBrush}" />
                            <Setter TargetName="innerBox" Property="BorderBrush" Value="{DynamicResource GameInputFocusBorderBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource GameInputFocusTextBrush}" />
                            <Setter Property="CaretBrush" Value="{DynamicResource GameInputFocusTextBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="outerGlow" Property="Opacity" Value="0.6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GamePasswordBoxStyle" TargetType="PasswordBox">
        <Setter Property="Background" Value="{DynamicResource GameInputNormalBgBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource GameInputNormalTextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GameInputNormalBorderBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource GameInputNormalTextBrush}" />
        <Setter Property="PasswordChar" Value="●" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Padding" Value="8,1" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border
                        x:Name="outerGlow"
                        Padding="1"
                        Background="{DynamicResource GameInputRimBrush}"
                        CornerRadius="5"
                        SnapsToDevicePixels="True">
                        <Border
                            x:Name="innerBox"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1.5"
                            CornerRadius="4"
                            SnapsToDevicePixels="True">
                            <ScrollViewer
                                x:Name="PART_ContentHost"
                                VerticalAlignment="Stretch"
                                Focusable="False"
                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="innerBox" Property="Background" Value="{DynamicResource GameInputFocusBgBrush}" />
                            <Setter TargetName="innerBox" Property="BorderBrush" Value="{DynamicResource GameInputFocusBorderBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource GameInputFocusTextBrush}" />
                            <Setter Property="CaretBrush" Value="{DynamicResource GameInputFocusTextBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="outerGlow" Property="Opacity" Value="0.6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GameEyeButtonStyle" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="border"
                        Padding="2"
                        Background="Transparent"
                        CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#254A2800" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#404A2800" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GameCheckBoxStyle" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource GameTextDarkBrush}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid
                            x:Name="boxContainer"
                            Grid.Column="0"
                            Width="20"
                            Height="18"
                            SnapsToDevicePixels="True">
                            <Border
                                x:Name="outerRim"
                                Padding="0.8,0.8,1.2,1.2"
                                Background="{DynamicResource GamePanelHighlightBrush}"
                                CornerRadius="5.2">
                                <Grid>
                                    <Border
                                        x:Name="innerFace"
                                        Background="{DynamicResource GameCheckBgBrush}"
                                        BorderBrush="{DynamicResource GameCheckBorderBrush}"
                                        BorderThickness="2.4,2.4,0,0"
                                        CornerRadius="4" />

                                    <Path
                                        x:Name="checkMark"
                                        Data="M 5.6,7.0 L 3.8,9.0 L 8.5,13.5 L 16.2,1.5 C 14.6,4.5 11.6,7.3 8.5,9.8 Z"
                                        Fill="{DynamicResource GameCheckMarkBrush}"
                                        SnapsToDevicePixels="True"
                                        Visibility="Collapsed" />
                                </Grid>
                            </Border>
                        </Grid>

                        <ContentPresenter
                            Grid.Column="1"
                            Margin="8,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="False" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="outerRim" Property="Background" Value="#E8F8EC" />
                            <Setter TargetName="innerFace" Property="Background" Value="#8FE298" />
                            <Setter TargetName="innerFace" Property="BorderBrush" Value="#45904E" />
                        </MultiTrigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="outerRim" Property="Background" Value="#E8F8EC" />
                            <Setter TargetName="innerFace" Property="Background" Value="#9BDF93" />
                            <Setter TargetName="innerFace" Property="BorderBrush" Value="#4E964A" />
                            <Setter TargetName="checkMark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="innerFace" Property="Background" Value="#A5E79D" />
                        </MultiTrigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="boxContainer" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform Y="0.8" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="boxContainer" Property="Opacity" Value="0.5" />
                            <Setter Property="Opacity" Value="0.6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="StatusOrbTemplate">
        <Grid
            Width="15"
            Height="15"
            SnapsToDevicePixels="True">
            <Ellipse
                x:Name="orbRim"
                Fill="#008E08"
                Stroke="#36C2FB"
                StrokeThickness="1.0" />
            <Ellipse x:Name="orbBody" Margin="1.2">
                <Ellipse.Fill>
                    <RadialGradientBrush Center="0.35,0.35" GradientOrigin="0.32,0.3" RadiusX="0.68" RadiusY="0.68">
                        <GradientStop Offset="0.0" Color="#FFFFFF" />
                        <GradientStop Offset="0.25" Color="#42FF4F" />
                        <GradientStop Offset="0.55" Color="#00FA0B" />
                        <GradientStop Offset="1.0" Color="#009605" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse
                x:Name="orbGlint"
                Width="3.2"
                Height="3.2"
                Margin="3.2,2.8,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Fill="#FFFFFF" />
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding}" Value="Running">
                <Setter TargetName="orbRim" Property="Fill" Value="#8D5901" />
                <Setter TargetName="orbRim" Property="Stroke" Value="#9DBF6A" />
                <Setter TargetName="orbBody" Property="Fill">
                    <Setter.Value>
                        <RadialGradientBrush Center="0.35,0.35" GradientOrigin="0.32,0.3" RadiusX="0.68" RadiusY="0.68">
                            <GradientStop Offset="0.0" Color="#FFFFFF" />
                            <GradientStop Offset="0.25" Color="#FFCA28" />
                            <GradientStop Offset="0.55" Color="#FA9C00" />
                            <GradientStop Offset="1.0" Color="#A06300" />
                        </RadialGradientBrush>
                    </Setter.Value>
                </Setter>
            </DataTrigger>
            <DataTrigger Binding="{Binding}" Value="LoggingIn">
                <Setter TargetName="orbRim" Property="Fill" Value="#01579B" />
                <Setter TargetName="orbRim" Property="Stroke" Value="#81D4FA" />
                <Setter TargetName="orbBody" Property="Fill">
                    <Setter.Value>
                        <RadialGradientBrush Center="0.35,0.35" GradientOrigin="0.32,0.3" RadiusX="0.68" RadiusY="0.68">
                            <GradientStop Offset="0.0" Color="#FFFFFF" />
                            <GradientStop Offset="0.25" Color="#80D8FF" />
                            <GradientStop Offset="0.55" Color="#0091EA" />
                            <GradientStop Offset="1.0" Color="#01579B" />
                        </RadialGradientBrush>
                    </Setter.Value>
                </Setter>
            </DataTrigger>
            <DataTrigger Binding="{Binding}" Value="Waiting">
                <Setter TargetName="orbRim" Property="Fill" Value="#4A148C" />
                <Setter TargetName="orbRim" Property="Stroke" Value="#CE93D8" />
                <Setter TargetName="orbBody" Property="Fill">
                    <Setter.Value>
                        <RadialGradientBrush Center="0.35,0.35" GradientOrigin="0.32,0.3" RadiusX="0.68" RadiusY="0.68">
                            <GradientStop Offset="0.0" Color="#FFFFFF" />
                            <GradientStop Offset="0.25" Color="#E1BEE7" />
                            <GradientStop Offset="0.55" Color="#AB47BC" />
                            <GradientStop Offset="1.0" Color="#6A1B9A" />
                        </RadialGradientBrush>
                    </Setter.Value>
                </Setter>
            </DataTrigger>
            <DataTrigger Binding="{Binding}" Value="Offline">
                <Setter TargetName="orbRim" Property="Fill" Value="#474747" />
                <Setter TargetName="orbRim" Property="Stroke" Value="#AFAFAF" />
                <Setter TargetName="orbBody" Property="Fill">
                    <Setter.Value>
                        <RadialGradientBrush Center="0.35,0.35" GradientOrigin="0.32,0.3" RadiusX="0.68" RadiusY="0.68">
                            <GradientStop Offset="0.0" Color="#FFFFFF" />
                            <GradientStop Offset="0.25" Color="#BDBDBD" />
                            <GradientStop Offset="0.6" Color="#757575" />
                            <GradientStop Offset="1.0" Color="#424242" />
                        </RadialGradientBrush>
                    </Setter.Value>
                </Setter>
            </DataTrigger>
            <DataTrigger Binding="{Binding}" Value="Banned">
                <Setter TargetName="orbRim" Property="Fill" Value="#990000" />
                <Setter TargetName="orbRim" Property="Stroke" Value="#FF7878" />
                <Setter TargetName="orbBody" Property="Fill">
                    <Setter.Value>
                        <RadialGradientBrush Center="0.35,0.35" GradientOrigin="0.32,0.3" RadiusX="0.68" RadiusY="0.68">
                            <GradientStop Offset="0.0" Color="#FFFFFF" />
                            <GradientStop Offset="0.25" Color="#FF8A80" />
                            <GradientStop Offset="0.55" Color="#FF1744" />
                            <GradientStop Offset="1.0" Color="#B71C1C" />
                        </RadialGradientBrush>
                    </Setter.Value>
                </Setter>
            </DataTrigger>
            <DataTrigger Binding="{Binding}" Value="Error">
                <Setter TargetName="orbRim" Property="Fill" Value="#990000" />
                <Setter TargetName="orbRim" Property="Stroke" Value="#FF7878" />
                <Setter TargetName="orbBody" Property="Fill">
                    <Setter.Value>
                        <RadialGradientBrush Center="0.35,0.35" GradientOrigin="0.32,0.3" RadiusX="0.68" RadiusY="0.68">
                            <GradientStop Offset="0.0" Color="#FFFFFF" />
                            <GradientStop Offset="0.25" Color="#FF8A80" />
                            <GradientStop Offset="0.55" Color="#FF1744" />
                            <GradientStop Offset="1.0" Color="#B71C1C" />
                        </RadialGradientBrush>
                    </Setter.Value>
                </Setter>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <ControlTemplate x:Key="GameComboBoxToggleButtonTemplate" TargetType="ToggleButton">
        <Grid SnapsToDevicePixels="True">
            <Border
                x:Name="outerGlow"
                Padding="1,1,1.5,1.5"
                Background="{DynamicResource GameInputRimBrush}"
                CornerRadius="6"
                SnapsToDevicePixels="True">
                <Border
                    x:Name="innerBox"
                    Background="{DynamicResource GameInputNormalBgBrush}"
                    BorderBrush="{DynamicResource GameInputNormalBorderBrush}"
                    BorderThickness="2.5,2.5,0,0"
                    CornerRadius="5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="26" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Grid.Column="1"
                            Width="1"
                            Margin="0,4"
                            HorizontalAlignment="Left"
                            Background="{DynamicResource GameInputNormalBorderBrush}"
                            Opacity="0.4" />

                        <Border
                            Grid.Column="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                            <Path
                                x:Name="arrowIcon"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Data="M 0,2 L 8,2 L 4,7 Z"
                                Fill="{DynamicResource GameInputNormalTextBrush}" />
                        </Border>
                    </Grid>
                </Border>
            </Border>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="innerBox" Property="Background" Value="#F2CD95" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="innerBox" Property="Background" Value="{DynamicResource GameInputFocusBgBrush}" />
                <Setter TargetName="innerBox" Property="BorderBrush" Value="{DynamicResource GameInputFocusBorderBrush}" />
                <Setter TargetName="arrowIcon" Property="Fill" Value="{DynamicResource GameInputFocusTextBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="outerGlow" Property="Opacity" Value="0.6" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="GameComboBoxItemStyle" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource GameInputNormalTextBrush}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border
                        x:Name="itemBorder"
                        Padding="{TemplateBinding Padding}"
                        Background="Transparent"
                        CornerRadius="4"
                        SnapsToDevicePixels="True">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource GameHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource GameInputFocusBgBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource GameInputFocusTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GameComboBoxStyle" TargetType="ComboBox">
        <Setter Property="Background" Value="{DynamicResource GameInputNormalBgBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource GameInputNormalTextBrush}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource GameComboBoxItemStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton
                            x:Name="toggleButton"
                            ClickMode="Press"
                            Focusable="False"
                            IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                            Template="{StaticResource GameComboBoxToggleButtonTemplate}" />
                        <ContentPresenter
                            x:Name="contentPresenter"
                            Margin="10,0,28,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding SelectionBoxItem}"
                            ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                            ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                            IsHitTestVisible="False" />
                        <Popup
                            x:Name="PART_Popup"
                            AllowsTransparency="True"
                            Focusable="False"
                            IsOpen="{Binding Path=IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                            Placement="Bottom">
                            <Border
                                x:Name="dropDownBorder"
                                MinWidth="{Binding ActualWidth, ElementName=toggleButton}"
                                MaxHeight="220"
                                Margin="0,3,0,0"
                                Background="{DynamicResource GameInputNormalBgBrush}"
                                BorderBrush="{DynamicResource GameInputNormalBorderBrush}"
                                BorderThickness="2"
                                CornerRadius="5"
                                SnapsToDevicePixels="True">
                                <ScrollViewer CanContentScroll="True">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource GameInputFocusTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GameTabItemStyle" TargetType="TabItem">
        <Setter Property="Background" Value="{DynamicResource GameTabInactiveBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource GameTextMutedBrush}" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="1.5,2,1.5,0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid x:Name="Root">
                        <Border
                            x:Name="TabBorder"
                            Padding="4,0"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource GameTabBorderBrush}"
                            BorderThickness="1.5,1.5,1.5,1.5"
                            CornerRadius="5,5,0,0"
                            SnapsToDevicePixels="True">
                            <Grid>
                                <Border
                                    x:Name="TabHighlight"
                                    Height="4"
                                    VerticalAlignment="Top"
                                    Background="{DynamicResource GamePanelHighlightBrush}"
                                    CornerRadius="3.5,3.5,0,0"
                                    Visibility="Collapsed" />
                                <ContentPresenter
                                    x:Name="ContentSite"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    ContentSource="Header"
                                    RecognizesAccessKey="True" />
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource GameTabActiveBrush}" />
                            <Setter TargetName="TabBorder" Property="BorderThickness" Value="1.8,1.8,1.8,0" />
                            <Setter TargetName="TabBorder" Property="Margin" Value="0,-2,0,-1.8" />
                            <Setter TargetName="TabHighlight" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{DynamicResource GameGreenBrush}" />
                            <Setter Property="Panel.ZIndex" Value="10" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsSelected" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource GameTabInactiveHoverBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource GameTextDarkBrush}" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GameTabControlStyle" TargetType="TabControl">
        <Setter Property="Background" Value="{DynamicResource GameTabContentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GameBorderBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border
                            Grid.Row="0"
                            Padding="2,3,2,0"
                            Background="{DynamicResource GameHeaderBrush}"
                            BorderBrush="{DynamicResource GameTabBorderBrush}"
                            BorderThickness="0,0,0,1.8"
                            CornerRadius="3,3,0,0"
                            SnapsToDevicePixels="True">
                            <UniformGrid
                                Background="Transparent"
                                IsItemsHost="True"
                                Rows="1" />
                        </Border>

                        <Border
                            Grid.Row="1"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="0,0,3,3"
                            SnapsToDevicePixels="True">
                            <ContentPresenter
                                x:Name="PART_SelectedContentHost"
                                Margin="{TemplateBinding Padding}"
                                ContentSource="SelectedContent" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GameScrollBarPageButton" TargetType="{x:Type RepeatButton}">
        <Setter Property="OverridesDefaultStyle" Value="true" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Focusable" Value="false" />
        <Setter Property="IsTabStop" Value="false" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Rectangle
                        Width="{TemplateBinding Width}"
                        Height="{TemplateBinding Height}"
                        Fill="{TemplateBinding Background}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GameScrollBarThumb" TargetType="{x:Type Thumb}">
        <Setter Property="OverridesDefaultStyle" Value="true" />
        <Setter Property="IsTabStop" Value="false" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border
                        x:Name="thumbBorder"
                        Margin="1"
                        Background="{DynamicResource GameBorderBrush}"
                        CornerRadius="4"
                        SnapsToDevicePixels="True" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="thumbBorder" Property="Background" Value="{DynamicResource GameBorderDarkBrush}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="thumbBorder" Property="Background" Value="{DynamicResource GameScrollThumbDarkBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="GameVerticalScrollBarTemplate" TargetType="{x:Type ScrollBar}">
        <Grid
            Width="8"
            Background="{DynamicResource GameScrollTrackBrush}"
            SnapsToDevicePixels="true">
            <Track x:Name="PART_Track" IsDirectionReversed="true">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Style="{StaticResource GameScrollBarPageButton}" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource GameScrollBarThumb}" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Style="{StaticResource GameScrollBarPageButton}" />
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="GameHorizontalScrollBarTemplate" TargetType="{x:Type ScrollBar}">
        <Grid
            Height="8"
            Background="{DynamicResource GameScrollTrackBrush}"
            SnapsToDevicePixels="true">
            <Track x:Name="PART_Track" IsDirectionReversed="false">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="{x:Static ScrollBar.PageLeftCommand}" Style="{StaticResource GameScrollBarPageButton}" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource GameScrollBarThumb}" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="{x:Static ScrollBar.PageRightCommand}" Style="{StaticResource GameScrollBarPageButton}" />
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
    </ControlTemplate>

    <Style TargetType="{x:Type ScrollBar}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="Auto" />
        <Setter Property="Template" Value="{StaticResource GameVerticalScrollBarTemplate}" />
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Height" Value="8" />
                <Setter Property="Template" Value="{StaticResource GameHorizontalScrollBarTemplate}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="GameRadarProgressBarStyle" TargetType="{x:Type ProgressBar}">
        <Setter Property="Height" Value="14" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{DynamicResource GameRadarTrackBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GameRadarTrackBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ProgressBar}">
                    <Border
                        x:Name="Track"
                        Padding="1.5"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="7"
                        SnapsToDevicePixels="True">
                        <Grid x:Name="PART_Track">
                            <Decorator x:Name="PART_Indicator" HorizontalAlignment="Left">
                                <Border
                                    x:Name="Indicator"
                                    Background="{DynamicResource GameRadarProgressFillBrush}"
                                    CornerRadius="5.5"
                                    SnapsToDevicePixels="True" />
                            </Decorator>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GameSliderThumbStyle" TargetType="{x:Type Thumb}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Width" Value="16" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Grid SnapsToDevicePixels="True">
                        <Border
                            x:Name="ThumbBevel"
                            Padding="1,1,1,2"
                            Background="{DynamicResource GameDarkBrownBrush}"
                            CornerRadius="4">
                            <Border
                                x:Name="ThumbFace"
                                Background="{DynamicResource GameBtnOrangeInnerTopBrush}"
                                CornerRadius="3">
                                <Grid>
                                    <Border
                                        Margin="1"
                                        Background="#E5B942"
                                        CornerRadius="2">
                                        <Border
                                            Height="3"
                                            VerticalAlignment="Top"
                                            Background="#FFE082"
                                            CornerRadius="1" />
                                    </Border>
                                    <StackPanel
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                        <Border
                                            Width="1.5"
                                            Height="8"
                                            Margin="1,0"
                                            Background="#8D5514" />
                                        <Border
                                            Width="1.5"
                                            Height="8"
                                            Margin="1,0"
                                            Background="#8D5514" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbFace" Property="Background" Value="#FFF7CC" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbBevel" Property="Padding" Value="1,2,1,1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GameSliderStyle" TargetType="{x:Type Slider}">
        <Setter Property="Stylus.IsPressAndHoldEnabled" Value="False" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Slider}">
                    <Border Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                        <Grid VerticalAlignment="Center">
                            <Border
                                x:Name="TrackBackground"
                                Height="8"
                                Margin="5,0"
                                Background="{DynamicResource GameHighlightBrush}"
                                BorderBrush="{DynamicResource GameBorderBrush}"
                                BorderThickness="1.2"
                                CornerRadius="4" />

                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                <Border
                                                    Height="8"
                                                    Margin="5,0,0,0"
                                                    Background="{DynamicResource GameBtnOrangeFaceTopBrush}"
                                                    CornerRadius="4,0,0,4" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource GameSliderThumbStyle}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GameSpeedQuickButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="22" />
        <Setter Property="FontSize" Value="9" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="Foreground" Value="{DynamicResource GameTextDarkBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="OuterBorder"
                        Padding="1,1,1,2"
                        Background="{DynamicResource GameDarkBrownBrush}"
                        CornerRadius="3.5"
                        SnapsToDevicePixels="True">
                        <Border
                            x:Name="InnerFace"
                            Background="{DynamicResource GameBgLightBrush}"
                            CornerRadius="2.5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="InnerFace" Property="Background" Value="#FFF7CC" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="OuterBorder" Property="Padding" Value="1,2,1,1" />
                            <Setter TargetName="InnerFace" Property="Background" Value="#EDA23C" />
                            <Setter Property="Foreground" Value="#FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

