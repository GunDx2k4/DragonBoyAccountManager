<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
    xmlns:converters="clr-namespace:DragonBoyAccountManager.GUI.UI.Converters"
    mc:Ignorable="po">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/DragonBoyAccountManager.GUI;component/UI/Themes/Colors.xaml" />
        <ResourceDictionary Source="pack://application:,,,/DragonBoyAccountManager.GUI;component/UI/Themes/Buttons.xaml" />
        <ResourceDictionary Source="pack://application:,,,/DragonBoyAccountManager.GUI;component/UI/Themes/Inputs.xaml" />
        <ResourceDictionary Source="pack://application:,,,/DragonBoyAccountManager.GUI;component/UI/Themes/DataGrids.xaml" />
        <ResourceDictionary Source="pack://application:,,,/DragonBoyAccountManager.GUI;component/UI/Themes/Dialogs.xaml" />
        <ResourceDictionary Source="pack://application:,,,/DragonBoyAccountManager.GUI;component/UI/Themes/Generic.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

    <FontFamily x:Key="GameFont">Segoe UI, Tahoma, Arial</FontFamily>

    <DropShadowEffect
        x:Key="GameTextPixelShadow"
        po:Freeze="True"
        BlurRadius="0"
        Direction="315"
        Opacity="0.75"
        ShadowDepth="1"
        Color="{StaticResource GameShadowDarkColor}" />
    <DropShadowEffect
        x:Key="GameTextPixelShadowLight"
        po:Freeze="True"
        BlurRadius="0"
        Direction="315"
        Opacity="0.8"
        ShadowDepth="1"
        Color="#FFF8EE" />

    <Style x:Key="GameTextTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource GameFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="Foreground" Value="{DynamicResource GameTextLightBrush}" />
        <Setter Property="Effect" Value="{StaticResource GameTextPixelShadow}" />
    </Style>

    <Style x:Key="GameTextHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource GameFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="Foreground" Value="{DynamicResource GameTextDarkBrush}" />
    </Style>

    <Style x:Key="GameTextSubheaderStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource GameFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource GameTextDarkBrush}" />
    </Style>

    <Style x:Key="GameTextBodyStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource GameFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource GameTextDarkBrush}" />
    </Style>

    <Style x:Key="GameTextCaptionStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource GameFont}" />
        <Setter Property="FontSize" Value="9.5" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource GameTextMutedBrush}" />
    </Style>

    <StreamGeometry
        x:Key="GameDragonBallFourStarsGeometry"
        po:Freeze="True">
        M 20,11.5 L 21.3,14.8 L 24.8,15.1 L 22.1,17.3 L 23,20.8 L 20,18.9 L 17,20.8 L 17.9,17.3 L 15.2,15.1 L 18.7,14.8 Z
        M 14,17.5 L 15.3,20.8 L 18.8,21.1 L 16.1,23.3 L 17,26.8 L 14,24.9 L 11,26.8 L 11.9,23.3 L 9.2,21.1 L 12.7,20.8 Z
        M 26,17.5 L 27.3,20.8 L 30.8,21.1 L 28.1,23.3 L 29,26.8 L 26,24.9 L 23,26.8 L 23.9,23.3 L 21.2,21.1 L 24.7,20.8 Z
        M 20,23.5 L 21.3,26.8 L 24.8,27.1 L 22.1,29.3 L 23,32.8 L 20,30.9 L 17,32.8 L 17.9,29.3 L 15.2,27.1 L 18.7,26.8 Z
    </StreamGeometry>
</ResourceDictionary>
