                        <TranslateTransform Y="0.8" />
                    </Setter.Value>
                </Setter>
                <Setter TargetName="KeycapOuter" Property="Background" Value="{DynamicResource GameDarkBrownBrush}" />
                <Setter TargetName="KeycapInner" Property="Background" Value="{DynamicResource GameBtnOrangeHoverBrush}" />
                <Setter TargetName="KeycapInner" Property="BorderThickness" Value="0,0,0,0.8" />
                <Setter TargetName="KeycapFace" Property="Background" Value="#FFE8B5" />
                <Setter TargetName="KeycapGloss" Property="Opacity" Value="0.2" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
                <Setter Property="Cursor" Value="No" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="GameActionKeycapButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="24" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template" Value="{StaticResource GameActionKeycapButtonTemplate}" />
    </Style>

</ResourceDictionary>
