                            Background="#7A000C"
                            CornerRadius="7">
                            <Border
                                x:Name="innerBox"
                                Padding="1"
                                Background="#D32F2F"
                                CornerRadius="4.8">
                                <Grid>
                                    <Border
                                        x:Name="highlightStrip"
                                        Height="6"
                                        VerticalAlignment="Top"
                                        Background="#EF5350"
                                        CornerRadius="3.8,3.8,0,0" />
                                    <ContentPresenter
                                        Margin="{TemplateBinding Padding}"
