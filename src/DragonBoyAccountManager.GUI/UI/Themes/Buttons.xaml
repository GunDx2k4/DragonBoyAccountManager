                                    Foreground="{DynamicResource GameTextMutedBrush}"
                                    Opacity="0.45"
                                    Text="{Binding ShortcutBadge}"
                                    Visibility="{Binding HasIcon, Converter={StaticResource SkillBoolToVisConverter}, ConverterParameter=Invert}" />

