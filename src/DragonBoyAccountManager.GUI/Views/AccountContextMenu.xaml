<ContextMenu
    x:Class="DragonBoyAccountManager.GUI.Views.AccountContextMenu"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="190"
    Padding="0"
    Background="Transparent"
    BorderThickness="0"
    Grid.IsSharedSizeScope="True"
    HasDropShadow="False"
    SnapsToDevicePixels="True"
    d:DesignHeight="230"
    d:DesignWidth="190"
    d:Visibility="Visible"
    mc:Ignorable="d">

    <ContextMenu.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/DragonBoyAccountManager.GUI;component/UI/Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContextMenu.Resources>

    <ContextMenu.Template>
        <ControlTemplate TargetType="ContextMenu">
            <Border
                Padding="4,4"
                Background="{DynamicResource GameBgLightBrush}"
                BorderBrush="{DynamicResource GameBorderDarkBrush}"
                BorderThickness="1.8"
                CornerRadius="6">
                <Border.Effect>
                    <DropShadowEffect
                        BlurRadius="8"
                        Direction="315"
                        Opacity="0.3"
                        ShadowDepth="2"
                        Color="#4A2800" />
                </Border.Effect>
                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
            </Border>
        </ControlTemplate>
    </ContextMenu.Template>

    <MenuItem
        Command="{Binding PlacementTarget.Tag.LoginSelectedAccountsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
        CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
        Header="Đăng nhập tài khoản"
        Style="{StaticResource GameMenuItemStyle}">
        <MenuItem.Icon>
            <Path
                Width="11"
                Height="11"
                Data="M 1,6 L 7,6 M 5,3 L 8,6 L 5,9 M 9,1 L 11,1 L 11,11 L 9,11"
                Stroke="#2E7D32"
                StrokeEndLineCap="Round"
                StrokeStartLineCap="Round"
                StrokeThickness="1.5" />
        </MenuItem.Icon>
    </MenuItem>

    <MenuItem
        d:Visibility="Visible"
        Command="{Binding PlacementTarget.Tag.FocusGameWindowCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
        CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
        Header="Chọn vào game">
        <MenuItem.Style>
            <Style BasedOn="{StaticResource GameMenuItemStyle}" TargetType="MenuItem">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding PlacementTarget.DataContext.IsRunning, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="True">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </MenuItem.Style>
        <MenuItem.Icon>
            <Path
                Width="11"
                Height="11"
                Data="M 1,1 L 9,5 L 5,6 L 4,10 Z"
                Fill="#FF9800"
                Stretch="Uniform" />
        </MenuItem.Icon>
    </MenuItem>

    <MenuItem
        d:Visibility="Visible"
        Command="{Binding PlacementTarget.Tag.StopSelectedAccountsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
        CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
        Header="Đóng game">
        <MenuItem.Style>
            <Style BasedOn="{StaticResource GameMenuItemStyle}" TargetType="MenuItem">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding PlacementTarget.DataContext.IsRunning, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="True">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </MenuItem.Style>
        <MenuItem.Icon>
            <Rectangle
                Width="10"
                Height="10"
                Fill="#D32F2F"
                RadiusX="1.5"
                RadiusY="1.5" />
        </MenuItem.Icon>
    </MenuItem>

    <Separator>
        <Separator.Style>
            <Style BasedOn="{StaticResource GameMenuSeparatorStyle}" TargetType="Separator">
                <Setter Property="Visibility" Value="Visible" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding PlacementTarget.DataContext.IsRunning, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Separator.Style>
    </Separator>

    <MenuItem
        Command="{Binding PlacementTarget.Tag.DeleteAccountCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
        CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
        Header="Xóa tài khoản">
        <MenuItem.Style>
            <Style BasedOn="{StaticResource GameMenuItemStyle}" TargetType="MenuItem">
                <Setter Property="Visibility" Value="Visible" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding PlacementTarget.DataContext.IsRunning, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </MenuItem.Style>
        <MenuItem.Icon>
            <Path
                Width="10"
                Height="10"
                Data="M 1,1 L 9,9 M 1,9 L 9,1"
                Stroke="#C62828"
                StrokeEndLineCap="Round"
                StrokeStartLineCap="Round"
                StrokeThickness="2" />
        </MenuItem.Icon>
    </MenuItem>

    <Separator Style="{StaticResource GameMenuSeparatorStyle}" />

    <MenuItem
        Command="{Binding PlacementTarget.Tag.ArrangeWindowsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
        Header="Sắp xếp cửa sổ"
        Style="{StaticResource GameMenuItemStyle}">
        <MenuItem.Icon>
            <Path
                Width="11"
                Height="11"
                Data="M 1,1 H 7 V 7 H 1 Z M 4,4 H 10 V 10 H 4 Z"
                Stretch="Uniform"
                Stroke="#E65100"
                StrokeThickness="1.2" />
        </MenuItem.Icon>
    </MenuItem>
</ContextMenu>
