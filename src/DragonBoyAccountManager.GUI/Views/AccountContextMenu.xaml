<ContextMenu
    x:Class="DragonBoyAccountManager.GUI.Views.AccountContextMenu"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Style="{DynamicResource GameContextMenuStyle}"
    d:DesignHeight="230"
    d:DesignWidth="190"
    d:Visibility="Visible"
    mc:Ignorable="d">

    <ContextMenu.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/DragonBoyAccountManager.GUI;component/UI/Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContextMenu.Resources>

    <MenuItem
        Command="{Binding PlacementTarget.Tag.LoginSelectedAccountsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
        CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
        Header="Đăng nhập tài khoản"
        Style="{StaticResource GameMenuItemStyle}">
        <MenuItem.Icon>
            <Path
                Width="11"
                Height="11"
                Data="{StaticResource GameMenuLoginGeometry}"
                Stroke="{DynamicResource GameMenuIconGreenBrush}"
                StrokeEndLineCap="Round"
                StrokeStartLineCap="Round"
                StrokeThickness="1.5" />
        </MenuItem.Icon>
    </MenuItem>

    <MenuItem
        d:Visibility="Visible"
        Command="{Binding PlacementTarget.Tag.FocusGameWindowCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
        CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
        Header="Chọn vào game"
        Style="{StaticResource GameRunningAccountMenuItemStyle}">
        <MenuItem.Icon>
            <Path
                Width="11"
                Height="11"
                Data="{StaticResource GameMenuFocusGeometry}"
                Fill="{DynamicResource GameMenuIconOrangeBrush}"
                Stretch="Uniform" />
        </MenuItem.Icon>
    </MenuItem>

    <MenuItem
        d:Visibility="Visible"
        Command="{Binding PlacementTarget.Tag.StopSelectedAccountsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
        CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
        Header="Đóng game"
        Style="{StaticResource GameRunningAccountMenuItemStyle}">
        <MenuItem.Icon>
            <Rectangle
                Width="10"
                Height="10"
                Fill="{DynamicResource GameRedBrush}"
                RadiusX="1.5"
                RadiusY="1.5" />
        </MenuItem.Icon>
    </MenuItem>

    <Separator Style="{StaticResource GameStoppedAccountSeparatorStyle}" />

    <MenuItem
        Command="{Binding PlacementTarget.Tag.DeleteAccountCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
        CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
        Header="Xóa tài khoản"
        Style="{StaticResource GameStoppedAccountMenuItemStyle}">
        <MenuItem.Icon>
            <Path
                Width="10"
                Height="10"
                Data="{StaticResource GameMenuDeleteGeometry}"
                Stroke="{DynamicResource GameMenuIconRedBrush}"
                StrokeEndLineCap="Round"
                StrokeStartLineCap="Round"
                StrokeThickness="2" />
        </MenuItem.Icon>
    </MenuItem>

    <Separator Style="{StaticResource GameMenuSeparatorStyle}" />

    <MenuItem
        Command="{Binding PlacementTarget.Tag.ArrangeWindowsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
        Header="Sắp xếp cửa sổ"
        Style="{StaticResource GameMenuItemStyle}">
        <MenuItem.Icon>
            <Path
                Width="11"
                Height="11"
                Data="{StaticResource GameMenuArrangeGeometry}"
                Stretch="Uniform"
                Stroke="{DynamicResource GameMenuIconDarkOrangeBrush}"
                StrokeThickness="1.2" />
        </MenuItem.Icon>
    </MenuItem>
</ContextMenu>
