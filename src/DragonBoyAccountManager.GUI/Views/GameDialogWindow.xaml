<Window
    x:Class="DragonBoyAccountManager.GUI.Views.GameDialogWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    MinWidth="380"
    MaxWidth="560"
    AllowsTransparency="True"
    Background="Transparent"
    FontFamily="{DynamicResource GameFont}"
    FontWeight="Bold"
    MouseLeftButtonDown="Window_MouseLeftButtonDown"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="WidthAndHeight"
    SnapsToDevicePixels="True"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType"
    UseLayoutRounding="True"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None"
    mc:Ignorable="d">

    <Grid Margin="24">
        <!--  Dialog Card  -->
        <Border
            Margin="0,0,0,17"
            Background="#FFFFFF"
            BorderBrush="#000000"
            BorderThickness="2.8"
            CornerRadius="9"
            SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="14"
                    Direction="270"
                    Opacity="0.18"
                    ShadowDepth="3"
                    Color="#000000" />
            </Border.Effect>

            <StackPanel Margin="28,22,28,26">
                <!--  Optional Title Header  -->
                <TextBlock
                    x:Name="TitleTextBlock"
                    Margin="0,0,0,8"
                    HorizontalAlignment="Center"
                    FontFamily="{DynamicResource GameFont}"
                    FontSize="14"
                    FontWeight="Bold"
                    Foreground="#8B2500"
                    Visibility="Collapsed" />

                <!--  Message Content  -->
                <TextBlock
                    x:Name="MessageTextBlock"
                    FontFamily="{DynamicResource GameFont}"
                    FontSize="13.2"
                    FontWeight="Bold"
                    Foreground="#000000"
                    LineHeight="20"
                    SnapsToDevicePixels="True"
                    Text="Nội dung thông báo"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!--  Centered Buttons overlapping bottom border  -->
        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Orientation="Horizontal">
            <Button
                x:Name="PrimaryButton"
                Margin="6,0"
                Click="PrimaryButton_Click"
                Content="Đóng"
                IsDefault="True"
                Style="{StaticResource GameDialogButtonStyle}" />
            <Button
                x:Name="SecondaryButton"
                Margin="6,0"
                Click="SecondaryButton_Click"
                Content="Hủy"
                IsCancel="True"
                Style="{StaticResource GameDialogButtonStyle}"
                Visibility="Collapsed" />
        </StackPanel>
    </Grid>
</Window>
