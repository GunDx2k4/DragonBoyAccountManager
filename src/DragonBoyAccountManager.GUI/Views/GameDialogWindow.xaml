<Window
    x:Class="DragonBoyAccountManager.GUI.Views.GameDialogWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    MinWidth="380"
    MaxWidth="560"
    AllowsTransparency="True"
    Background="Transparent"
    FontFamily="{DynamicResource GameFont}"
    FontWeight="Bold"
    MouseLeftButtonDown="Window_MouseLeftButtonDown"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="WidthAndHeight"
    SnapsToDevicePixels="True"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType"
    UseLayoutRounding="True"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None"
    mc:Ignorable="d">

    <Grid Margin="24">

        <Border
            Margin="0,0,0,17"
            Padding="2.5"
            Background="{DynamicResource GameBorderDarkBrush}"
            CornerRadius="8"
            SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="4"
                    Direction="270"
                    Opacity="0.45"
                    ShadowDepth="3"
                    Color="{StaticResource GameShadowBackdropColor}" />
            </Border.Effect>

            <Border
                Background="{DynamicResource GameBgLightBrush}"
                BorderBrush="{DynamicResource GameHeaderBrush}"
                BorderThickness="2"
                CornerRadius="6">
                <Grid>
                    <Border
                        Height="5"
                        VerticalAlignment="Top"
                        Background="{DynamicResource GamePanelHighlightBrush}"
                        CornerRadius="4,4,0,0"
                        IsHitTestVisible="False" />
                    <Border
                        Height="3"
                        VerticalAlignment="Bottom"
                        Background="{DynamicResource GamePanelShadowBrush}"
                        CornerRadius="0,0,4,4"
                        IsHitTestVisible="False" />

                    <StackPanel Margin="28,22,28,26">

                        <TextBlock
                            x:Name="TitleTextBlock"
                            Margin="0,0,0,8"
                            HorizontalAlignment="Center"
                            FontFamily="{DynamicResource GameFont}"
                            FontSize="14"
                            FontWeight="ExtraBold"
                            Foreground="{DynamicResource GameDangerBrush}"
                            Visibility="Collapsed" />

                        <ScrollViewer
                            MaxHeight="340"
                            FocusVisualStyle="{x:Null}"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                            <TextBlock
                                x:Name="MessageTextBlock"
                                FontFamily="{DynamicResource GameFont}"
                                FontSize="12.5"
                                FontWeight="Bold"
                                Foreground="{DynamicResource GameTextDarkBrush}"
                                LineHeight="19"
                                SnapsToDevicePixels="True"
                                Text="Nội dung thông báo"
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                        </ScrollViewer>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>

        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Orientation="Horizontal">
            <Button
                x:Name="PrimaryButton"
                Margin="6,0"
                Click="PrimaryButton_Click"
                Content="Đóng"
                IsDefault="True"
                Style="{StaticResource GameDialogButtonStyle}" />
            <Button
                x:Name="SecondaryButton"
                Margin="6,0"
                Click="SecondaryButton_Click"
                Content="Hủy"
                IsCancel="True"
                Style="{StaticResource GameDialogButtonStyle}"
                Visibility="Collapsed" />
        </StackPanel>
    </Grid>
</Window>
