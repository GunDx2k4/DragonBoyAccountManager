<UserControl
    x:Class="DragonBoyAccountManager.GUI.Views.AppStatusBarView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="clr-namespace:DragonBoyAccountManager.GUI.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodels:AppStatusBarViewModel}"
    d:DesignHeight="34"
    d:DesignWidth="1180"
    mc:Ignorable="d">


    <Border
        Background="{DynamicResource GameBgAltBrush}"
        BorderBrush="{DynamicResource GameBorderBrush}"
        BorderThickness="0,1.5,0,0"
        CornerRadius="0,0,4.5,4.5">
        <Grid>
            <Border
                Height="3"
                VerticalAlignment="Top"
                Background="{DynamicResource GamePanelHighlightBrush}" />

            <Border
                Height="3"
                VerticalAlignment="Bottom"
                Background="{DynamicResource GamePanelShadowBrush}"
                CornerRadius="0,0,4.5,4.5" />

            <Grid Margin="14,0" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <ContentControl
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Content="Active"
                        ContentTemplate="{StaticResource StatusOrbTemplate}" />
                    <TextBlock
                        FontSize="11"
                        FontWeight="Bold"
                        Foreground="{DynamicResource GameTextMutedBrush}"
                        Text="Trạng thái: " />
                    <TextBlock
                        FontSize="11"
                        FontWeight="Bold"
                        Foreground="{DynamicResource GameTextDarkBrush}"
                        Text="{Binding StatusMessage}" />
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,5,0"
                        VerticalAlignment="Center"
                        FontSize="11"
                        FontWeight="Bold"
                        Foreground="{DynamicResource GameTextDarkBrush}"
                        Text="Đường dẫn game:" />

                    <TextBox
                        Width="210"
                        Height="24"
                        Padding="5,1"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Style="{StaticResource GameTextBoxStyle}"
                        Text="{Binding GamePath, UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="{Binding GamePath}" />

                    <Button
                        Height="24"
                        MinWidth="66"
                        Margin="5,0,0,0"
                        VerticalAlignment="Center"
                        Command="{Binding BrowseGamePathCommand}"
                        Content="Chọn file..."
                        Style="{StaticResource GameMiniButton}"
                        ToolTip="Chọn tệp thực thi game (.exe)" />

                    <Rectangle
                        Width="1.5"
                        Height="16"
                        Margin="8,0"
                        Fill="{DynamicResource GameBorderBrush}" />

                    <TextBlock
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        FontFamily="{DynamicResource GameFont}"
                        FontSize="11.5"
                        FontWeight="Bold"
                        Foreground="{DynamicResource GameTextDarkBrush}"
                        Text="Phiên bản:" />

                    <Button
                        Padding="0"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{Binding OpenAssemblyFolderCommand}"
                        Cursor="Hand"
                        Focusable="False"
                        ToolTip="{Binding AssemblyStatusTooltip}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border
                                    Padding="8,2.5"
                                    Background="{Binding DataContext.AssemblyStatusBg, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    BorderBrush="{Binding DataContext.AssemblyStatusColor, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    SnapsToDevicePixels="True">
                                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                        <Ellipse
                                            Width="7"
                                            Height="7"
                                            Margin="0,0,5,0"
                                            VerticalAlignment="Center"
                                            Fill="{Binding DataContext.AssemblyStatusColor, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontFamily="{DynamicResource GameFont}"
                                            FontSize="11.5"
                                            FontWeight="Bold"
                                            Foreground="{Binding DataContext.AssemblyStatusColor, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            Text="{Binding DataContext.AssemblyStatus, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
