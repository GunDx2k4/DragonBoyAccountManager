<UserControl
    x:Class="DragonBoyAccountManager.GUI.Views.AppStatusBarView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:DragonBoyAccountManager.GUI.UI.Controls"
    xmlns:converters="clr-namespace:DragonBoyAccountManager.GUI.UI.Converters"
    xmlns:viewmodels="clr-namespace:DragonBoyAccountManager.GUI.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodels:AppStatusBarViewModel}"
    d:DesignHeight="34"
    d:DesignWidth="1180"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:ClientStatusToBrushConverter x:Key="ClientStatusToBrushConverter" />
    </UserControl.Resources>

    <Border
        Background="{DynamicResource GameBgAltBrush}"
        BorderBrush="{DynamicResource GameBorderBrush}"
        BorderThickness="0,1.5,0,0"
        CornerRadius="0,0,4.5,4.5">
        <Grid>
            <Border
                Height="3"
                VerticalAlignment="Top"
                Background="{DynamicResource GamePanelHighlightBrush}" />

            <Border
                Height="2"
                VerticalAlignment="Bottom"
                Background="{DynamicResource GamePanelShadowBrush}"
                CornerRadius="0,0,4.5,4.5" />

            <Grid Margin="12,0" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    Margin="0,0,12,0"
                    Padding="8,2,10,2"
                    VerticalAlignment="Center"
                    Background="{DynamicResource GameBgBrush}"
                    BorderBrush="{DynamicResource GameBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    SnapsToDevicePixels="True">
                    <Grid>
                        <Border
                            Height="1.5"
                            VerticalAlignment="Bottom"
                            Background="{DynamicResource GamePanelShadowBrush}"
                            CornerRadius="0,0,3,3" />

                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel
                                Grid.Column="0"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                Orientation="Vertical">
                                <Rectangle
                                    Width="2"
                                    Height="2"
                                    Margin="0,0.8"
                                    Fill="{DynamicResource GameBorderHighlightBrush}" />
                                <Rectangle
                                    Width="2"
                                    Height="2"
                                    Margin="0,0.8"
                                    Fill="{DynamicResource GameBorderHighlightBrush}" />
                            </StackPanel>

                            <ui:GameStatusOrb
                                Grid.Column="1"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                Status="{Binding Status}"
                                Size="11" />

                            <TextBlock
                                Grid.Column="2"
                                Margin="0,0,5,0"
                                VerticalAlignment="Center"
                                FontFamily="{DynamicResource GameFont}"
                                FontSize="9.5"
                                FontWeight="ExtraBold"
                                Foreground="{DynamicResource GameTextMutedBrush}"
                                Text="TRẠNG THÁI:" />

                            <TextBlock
                                Grid.Column="3"
                                VerticalAlignment="Center"
                                Effect="{StaticResource GameTextPixelShadowLight}"
                                FontFamily="{DynamicResource GameFont}"
                                FontSize="11"
                                FontWeight="Bold"
                                Foreground="{DynamicResource GameTextDarkBrush}"
                                Text="{Binding StatusMessage}"
                                TextTrimming="CharacterEllipsis"
                                ToolTip="{Binding StatusMessage}" />
                        </Grid>
                    </Grid>
                </Border>

                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,5,0"
                        VerticalAlignment="Center"
                        FontFamily="{DynamicResource GameFont}"
                        FontSize="9.5"
                        FontWeight="ExtraBold"
                        Foreground="{DynamicResource GameTextMutedBrush}"
                        Text="GAME .EXE:" />

                    <TextBox
                        Width="160"
                        MaxWidth="220"
                        Height="22"
                        Padding="5,1"
                        VerticalAlignment="Center"
                        FontFamily="{DynamicResource GameFont}"
                        FontSize="10.5"
                        Style="{StaticResource GameTextBoxStyle}"
                        Text="{Binding GamePath, UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="{Binding GamePath}" />

                    <Button
                        Height="22"
                        MinWidth="50"
                        Margin="4,0,0,0"
                        VerticalAlignment="Center"
                        Command="{Binding BrowseGamePathCommand}"
                        Content="CHỌN"
                        FontFamily="{DynamicResource GameFont}"
                        FontSize="10"
                        FontWeight="Bold"
                        Style="{StaticResource GameMiniButton}"
                        ToolTip="Chọn tệp thực thi game (.exe)" />

                    <StackPanel
                        Margin="9,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <Rectangle
                            Width="1"
                            Height="14"
                            Fill="{DynamicResource GameBorderBrush}" />
                        <Rectangle
                            Width="1"
                            Height="14"
                            Fill="{DynamicResource GamePanelHighlightBrush}" />
                    </StackPanel>

                    <TextBlock
                        Margin="0,0,5,0"
                        VerticalAlignment="Center"
                        FontFamily="{DynamicResource GameFont}"
                        FontSize="9.5"
                        FontWeight="ExtraBold"
                        Foreground="{DynamicResource GameTextMutedBrush}"
                        Text="TOOL:" />

                    <Border
                        Padding="6,1.5"
                        VerticalAlignment="Center"
                        Background="{DynamicResource GamePillVersionBgBrush}"
                        BorderBrush="{DynamicResource GamePillVersionBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="3"
                        ToolTip="Phiên bản công cụ DragonBoy Account Manager">
                        <TextBlock
                            VerticalAlignment="Center"
                            Effect="{StaticResource GameTextPixelShadow}"
                            FontFamily="{DynamicResource GameFont}"
                            FontSize="9"
                            FontWeight="ExtraBold"
                            Foreground="{DynamicResource GameTextLightBrush}"
                            Text="{Binding AppVersion, StringFormat='v{0}'}" />
                    </Border>

                    <StackPanel
                        Margin="9,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <Rectangle
                            Width="1"
                            Height="14"
                            Fill="{DynamicResource GameBorderBrush}" />
                        <Rectangle
                            Width="1"
                            Height="14"
                            Fill="{DynamicResource GamePanelHighlightBrush}" />
                    </StackPanel>

                    <TextBlock
                        Margin="0,0,5,0"
                        VerticalAlignment="Center"
                        FontFamily="{DynamicResource GameFont}"
                        FontSize="9.5"
                        FontWeight="ExtraBold"
                        Foreground="{DynamicResource GameTextMutedBrush}"
                        Text="CLIENT:" />

                    <Button
                        Padding="0"
                        VerticalAlignment="Center"
                        Command="{Binding OpenAssemblyFolderCommand}"
                        Style="{StaticResource GameGhostButton}"
                        ToolTip="{Binding AssemblyStatusTooltip}">
                        <ui:GameBadge
                            Padding="7,2"
                            Background="{Binding Status, Converter={StaticResource ClientStatusToBrushConverter}, ConverterParameter=Background}"
                            BorderBrush="{Binding Status, Converter={StaticResource ClientStatusToBrushConverter}}"
                            BorderThickness="1"
                            CornerRadius="3.5">
                            <StackPanel
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <Ellipse
                                    Width="6.5"
                                    Height="6.5"
                                    Margin="0,0,5,0"
                                    VerticalAlignment="Center"
                                    Fill="{Binding Status, Converter={StaticResource ClientStatusToBrushConverter}}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontFamily="{DynamicResource GameFont}"
                                    FontSize="10.5"
                                    FontWeight="Bold"
                                    Foreground="{Binding Status, Converter={StaticResource ClientStatusToBrushConverter}}"
                                    Text="{Binding AssemblyStatus}" />
                            </StackPanel>
                        </ui:GameBadge>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
