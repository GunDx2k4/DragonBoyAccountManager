<UserControl
    x:Class="DragonBoyAccountManager.GUI.Views.FeedbackView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:DragonBoyAccountManager.GUI.UI.Controls"
    xmlns:viewmodels="clr-namespace:DragonBoyAccountManager.GUI.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodels:FeedbackViewModel}"
    d:DesignWidth="435"
    mc:Ignorable="d">

    <ScrollViewer
        FocusVisualStyle="{x:Null}"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10,8,10,14">
            <ui:GameCard Header="GÓP Ý &amp; BÁO CÁO LỖI">
                <StackPanel>
                    <Border
                        Margin="0,0,0,10"
                        Padding="10,8"
                        Background="{DynamicResource GameBgAltBrush}"
                        BorderBrush="{DynamicResource GameBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                        <TextBlock
                            FontSize="11"
                            Foreground="{DynamicResource GameTextDarkBrush}"
                            TextWrapping="Wrap">
                            Gửi phản hồi về tính năng mới, cải tiến cập nhật hoặc báo cáo lỗi bạn gặp phải. Nội dung sẽ được chuyển trực tiếp tới kênh Discord của đội ngũ phát triển.
                        </TextBlock>
                    </Border>

                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="11"
                        FontWeight="Bold"
                        Foreground="{DynamicResource GameTextDarkBrush}"
                        Text="Phân loại góp ý:" />
                    <ComboBox
                        Margin="0,0,0,10"
                        Height="28"
                        ItemsSource="{Binding FeedbackTypes}"
                        SelectedItem="{Binding SelectedTypeOption}"
                        DisplayMemberPath="DisplayName"
                        Style="{StaticResource GameComboBoxStyle}" />

                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="11"
                        FontWeight="Bold"
                        Foreground="{DynamicResource GameTextDarkBrush}"
                        Text="Tiêu đề (ngắn gọn):" />
                    <TextBox
                        Margin="0,0,0,10"
                        Height="28"
                        Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                        Style="{StaticResource GameTextBoxStyle}" />

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock
                                Margin="0,0,0,4"
                                FontSize="11"
                                FontWeight="Bold"
                                Foreground="{DynamicResource GameTextDarkBrush}"
                                Text="Người gửi (tùy chọn):" />
                            <TextBox
                                Height="28"
                                Text="{Binding SenderName, UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource GameTextBoxStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock
                                Margin="0,0,0,4"
                                FontSize="11"
                                FontWeight="Bold"
                                Foreground="{DynamicResource GameTextDarkBrush}"
                                Text="Liên hệ (Discord/Zalo):" />
                            <TextBox
                                Height="28"
                                Text="{Binding ContactInfo, UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource GameTextBoxStyle}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="11"
                        FontWeight="Bold"
                        Foreground="{DynamicResource GameTextDarkBrush}"
                        Text="Nội dung chi tiết (ít nhất 10 ký tự):" />
                    <TextBox
                        Height="110"
                        Margin="0,0,0,10"
                        Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}"
                        Style="{StaticResource GameTextAreaStyle}" />

                    <CheckBox
                        Margin="0,0,0,12"
                        Content="Đính kèm thông tin phiên bản DBAM &amp; hệ điều hành"
                        FontSize="11"
                        FontWeight="SemiBold"
                        IsChecked="{Binding IncludeSystemInfo}"
                        Style="{StaticResource GameCheckBoxStyle}" />

                    <Border Style="{StaticResource GameAlertBannerBorderStyle}">
                        <TextBlock
                            Style="{StaticResource GameAlertBannerTextStyle}"
                            Text="{Binding StatusMessage}" />
                    </Border>

                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button
                            Height="28"
                            MinWidth="80"
                            Margin="0,0,8,0"
                            Padding="12,0"
                            Command="{Binding ClearFormCommand}"
                            Content="LÀM MỚI"
                            FontSize="11"
                            Style="{StaticResource GameSecondaryButton}" />
                        <Button
                            Height="28"
                            MinWidth="110"
                            Padding="16,0"
                            Command="{Binding SendFeedbackCommand}"
                            Content="{Binding SubmitButtonText}"
                            FontSize="11"
                            Style="{StaticResource GamePrimaryButton}" />
                    </StackPanel>
                </StackPanel>
            </ui:GameCard>
        </StackPanel>
    </ScrollViewer>
</UserControl>
