<UserControl
    x:Class="DragonBoyAccountManager.GUI.Views.FeedbackView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:DragonBoyAccountManager.GUI.UI.Controls"
    xmlns:viewmodels="clr-namespace:DragonBoyAccountManager.GUI.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodels:FeedbackViewModel}"
    d:DesignWidth="435"
    mc:Ignorable="d">

    <ui:GameCard Header="GÓP Ý &amp; BÁO CÁO LỖI">
        <StackPanel>
            <Border
                Margin="0,0,0,10"
                Padding="10,8"
                Background="{DynamicResource GameBgAltBrush}"
                BorderBrush="{DynamicResource GameBorderBrush}"
                BorderThickness="1"
                CornerRadius="4">
                <TextBlock
                    FontSize="11"
                    Foreground="{DynamicResource GameTextDarkBrush}"
                    TextWrapping="Wrap">
                    Gửi phản hồi về tính năng mới, cải tiến cập nhật hoặc báo cáo lỗi bạn gặp phải. Nội dung sẽ được chuyển trực tiếp tới kênh Discord của đội ngũ phát triển.
                </TextBlock>
            </Border>

            <TextBlock
                Margin="0,0,0,4"
                FontSize="11"
                FontWeight="Bold"
                Foreground="{DynamicResource GameTextDarkBrush}"
                Text="Phân loại góp ý:" />
            <ComboBox
                Margin="0,0,0,10"
                Height="28"
                ItemsSource="{Binding FeedbackTypes}"
                SelectedItem="{Binding SelectedTypeOption}"
                DisplayMemberPath="DisplayName"
                Style="{StaticResource GameComboBoxStyle}" />

            <TextBlock
                Margin="0,0,0,4"
                FontSize="11"
                FontWeight="Bold"
                Foreground="{DynamicResource GameTextDarkBrush}"
                Text="Tiêu đề (ngắn gọn):" />
            <TextBox
                Margin="0,0,0,10"
                Height="28"
                Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                Style="{StaticResource GameTextBoxStyle}" />

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="11"
                        FontWeight="Bold"
                        Foreground="{DynamicResource GameTextDarkBrush}"
                        Text="Người gửi (tùy chọn):" />
                    <TextBox
                        Height="28"
                        Text="{Binding SenderName, UpdateSourceTrigger=PropertyChanged}"
                        Style="{StaticResource GameTextBoxStyle}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="11"
                        FontWeight="Bold"
                        Foreground="{DynamicResource GameTextDarkBrush}"
                        Text="Liên hệ (Discord/Zalo):" />
                    <TextBox
                        Height="28"
                        Text="{Binding ContactInfo, UpdateSourceTrigger=PropertyChanged}"
                        Style="{StaticResource GameTextBoxStyle}" />
                </StackPanel>
            </Grid>

            <TextBlock
                Margin="0,0,0,4"
                FontSize="11"
                FontWeight="Bold"
                Foreground="{DynamicResource GameTextDarkBrush}"
                Text="Nội dung chi tiết (ít nhất 10 ký tự):" />
            <Border
                Margin="0,0,0,10"
                Padding="1"
                Background="{DynamicResource GameInputRimBrush}"
                CornerRadius="5"
                SnapsToDevicePixels="True">
                <Border
                    Padding="6,4"
                    Background="{DynamicResource GameInputNormalBgBrush}"
                    BorderBrush="{DynamicResource GameInputNormalBorderBrush}"
                    BorderThickness="1.5"
                    CornerRadius="4"
                    SnapsToDevicePixels="True">
                    <TextBox
                        Height="110"
                        AcceptsReturn="True"
                        BorderThickness="0"
                        Background="Transparent"
                        Foreground="{DynamicResource GameInputNormalTextBrush}"
                        CaretBrush="{DynamicResource GameInputNormalTextBrush}"
                        FontSize="11.5"
                        FontWeight="Normal"
                        Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}"
                        TextWrapping="Wrap"
                        VerticalScrollBarVisibility="Auto" />
                </Border>
            </Border>

            <CheckBox
                Margin="0,0,0,12"
                Content="Đính kèm thông tin phiên bản DBAM &amp; hệ điều hành"
                FontSize="11"
                FontWeight="SemiBold"
                IsChecked="{Binding IncludeSystemInfo}"
                Style="{StaticResource GameCheckBoxStyle}" />

            <Border
                Margin="0,0,0,10"
                Padding="10,8"
                CornerRadius="4"
                BorderThickness="1.2">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Setter Property="Background" Value="#FEF2F2" />
                        <Setter Property="BorderBrush" Value="#EF4444" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasStatusMessage}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsStatusSuccess}" Value="True">
                                <Setter Property="Background" Value="#ECFDF5" />
                                <Setter Property="BorderBrush" Value="#10B981" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock
                    FontSize="11"
                    FontWeight="Bold"
                    Text="{Binding StatusMessage}"
                    TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#B91C1C" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStatusSuccess}" Value="True">
                                    <Setter Property="Foreground" Value="#047857" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>

            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button
                    Height="28"
                    MinWidth="80"
                    Margin="0,0,8,0"
                    Padding="12,0"
                    Command="{Binding ClearFormCommand}"
                    Content="LÀM MỚI"
                    FontSize="11"
                    Style="{StaticResource GameSecondaryButton}" />
                <Button
                    Height="28"
                    MinWidth="110"
                    Padding="16,0"
                    Command="{Binding SendFeedbackCommand}"
                    Content="{Binding SubmitButtonText}"
                    FontSize="11"
                    Style="{StaticResource GamePrimaryButton}" />
            </StackPanel>
        </StackPanel>
    </ui:GameCard>
</UserControl>
