<UserControl
    x:Class="DragonBoyAccountManager.GUI.Views.AccountConfigTabView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="clr-namespace:DragonBoyAccountManager.GUI.UI.Converters"
    xmlns:guiModels="clr-namespace:DragonBoyAccountManager.GUI.Models"
    xmlns:models="clr-namespace:DragonBoyAccountManager.Core.Game.Snapshots;assembly=DragonBoyAccountManager.Core"
    xmlns:ui="clr-namespace:DragonBoyAccountManager.GUI.UI.Controls"
    xmlns:viewmodels="clr-namespace:DragonBoyAccountManager.GUI.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodels:AccountFormViewModel}"
    d:DesignHeight="520"
    d:DesignWidth="435"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <ControlTemplate x:Key="DpadArrowRightTemplate">
            <Grid Width="54" Height="54">
                <Path
                    Data="M 13.5,14 L 23.5,14 L 22.5,2 L 46.5,27 L 22.5,52 L 23.5,40 L 13.5,40 A 6,6 0 0 1 7.5,34 L 7.5,20 A 6,6 0 0 1 13.5,14 Z"
                    Fill="{DynamicResource GameGoldAccentBrush}"
                    Stroke="{DynamicResource GameDarkBrownBrush}"
                    StrokeEndLineCap="Round"
                    StrokeLineJoin="Round"
                    StrokeStartLineCap="Round"
                    StrokeThickness="3.8" />
                <Path
                    Data="M 12.5,16 L 15.5,16 L 15.5,38 L 12.5,38 A 4,4 0 0 1 9.5,34 L 9.5,20 A 4,4 0 0 1 12.5,16 Z"
                    Fill="{DynamicResource GameGoldDarkBrush}"
                    Opacity="0.95" />
            </Grid>
        </ControlTemplate>

        <ControlTemplate x:Key="DpadArrowLeftTemplate">
            <Grid Width="54" Height="54">
                <Path
                    Data="M 40.5,14 L 30.5,14 L 31.5,2 L 7.5,27 L 31.5,52 L 30.5,40 L 40.5,40 A 6,6 0 0 0 46.5,34 L 46.5,20 A 6,6 0 0 0 40.5,14 Z"
                    Fill="{DynamicResource GameGoldAccentBrush}"
                    Stroke="{DynamicResource GameDarkBrownBrush}"
                    StrokeEndLineCap="Round"
                    StrokeLineJoin="Round"
                    StrokeStartLineCap="Round"
                    StrokeThickness="3.8" />
                <Path
                    Data="M 41.5,16 L 38.5,16 L 38.5,38 L 41.5,38 A 4,4 0 0 0 44.5,34 L 44.5,20 A 4,4 0 0 0 41.5,16 Z"
                    Fill="{DynamicResource GameGoldDarkBrush}"
                    Opacity="0.95" />
            </Grid>
        </ControlTemplate>

        <ControlTemplate x:Key="DpadArrowUpTemplate">
            <Grid Width="54" Height="54">
                <Path
                    Data="M 14,40.5 L 14,30.5 L 2,31.5 L 27,7.5 L 52,31.5 L 40,30.5 L 40,40.5 A 6,6 0 0 1 34,46.5 L 20,46.5 A 6,6 0 0 1 14,40.5 Z"
                    Fill="{DynamicResource GameGoldAccentBrush}"
                    Stroke="{DynamicResource GameDarkBrownBrush}"
                    StrokeEndLineCap="Round"
                    StrokeLineJoin="Round"
                    StrokeStartLineCap="Round"
                    StrokeThickness="3.8" />
                <Path
                    Data="M 16,41.5 L 16,38.5 L 38,38.5 L 38,41.5 A 4,4 0 0 1 34,44.5 L 20,44.5 A 4,4 0 0 1 16,41.5 Z"
                    Fill="{DynamicResource GameGoldDarkBrush}"
                    Opacity="0.95" />
            </Grid>
        </ControlTemplate>

        <ControlTemplate x:Key="DpadArrowDownTemplate">
            <Grid Width="54" Height="54">
                <Path
                    Data="M 14,13.5 L 14,23.5 L 2,22.5 L 27,46.5 L 52,22.5 L 40,23.5 L 40,13.5 A 6,6 0 0 0 34,7.5 L 20,7.5 A 6,6 0 0 0 14,13.5 Z"
                    Fill="{DynamicResource GameGoldAccentBrush}"
                    Stroke="{DynamicResource GameDarkBrownBrush}"
                    StrokeEndLineCap="Round"
                    StrokeLineJoin="Round"
                    StrokeStartLineCap="Round"
                    StrokeThickness="3.8" />
                <Path
                    Data="M 16,12.5 L 16,15.5 L 38,15.5 L 38,12.5 A 4,4 0 0 0 34,9.5 L 20,9.5 A 4,4 0 0 0 16,12.5 Z"
                    Fill="{DynamicResource GameGoldDarkBrush}"
                    Opacity="0.95" />
            </Grid>
        </ControlTemplate>
    </UserControl.Resources>

    <ScrollViewer FocusVisualStyle="{x:Null}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="8,4">

            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,4">
                    <TextBlock
                        Margin="0,0,0,1"
                        FontSize="10.5"
                        FontWeight="Bold"
                        Foreground="{DynamicResource GameTextDarkBrush}"
                        Text="Tài khoản:" />
                    <Grid Height="26">
                        <TextBox
                            Padding="8,1,25,1"
                            Cursor="Arrow"
                            IsReadOnly="True"
                            Text="{Binding DisplayUsername, Mode=OneWay}">
                            <TextBox.Style>
                                <Style BasedOn="{StaticResource GameTextBoxStyle}" TargetType="TextBox">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMasked}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                        <TextBox Padding="8,1,25,1" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.Style>
                                <Style BasedOn="{StaticResource GameTextBoxStyle}" TargetType="TextBox">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMasked}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                        <Button
                            Width="18"
                            Height="18"
                            Margin="0,0,5,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Command="{Binding ToggleHideAccountsCommand}"
                            Style="{StaticResource GameEyeButtonStyle}"
                            ToolTip="Ẩn/Hiện tên tài khoản">
                            <Control
                                Width="12"
                                Height="12"
                                Focusable="False"
                                IsHitTestVisible="False"
                                Template="{StaticResource DragonBallHideAccountIconTemplate}" />
                        </Button>
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,4">
                    <TextBlock
                        Margin="0,0,0,1"
                        FontSize="10.5"
                        FontWeight="Bold"
                        Foreground="{DynamicResource GameTextDarkBrush}"
                        Text="Mật khẩu:" />
                    <ui:GamePasswordBox
                        Height="26"
                        Password="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        IsPasswordVisible="{Binding IsPasswordVisible, Mode=TwoWay}" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0">
                    <TextBlock
                        Margin="0,0,0,1"
                        FontSize="10.5"
                        FontWeight="Bold"
                        Foreground="{DynamicResource GameTextDarkBrush}"
                        Text="Máy chủ:" />
                    <ComboBox
                        Height="26"
                        ItemsSource="{Binding AvailableServers}"
                        SelectedItem="{Binding SelectedServer}"
                        Style="{StaticResource GameComboBoxStyle}" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="2" VerticalAlignment="Bottom" Margin="0,0,0,4">
                    <CheckBox
                        Content="Tự động đăng nhập"
                        FontSize="10.5"
                        FontWeight="Bold"
                        Foreground="{DynamicResource GameTextDarkBrush}"
                        IsChecked="{Binding AutoLogin}"
                        Style="{StaticResource GameCheckBoxStyle}"
                        ToolTip="Tự động đăng nhập khi mở game" />
                </StackPanel>
            </Grid>

            <Border
                Margin="0,2,0,0"
                Padding="6,4"
                Background="{DynamicResource GameBgBrush}"
                BorderBrush="{DynamicResource GameBorderBrush}"
                BorderThickness="1.5"
                CornerRadius="6">
                <StackPanel>

                    <Grid Margin="0,0,0,4" SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            FontSize="10"
                            FontWeight="ExtraBold"
                            Foreground="{DynamicResource GameTextDarkBrush}"
                            Text="ĐỔI KHU:" />

                        <ComboBox
                            x:Name="ZoneComboBox"
                            Grid.Column="1"
                            Height="24"
                            DropDownOpened="ZoneComboBox_DropDownOpened"
                            ItemsSource="{Binding AvailableZones}"
                            SelectedItem="{Binding SelectedZone, Mode=TwoWay}"
                            Style="{StaticResource GameComboBoxStyle}"
                            ToolTip="Chọn khu từ danh sách để chuyển map ngay lập tức">
                            <ComboBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:WorldZoneInfo}">
                                    <Grid Margin="2,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock
                                                FontSize="10"
                                                FontWeight="Bold"
                                                Foreground="{DynamicResource GameTextDarkBrush}"
                                                Text="{Binding ZoneId, StringFormat='Khu {0}'}" />
                                            <TextBlock
                                                Margin="4,0,0,0"
                                                FontSize="9"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource GameStatusSuccessBrush}"
                                                Text="{Binding NumPlayers, StringFormat='({0}'}" />
                                            <TextBlock
                                                FontSize="9"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource GameStatusSuccessBrush}"
                                                Text="{Binding MaxPlayers, StringFormat='/{0})'}" />
                                        </StackPanel>
                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="6,0,0,0"
                                            FontSize="8.5"
                                            FontWeight="ExtraBold"
                                            Foreground="{DynamicResource GameStatusDangerBrush}"
                                            Text="ĐẦY"
                                            VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFull}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <StackPanel
                            Grid.Column="2"
                            Margin="4,0,0,0"
                            Orientation="Horizontal">
                            <Button
                                Width="24"
                                Height="24"
                                Margin="0,0,3,0"
                                Command="{Binding PreviousZoneCommand}"
                                Style="{StaticResource GameSecondaryButton}"
                                ToolTip="Chuyển sang khu trước (Phím [)">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="{DynamicResource GameFont}"
                                    FontSize="11"
                                    FontWeight="ExtraBold"
                                    Foreground="{DynamicResource GameBtnTanTextBrush}"
                                    Text="&lt;" />
                            </Button>
                            <Button
                                Width="24"
                                Height="24"
                                Command="{Binding NextZoneCommand}"
                                Style="{StaticResource GameSecondaryButton}"
                                ToolTip="Chuyển sang khu kế tiếp (Phím ])">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="{DynamicResource GameFont}"
                                    FontSize="11"
                                    FontWeight="ExtraBold"
                                    Foreground="{DynamicResource GameBtnTanTextBrush}"
                                    Text="&gt;" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Border
                        Height="1"
                        Margin="0,0,0,4"
                        Background="{DynamicResource GameBorderBrush}"
                        Opacity="0.3" />

                    <Grid Margin="0,2,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="34" />
                                    <RowDefinition Height="2" />
                                    <RowDefinition Height="34" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="2" />
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="2" />
                                    <ColumnDefinition Width="34" />
                                </Grid.ColumnDefinitions>

                                <Button
                                    Grid.Row="0"
                                    Grid.Column="2"
                                    Width="34"
                                    Height="34"
                                    MouseLeave="DpadButton_MouseLeave"
                                    PreviewMouseDown="DpadButton_PreviewMouseDown"
                                    PreviewMouseUp="DpadButton_PreviewMouseUp"
                                    Style="{StaticResource GameArrowVectorButtonStyle}"
                                    Tag="Up"
                                    ToolTip="Di chuyển Lên (Phím mũi tên Lên / Phím W)">
                                    <Viewbox
                                        Width="20"
                                        Height="20"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                        <Control Template="{StaticResource DpadArrowUpTemplate}" />
                                    </Viewbox>
                                </Button>

                                <Button
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Width="34"
                                    Height="34"
                                    MouseLeave="DpadButton_MouseLeave"
                                    PreviewMouseDown="DpadButton_PreviewMouseDown"
                                    PreviewMouseUp="DpadButton_PreviewMouseUp"
                                    Style="{StaticResource GameArrowVectorButtonStyle}"
                                    Tag="Left"
                                    ToolTip="Di chuyển Trái (Phím mũi tên Trái / Phím A)">
                                    <Viewbox
                                        Width="20"
                                        Height="20"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                        <Control Template="{StaticResource DpadArrowLeftTemplate}" />
                                    </Viewbox>
                                </Button>

                                <Button
                                    Grid.Row="2"
                                    Grid.Column="2"
                                    Width="34"
                                    Height="34"
                                    MouseLeave="DpadButton_MouseLeave"
                                    PreviewMouseDown="DpadButton_PreviewMouseDown"
                                    PreviewMouseUp="DpadButton_PreviewMouseUp"
                                    Style="{StaticResource GameArrowVectorButtonStyle}"
                                    Tag="Down"
                                    ToolTip="Di chuyển Xuống (Phím mũi tên Xuống / Phím S)">
                                    <Viewbox
                                        Width="20"
                                        Height="20"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                        <Control Template="{StaticResource DpadArrowDownTemplate}" />
                                    </Viewbox>
                                </Button>

                                <Button
                                    Grid.Row="2"
                                    Grid.Column="4"
                                    Width="34"
                                    Height="34"
                                    MouseLeave="DpadButton_MouseLeave"
                                    PreviewMouseDown="DpadButton_PreviewMouseDown"
                                    PreviewMouseUp="DpadButton_PreviewMouseUp"
                                    Style="{StaticResource GameArrowVectorButtonStyle}"
                                    Tag="Right"
                                    ToolTip="Di chuyển Phải (Phím mũi tên Phải / Phím D)">
                                    <Viewbox
                                        Width="20"
                                        Height="20"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                        <Control Template="{StaticResource DpadArrowRightTemplate}" />
                                    </Viewbox>
                                </Button>
                            </Grid>

                            <Border
                                Width="1"
                                Margin="6,4,6,4"
                                VerticalAlignment="Stretch"
                                Background="{DynamicResource GameBorderBrush}"
                                Opacity="0.4" />

                            <Button
                                Width="46"
                                Height="46"
                                VerticalAlignment="Center"
                                MouseLeave="DpadButton_MouseLeave"
                                PreviewMouseDown="DpadButton_PreviewMouseDown"
                                PreviewMouseUp="DpadButton_PreviewMouseUp"
                                Style="{StaticResource GameEnterOrbButtonStyle}"
                                Tag="Ok"
                                ToolTip="Phím Chọn / Tấn công / Trò chuyện NPC (Phím Enter)" />

                            <Border
                                Width="1"
                                Margin="6,4,6,4"
                                VerticalAlignment="Stretch"
                                Background="{DynamicResource GameBorderBrush}"
                                Opacity="0.4" />
                        </StackPanel>

                        <Grid Grid.Column="1" VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button
                                Grid.Row="0"
                                Grid.Column="0"
                                Height="21"
                                Margin="1,1"
                                Padding="2,1"
                                Command="{Binding ActionUsePeanCommand}"
                                Style="{StaticResource GameSecondaryButton}"
                                ToolTip="Dùng Đậu Thần phục hồi HP và KI (Phím Space)">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="9"
                                        FontWeight="ExtraBold"
                                        Foreground="{DynamicResource GameBtnTanTextBrush}"
                                        Text="Đậu thần" />
                                    <Border
                                        Margin="2.5,0,0,0"
                                        Padding="2,0.5"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource GameBadgeShortcutBgBrush}"
                                        CornerRadius="2">
                                        <TextBlock
                                            FontSize="7.5"
                                            FontWeight="ExtraBold"
                                            Foreground="{DynamicResource GameBadgeShortcutTextBrush}"
                                            Text="[Space]" />
                                    </Border>
                                </StackPanel>
                            </Button>

                            <Button
                                Grid.Row="0"
                                Grid.Column="1"
                                Height="21"
                                Margin="1,1"
                                Padding="2,1"
                                Command="{Binding ActionPickItemCommand}"
                                Style="{StaticResource GameSecondaryButton}"
                                ToolTip="Nhặt vật phẩm rơi dưới đất (Phím Q)">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="9"
                                        FontWeight="ExtraBold"
                                        Foreground="{DynamicResource GameBtnTanTextBrush}"
                                        Text="Nhặt đồ" />
                                    <Border
                                        Margin="2.5,0,0,0"
                                        Padding="2,0.5"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource GameBadgeShortcutBgBrush}"
                                        CornerRadius="2">
                                        <TextBlock
                                            FontSize="7.5"
                                            FontWeight="ExtraBold"
                                            Foreground="{DynamicResource GameBadgeShortcutTextBrush}"
                                            Text="[Q]" />
                                    </Border>
                                </StackPanel>
                            </Button>

                            <Button
                                Grid.Row="1"
                                Grid.Column="0"
                                Height="21"
                                Margin="1,1"
                                Padding="2,1"
                                Command="{Binding ActionFocusCommand}"
                                Style="{StaticResource GameSecondaryButton}"
                                ToolTip="Đổi mục tiêu sang quái hoặc người chơi khác (Phím Tab)">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="9"
                                        FontWeight="ExtraBold"
                                        Foreground="{DynamicResource GameBtnTanTextBrush}"
                                        Text="Mục tiêu" />
                                    <Border
                                        Margin="2.5,0,0,0"
                                        Padding="2,0.5"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource GameBadgeShortcutBgBrush}"
                                        CornerRadius="2">
                                        <TextBlock
                                            FontSize="7.5"
                                            FontWeight="ExtraBold"
                                            Foreground="{DynamicResource GameBadgeShortcutTextBrush}"
                                            Text="[Tab]" />
                                    </Border>
                                </StackPanel>
                            </Button>

                            <Button
                                Grid.Row="1"
                                Grid.Column="1"
                                Height="21"
                                Margin="1,1"
                                Padding="2,1"
                                Command="{Binding ActionYesCommand}"
                                Style="{StaticResource GameSecondaryButton}"
                                ToolTip="Đồng ý xác nhận hộp thoại (Phím Y)">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="9"
                                        FontWeight="ExtraBold"
                                        Foreground="{DynamicResource GameBtnTanTextBrush}"
                                        Text="Đồng ý" />
                                    <Border
                                        Margin="2.5,0,0,0"
                                        Padding="2,0.5"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource GameBadgeShortcutBgBrush}"
                                        CornerRadius="2">
                                        <TextBlock
                                            FontSize="7.5"
                                            FontWeight="ExtraBold"
                                            Foreground="{DynamicResource GameBadgeShortcutTextBrush}"
                                            Text="[Y]" />
                                    </Border>
                                </StackPanel>
                            </Button>

                            <Button
                                Grid.Row="2"
                                Grid.Column="0"
                                Height="21"
                                Margin="1,1"
                                Padding="2,1"
                                Command="{Binding ActionShowPanelCommand}"
                                Style="{StaticResource GameSecondaryButton}"
                                ToolTip="Mở giao diện bảng điều khiển / menu (Phím F1)">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="9"
                                        FontWeight="ExtraBold"
                                        Foreground="{DynamicResource GameBtnTanTextBrush}"
                                        Text="Hiện panel" />
                                    <Border
                                        Margin="2.5,0,0,0"
                                        Padding="2,0.5"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource GameBadgeShortcutBgBrush}"
                                        CornerRadius="2">
                                        <TextBlock
                                            FontSize="7.5"
                                            FontWeight="ExtraBold"
                                            Foreground="{DynamicResource GameBadgeShortcutTextBrush}"
                                            Text="[F1]" />
                                    </Border>
                                </StackPanel>
                            </Button>

                            <Button
                                Grid.Row="2"
                                Grid.Column="1"
                                Height="21"
                                Margin="1,1"
                                Padding="2,1"
                                Command="{Binding ActionHidePanelCommand}"
                                Style="{StaticResource GameSecondaryButton}"
                                ToolTip="Đóng giao diện bảng điều khiển / menu (Phím F2)">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="9"
                                        FontWeight="ExtraBold"
                                        Foreground="{DynamicResource GameBtnTanTextBrush}"
                                        Text="Ẩn panel" />
                                    <Border
                                        Margin="2.5,0,0,0"
                                        Padding="2,0.5"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource GameBadgeShortcutBgBrush}"
                                        CornerRadius="2">
                                        <TextBlock
                                            FontSize="7.5"
                                            FontWeight="ExtraBold"
                                            Foreground="{DynamicResource GameBadgeShortcutTextBrush}"
                                            Text="[F2]" />
                                    </Border>
                                </StackPanel>
                            </Button>

                            <Button
                                Grid.Row="3"
                                Grid.Column="0"
                                Height="21"
                                Margin="1,1"
                                Padding="2,1"
                                Command="{Binding ActionChatCommand}"
                                Style="{StaticResource GameSecondaryButton}"
                                ToolTip="Mở khung chat (Phím R)">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="9"
                                        FontWeight="ExtraBold"
                                        Foreground="{DynamicResource GameBtnTanTextBrush}"
                                        Text="Chat" />
                                    <Border
                                        Margin="2.5,0,0,0"
                                        Padding="2,0.5"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource GameBadgeShortcutBgBrush}"
                                        CornerRadius="2">
                                        <TextBlock
                                            FontSize="7.5"
                                            FontWeight="ExtraBold"
                                            Foreground="{DynamicResource GameBadgeShortcutTextBrush}"
                                            Text="[R]" />
                                    </Border>
                                </StackPanel>
                            </Button>

                            <Button
                                Grid.Row="3"
                                Grid.Column="1"
                                Height="21"
                                Margin="1,1"
                                Padding="2,1"
                                Command="{Binding ActionBackCommand}"
                                Style="{StaticResource GameSecondaryButton}"
                                ToolTip="Đóng menu, hủy bỏ hoặc quay lại (Phím Esc / Backspace)">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="9"
                                        FontWeight="ExtraBold"
                                        Foreground="{DynamicResource GameBtnTanTextBrush}"
                                        Text="Đóng/Hủy" />
                                    <Border
                                        Margin="2.5,0,0,0"
                                        Padding="2,0.5"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource GameBadgeShortcutBgBrush}"
                                        CornerRadius="2">
                                        <TextBlock
                                            FontSize="7.5"
                                            FontWeight="ExtraBold"
                                            Foreground="{DynamicResource GameBadgeShortcutTextBrush}"
                                            Text="[Esc]" />
                                    </Border>
                                </StackPanel>
                            </Button>

                            <Button
                                Grid.Row="4"
                                Grid.Column="0"
                                Height="21"
                                Margin="1,1"
                                Padding="2,1"
                                Command="{Binding UseTdltCommand}"
                                Style="{StaticResource GameSecondaryButton}"
                                ToolTip="Sử dụng Tự Động Luyện Tập (Phím X)">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="9"
                                        FontWeight="ExtraBold"
                                        Foreground="{DynamicResource GameBtnTanTextBrush}"
                                        Text="TDLT" />
                                    <Border
                                        Margin="2.5,0,0,0"
                                        Padding="2,0.5"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource GameBadgeShortcutBgBrush}"
                                        CornerRadius="2">
                                        <TextBlock
                                            FontSize="7.5"
                                            FontWeight="ExtraBold"
                                            Foreground="{DynamicResource GameBadgeShortcutTextBrush}"
                                            Text="[X]" />
                                    </Border>
                                </StackPanel>
                            </Button>

                            <Button
                                Grid.Row="4"
                                Grid.Column="1"
                                Height="21"
                                Margin="1,1"
                                Padding="2,1"
                                Command="{Binding UseCapsuleCommand}"
                                Style="{StaticResource GameSecondaryButton}"
                                ToolTip="Sử dụng Capsule bay về nhà / các map (Phím C)">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="9"
                                        FontWeight="ExtraBold"
                                        Foreground="{DynamicResource GameBtnTanTextBrush}"
                                        Text="Capsule" />
                                    <Border
                                        Margin="2.5,0,0,0"
                                        Padding="2,0.5"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource GameBadgeShortcutBgBrush}"
                                        CornerRadius="2">
                                        <TextBlock
                                            FontSize="7.5"
                                            FontWeight="ExtraBold"
                                            Foreground="{DynamicResource GameBadgeShortcutTextBrush}"
                                            Text="[C]" />
                                    </Border>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>

                    <Border
                        Height="1"
                        Margin="0,4,0,3"
                        Background="{DynamicResource GameBorderBrush}"
                        Opacity="0.3" />

                    <Grid Margin="0,0,0,3" SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontSize="9.5"
                            FontWeight="ExtraBold"
                            Foreground="{DynamicResource GameTextDarkBrush}"
                            Text="THANH KỸ NĂNG:" />
                        <Button
                            Grid.Column="1"
                            Height="18"
                            Margin="6,0,0,0"
                            Padding="6,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Command="{Binding AutoAssignSkillsCommand}"
                            Content="TỰ GÁN CHIÊU"
                            FontSize="8"
                            FontWeight="ExtraBold"
                            Style="{StaticResource GameSecondaryButton}"
                            ToolTip="Tự động nạp và gán toàn bộ kỹ năng có sẵn vào phím tắt 1 - 0" />
                    </Grid>

                    <StackPanel SnapsToDevicePixels="True">
                        <StackPanel.Resources>
                            <DataTemplate DataType="{x:Type viewmodels:SkillButtonItem}">
                                <Button
                                    Width="36"
                                    Height="36"
                                    Margin="1.5,1.5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Command="{Binding DataContext.SelectSkillCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Cursor="Hand"
                                    FocusVisualStyle="{x:Null}"
                                    PreviewMouseLeftButtonDown="SkillSlot_PreviewMouseLeftButtonDown"
                                    ToolTip="{Binding ToolTipText}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Grid x:Name="RootGrid" SnapsToDevicePixels="True">
                                                <Border
                                                    x:Name="OuterBorder"
                                                    Padding="1"
                                                    Background="{DynamicResource GameSkillSlotOrangeOuterBrush}"
                                                    CornerRadius="4">
                                                    <Border
                                                        x:Name="BezelBorder"
                                                        Padding="2"
                                                        Background="{DynamicResource GameSkillSlotOrangeBezelBrush}"
                                                        CornerRadius="3">
                                                        <Border
                                                            x:Name="SeparatorBorder"
                                                            Padding="0.8"
                                                            Background="{DynamicResource GameSkillSlotOrangeSeparatorBrush}"
                                                            CornerRadius="2">
                                                            <Border
                                                                x:Name="FaceBorder"
                                                                Background="{DynamicResource GameSkillSlotOrangeFaceBrush}"
                                                                ClipToBounds="True"
                                                                CornerRadius="1.5">
                                                                <Grid>
                                                                    <Image
                                                                        Width="24"
                                                                        Height="24"
                                                                        HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center"
                                                                        RenderOptions.BitmapScalingMode="NearestNeighbor"
                                                                        SnapsToDevicePixels="True"
                                                                        Source="{Binding Icon}"
                                                                        Visibility="{Binding HasIcon, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                                                    <TextBlock
                                                                        HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center"
                                                                        FontSize="10"
                                                                        FontWeight="ExtraBold"
                                                                        Foreground="{DynamicResource GameTextMutedBrush}"
                                                                        Opacity="0.45"
                                                                        Text="{Binding ShortcutBadge}"
                                                                        Visibility="{Binding HasIcon, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}" />

                                                                    <Border
                                                                        VerticalAlignment="Bottom"
                                                                        Height="{Binding CooldownOverlayHeight}"
                                                                        Background="{DynamicResource GameSkillSlotCooldownBrush}"
                                                                        CornerRadius="1"
                                                                        IsHitTestVisible="False"
                                                                        Visibility="{Binding IsOnCooldown, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                                                    <TextBlock
                                                                        HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center"
                                                                        FontSize="8"
                                                                        FontWeight="ExtraBold"
                                                                        Foreground="{DynamicResource GameSkillSlotCooldownTextBrush}"
                                                                        Text="{Binding CooldownText}"
                                                                        IsHitTestVisible="False"
                                                                        Visibility="{Binding IsOnCooldown, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                                                    <Border
                                                                        HorizontalAlignment="Left"
                                                                        VerticalAlignment="Top"
                                                                        Margin="1,0.5,0,0"
                                                                        Padding="2,0.5"
                                                                        Background="{DynamicResource GameBadgeShortcutBgBrush}"
                                                                        CornerRadius="1.5"
                                                                        Visibility="{Binding HasIcon, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                        <TextBlock
                                                                            FontSize="6.5"
                                                                            FontWeight="ExtraBold"
                                                                            Foreground="{DynamicResource GameBadgeShortcutTextBrush}"
                                                                            Text="{Binding ShortcutBadge}" />
                                                                    </Border>
                                                                </Grid>
                                                            </Border>
                                                        </Border>
                                                    </Border>
                                                </Border>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="BezelBorder" Property="Background" Value="{DynamicResource GameSkillSlotOrangeBezelHoverBrush}" />
                                                </Trigger>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter TargetName="OuterBorder" Property="Background" Value="{DynamicResource GameSkillSlotGreenOuterBrush}" />
                                                    <Setter TargetName="BezelBorder" Property="Background" Value="{DynamicResource GameSkillSlotGreenBezelBrush}" />
                                                    <Setter TargetName="SeparatorBorder" Property="Background" Value="{DynamicResource GameSkillSlotGreenSeparatorBrush}" />
                                                    <Setter TargetName="FaceBorder" Property="Background" Value="{DynamicResource GameSkillSlotGreenFaceBrush}" />
                                                </DataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsSelected}" Value="True" />
                                                        <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter TargetName="BezelBorder" Property="Background" Value="{DynamicResource GameSkillSlotGreenBezelHoverBrush}" />
                                                </MultiDataTrigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="RootGrid" Property="RenderTransform">
                                                        <Setter.Value>
                                                            <TranslateTransform Y="0.8" />
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </StackPanel.Resources>

                        <ItemsControl ItemsSource="{Binding TopSkills}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="5" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <ItemsControl Margin="0,1,0,0" ItemsSource="{Binding BottomSkills}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="5" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>

            <StackPanel
                Margin="0,5,0,0"
                HorizontalAlignment="Center"
                Orientation="Horizontal">
                <Button
                    Height="26"
                    MinWidth="80"
                    Margin="0,0,6,0"
                    Command="{Binding SaveCommand}"
                    Content="LƯU"
                    Style="{StaticResource GamePrimaryButton}" />

                <Button
                    Height="26"
                    MinWidth="70"
                    Margin="0,0,6,0"
                    Command="{Binding CancelCommand}"
                    Content="HỦY"
                    Style="{StaticResource GameSecondaryButton}" />

                <Button
                    Height="26"
                    MinWidth="70"
                    Command="{Binding DeleteCommand}"
                    Content="XÓA"
                    IsEnabled="{Binding CanDelete}"
                    Style="{StaticResource GameDangerButton}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
