<UserControl
    x:Class="DragonBoyAccountManager.GUI.Views.AccountConfigTabView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:guiModels="clr-namespace:DragonBoyAccountManager.GUI.Models"
    xmlns:models="clr-namespace:DragonBoyAccountManager.Core.Game.Objects;assembly=DragonBoyAccountManager.Core"
    xmlns:ui="clr-namespace:DragonBoyAccountManager.GUI.UI.Controls"
    xmlns:viewmodels="clr-namespace:DragonBoyAccountManager.GUI.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodels:AccountFormViewModel}"
    d:DesignHeight="520"
    d:DesignWidth="435"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ControlTemplate x:Key="DpadArrowIconTemplate">
            <Grid Width="54" Height="54">
                <Path
                    Data="M 13.5,14 L 23.5,14 L 22.5,2 L 46.5,27 L 22.5,52 L 23.5,40 L 13.5,40 A 6,6 0 0 1 7.5,34 L 7.5,20 A 6,6 0 0 1 13.5,14 Z"
                    Fill="#F7C934"
                    Stroke="#350C03"
                    StrokeEndLineCap="Round"
                    StrokeLineJoin="Round"
                    StrokeStartLineCap="Round"
                    StrokeThickness="3.8" />
                <Path
                    Data="M 12.5,16 L 15.5,16 L 15.5,38 L 12.5,38 A 4,4 0 0 1 9.5,34 L 9.5,20 A 4,4 0 0 1 12.5,16 Z"
                    Fill="#D49B1C"
                    Opacity="0.95" />
            </Grid>
        </ControlTemplate>
    </UserControl.Resources>

    <ScrollViewer FocusVisualStyle="{x:Null}" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12,8">
            <TextBlock
                Margin="0,0,0,2"
                FontWeight="Bold"
                Foreground="{DynamicResource GameTextDarkBrush}"
                Text="Tài khoản:" />
            <Grid Height="30" Margin="0,0,0,8">
                <TextBox
                    Padding="8,1,25,1"
                    Cursor="Arrow"
                    IsReadOnly="True"
                    Text="{Binding DisplayUsername, Mode=OneWay}">
                    <TextBox.Style>
                        <Style BasedOn="{StaticResource GameTextBoxStyle}" TargetType="TextBox">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMasked}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <TextBox Padding="8,1,25,1" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.Style>
                        <Style BasedOn="{StaticResource GameTextBoxStyle}" TargetType="TextBox">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMasked}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <Button
                    Width="20"
                    Height="20"
                    Margin="0,0,5,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Command="{Binding ToggleHideAccountsCommand}"
                    Style="{StaticResource GameEyeButtonStyle}"
                    ToolTip="Ẩn/Hiện tên tài khoản">
                    <Control
                        Width="13"
                        Height="13"
                        Focusable="False"
                        IsHitTestVisible="False"
                        Template="{StaticResource DragonBallHideAccountIconTemplate}" />
                </Button>
            </Grid>

            <TextBlock
                Margin="0,0,0,2"
                FontWeight="Bold"
                Foreground="{DynamicResource GameTextDarkBrush}"
                Text="Mật khẩu:" />
            <ui:GamePasswordBox
                Height="30"
                Margin="0,0,0,8"
                Password="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                IsPasswordVisible="{Binding IsPasswordVisible, Mode=TwoWay}" />

            <TextBlock
                Margin="0,0,0,2"
                FontWeight="Bold"
                Foreground="{DynamicResource GameTextDarkBrush}"
                Text="Máy chủ:" />
            <ComboBox
                Height="30"
                Margin="0,0,0,6"
                ItemsSource="{Binding AvailableServers}"
                SelectedItem="{Binding SelectedServer}"
                Style="{StaticResource GameComboBoxStyle}" />

            <CheckBox
                Margin="0,2,0,8"
                Content="Tự động đăng nhập khi mở game"
                FontSize="11"
                FontWeight="Bold"
                Foreground="{DynamicResource GameTextDarkBrush}"
                IsChecked="{Binding AutoLogin}"
                Style="{StaticResource GameCheckBoxStyle}" />

            <!-- BẢNG ĐIỀU KHIỂN BÀN PHÍM & THAO TÁC NHANH -->
            <Border
                Margin="0,4,0,0"
                Padding="8,8"
                Background="{DynamicResource GameBgBrush}"
                BorderBrush="{DynamicResource GameBorderBrush}"
                BorderThickness="1.5"
                CornerRadius="6">
                <StackPanel>
                    <!-- 1. ĐỔI KHU NHANH -->
                    <Grid Margin="0,0,0,6" SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            FontSize="10.5"
                            FontWeight="ExtraBold"
                            Foreground="{DynamicResource GameTextDarkBrush}"
                            Text="ĐỔI KHU:" />

                        <ComboBox
                            x:Name="ZoneComboBox"
                            Grid.Column="1"
                            Height="26"
                            DropDownOpened="ZoneComboBox_DropDownOpened"
                            ItemsSource="{Binding AvailableZones}"
                            SelectedItem="{Binding SelectedZone, Mode=TwoWay}"
                            Style="{StaticResource GameComboBoxStyle}"
                            ToolTip="Chọn khu từ danh sách để chuyển map ngay lập tức">
                            <ComboBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:MapZoneInfo}">
                                    <Grid Margin="2,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock
                                                FontSize="10.5"
                                                FontWeight="Bold"
                                                Foreground="{DynamicResource GameTextDarkBrush}"
                                                Text="{Binding ZoneId, StringFormat='Khu {0}'}" />
                                            <TextBlock
                                                Margin="6,0,0,0"
                                                FontSize="9.5"
                                                FontWeight="SemiBold"
                                                Foreground="#27AE60"
                                                Text="{Binding NumPlayers, StringFormat='({0}'}" />
                                            <TextBlock
                                                FontSize="9.5"
                                                FontWeight="SemiBold"
                                                Foreground="#27AE60"
                                                Text="{Binding MaxPlayers, StringFormat='/{0})'}" />
                                        </StackPanel>
                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="8,0,0,0"
                                            FontSize="9"
                                            FontWeight="ExtraBold"
                                            Foreground="#E74C3C"
                                            Text="ĐẦY"
                                            VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFull}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <StackPanel
                            Grid.Column="2"
                            Margin="6,0,0,0"
                            Orientation="Horizontal">
                            <Button
                                Width="26"
                                Height="26"
                                Margin="0,0,4,0"
                                Command="{Binding PreviousZoneCommand}"
                                Content="&lt;"
                                FontSize="11"
                                FontWeight="ExtraBold"
                                Style="{StaticResource GameSecondaryButton}"
                                ToolTip="Chuyển sang khu trước" />
                            <Button
                                Width="26"
                                Height="26"
                                Command="{Binding NextZoneCommand}"
                                Content="&gt;"
                                FontSize="11"
                                FontWeight="ExtraBold"
                                Style="{StaticResource GameSecondaryButton}"
                                ToolTip="Chuyển sang khu kế tiếp" />
                        </StackPanel>
                    </Grid>

                    <Border
                        Height="1"
                        Margin="0,0,0,6"
                        Background="{DynamicResource GameBorderBrush}"
                        Opacity="0.3" />

                    <!-- 2. ĐIỀU HƯỚNG & PHÍM TẮT NHANH -->
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="34" />
                                <RowDefinition Height="2" />
                                <RowDefinition Height="34" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="2" />
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="2" />
                                <ColumnDefinition Width="34" />
                            </Grid.ColumnDefinitions>

                            <Button
                                Grid.Row="0"
                                Grid.Column="2"
                                Width="34"
                                Height="34"
                                MouseLeave="DpadButton_MouseLeave"
                                PreviewMouseDown="DpadButton_PreviewMouseDown"
                                PreviewMouseUp="DpadButton_PreviewMouseUp"
                                Style="{StaticResource GameArrowVectorButtonStyle}"
                                Tag="Up"
                                ToolTip="Di chuyển Lên (Phím mũi tên Lên)">
                                <Viewbox
                                    Width="20"
                                    Height="20"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                    <Control RenderTransformOrigin="0.5,0.5" Template="{StaticResource DpadArrowIconTemplate}">
                                        <Control.RenderTransform>
                                            <RotateTransform Angle="-90" />
                                        </Control.RenderTransform>
                                    </Control>
                                </Viewbox>
                            </Button>

                            <Button
                                Grid.Row="2"
                                Grid.Column="0"
                                Width="34"
                                Height="34"
                                MouseLeave="DpadButton_MouseLeave"
                                PreviewMouseDown="DpadButton_PreviewMouseDown"
                                PreviewMouseUp="DpadButton_PreviewMouseUp"
                                Style="{StaticResource GameArrowVectorButtonStyle}"
                                Tag="Left"
                                ToolTip="Di chuyển Trái (Phím mũi tên Trái)">
                                <Viewbox
                                    Width="20"
                                    Height="20"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                    <Control RenderTransformOrigin="0.5,0.5" Template="{StaticResource DpadArrowIconTemplate}">
                                        <Control.RenderTransform>
                                            <RotateTransform Angle="180" />
                                        </Control.RenderTransform>
                                    </Control>
                                </Viewbox>
                            </Button>

                            <Button
                                Grid.Row="2"
                                Grid.Column="2"
                                Width="34"
                                Height="34"
                                MouseLeave="DpadButton_MouseLeave"
                                PreviewMouseDown="DpadButton_PreviewMouseDown"
                                PreviewMouseUp="DpadButton_PreviewMouseUp"
                                Style="{StaticResource GameArrowVectorButtonStyle}"
                                Tag="Down"
                                ToolTip="Di chuyển Xuống (Phím mũi tên Xuống)">
                                <Viewbox
                                    Width="20"
                                    Height="20"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                    <Control RenderTransformOrigin="0.5,0.5" Template="{StaticResource DpadArrowIconTemplate}">
                                        <Control.RenderTransform>
                                            <RotateTransform Angle="90" />
                                        </Control.RenderTransform>
                                    </Control>
                                </Viewbox>
                            </Button>

                            <Button
                                Grid.Row="2"
                                Grid.Column="4"
                                Width="34"
                                Height="34"
                                MouseLeave="DpadButton_MouseLeave"
                                PreviewMouseDown="DpadButton_PreviewMouseDown"
                                PreviewMouseUp="DpadButton_PreviewMouseUp"
                                Style="{StaticResource GameArrowVectorButtonStyle}"
                                Tag="Right"
                                ToolTip="Di chuyển Phải (Phím mũi tên Phải)">
                                <Viewbox
                                    Width="20"
                                    Height="20"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                    <Control Template="{StaticResource DpadArrowIconTemplate}" />
                                </Viewbox>
                            </Button>
                        </Grid>

                        <Border
                            Width="1"
                            Margin="12,4,12,4"
                            VerticalAlignment="Stretch"
                            Background="{DynamicResource GameBorderBrush}"
                            Opacity="0.4" />

                        <Button
                            Width="48"
                            Height="48"
                            VerticalAlignment="Center"
                            MouseLeave="DpadButton_MouseLeave"
                            PreviewMouseDown="DpadButton_PreviewMouseDown"
                            PreviewMouseUp="DpadButton_PreviewMouseUp"
                            Style="{StaticResource GameEnterOrbButtonStyle}"
                            Tag="Ok"
                            ToolTip="Phím Chọn / Tấn công / Trò chuyện NPC (Enter / Space / Phím 5)" />

                        <Border
                            Width="1"
                            Margin="12,4,12,4"
                            VerticalAlignment="Stretch"
                            Background="{DynamicResource GameBorderBrush}"
                            Opacity="0.4" />

                        <StackPanel VerticalAlignment="Center">
                            <Button
                                Height="24"
                                Margin="0,0,0,5"
                                Padding="8,1"
                                Command="{Binding UseCapsuleCommand}"
                                Content="Capsule [C]"
                                FontSize="9.5"
                                FontWeight="Bold"
                                Style="{StaticResource GameSecondaryButton}"
                                ToolTip="Sử dụng Capsule bay về nhà / các map (Phím C)" />
                            <Button
                                Height="24"
                                Padding="8,1"
                                Command="{Binding UseTdltCommand}"
                                Content="TDLT [X]"
                                FontSize="9.5"
                                FontWeight="Bold"
                                Style="{StaticResource GameSecondaryButton}"
                                ToolTip="Sử dụng Tự Động Luyện Tập (Phím X)" />
                        </StackPanel>
                    </StackPanel>

                    <Border
                        Height="1"
                        Margin="0,8,0,6"
                        Background="{DynamicResource GameBorderBrush}"
                        Opacity="0.3" />

                    <!-- 3. HÀNG NÚT SỬ DỤNG KỸ NĂNG (SKILLS) -->
                    <ItemsControl ItemsSource="{Binding Skills}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="5" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type guiModels:SkillButtonItem}">
                                <Button
                                    Height="26"
                                    Margin="2,0"
                                    Padding="2,1"
                                    Command="{Binding DataContext.UseSkillCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource GameSecondaryButton}"
                                    ToolTip="{Binding Name, StringFormat='Sử dụng {0}'}">
                                    <StackPanel
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                        <TextBlock
                                            MaxWidth="46"
                                            VerticalAlignment="Center"
                                            FontSize="9"
                                            FontWeight="Bold"
                                            Text="{Binding Name}"
                                            TextTrimming="CharacterEllipsis" />
                                        <Border
                                            Margin="3,0,0,0"
                                            Padding="3,0.5"
                                            VerticalAlignment="Center"
                                            Background="#350C03"
                                            CornerRadius="2.5">
                                            <TextBlock
                                                FontSize="8"
                                                FontWeight="Bold"
                                                Foreground="#F7C934"
                                                Text="{Binding ShortcutBadge}" />
                                        </Border>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Cụm nút Thao tác Cấu hình Tài khoản: LƯU / HỦY / XÓA -->
            <StackPanel
                Margin="0,14,0,4"
                HorizontalAlignment="Center"
                Orientation="Horizontal">
                <Button
                    Height="28"
                    MinWidth="85"
                    Margin="0,0,8,0"
                    Command="{Binding SaveCommand}"
                    Content="LƯU"
                    Style="{StaticResource GamePrimaryButton}" />

                <Button
                    Height="28"
                    MinWidth="75"
                    Margin="0,0,8,0"
                    Command="{Binding CancelCommand}"
                    Content="HỦY"
                    Style="{StaticResource GameSecondaryButton}" />

                <Button
                    Height="28"
                    MinWidth="75"
                    Command="{Binding DeleteCommand}"
                    Content="XÓA"
                    IsEnabled="{Binding CanDelete}"
                    Style="{StaticResource GameDangerButton}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
