<UserControl
    x:Class="DragonBoyAccountManager.GUI.Views.AccountConfigTabView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:DragonBoyAccountManager.GUI.UI.Controls"
    xmlns:viewmodels="clr-namespace:DragonBoyAccountManager.GUI.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodels:AccountFormViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="435"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ControlTemplate x:Key="DpadArrowIconTemplate">
            <Grid Width="54" Height="54">
                <Path
                    Data="M 13.5,14 L 23.5,14 L 22.5,2 L 46.5,27 L 22.5,52 L 23.5,40 L 13.5,40 A 6,6 0 0 1 7.5,34 L 7.5,20 A 6,6 0 0 1 13.5,14 Z"
                    Fill="#F7C934"
                    Stroke="#350C03"
                    StrokeEndLineCap="Round"
                    StrokeLineJoin="Round"
                    StrokeStartLineCap="Round"
                    StrokeThickness="3.8" />
                <Path
                    Data="M 12.5,16 L 15.5,16 L 15.5,38 L 12.5,38 A 4,4 0 0 1 9.5,34 L 9.5,20 A 4,4 0 0 1 12.5,16 Z"
                    Fill="#D49B1C"
                    Opacity="0.95" />
            </Grid>
        </ControlTemplate>
    </UserControl.Resources>

    <ScrollViewer FocusVisualStyle="{x:Null}" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12,8">
            <TextBlock
                Margin="0,0,0,2"
                FontWeight="Bold"
                Foreground="{DynamicResource GameTextDarkBrush}"
                Text="Tài khoản:" />
            <Grid Height="30" Margin="0,0,0,8">
                <TextBox
                    Padding="8,1,25,1"
                    Cursor="Arrow"
                    IsReadOnly="True"
                    Text="{Binding DisplayUsername, Mode=OneWay}">
                    <TextBox.Style>
                        <Style BasedOn="{StaticResource GameTextBoxStyle}" TargetType="TextBox">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMasked}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <TextBox Padding="8,1,25,1" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.Style>
                        <Style BasedOn="{StaticResource GameTextBoxStyle}" TargetType="TextBox">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMasked}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <Button
                    Width="20"
                    Height="20"
                    Margin="0,0,5,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Command="{Binding ToggleHideAccountsCommand}"
                    Style="{StaticResource GameEyeButtonStyle}"
                    ToolTip="Ẩn/Hiện tên tài khoản">
                    <Control
                        Width="13"
                        Height="13"
                        Focusable="False"
                        IsHitTestVisible="False"
                        Template="{StaticResource DragonBallHideAccountIconTemplate}" />
                </Button>
            </Grid>

            <TextBlock
                Margin="0,0,0,2"
                FontWeight="Bold"
                Foreground="{DynamicResource GameTextDarkBrush}"
                Text="Mật khẩu:" />
            <ui:GamePasswordBox
                Height="30"
                Margin="0,0,0,8"
                Password="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                IsPasswordVisible="{Binding IsPasswordVisible, Mode=TwoWay}" />

            <TextBlock
                Margin="0,0,0,2"
                FontWeight="Bold"
                Foreground="{DynamicResource GameTextDarkBrush}"
                Text="Máy chủ:" />
            <ComboBox
                Height="30"
                Margin="0,0,0,6"
                ItemsSource="{Binding AvailableServers}"
                SelectedItem="{Binding SelectedServer}"
                Style="{StaticResource GameComboBoxStyle}" />

            <CheckBox
                Margin="0,2,0,8"
                Content="Tự động đăng nhập khi mở game"
                FontSize="11"
                FontWeight="Bold"
                Foreground="{DynamicResource GameTextDarkBrush}"
                IsChecked="{Binding AutoLogin}"
                Style="{StaticResource GameCheckBoxStyle}" />

            <!-- BẢNG ĐIỀU KHIỂN NHANH & TỐC ĐỘ GAME (TIME.TIMESCALE) -->
            <Border
                Margin="0,4,0,0"
                Padding="8,7"
                Background="{DynamicResource GameBgBrush}"
                BorderBrush="{DynamicResource GameBorderBrush}"
                BorderThickness="1.5"
                CornerRadius="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Khung bên trái: Chỉnh tốc độ Game (Time.timeScale) -->
                    <Border
                        Grid.Column="0"
                        Padding="8,7"
                        VerticalAlignment="Center"
                        Background="{DynamicResource GameTabContentBrush}"
                        BorderBrush="{DynamicResource GameBorderBrush}"
                        BorderThickness="1.5"
                        CornerRadius="8">
                        <StackPanel>
                            <Grid Margin="0,0,0,6" SnapsToDevicePixels="True">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="9"
                                        FontWeight="ExtraBold"
                                        Foreground="{DynamicResource GameTextDarkBrush}"
                                        Text="TỐC ĐỘ" />

                                    <CheckBox
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Content="Toàn bộ"
                                        FontSize="9"
                                        FontWeight="Bold"
                                        IsChecked="{Binding IsApplySpeedToAll}"
                                        Style="{StaticResource GameCheckBoxStyle}"
                                        ToolTip="Áp dụng tốc độ cho toàn bộ tài khoản" />
                                </StackPanel>

                                <Border
                                    Grid.Column="2"
                                    Margin="0,0,3,0"
                                    Padding="5,1"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource GameBtnOrangeFaceTopBrush}"
                                    BorderBrush="{DynamicResource GameBorderDarkBrush}"
                                    BorderThickness="1"
                                    CornerRadius="3.5"
                                    SnapsToDevicePixels="True">
                                    <TextBlock
                                        FontSize="9"
                                        FontWeight="ExtraBold"
                                        Foreground="#FFFFFF"
                                        Text="{Binding GameSpeedText, FallbackValue='1.0x'}" />
                                </Border>
                            </Grid>

                            <!-- Thanh kéo Slider điều chỉnh Time.timeScale -->
                            <Slider
                                Margin="0,3,0,7"
                                LargeChange="0.5"
                                Maximum="5.0"
                                Minimum="0.1"
                                SmallChange="0.1"
                                Style="{StaticResource GameSliderStyle}"
                                TickFrequency="0.5"
                                ToolTip="Kéo để điều chỉnh Time.timeScale của game (0.1x - 5.0x)"
                                Value="{Binding GameSpeed, UpdateSourceTrigger=PropertyChanged}" />

                            <!-- Các nút bấm chọn nhanh tốc độ -->
                            <UniformGrid Margin="0,0,0,0" Columns="4">
                                <Button
                                    Margin="0,0,1.5,0"
                                    Command="{Binding SetGameSpeedCommand}"
                                    CommandParameter="1.0"
                                    Content="1x"
                                    Style="{StaticResource GameSpeedQuickButtonStyle}" />
                                <Button
                                    Margin="1.5,0,1.5,0"
                                    Command="{Binding SetGameSpeedCommand}"
                                    CommandParameter="1.5"
                                    Content="1.5x"
                                    Style="{StaticResource GameSpeedQuickButtonStyle}" />
                                <Button
                                    Margin="1.5,0,1.5,0"
                                    Command="{Binding SetGameSpeedCommand}"
                                    CommandParameter="2.0"
                                    Content="2x"
                                    Style="{StaticResource GameSpeedQuickButtonStyle}" />
                                <Button
                                    Margin="1.5,0,0,0"
                                    Command="{Binding SetGameSpeedCommand}"
                                    CommandParameter="3.0"
                                    Content="3x"
                                    Style="{StaticResource GameSpeedQuickButtonStyle}" />
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- Khung bên phải: Cụm phím điều hướng Bàn phím -->
                    <Border
                        Grid.Column="2"
                        Padding="8,5"
                        VerticalAlignment="Center"
                        Background="{DynamicResource GameTabContentBrush}"
                        BorderBrush="{DynamicResource GameBorderBrush}"
                        BorderThickness="1.5"
                        CornerRadius="8">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock
                                Margin="0,0,0,3"
                                HorizontalAlignment="Center"
                                FontSize="8.5"
                                FontWeight="ExtraBold"
                                Foreground="{DynamicResource GameTextDarkBrush}"
                                Text="BÀN PHÍM" />

                            <StackPanel
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="34" />
                                        <RowDefinition Height="3" />
                                        <RowDefinition Height="34" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition Width="3" />
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition Width="3" />
                                        <ColumnDefinition Width="34" />
                                    </Grid.ColumnDefinitions>

                                    <Button
                                        Grid.Row="0"
                                        Grid.Column="2"
                                        Width="34"
                                        Height="34"
                                        MouseLeave="DpadButton_MouseLeave"
                                        PreviewMouseDown="DpadButton_PreviewMouseDown"
                                        PreviewMouseUp="DpadButton_PreviewMouseUp"
                                        Style="{StaticResource GameArrowVectorButtonStyle}"
                                        Tag="Up"
                                        ToolTip="Di chuyển Lên / Nhảy (Phím mũi tên Lên)">
                                        <Viewbox
                                            Width="20"
                                            Height="20"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                            <Control RenderTransformOrigin="0.5,0.5" Template="{StaticResource DpadArrowIconTemplate}">
                                                <Control.RenderTransform>
                                                    <RotateTransform Angle="-90" />
                                                </Control.RenderTransform>
                                            </Control>
                                        </Viewbox>
                                    </Button>

                                    <Button
                                        Grid.Row="2"
                                        Grid.Column="0"
                                        Width="34"
                                        Height="34"
                                        MouseLeave="DpadButton_MouseLeave"
                                        PreviewMouseDown="DpadButton_PreviewMouseDown"
                                        PreviewMouseUp="DpadButton_PreviewMouseUp"
                                        Style="{StaticResource GameArrowVectorButtonStyle}"
                                        Tag="Left"
                                        ToolTip="Di chuyển Trái (Phím mũi tên Trái)">
                                        <Viewbox
                                            Width="20"
                                            Height="20"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                            <Control RenderTransformOrigin="0.5,0.5" Template="{StaticResource DpadArrowIconTemplate}">
                                                <Control.RenderTransform>
                                                    <RotateTransform Angle="180" />
                                                </Control.RenderTransform>
                                            </Control>
                                        </Viewbox>
                                    </Button>

                                    <Button
                                        Grid.Row="2"
                                        Grid.Column="2"
                                        Width="34"
                                        Height="34"
                                        MouseLeave="DpadButton_MouseLeave"
                                        PreviewMouseDown="DpadButton_PreviewMouseDown"
                                        PreviewMouseUp="DpadButton_PreviewMouseUp"
                                        Style="{StaticResource GameArrowVectorButtonStyle}"
                                        Tag="Down"
                                        ToolTip="Di chuyển Xuống (Phím mũi tên Xuống)">
                                        <Viewbox
                                            Width="20"
                                            Height="20"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                            <Control RenderTransformOrigin="0.5,0.5" Template="{StaticResource DpadArrowIconTemplate}">
                                                <Control.RenderTransform>
                                                    <RotateTransform Angle="90" />
                                                </Control.RenderTransform>
                                            </Control>
                                        </Viewbox>
                                    </Button>

                                    <Button
                                        Grid.Row="2"
                                        Grid.Column="4"
                                        Width="34"
                                        Height="34"
                                        MouseLeave="DpadButton_MouseLeave"
                                        PreviewMouseDown="DpadButton_PreviewMouseDown"
                                        PreviewMouseUp="DpadButton_PreviewMouseUp"
                                        Style="{StaticResource GameArrowVectorButtonStyle}"
                                        Tag="Right"
                                        ToolTip="Di chuyển Phải (Phím mũi tên Phải)">
                                        <Viewbox
                                            Width="20"
                                            Height="20"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                            <Control Template="{StaticResource DpadArrowIconTemplate}" />
                                        </Viewbox>
                                    </Button>
                                </Grid>

                                <Border
                                    Width="1"
                                    Margin="8,4,8,4"
                                    VerticalAlignment="Stretch"
                                    Background="{DynamicResource GameBorderBrush}"
                                    Opacity="0.4" />

                                <Button
                                    Width="46"
                                    Height="46"
                                    VerticalAlignment="Center"
                                    MouseLeave="DpadButton_MouseLeave"
                                    PreviewMouseDown="DpadButton_PreviewMouseDown"
                                    PreviewMouseUp="DpadButton_PreviewMouseUp"
                                    Style="{StaticResource GameEnterOrbButtonStyle}"
                                    Tag="Ok"
                                    ToolTip="Phím Chọn / Tấn công / Trò chuyện NPC (Enter / Space / Phím 5)" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Cụm nút Thao tác Cấu hình Tài khoản: LƯU / HỦY / XÓA -->
            <StackPanel
                Margin="0,14,0,4"
                HorizontalAlignment="Center"
                Orientation="Horizontal">
                <Button
                    Height="28"
                    MinWidth="85"
                    Margin="0,0,8,0"
                    Command="{Binding SaveCommand}"
                    Content="LƯU"
                    Style="{StaticResource GamePrimaryButton}" />

                <Button
                    Height="28"
                    MinWidth="75"
                    Margin="0,0,8,0"
                    Command="{Binding CancelCommand}"
                    Content="HỦY"
                    Style="{StaticResource GameSecondaryButton}" />

                <Button
                    Height="28"
                    MinWidth="75"
                    Command="{Binding DeleteCommand}"
                    Content="XÓA"
                    IsEnabled="{Binding CanDelete}"
                    Style="{StaticResource GameDangerButton}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
