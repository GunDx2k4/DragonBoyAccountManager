<UserControl
    x:Class="DragonBoyAccountManager.GUI.Views.AccountConfigTabView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:guiModels="clr-namespace:DragonBoyAccountManager.GUI.Models"
    xmlns:models="clr-namespace:DragonBoyAccountManager.Core.Game.Snapshots;assembly=DragonBoyAccountManager.Core"
    xmlns:ui="clr-namespace:DragonBoyAccountManager.GUI.UI.Controls"
    xmlns:viewmodels="clr-namespace:DragonBoyAccountManager.GUI.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodels:AccountFormViewModel}"
    d:DesignHeight="520"
    d:DesignWidth="435"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ControlTemplate x:Key="DpadArrowIconTemplate">
            <Grid Width="54" Height="54">
                <Path
                    Data="M 13.5,14 L 23.5,14 L 22.5,2 L 46.5,27 L 22.5,52 L 23.5,40 L 13.5,40 A 6,6 0 0 1 7.5,34 L 7.5,20 A 6,6 0 0 1 13.5,14 Z"
                    Fill="#F7C934"
                    Stroke="#350C03"
                    StrokeEndLineCap="Round"
                    StrokeLineJoin="Round"
                    StrokeStartLineCap="Round"
                    StrokeThickness="3.8" />
                <Path
                    Data="M 12.5,16 L 15.5,16 L 15.5,38 L 12.5,38 A 4,4 0 0 1 9.5,34 L 9.5,20 A 4,4 0 0 1 12.5,16 Z"
                    Fill="#D49B1C"
                    Opacity="0.95" />
            </Grid>
        </ControlTemplate>
    </UserControl.Resources>

    <ScrollViewer FocusVisualStyle="{x:Null}" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10,6">

            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,6">
                    <TextBlock
                        Margin="0,0,0,2"
                        FontSize="11"
                        FontWeight="Bold"
                        Foreground="{DynamicResource GameTextDarkBrush}"
                        Text="Tài khoản:" />
                    <Grid Height="28">
                        <TextBox
                            Padding="8,1,25,1"
                            Cursor="Arrow"
                            IsReadOnly="True"
                            Text="{Binding DisplayUsername, Mode=OneWay}">
                            <TextBox.Style>
                                <Style BasedOn="{StaticResource GameTextBoxStyle}" TargetType="TextBox">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMasked}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                        <TextBox Padding="8,1,25,1" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.Style>
                                <Style BasedOn="{StaticResource GameTextBoxStyle}" TargetType="TextBox">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMasked}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                        <Button
                            Width="18"
                            Height="18"
                            Margin="0,0,5,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Command="{Binding ToggleHideAccountsCommand}"
                            Style="{StaticResource GameEyeButtonStyle}"
                            ToolTip="Ẩn/Hiện tên tài khoản">
                            <Control
                                Width="12"
                                Height="12"
                                Focusable="False"
                                IsHitTestVisible="False"
                                Template="{StaticResource DragonBallHideAccountIconTemplate}" />
                        </Button>
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,6">
                    <TextBlock
                        Margin="0,0,0,2"
                        FontSize="11"
                        FontWeight="Bold"
                        Foreground="{DynamicResource GameTextDarkBrush}"
                        Text="Mật khẩu:" />
                    <ui:GamePasswordBox
                        Height="28"
                        Password="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        IsPasswordVisible="{Binding IsPasswordVisible, Mode=TwoWay}" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0">
                    <TextBlock
                        Margin="0,0,0,2"
                        FontSize="11"
                        FontWeight="Bold"
                        Foreground="{DynamicResource GameTextDarkBrush}"
                        Text="Máy chủ:" />
                    <ComboBox
                        Height="28"
                        ItemsSource="{Binding AvailableServers}"
                        SelectedItem="{Binding SelectedServer}"
                        Style="{StaticResource GameComboBoxStyle}" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="2" VerticalAlignment="Bottom" Margin="0,0,0,5">
                    <CheckBox
                        Content="Tự động đăng nhập"
                        FontSize="11"
                        FontWeight="Bold"
                        Foreground="{DynamicResource GameTextDarkBrush}"
                        IsChecked="{Binding AutoLogin}"
                        Style="{StaticResource GameCheckBoxStyle}"
                        ToolTip="Tự động đăng nhập khi mở game" />
                </StackPanel>
            </Grid>

            <Border
                Margin="0,2,0,0"
                Padding="8,6"
                Background="{DynamicResource GameBgBrush}"
                BorderBrush="{DynamicResource GameBorderBrush}"
                BorderThickness="1.5"
                CornerRadius="6">
                <StackPanel>

                    <Grid Margin="0,0,0,6" SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            FontSize="10.5"
                            FontWeight="ExtraBold"
                            Foreground="{DynamicResource GameTextDarkBrush}"
                            Text="ĐỔI KHU:" />

                        <ComboBox
                            x:Name="ZoneComboBox"
                            Grid.Column="1"
                            Height="26"
                            DropDownOpened="ZoneComboBox_DropDownOpened"
                            ItemsSource="{Binding AvailableZones}"
                            SelectedItem="{Binding SelectedZone, Mode=TwoWay}"
                            Style="{StaticResource GameComboBoxStyle}"
                            ToolTip="Chọn khu từ danh sách để chuyển map ngay lập tức">
                            <ComboBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:WorldZoneInfo}">
                                    <Grid Margin="2,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock
                                                FontSize="10.5"
                                                FontWeight="Bold"
                                                Foreground="{DynamicResource GameTextDarkBrush}"
                                                Text="{Binding ZoneId, StringFormat='Khu {0}'}" />
                                            <TextBlock
                                                Margin="6,0,0,0"
                                                FontSize="9.5"
                                                FontWeight="SemiBold"
                                                Foreground="#27AE60"
                                                Text="{Binding NumPlayers, StringFormat='({0}'}" />
                                            <TextBlock
                                                FontSize="9.5"
                                                FontWeight="SemiBold"
                                                Foreground="#27AE60"
                                                Text="{Binding MaxPlayers, StringFormat='/{0})'}" />
                                        </StackPanel>
                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="8,0,0,0"
                                            FontSize="9"
                                            FontWeight="ExtraBold"
                                            Foreground="#E74C3C"
                                            Text="ĐẦY"
                                            VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFull}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <StackPanel
                            Grid.Column="2"
                            Margin="6,0,0,0"
                            Orientation="Horizontal">
                            <Button
                                Width="26"
                                Height="26"
                                Margin="0,0,4,0"
                                Command="{Binding PreviousZoneCommand}"
                                Style="{StaticResource GameSecondaryButton}"
                                ToolTip="Chuyển sang khu trước (Phím [)">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="Segoe UI Black, Arial Black, Segoe UI"
                                    FontSize="12"
                                    FontWeight="ExtraBold"
                                    Foreground="{DynamicResource GameBtnTanTextBrush}"
                                    Text="&lt;" />
                            </Button>
                            <Button
                                Width="26"
                                Height="26"
                                Command="{Binding NextZoneCommand}"
                                Style="{StaticResource GameSecondaryButton}"
                                ToolTip="Chuyển sang khu kế tiếp (Phím ])">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="Segoe UI Black, Arial Black, Segoe UI"
                                    FontSize="12"
                                    FontWeight="ExtraBold"
                                    Foreground="{DynamicResource GameBtnTanTextBrush}"
                                    Text="&gt;" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Border
                        Height="1"
                        Margin="0,0,0,6"
                        Background="{DynamicResource GameBorderBrush}"
                        Opacity="0.3" />

                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="34" />
                                <RowDefinition Height="2" />
                                <RowDefinition Height="34" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="2" />
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="2" />
                                <ColumnDefinition Width="34" />
                            </Grid.ColumnDefinitions>

                            <Button
                                Grid.Row="0"
                                Grid.Column="2"
                                Width="34"
                                Height="34"
                                MouseLeave="DpadButton_MouseLeave"
                                PreviewMouseDown="DpadButton_PreviewMouseDown"
                                PreviewMouseUp="DpadButton_PreviewMouseUp"
                                Style="{StaticResource GameArrowVectorButtonStyle}"
                                Tag="Up"
                                ToolTip="Di chuyển Lên (Phím mũi tên Lên / Phím W)">
                                <Viewbox
                                    Width="20"
                                    Height="20"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                    <Control RenderTransformOrigin="0.5,0.5" Template="{StaticResource DpadArrowIconTemplate}">
                                        <Control.RenderTransform>
                                            <RotateTransform Angle="-90" />
                                        </Control.RenderTransform>
                                    </Control>
                                </Viewbox>
                            </Button>

                            <Button
                                Grid.Row="2"
                                Grid.Column="0"
                                Width="34"
                                Height="34"
                                MouseLeave="DpadButton_MouseLeave"
                                PreviewMouseDown="DpadButton_PreviewMouseDown"
                                PreviewMouseUp="DpadButton_PreviewMouseUp"
                                Style="{StaticResource GameArrowVectorButtonStyle}"
                                Tag="Left"
                                ToolTip="Di chuyển Trái (Phím mũi tên Trái / Phím A)">
                                <Viewbox
                                    Width="20"
                                    Height="20"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                    <Control RenderTransformOrigin="0.5,0.5" Template="{StaticResource DpadArrowIconTemplate}">
                                        <Control.RenderTransform>
                                            <RotateTransform Angle="180" />
                                        </Control.RenderTransform>
                                    </Control>
                                </Viewbox>
                            </Button>

                            <Button
                                Grid.Row="2"
                                Grid.Column="2"
                                Width="34"
                                Height="34"
                                MouseLeave="DpadButton_MouseLeave"
                                PreviewMouseDown="DpadButton_PreviewMouseDown"
                                PreviewMouseUp="DpadButton_PreviewMouseUp"
                                Style="{StaticResource GameArrowVectorButtonStyle}"
                                Tag="Down"
                                ToolTip="Di chuyển Xuống (Phím mũi tên Xuống / Phím S)">
                                <Viewbox
                                    Width="20"
                                    Height="20"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                    <Control RenderTransformOrigin="0.5,0.5" Template="{StaticResource DpadArrowIconTemplate}">
                                        <Control.RenderTransform>
                                            <RotateTransform Angle="90" />
                                        </Control.RenderTransform>
                                    </Control>
                                </Viewbox>
                            </Button>

                            <Button
                                Grid.Row="2"
                                Grid.Column="4"
                                Width="34"
                                Height="34"
                                MouseLeave="DpadButton_MouseLeave"
                                PreviewMouseDown="DpadButton_PreviewMouseDown"
                                PreviewMouseUp="DpadButton_PreviewMouseUp"
                                Style="{StaticResource GameArrowVectorButtonStyle}"
                                Tag="Right"
                                ToolTip="Di chuyển Phải (Phím mũi tên Phải / Phím D)">
                                <Viewbox
                                    Width="20"
                                    Height="20"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                    <Control Template="{StaticResource DpadArrowIconTemplate}" />
                                </Viewbox>
                            </Button>
                        </Grid>

                        <Border
                            Width="1"
                            Margin="12,4,12,4"
                            VerticalAlignment="Stretch"
                            Background="{DynamicResource GameBorderBrush}"
                            Opacity="0.4" />

                        <Button
                            Width="48"
                            Height="48"
                            VerticalAlignment="Center"
                            MouseLeave="DpadButton_MouseLeave"
                            PreviewMouseDown="DpadButton_PreviewMouseDown"
                            PreviewMouseUp="DpadButton_PreviewMouseUp"
                            Style="{StaticResource GameEnterOrbButtonStyle}"
                            Tag="Ok"
                            ToolTip="Phím Chọn / Tấn công / Trò chuyện NPC (Enter / Space)" />

                        <Border
                            Width="1"
                            Margin="12,4,12,4"
                            VerticalAlignment="Stretch"
                            Background="{DynamicResource GameBorderBrush}"
                            Opacity="0.4" />

                        <StackPanel VerticalAlignment="Center">
                            <Button
                                Height="26"
                                Margin="0,0,0,5"
                                Padding="8,1"
                                Command="{Binding UseCapsuleCommand}"
                                Style="{StaticResource GameSecondaryButton}"
                                ToolTip="Sử dụng Capsule bay về nhà / các map (Phím C)">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="10"
                                        FontWeight="ExtraBold"
                                        Foreground="{DynamicResource GameBtnTanTextBrush}"
                                        Text="Capsule" />
                                    <Border
                                        Margin="4,0,0,0"
                                        Padding="3,0.5"
                                        VerticalAlignment="Center"
                                        Background="#350C03"
                                        CornerRadius="2.5">
                                        <TextBlock
                                            FontSize="8.5"
                                            FontWeight="ExtraBold"
                                            Foreground="#F7C934"
                                            Text="[C]" />
                                    </Border>
                                </StackPanel>
                            </Button>
                            <Button
                                Height="26"
                                Padding="8,1"
                                Command="{Binding UseTdltCommand}"
                                Style="{StaticResource GameSecondaryButton}"
                                ToolTip="Sử dụng Tự Động Luyện Tập (Phím X)">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="10"
                                        FontWeight="ExtraBold"
                                        Foreground="{DynamicResource GameBtnTanTextBrush}"
                                        Text="TDLT" />
                                    <Border
                                        Margin="4,0,0,0"
                                        Padding="3,0.5"
                                        VerticalAlignment="Center"
                                        Background="#350C03"
                                        CornerRadius="2.5">
                                        <TextBlock
                                            FontSize="8.5"
                                            FontWeight="ExtraBold"
                                            Foreground="#F7C934"
                                            Text="[X]" />
                                    </Border>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <Border
                        Height="1"
                        Margin="0,6,0,5"
                        Background="{DynamicResource GameBorderBrush}"
                        Opacity="0.3" />

                    <Grid Margin="0,0,0,4" SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontSize="10"
                            FontWeight="ExtraBold"
                            Foreground="{DynamicResource GameTextDarkBrush}"
                            Text="THANH KỸ NĂNG:" />
                        <Button
                            Grid.Column="1"
                            Height="20"
                            Margin="8,0,0,0"
                            Padding="8,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Command="{Binding AutoAssignSkillsCommand}"
                            Content="TỰ GÁN CHIÊU"
                            FontSize="8.5"
                            FontWeight="ExtraBold"
                            Style="{StaticResource GameSecondaryButton}"
                            ToolTip="Tự động nạp và gán toàn bộ kỹ năng có sẵn vào phím tắt 1 - 0" />
                    </Grid>

                    <StackPanel SnapsToDevicePixels="True">
                        <StackPanel.Resources>
                            <DataTemplate DataType="{x:Type guiModels:SkillButtonItem}">
                                <Border
                                    x:Name="SelectionFrame"
                                    Margin="1.5,1.5"
                                    Padding="1"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="1.5"
                                    CornerRadius="4.5">
                                    <Button
                                        Height="30"
                                        MinWidth="0"
                                        Padding="3,1"
                                        Command="{Binding DataContext.UseSkillCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource GameSecondaryButton}"
                                        ToolTip="{Binding ToolTipText}">
                                        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Grid.Column="0"
                                                Margin="1,0,2,0"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="9.5"
                                                FontWeight="ExtraBold"
                                                Foreground="{DynamicResource GameBtnTanTextBrush}"
                                                Text="{Binding Name}"
                                                TextTrimming="CharacterEllipsis" />
                                            <Border
                                                x:Name="BadgeBorder"
                                                Grid.Column="1"
                                                Padding="3,1"
                                                VerticalAlignment="Center"
                                                Background="#350C03"
                                                CornerRadius="2.5">
                                                <TextBlock
                                                    x:Name="BadgeText"
                                                    FontSize="8.5"
                                                    FontWeight="ExtraBold"
                                                    Foreground="#F7C934"
                                                    Text="{Binding ShortcutBadge}" />
                                            </Border>
                                        </Grid>
                                    </Button>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter TargetName="SelectionFrame" Property="BorderBrush" Value="#F7C934" />
                                        <Setter TargetName="SelectionFrame" Property="Background" Value="#33F7C934" />
                                        <Setter TargetName="BadgeBorder" Property="Background" Value="#8B0000" />
                                        <Setter TargetName="BadgeText" Property="Foreground" Value="#FFF8EE" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </StackPanel.Resources>

                        <ItemsControl ItemsSource="{Binding TopSkills}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="5" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <ItemsControl Margin="0,1,0,0" ItemsSource="{Binding BottomSkills}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="5" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>

            <StackPanel
                Margin="0,8,0,2"
                HorizontalAlignment="Center"
                Orientation="Horizontal">
                <Button
                    Height="28"
                    MinWidth="85"
                    Margin="0,0,8,0"
                    Command="{Binding SaveCommand}"
                    Content="LƯU"
                    Style="{StaticResource GamePrimaryButton}" />

                <Button
                    Height="28"
                    MinWidth="75"
                    Margin="0,0,8,0"
                    Command="{Binding CancelCommand}"
                    Content="HỦY"
                    Style="{StaticResource GameSecondaryButton}" />

                <Button
                    Height="28"
                    MinWidth="75"
                    Command="{Binding DeleteCommand}"
                    Content="XÓA"
                    IsEnabled="{Binding CanDelete}"
                    Style="{StaticResource GameDangerButton}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
