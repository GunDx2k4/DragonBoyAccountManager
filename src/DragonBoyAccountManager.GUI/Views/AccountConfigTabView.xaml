<UserControl
    x:Class="DragonBoyAccountManager.GUI.Views.AccountConfigTabView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="clr-namespace:DragonBoyAccountManager.GUI.UI.Converters"
    xmlns:guiModels="clr-namespace:DragonBoyAccountManager.GUI.Models"
    xmlns:models="clr-namespace:DragonBoyAccountManager.Core.Domain.Snapshots;assembly=DragonBoyAccountManager.Core"
    xmlns:ui="clr-namespace:DragonBoyAccountManager.GUI.UI.Controls"
    xmlns:viewmodels="clr-namespace:DragonBoyAccountManager.GUI.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodels:AccountFormViewModel}"
    d:DesignHeight="520"
    d:DesignWidth="435"
    mc:Ignorable="d">

    <Grid Margin="8,4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,4">
                    <TextBlock
                        Margin="0,0,0,1"
                        FontSize="10.5"
                        FontWeight="Bold"
                        Foreground="{DynamicResource GameTextDarkBrush}"
                        Text="Tài khoản:" />
                    <Grid Height="26">
                        <TextBox
                            Padding="8,1,25,1"
                            Cursor="Arrow"
                            IsReadOnly="True"
                            Style="{StaticResource GameTextBoxStyle}"
                            Text="{Binding DisplayUsername, Mode=OneWay}"
                            Visibility="{Binding IsMasked, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <TextBox
                            Padding="8,1,25,1"
                            Style="{StaticResource GameTextBoxStyle}"
                            Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                            Visibility="{Binding IsMasked, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}" />

                        <Button
                            Width="18"
                            Height="18"
                            Margin="0,0,5,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Command="{Binding ToggleHideAccountsCommand}"
                            Style="{StaticResource GameEyeButtonStyle}"
                            ToolTip="Ẩn/Hiện tên tài khoản">
                            <Control
                                Width="12"
                                Height="12"
                                Focusable="False"
                                IsHitTestVisible="False"
                                Template="{StaticResource DragonBallHideAccountIconTemplate}" />
                        </Button>
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,4">
                    <TextBlock
                        Margin="0,0,0,1"
                        FontSize="10.5"
                        FontWeight="Bold"
                        Foreground="{DynamicResource GameTextDarkBrush}"
                        Text="Mật khẩu:" />
                    <ui:GamePasswordBox
                        Height="26"
                        Password="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        IsPasswordVisible="{Binding IsPasswordVisible, Mode=TwoWay}" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0">
                    <TextBlock
                        Margin="0,0,0,1"
                        FontSize="10.5"
                        FontWeight="Bold"
                        Foreground="{DynamicResource GameTextDarkBrush}"
                        Text="Máy chủ:" />
                    <ComboBox
                        Height="26"
                        ItemsSource="{Binding AvailableServers}"
                        SelectedItem="{Binding SelectedServer}"
                        Style="{StaticResource GameComboBoxStyle}" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="2" VerticalAlignment="Bottom" Margin="0,0,0,4">
                    <CheckBox
                        Content="Tự động đăng nhập"
                        FontSize="10.5"
                        FontWeight="Bold"
                        Foreground="{DynamicResource GameTextDarkBrush}"
                        IsChecked="{Binding AutoLogin}"
                        Style="{StaticResource GameCheckBoxStyle}"
                        ToolTip="Tự động đăng nhập khi mở game" />
                </StackPanel>
            </Grid>

            <Border
                Grid.Row="1"
                Margin="0,2,0,0"
                Padding="6,4"
                Background="{DynamicResource GameBgBrush}"
                BorderBrush="{DynamicResource GameBorderBrush}"
                BorderThickness="1.5"
                CornerRadius="6">
                <StackPanel>

                    <Grid Margin="0,0,0,4" SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            FontSize="10"
                            FontWeight="ExtraBold"
                            Foreground="{DynamicResource GameTextDarkBrush}"
                            Text="ĐỔI KHU:" />

                        <ComboBox
                            x:Name="ZoneComboBox"
                            Grid.Column="1"
                            Height="24"
                            DropDownOpened="ZoneComboBox_DropDownOpened"
                            ItemsSource="{Binding AvailableZones}"
                            SelectedItem="{Binding SelectedZone, Mode=TwoWay}"
                            Style="{StaticResource GameComboBoxStyle}"
                            ToolTip="Chọn khu từ danh sách để chuyển map ngay lập tức">
                            <ComboBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:WorldZoneInfo}">
                                    <Grid Margin="2,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock
                                                FontSize="10"
                                                FontWeight="Bold"
                                                Foreground="{DynamicResource GameTextDarkBrush}"
                                                Text="{Binding ZoneId, StringFormat='Khu {0}'}" />
                                            <TextBlock
                                                Margin="4,0,0,0"
                                                FontSize="9"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource GameTextGreenBrush}"
                                                Text="{Binding NumPlayers, StringFormat='({0}'}" />
                                            <TextBlock
                                                FontSize="9"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource GameTextGreenBrush}"
                                                Text="{Binding MaxPlayers, StringFormat='/{0})'}" />
                                        </StackPanel>
                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="6,0,0,0"
                                            FontSize="8.5"
                                            FontWeight="ExtraBold"
                                            Foreground="{DynamicResource GameTextRedBrush}"
                                            Text="ĐẦY"
                                            VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFull}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <StackPanel
                            Grid.Column="2"
                            Margin="4,0,0,0"
                            Orientation="Horizontal">
                            <Button
                                Width="24"
                                Height="24"
                                Margin="0,0,3,0"
                                Command="{Binding PreviousZoneCommand}"
                                Style="{StaticResource GameSecondaryButton}"
                                ToolTip="Chuyển sang khu trước (Phím [)">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="{DynamicResource GameFont}"
                                    FontSize="11"
                                    FontWeight="ExtraBold"
                                    Foreground="{DynamicResource GameBtnTanTextBrush}"
                                    Text="&lt;" />
                            </Button>
                            <Button
                                Width="24"
                                Height="24"
                                Command="{Binding NextZoneCommand}"
                                Style="{StaticResource GameSecondaryButton}"
                                ToolTip="Chuyển sang khu kế tiếp (Phím ])">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="{DynamicResource GameFont}"
                                    FontSize="11"
                                    FontWeight="ExtraBold"
                                    Foreground="{DynamicResource GameBtnTanTextBrush}"
                                    Text="&gt;" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Border
                        Height="1"
                        Margin="0,0,0,4"
                        Background="{DynamicResource GameBorderBrush}"
                        Opacity="0.3" />

                    <Grid Margin="0,0,0,3" SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontSize="9.5"
                            FontWeight="ExtraBold"
                            Foreground="{DynamicResource GameTextDarkBrush}"
                            Text="ĐIỀU KHIỂN &amp; PHÍM TẮT:" />
                        <Button
                            Grid.Column="1"
                            Height="18"
                            Padding="6,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Click="OpenCheatsheet_Click"
                            Content="[?] TRA CỨU PHÍM"
                            FontSize="8"
                            FontWeight="ExtraBold"
                            Style="{StaticResource GameSecondaryButton}"
                            ToolTip="Mở bảng tra cứu chi tiết toàn bộ phím tắt trong DBAM (Phím F12)" />
                    </Grid>

                    <Grid Margin="0,2,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel
                            Grid.Column="0"
                            VerticalAlignment="Center">
                            <TextBlock
                                Margin="0,0,0,4"
                                HorizontalAlignment="Center"
                                FontSize="9"
                                FontWeight="ExtraBold"
                                Foreground="{DynamicResource GameTextDarkBrush}"
                                Text="ĐIỀU HƯỚNG" />

                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="34" />
                                    <RowDefinition Height="2" />
                                    <RowDefinition Height="34" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="2" />
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="2" />
                                    <ColumnDefinition Width="34" />
                                </Grid.ColumnDefinitions>

                                <Button
                                    Grid.Row="0"
                                    Grid.Column="2"
                                    Width="34"
                                    Height="34"
                                    MouseLeave="DpadButton_MouseLeave"
                                    PreviewMouseDown="DpadButton_PreviewMouseDown"
                                    PreviewMouseUp="DpadButton_PreviewMouseUp"
                                    Style="{StaticResource GameArrowVectorButtonStyle}"
                                    Tag="Up"
                                    ToolTip="Di chuyển Lên (Phím mũi tên Lên / Phím W)">
                                    <Viewbox
                                        Width="20"
                                        Height="20"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                        <Control Template="{StaticResource DpadArrowUpTemplate}" />
                                    </Viewbox>
                                </Button>

                                <Button
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Width="34"
                                    Height="34"
                                    MouseLeave="DpadButton_MouseLeave"
                                    PreviewMouseDown="DpadButton_PreviewMouseDown"
                                    PreviewMouseUp="DpadButton_PreviewMouseUp"
                                    Style="{StaticResource GameArrowVectorButtonStyle}"
                                    Tag="Left"
                                    ToolTip="Di chuyển Trái (Phím mũi tên Trái / Phím A)">
                                    <Viewbox
                                        Width="20"
                                        Height="20"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                        <Control Template="{StaticResource DpadArrowLeftTemplate}" />
                                    </Viewbox>
                                </Button>

                                <Button
                                    Grid.Row="2"
                                    Grid.Column="2"
                                    Width="34"
                                    Height="34"
                                    MouseLeave="DpadButton_MouseLeave"
                                    PreviewMouseDown="DpadButton_PreviewMouseDown"
                                    PreviewMouseUp="DpadButton_PreviewMouseUp"
                                    Style="{StaticResource GameArrowVectorButtonStyle}"
                                    Tag="Down"
                                    ToolTip="Di chuyển Xuống (Phím mũi tên Xuống / Phím S)">
                                    <Viewbox
                                        Width="20"
                                        Height="20"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                        <Control Template="{StaticResource DpadArrowDownTemplate}" />
                                    </Viewbox>
                                </Button>

                                <Button
                                    Grid.Row="2"
                                    Grid.Column="4"
                                    Width="34"
                                    Height="34"
                                    MouseLeave="DpadButton_MouseLeave"
                                    PreviewMouseDown="DpadButton_PreviewMouseDown"
                                    PreviewMouseUp="DpadButton_PreviewMouseUp"
                                    Style="{StaticResource GameArrowVectorButtonStyle}"
                                    Tag="Right"
                                    ToolTip="Di chuyển Phải (Phím mũi tên Phải / Phím D)">
                                    <Viewbox
                                        Width="20"
                                        Height="20"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                        <Control Template="{StaticResource DpadArrowRightTemplate}" />
                                    </Viewbox>
                                </Button>
                            </Grid>

                            <Button
                                Width="106"
                                Height="28"
                                Margin="0,6,0,0"
                                HorizontalAlignment="Center"
                                Content="ENTER"
                                FontSize="11"
                                FontWeight="ExtraBold"
                                MouseLeave="DpadButton_MouseLeave"
                                PreviewMouseDown="DpadButton_PreviewMouseDown"
                                PreviewMouseUp="DpadButton_PreviewMouseUp"
                                Style="{StaticResource GamePrimaryButton}"
                                Tag="Ok"
                                ToolTip="Phím Chọn / Tấn công / Trò chuyện NPC (Phím Enter)" />
                        </StackPanel>

                        <Border
                            Grid.Column="1"
                            Width="1"
                            Margin="8,4,8,4"
                            VerticalAlignment="Stretch"
                            Background="{DynamicResource GameBorderBrush}"
                            Opacity="0.4" />

                        <Grid Grid.Column="2" VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button
                                Grid.Row="0"
                                Grid.Column="0"
                                Margin="0,1"
                                Command="{Binding ActionUsePeanCommand}"
                                Style="{StaticResource GameActionKeycapButtonStyle}"
                                ToolTip="Dùng Đậu Thần phục hồi HP và KI (Phím Space)">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Grid.Column="0"
                                        MinWidth="28"
                                        Height="17"
                                        Padding="3,0"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource GameBadgeShortcutBgBrush}"
                                        CornerRadius="2.5">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="8"
                                            FontWeight="ExtraBold"
                                            Foreground="{DynamicResource GameBadgeShortcutTextBrush}"
                                            Text="SPACE" />
                                    </Border>
                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="4,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="9.5"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource GameTextDarkBrush}"
                                        Text="Đậu thần"
                                        TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </Button>

                            <Button
                                Grid.Row="0"
                                Grid.Column="2"
                                Margin="0,1"
                                Command="{Binding UseCapsuleCommand}"
                                Style="{StaticResource GameActionKeycapButtonStyle}"
                                ToolTip="Sử dụng Capsule bay về nhà / các map (Phím C)">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Grid.Column="0"
                                        MinWidth="22"
                                        Height="17"
                                        Padding="3,0"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource GameBadgeShortcutBgBrush}"
                                        CornerRadius="2.5">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="8"
                                            FontWeight="ExtraBold"
                                            Foreground="{DynamicResource GameBadgeShortcutTextBrush}"
                                            Text="C" />
                                    </Border>
                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="4,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="9.5"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource GameTextDarkBrush}"
                                        Text="Capsule"
                                        TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </Button>

                            <Button
                                Grid.Row="1"
                                Grid.Column="0"
                                Margin="0,1"
                                Command="{Binding ActionPickItemCommand}"
                                Style="{StaticResource GameActionKeycapButtonStyle}"
                                ToolTip="Nhặt vật phẩm rơi dưới đất (Phím Q)">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Grid.Column="0"
                                        MinWidth="22"
                                        Height="17"
                                        Padding="3,0"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource GameBadgeShortcutBgBrush}"
                                        CornerRadius="2.5">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="8"
                                            FontWeight="ExtraBold"
                                            Foreground="{DynamicResource GameBadgeShortcutTextBrush}"
                                            Text="Q" />
                                    </Border>
                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="4,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="9.5"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource GameTextDarkBrush}"
                                        Text="Nhặt đồ"
                                        TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </Button>

                            <Button
                                Grid.Row="1"
                                Grid.Column="2"
                                Margin="0,1"
                                Command="{Binding UseTdltCommand}"
                                Style="{StaticResource GameActionKeycapButtonStyle}"
                                ToolTip="Sử dụng Tự Động Luyện Tập (Phím X)">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Grid.Column="0"
                                        MinWidth="22"
                                        Height="17"
                                        Padding="3,0"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource GameBadgeShortcutBgBrush}"
                                        CornerRadius="2.5">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="8"
                                            FontWeight="ExtraBold"
                                            Foreground="{DynamicResource GameBadgeShortcutTextBrush}"
                                            Text="X" />
                                    </Border>
                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="4,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="9.5"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource GameTextDarkBrush}"
                                        Text="TDLT"
                                        TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </Button>

                            <Button
                                Grid.Row="2"
                                Grid.Column="0"
                                Margin="0,1"
                                Command="{Binding ActionFocusCommand}"
                                Style="{StaticResource GameActionKeycapButtonStyle}"
                                ToolTip="Đổi mục tiêu sang quái hoặc người chơi khác (Phím Tab)">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Grid.Column="0"
                                        MinWidth="24"
                                        Height="17"
                                        Padding="3,0"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource GameBadgeShortcutBgBrush}"
                                        CornerRadius="2.5">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="8"
                                            FontWeight="ExtraBold"
                                            Foreground="{DynamicResource GameBadgeShortcutTextBrush}"
                                            Text="TAB" />
                                    </Border>
                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="4,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="9.5"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource GameTextDarkBrush}"
                                        Text="Mục tiêu"
                                        TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </Button>

                            <Button
                                Grid.Row="2"
                                Grid.Column="2"
                                Margin="0,1"
                                Command="{Binding ActionShowPanelCommand}"
                                Style="{StaticResource GameActionKeycapButtonStyle}"
                                ToolTip="Mở giao diện bảng điều khiển / menu (Phím F1)">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Grid.Column="0"
                                        MinWidth="22"
                                        Height="17"
                                        Padding="3,0"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource GameBadgeShortcutBgBrush}"
                                        CornerRadius="2.5">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="8"
                                            FontWeight="ExtraBold"
                                            Foreground="{DynamicResource GameBadgeShortcutTextBrush}"
                                            Text="F1" />
                                    </Border>
                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="4,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="9.5"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource GameTextDarkBrush}"
                                        Text="Mở panel"
                                        TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </Button>

                            <Button
                                Grid.Row="3"
                                Grid.Column="0"
                                Margin="0,1"
                                Command="{Binding ActionYesCommand}"
                                Style="{StaticResource GameActionKeycapButtonStyle}"
                                ToolTip="Đồng ý xác nhận hộp thoại (Phím Y)">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Grid.Column="0"
                                        MinWidth="22"
                                        Height="17"
                                        Padding="3,0"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource GameBadgeShortcutBgBrush}"
                                        CornerRadius="2.5">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="8"
                                            FontWeight="ExtraBold"
                                            Foreground="{DynamicResource GameBadgeShortcutTextBrush}"
                                            Text="Y" />
                                    </Border>
                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="4,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="9.5"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource GameTextDarkBrush}"
                                        Text="Đồng ý"
                                        TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </Button>

                            <Button
                                Grid.Row="3"
                                Grid.Column="2"
                                Margin="0,1"
                                Command="{Binding ActionHidePanelCommand}"
                                Style="{StaticResource GameActionKeycapButtonStyle}"
                                ToolTip="Đóng giao diện bảng điều khiển / menu (Phím F2)">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Grid.Column="0"
                                        MinWidth="22"
                                        Height="17"
                                        Padding="3,0"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource GameBadgeShortcutBgBrush}"
                                        CornerRadius="2.5">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="8"
                                            FontWeight="ExtraBold"
                                            Foreground="{DynamicResource GameBadgeShortcutTextBrush}"
                                            Text="F2" />
                                    </Border>
                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="4,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="9.5"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource GameTextDarkBrush}"
                                        Text="Đóng panel"
                                        TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </Button>

                            <Button
                                Grid.Row="4"
                                Grid.Column="0"
                                Margin="0,1"
                                Command="{Binding ActionChatCommand}"
                                Style="{StaticResource GameActionKeycapButtonStyle}"
                                ToolTip="Mở khung chat (Phím R)">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Grid.Column="0"
                                        MinWidth="22"
                                        Height="17"
                                        Padding="3,0"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource GameBadgeShortcutBgBrush}"
                                        CornerRadius="2.5">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="8"
                                            FontWeight="ExtraBold"
                                            Foreground="{DynamicResource GameBadgeShortcutTextBrush}"
                                            Text="R" />
                                    </Border>
                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="4,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="9.5"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource GameTextDarkBrush}"
                                        Text="Chat"
                                        TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </Button>

                            <Button
                                Grid.Row="4"
                                Grid.Column="2"
                                Margin="0,1"
                                Command="{Binding ActionBackCommand}"
                                Style="{StaticResource GameActionKeycapButtonStyle}"
                                ToolTip="Đóng menu, hủy bỏ hoặc quay lại (Phím Esc / Backspace)">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Grid.Column="0"
                                        MinWidth="22"
                                        Height="17"
                                        Padding="3,0"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource GameBadgeShortcutBgBrush}"
                                        CornerRadius="2.5">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="8"
                                            FontWeight="ExtraBold"
                                            Foreground="{DynamicResource GameBadgeShortcutTextBrush}"
                                            Text="ESC" />
                                    </Border>
                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="4,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="9.5"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource GameTextDarkBrush}"
                                        Text="Đóng/Hủy"
                                        TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </Button>
                        </Grid>
                    </Grid>

                    <Border
                        Height="1"
                        Margin="0,4,0,3"
                        Background="{DynamicResource GameBorderBrush}"
                        Opacity="0.3" />

                    <Grid Margin="0,0,0,3" SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontSize="9.5"
                            FontWeight="ExtraBold"
                            Foreground="{DynamicResource GameTextDarkBrush}"
                            Text="THANH KỸ NĂNG:" />
                        <Button
                            Grid.Column="1"
                            Height="18"
                            Margin="6,0,0,0"
                            Padding="6,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Command="{Binding AutoAssignSkillsCommand}"
                            Content="TỰ GÁN CHIÊU"
                            FontSize="8"
                            FontWeight="ExtraBold"
                            Style="{StaticResource GameSecondaryButton}"
                            ToolTip="Tự động nạp và gán toàn bộ kỹ năng có sẵn vào phím tắt 1 - 0" />
                    </Grid>

                    <StackPanel SnapsToDevicePixels="True">
                        <StackPanel.Resources>
                            <DataTemplate DataType="{x:Type viewmodels:SkillButtonItem}">
                                <Button
                                    Command="{Binding DataContext.SelectSkillCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    PreviewMouseLeftButtonDown="SkillSlot_PreviewMouseLeftButtonDown"
                                    Style="{StaticResource GameSkillSlotButtonStyle}"
                                    ToolTip="{Binding ToolTipText}" />
                            </DataTemplate>
                        </StackPanel.Resources>

                        <ItemsControl ItemsSource="{Binding TopSkills}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="5" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <ItemsControl Margin="0,1,0,0" ItemsSource="{Binding BottomSkills}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="5" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>

            <StackPanel
                Grid.Row="2"
                Margin="0,5,0,0"
                HorizontalAlignment="Center"
                Orientation="Horizontal">
                <Button
                    Height="26"
                    MinWidth="80"
                    Margin="0,0,6,0"
                    Command="{Binding SaveCommand}"
                    Content="LƯU"
                    Style="{StaticResource GamePrimaryButton}" />

                <Button
                    Height="26"
                    MinWidth="70"
                    Margin="0,0,6,0"
                    Command="{Binding CancelCommand}"
                    Content="HỦY"
                    Style="{StaticResource GameSecondaryButton}" />

                <Button
                    Height="26"
                    MinWidth="70"
                    Command="{Binding DeleteCommand}"
                    Content="XÓA"
                    IsEnabled="{Binding CanDelete}"
                    Style="{StaticResource GameDangerButton}" />
            </StackPanel>
    </Grid>
</UserControl>
