<UserControl
    x:Class="DragonBoyAccountManager.GUI.Views.AutoTabView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="clr-namespace:DragonBoyAccountManager.GUI.UI.Converters"
    xmlns:controls="clr-namespace:DragonBoyAccountManager.GUI.UI.Controls"
    xmlns:guiModels="clr-namespace:DragonBoyAccountManager.GUI.Models"
    xmlns:viewmodels="clr-namespace:DragonBoyAccountManager.GUI.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodels:AutoTabViewModel}"
    d:DesignHeight="550"
    d:DesignWidth="435"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Margin="10,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Margin="0,0,0,8"
            Padding="8,7"
            Background="{DynamicResource GameBgBrush}"
            BorderBrush="{DynamicResource GameBorderBrush}"
            BorderThickness="1.5"
            CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse
                        Width="8"
                        Height="8"
                        Margin="0,0,6,0"
                        VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource GameGrayBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAccountRunning}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource GameGreenBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>

                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="11.5"
                        FontWeight="ExtraBold"
                        Foreground="{DynamicResource GameTextDarkBrush}"
                        Text="{Binding ActiveAccountInfo}"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding ActiveAccountInfo}" />
                </StackPanel>

                <Border
                    Grid.Column="1"
                    Margin="8,0,0,0"
                    Padding="6,2"
                    VerticalAlignment="Center"
                    Background="{DynamicResource GameGreenBrush}"
                    CornerRadius="3"
                    ToolTip="Số tài khoản đang được áp dụng đồng bộ lệnh auto">
                    <TextBlock
                        FontSize="9"
                        FontWeight="ExtraBold"
                        Foreground="{DynamicResource GameTextLightBrush}"
                        Text="{Binding SyncTargetDisplay, FallbackValue='1 tài khoản'}" />
                </Border>
            </Grid>
        </Border>

        <Border
            Grid.Row="1"
            Background="{DynamicResource GameTabContentBrush}"
            BorderBrush="{DynamicResource GameBorderBrush}"
            BorderThickness="1.5"
            CornerRadius="6">
            <TabControl Style="{StaticResource GameTabControlStyle}">

                <TabItem Style="{StaticResource GameTabItemStyle}">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="AUTO ĐÁNH" />
                            <Ellipse
                                Width="7"
                                Height="7"
                                Margin="6,0,0,0"
                                VerticalAlignment="Center"
                                Fill="{DynamicResource GameDangerBrush}"
                                ToolTip="Auto đánh đang hoạt động"
                                Visibility="{Binding IsAutoTrainRunning, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer FocusVisualStyle="{x:Null}" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10,8">

                            <TextBlock
                                Margin="0,0,0,6"
                                FontSize="11"
                                FontWeight="ExtraBold"
                                Foreground="{DynamicResource GameTextDarkBrush}"
                                Text="CẤU HÌNH CHIÊU THỨC TỰ ĐỘNG ĐÁNH:" />

                            <Border
                                Margin="0,0,0,8"
                                Padding="8,6"
                                Background="{DynamicResource GameBgBrush}"
                                BorderBrush="{DynamicResource GameBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="10"
                                            FontWeight="Bold"
                                            Foreground="{DynamicResource GameTextMutedBrush}"
                                            Text="Tích chọn các chiêu được phép dùng (xoay tua):"
                                            TextTrimming="CharacterEllipsis" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button
                                                Height="20"
                                                Padding="6,0"
                                                Margin="0,0,4,0"
                                                Command="{Binding SelectAllSkillsCommand}"
                                                Content="TẤT CẢ"
                                                FontSize="8.5"
                                                FontWeight="Bold"
                                                Style="{StaticResource GameSecondaryButton}" />
                                            <Button
                                                Height="20"
                                                Padding="6,0"
                                                Command="{Binding DeselectAllSkillsCommand}"
                                                Content="BỎ CHỌN"
                                                FontSize="8.5"
                                                FontWeight="Bold"
                                                Style="{StaticResource GameSecondaryButton}" />
                                        </StackPanel>
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding AutoTrainSkills}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="5" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type viewmodels:SkillButtonItem}">
                                                <CheckBox
                                                    Width="36"
                                                    Height="36"
                                                    Margin="1.5,1.5"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Cursor="Hand"
                                                    FocusVisualStyle="{x:Null}"
                                                    IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                    PreviewMouseLeftButtonDown="SkillSlot_PreviewMouseLeftButtonDown"
                                                    ToolTip="{Binding ToolTipText}">
                                                    <CheckBox.Template>
                                                        <ControlTemplate TargetType="CheckBox">
                                                            <Grid x:Name="RootGrid" SnapsToDevicePixels="True">
                                                                <Border
                                                                    x:Name="OuterBorder"
                                                                    Padding="1"
                                                                    Background="{DynamicResource GameSkillSlotOrangeOuterBrush}"
                                                                    CornerRadius="4">
                                                                    <Border
                                                                        x:Name="BezelBorder"
                                                                        Padding="2"
                                                                        Background="{DynamicResource GameSkillSlotOrangeBezelBrush}"
                                                                        CornerRadius="3">
                                                                        <Border
                                                                            x:Name="SeparatorBorder"
                                                                            Padding="0.8"
                                                                            Background="{DynamicResource GameSkillSlotOrangeSeparatorBrush}"
                                                                            CornerRadius="2">
                                                                            <Border
                                                                                x:Name="FaceBorder"
                                                                                Background="{DynamicResource GameSkillSlotOrangeFaceBrush}"
                                                                                ClipToBounds="True"
                                                                                CornerRadius="1.5">
                                                                                <Grid>
                                                                                    <Image
                                                                                        Width="24"
                                                                                        Height="24"
                                                                                        HorizontalAlignment="Center"
                                                                                        VerticalAlignment="Center"
                                                                                        RenderOptions.BitmapScalingMode="NearestNeighbor"
                                                                                        SnapsToDevicePixels="True"
                                                                                        Source="{Binding Icon}"
                                                                                        Visibility="{Binding HasIcon, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                                                                    <TextBlock
                                                                                        HorizontalAlignment="Center"
                                                                                        VerticalAlignment="Center"
                                                                                        FontSize="10"
                                                                                        FontWeight="ExtraBold"
                                                                                        Foreground="{DynamicResource GameTextMutedBrush}"
                                                                                        Opacity="0.45"
                                                                                        Text="{Binding ShortcutBadge}"
                                                                                        Visibility="{Binding HasIcon, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}" />

                                                                                    <Border
                                                                                        VerticalAlignment="Bottom"
                                                                                        Height="{Binding CooldownOverlayHeight}"
                                                                                        Background="{DynamicResource GameSkillSlotCooldownBrush}"
                                                                                        CornerRadius="1"
                                                                                        IsHitTestVisible="False"
                                                                                        Visibility="{Binding IsOnCooldown, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                                                                    <TextBlock
                                                                                        HorizontalAlignment="Center"
                                                                                        VerticalAlignment="Center"
                                                                                        FontSize="8"
                                                                                        FontWeight="ExtraBold"
                                                                                        Foreground="{DynamicResource GameSkillSlotCooldownTextBrush}"
                                                                                        Text="{Binding CooldownText}"
                                                                                        IsHitTestVisible="False"
                                                                                        Visibility="{Binding IsOnCooldown, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                                                                    <Border
                                                                                        HorizontalAlignment="Left"
                                                                                        VerticalAlignment="Top"
                                                                                        Margin="1,0.5,0,0"
                                                                                        Padding="2,0.5"
                                                                                        Background="{DynamicResource GameBadgeShortcutBgBrush}"
                                                                                        CornerRadius="1.5"
                                                                                        Visibility="{Binding HasIcon, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                                        <TextBlock
                                                                                            FontSize="6.5"
                                                                                            FontWeight="ExtraBold"
                                                                                            Foreground="{DynamicResource GameBadgeShortcutTextBrush}"
                                                                                            Text="{Binding ShortcutBadge}" />
                                                                                    </Border>
                                                                                </Grid>
                                                                            </Border>
                                                                        </Border>
                                                                    </Border>
                                                                </Border>
                                                            </Grid>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="BezelBorder" Property="Background" Value="{DynamicResource GameSkillSlotOrangeBezelHoverBrush}" />
                                                                </Trigger>
                                                                <Trigger Property="IsChecked" Value="True">
                                                                    <Setter TargetName="OuterBorder" Property="Background" Value="{DynamicResource GameSkillSlotGreenOuterBrush}" />
                                                                    <Setter TargetName="BezelBorder" Property="Background" Value="{DynamicResource GameSkillSlotGreenBezelBrush}" />
                                                                    <Setter TargetName="SeparatorBorder" Property="Background" Value="{DynamicResource GameSkillSlotGreenSeparatorBrush}" />
                                                                    <Setter TargetName="FaceBorder" Property="Background" Value="{DynamicResource GameSkillSlotGreenFaceBrush}" />
                                                                </Trigger>
                                                                <MultiTrigger>
                                                                    <MultiTrigger.Conditions>
                                                                        <Condition Property="IsChecked" Value="True" />
                                                                        <Condition Property="IsMouseOver" Value="True" />
                                                                    </MultiTrigger.Conditions>
                                                                    <Setter TargetName="BezelBorder" Property="Background" Value="{DynamicResource GameSkillSlotGreenBezelHoverBrush}" />
                                                                </MultiTrigger>
                                                                <Trigger Property="IsPressed" Value="True">
                                                                    <Setter TargetName="RootGrid" Property="RenderTransform">
                                                                        <Setter.Value>
                                                                            <TranslateTransform Y="0.8" />
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </CheckBox.Template>
                                                </CheckBox>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <TextBlock
                                Margin="0,4,0,6"
                                FontSize="11"
                                FontWeight="ExtraBold"
                                Foreground="{DynamicResource GameTextDarkBrush}"
                                Text="CẤU HÌNH QUÁI MỤC TIÊU:" />

                            <Border
                                Margin="0,0,0,8"
                                Padding="8,6"
                                Background="{DynamicResource GameBgBrush}"
                                BorderBrush="{DynamicResource GameBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Column="0"
                                            VerticalAlignment="Center"
                                            FontSize="10"
                                            FontWeight="Bold"
                                            Foreground="{DynamicResource GameTextMutedBrush}"
                                            Margin="0,0,6,0"
                                            Text="Chế độ:" />
                                        <ComboBox
                                            Grid.Column="1"
                                            Height="24"
                                            FontSize="9.5"
                                            FontWeight="Bold"
                                            SelectedIndex="{Binding MobTargetModeIndex, Mode=TwoWay}"
                                            Style="{StaticResource GameComboBoxStyle}">
                                            <ComboBoxItem Content="Theo loài (Mẫu ID)" />
                                            <ComboBoxItem Content="Theo từng con (Mob ID)" />
                                        </ComboBox>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="6,0,0,0">
                                            <Button
                                                Height="22"
                                                Padding="6,0"
                                                Margin="0,0,4,0"
                                                Command="{Binding SelectAllMobsCommand}"
                                                Content="TẤT CẢ"
                                                FontSize="8.5"
                                                FontWeight="Bold"
                                                Style="{StaticResource GameSecondaryButton}" />
                                            <Button
                                                Height="22"
                                                Padding="6,0"
                                                Command="{Binding DeselectAllMobsCommand}"
                                                Content="BỎ CHỌN"
                                                FontSize="8.5"
                                                FontWeight="Bold"
                                                Style="{StaticResource GameSecondaryButton}" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <controls:GameTextBox
                                            Grid.Column="0"
                                            Height="24"
                                            Padding="6,1"
                                            FontSize="10"
                                            Placeholder="Tìm theo ID hoặc tên quái..."
                                            Text="{Binding MobSearchText, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button
                                            Grid.Column="1"
                                            Height="24"
                                            Padding="6,0"
                                            Margin="4,0,0,0"
                                            Command="{Binding ClearMobSearchCommand}"
                                            Content="XÓA TÌM"
                                            FontSize="8.5"
                                            FontWeight="Bold"
                                            Style="{StaticResource GameSecondaryButton}" />
                                    </Grid>

                                    <Border
                                        Background="{DynamicResource GameTabContentBrush}"
                                        BorderBrush="{DynamicResource GameBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="4,3"
                                        MaxHeight="160">
                                        <ScrollViewer FocusVisualStyle="{x:Null}" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding FilteredMobTypes}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type viewmodels:MobFilterItem}">
                                                        <Border
                                                            Margin="0,1,0,2"
                                                            Padding="5,3"
                                                            Background="{DynamicResource GameBgBrush}"
                                                            BorderBrush="{DynamicResource GameBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="3">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>

                                                                <CheckBox
                                                                    Grid.Column="0"
                                                                    VerticalAlignment="Center"
                                                                    IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                    Style="{StaticResource GameCheckBoxStyle}" />

                                                                <TextBlock
                                                                    Grid.Column="1"
                                                                    Margin="6,0,6,0"
                                                                    VerticalAlignment="Center"
                                                                    FontSize="10.5"
                                                                    FontWeight="Bold"
                                                                    Foreground="{DynamicResource GameTextDarkBrush}"
                                                                    Text="{Binding FullDisplayTitle}"
                                                                    TextTrimming="CharacterEllipsis"
                                                                    ToolTip="{Binding FullDisplayTitle}" />

                                                                <Border
                                                                    Grid.Column="2"
                                                                    Margin="0,0,4,0"
                                                                    Padding="4,1"
                                                                    VerticalAlignment="Center"
                                                                    Background="{DynamicResource GameDangerBrush}"
                                                                    BorderBrush="{DynamicResource GameBorderDarkBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="3"
                                                                    ToolTip="Quái siêu cấp (Siêu quái)"
                                                                    Visibility="{Binding IsSuperMob, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                    <TextBlock
                                                                        FontSize="8"
                                                                        FontWeight="ExtraBold"
                                                                        Foreground="{DynamicResource GameTextLightBrush}"
                                                                        Text="SIÊU QUÁI" />
                                                                </Border>

                                                                <Border
                                                                    Grid.Column="3"
                                                                    Margin="0,0,4,0"
                                                                    Padding="4,1"
                                                                    VerticalAlignment="Center"
                                                                    CornerRadius="3"
                                                                    ToolTip="Đặc tính di chuyển của quái">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Background" Value="{DynamicResource GameBlueBrush}" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsFlying}" Value="False">
                                                                                    <Setter Property="Background" Value="{DynamicResource GameGrayBrush}" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <TextBlock
                                                                        FontSize="8"
                                                                        FontWeight="ExtraBold"
                                                                        Foreground="{DynamicResource GameTextLightBrush}"
                                                                        Text="{Binding FlyStatusText}" />
                                                                </Border>

                                                                <Border
                                                                    Grid.Column="4"
                                                                    Margin="0,0,4,0"
                                                                    Padding="4,1"
                                                                    VerticalAlignment="Center"
                                                                    Background="{DynamicResource GameGreenBrush}"
                                                                    CornerRadius="3"
                                                                    Visibility="{Binding HasMultipleCount, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                    <TextBlock
                                                                        FontSize="8"
                                                                        FontWeight="ExtraBold"
                                                                        Foreground="{DynamicResource GameTextLightBrush}"
                                                                        Text="{Binding CountDisplay}" />
                                                                </Border>

                                                                <Button
                                                                    Grid.Column="5"
                                                                    Width="16"
                                                                    Height="16"
                                                                    Padding="0"
                                                                    Command="{Binding DataContext.RemoveCustomMobCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Content="×"
                                                                    FontSize="10"
                                                                    FontWeight="ExtraBold"
                                                                    Style="{StaticResource GameSecondaryButton}"
                                                                    ToolTip="Xóa quái tự thêm này"
                                                                    Visibility="{Binding IsCustom, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>

                                    <Grid Margin="0,6,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <controls:GameTextBox
                                            Grid.Column="0"
                                            Height="24"
                                            Padding="6,1"
                                            FontSize="10"
                                            Placeholder="Nhập ID quái thủ công (VD: 1, 4, 12)..."
                                            Text="{Binding CustomMobIdInput, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button
                                            Grid.Column="1"
                                            Height="24"
                                            Padding="8,0"
                                            Margin="4,0,0,0"
                                            Command="{Binding AddCustomMobIdCommand}"
                                            Content="THÊM ID"
                                            FontSize="8.5"
                                            FontWeight="Bold"
                                            Style="{StaticResource GameSecondaryButton}" />
                                    </Grid>

                                    <TextBlock
                                        Margin="2,2,2,0"
                                        FontSize="9"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource GameTextMutedBrush}"
                                        Text="(Nếu bỏ chọn tất cả, nhân vật sẽ tấn công quái bất kỳ trong map)"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>

                            <TextBlock
                                Margin="0,4,0,6"
                                FontSize="11"
                                FontWeight="ExtraBold"
                                Foreground="{DynamicResource GameTextDarkBrush}"
                                Text="TÙY CHỌN HỖ TRỢ:" />

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox
                                    Grid.Column="0"
                                    Margin="0,2"
                                    Content="Bỏ qua Boss"
                                    FontSize="10.5"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource GameTextDarkBrush}"
                                    IsChecked="{Binding IgnoreBosses}"
                                    Style="{StaticResource GameCheckBoxStyle}" />
                                <CheckBox
                                    Grid.Column="1"
                                    Margin="0,2"
                                    Content="Né siêu quái"
                                    FontSize="10.5"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource GameTextDarkBrush}"
                                    IsChecked="{Binding AvoidSuperMobs}"
                                    ToolTip="Không tấn công và chủ động né tránh khi siêu quái tới gần"
                                    Style="{StaticResource GameCheckBoxStyle}" />
                            </Grid>

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox
                                    Grid.Column="0"
                                    Margin="0,2"
                                    Content="Tự dùng Đậu thần (HP/KI thấp)"
                                    FontSize="10.5"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource GameTextDarkBrush}"
                                    IsChecked="{Binding AutoUsePean}"
                                    Style="{StaticResource GameCheckBoxStyle}" />
                                <CheckBox
                                    Grid.Column="1"
                                    Margin="0,2"
                                    Content="Tự nhặt vật phẩm rơi"
                                    FontSize="10.5"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource GameTextDarkBrush}"
                                    IsChecked="{Binding AutoPickItems}"
                                    Style="{StaticResource GameCheckBoxStyle}" />
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox
                                    Grid.Column="0"
                                    Margin="0,2"
                                    Content="Dùng Tự động luyện tập (TDLT)"
                                    FontSize="10.5"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource GameTextDarkBrush}"
                                    IsChecked="{Binding UseTdlt}"
                                    ToolTip="Bật TDLT để dịch chuyển tới quái và đồ rơi; nếu tắt sẽ dùng A* đi bộ"
                                    Style="{StaticResource GameCheckBoxStyle}" />
                            </Grid>

                            <CheckBox
                                Margin="0,0,0,10"
                                Content="Đồng bộ tất cả acc đã chọn"
                                FontSize="10.5"
                                FontWeight="Bold"
                                Foreground="{DynamicResource GameTextDarkBrush}"
                                IsChecked="{Binding AutoTrainSyncAll}"
                                Style="{StaticResource GameCheckBoxStyle}" />

                            <Button
                                Height="34"
                                Margin="0,0,0,8"
                                Command="{Binding ToggleAutoTrainCommand}">
                                <Button.Style>
                                    <Style BasedOn="{StaticResource GamePrimaryButton}" TargetType="Button">
                                        <Setter Property="Content" Value="BẬT AUTO ĐÁNH" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAutoTrainRunning}" Value="True">
                                                <Setter Property="Content" Value="DỪNG AUTO ĐÁNH" />
                                                <Setter Property="Background" Value="{DynamicResource GameDangerBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Border
                                Padding="8,6"
                                Background="{DynamicResource GameHeaderBrush}"
                                BorderBrush="{DynamicResource GameBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        FontSize="10.5"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource GameTextDarkBrush}"
                                        Text="{Binding AutoTrainStatusText}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip="{Binding AutoTrainStatusText}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="4,0,0,0"
                                        FontSize="10"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource GameTextMutedBrush}"
                                        Text="{Binding SyncTargetDisplay}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip="{Binding SyncTargetDisplay}" />
                                </Grid>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Style="{StaticResource GameTabItemStyle}">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="AUTO CHAT" />
                            <Ellipse
                                Width="7"
                                Height="7"
                                Margin="6,0,0,0"
                                VerticalAlignment="Center"
                                Fill="{DynamicResource GameGreenBrush}"
                                ToolTip="Auto chat đang hoạt động"
                                Visibility="{Binding IsAutoChatRunning, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer FocusVisualStyle="{x:Null}" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10,8">

                            <TextBlock
                                Margin="0,0,0,4"
                                FontSize="11"
                                FontWeight="ExtraBold"
                                Foreground="{DynamicResource GameTextDarkBrush}"
                                Text="NỘI DUNG CHAT (MỖI DÒNG 1 CÂU):" />

                            <TextBox
                                Height="85"
                                Padding="8,6"
                                AcceptsReturn="True"
                                Style="{StaticResource GameTextBoxStyle}"
                                Text="{Binding ChatText, UpdateSourceTrigger=PropertyChanged}"
                                TextWrapping="Wrap"
                                VerticalScrollBarVisibility="Auto" />

                            <Grid Margin="0,6,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox
                                    Grid.Column="0"
                                    Content="Gửi ngẫu nhiên các dòng"
                                    FontSize="10.5"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource GameTextDarkBrush}"
                                    IsChecked="{Binding IsRandomChat}"
                                    Style="{StaticResource GameCheckBoxStyle}" />
                                <CheckBox
                                    Grid.Column="1"
                                    Content="Đồng bộ tất cả acc đã chọn"
                                    FontSize="10.5"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource GameTextDarkBrush}"
                                    IsChecked="{Binding AutoChatSyncAll}"
                                    Style="{StaticResource GameCheckBoxStyle}" />
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock
                                        Margin="0,0,0,3"
                                        FontSize="10.5"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource GameTextMutedBrush}"
                                        Text="Kênh chat:" />
                                    <ComboBox
                                        Height="26"
                                        SelectedIndex="{Binding SelectedChatTypeIndex}"
                                        Style="{StaticResource GameComboBoxStyle}">
                                        <ComboBoxItem Content="Khu vực (Map)" />
                                        <ComboBoxItem Content="Thế giới (Global)" />
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock
                                        Margin="0,0,0,3"
                                        FontSize="10.5"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource GameTextMutedBrush}"
                                        Text="Giãn cách gửi (giây):" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="50" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox
                                            Height="26"
                                            Padding="4,2"
                                            HorizontalContentAlignment="Center"
                                            Style="{StaticResource GameTextBoxStyle}"
                                            Text="{Binding ChatDelaySeconds, UpdateSourceTrigger=PropertyChanged}" />
                                        <UniformGrid Grid.Column="2" Columns="4">
                                            <Button
                                                Height="26"
                                                Margin="1,0"
                                                Padding="0"
                                                MinWidth="0"
                                                Command="{Binding SetChatDelayCommand}"
                                                CommandParameter="3"
                                                Content="3s"
                                                FontSize="10"
                                                FontWeight="Bold"
                                                Style="{StaticResource GameSecondaryButton}" />
                                            <Button
                                                Height="26"
                                                Margin="1,0"
                                                Padding="0"
                                                MinWidth="0"
                                                Command="{Binding SetChatDelayCommand}"
                                                CommandParameter="5"
                                                Content="5s"
                                                FontSize="10"
                                                FontWeight="Bold"
                                                Style="{StaticResource GameSecondaryButton}" />
                                            <Button
                                                Height="26"
                                                Margin="1,0"
                                                Padding="0"
                                                MinWidth="0"
                                                Command="{Binding SetChatDelayCommand}"
                                                CommandParameter="10"
                                                Content="10s"
                                                FontSize="10"
                                                FontWeight="Bold"
                                                Style="{StaticResource GameSecondaryButton}" />
                                            <Button
                                                Height="26"
                                                Margin="1,0"
                                                Padding="0"
                                                MinWidth="0"
                                                Command="{Binding SetChatDelayCommand}"
                                                CommandParameter="30"
                                                Content="30s"
                                                FontSize="10"
                                                FontWeight="Bold"
                                                Style="{StaticResource GameSecondaryButton}" />
                                        </UniformGrid>
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,4,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Button
                                    Grid.Column="0"
                                    Height="32"
                                    Command="{Binding SendChatOnceCommand}"
                                    Content="GỬI 1 LẦN"
                                    FontSize="11"
                                    FontWeight="ExtraBold"
                                    Style="{StaticResource GameSecondaryButton}"
                                    ToolTip="Gửi ngay 1 tin nhắn mà không chạy vòng lặp" />

                                <Button
                                    Grid.Column="2"
                                    Height="32"
                                    Command="{Binding ToggleAutoChatCommand}">
                                    <Button.Style>
                                        <Style BasedOn="{StaticResource GamePrimaryButton}" TargetType="Button">
                                            <Setter Property="Content" Value="BẬT AUTO CHAT" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAutoChatRunning}" Value="True">
                                                    <Setter Property="Content" Value="DỪNG AUTO CHAT" />
                                                    <Setter Property="Background" Value="{DynamicResource GameDangerBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>

                            <Border
                                Padding="8,6"
                                Background="{DynamicResource GameHeaderBrush}"
                                BorderBrush="{DynamicResource GameBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        FontSize="10.5"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource GameTextDarkBrush}"
                                        Text="{Binding AutoChatStatusText}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip="{Binding AutoChatStatusText}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="4,0,0,0"
                                        FontSize="10"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource GameTextMutedBrush}"
                                        Text="{Binding SyncTargetDisplay}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip="{Binding SyncTargetDisplay}" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Border>
    </Grid>
</UserControl>
