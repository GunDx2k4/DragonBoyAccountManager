<UserControl
    x:Class="DragonBoyAccountManager.GUI.Views.AppTitleBarView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="38"
    d:DesignWidth="1180"
    mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Border
        Background="{DynamicResource GameBgAltBrush}"
        BorderBrush="{DynamicResource GameBorderBrush}"
        BorderThickness="0,0,0,1.5"
        CornerRadius="4.5,4.5,0,0"
        MouseLeftButtonDown="Header_MouseLeftButtonDown">
        <Grid>
            <Border
                Height="4"
                VerticalAlignment="Top"
                Background="{DynamicResource GamePanelHighlightBrush}"
                CornerRadius="4,4,0,0" />
            <Border
                Height="2"
                VerticalAlignment="Bottom"
                Background="{DynamicResource GamePanelShadowBrush}" />

            <Grid Margin="12,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid
                    Grid.Column="0"
                    Margin="4,0,10,0"
                    VerticalAlignment="Center">
                    <Rectangle
                        Height="2"
                        HorizontalAlignment="Stretch"
                        Fill="{DynamicResource GamePanelShadowBrush}" />
                    <Rectangle
                        Height="1"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Stretch"
                        Fill="{DynamicResource GameBorderHighlightBrush}"
                        Opacity="0.5" />
                    <StackPanel
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <Rectangle
                            Width="3"
                            Height="3"
                            Margin="2,0"
                            Fill="{DynamicResource GameBorderHighlightBrush}" />
                        <Rectangle
                            Width="3"
                            Height="3"
                            Margin="2,0"
                            Fill="{DynamicResource GameBorderHighlightBrush}" />
                        <Rectangle
                            Width="3"
                            Height="3"
                            Margin="2,0"
                            Fill="{DynamicResource GameBorderHighlightBrush}" />
                    </StackPanel>
                </Grid>

                <Border
                    Grid.Column="1"
                    Padding="1.5"
                    VerticalAlignment="Center"
                    Background="{DynamicResource GameBorderDarkBrush}"
                    BorderBrush="{DynamicResource GameBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="5"
                    SnapsToDevicePixels="True">
                    <Border
                        Padding="8,2,10,2"
                        Background="{DynamicResource GameBgBrush}"
                        BorderBrush="{DynamicResource GamePanelHighlightBrush}"
                        BorderThickness="1,1,0,0"
                        CornerRadius="3.5">
                        <Grid>
                            <Border
                                Height="2"
                                VerticalAlignment="Bottom"
                                Background="{DynamicResource GamePanelShadowBrush}"
                                CornerRadius="0,0,2,2" />

                            <StackPanel
                                VerticalAlignment="Center"
                                Orientation="Horizontal">

                                <StackPanel
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    Orientation="Vertical">
                                    <Rectangle
                                        Width="2.5"
                                        Height="2.5"
                                        Margin="0,0.8"
                                        Fill="{DynamicResource GameBorderHighlightBrush}" />
                                    <Rectangle
                                        Width="2.5"
                                        Height="2.5"
                                        Margin="0,0.8"
                                        Fill="{DynamicResource GameBorderHighlightBrush}" />
                                </StackPanel>

                                <Border
                                    Width="22"
                                    Height="22"
                                    Margin="0,0,8,0"
                                    Padding="1.5"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource GameBgLightBrush}"
                                    BorderBrush="{DynamicResource GameBorderBrush}"
                                    BorderThickness="1.2"
                                    ClipToBounds="True"
                                    CornerRadius="11">
                                    <Viewbox Stretch="Uniform">
                                        <Canvas Width="40" Height="40">
                                            <Ellipse
                                                Canvas.Left="1"
                                                Canvas.Top="1"
                                                Width="38"
                                                Height="38"
                                                Fill="{DynamicResource GameDragonBallBallBrush}"
                                                Stroke="{DynamicResource GameDragonBallBorderBrush}"
                                                StrokeThickness="1.2" />

                                            <Ellipse
                                                Canvas.Left="6.5"
                                                Canvas.Top="3.5"
                                                Width="15"
                                                Height="9"
                                                Fill="{DynamicResource GameDragonBallGlintBrush}"
                                                RenderTransformOrigin="0.5,0.5">
                                                <Ellipse.RenderTransform>
                                                    <RotateTransform Angle="-25" />
                                                </Ellipse.RenderTransform>
                                            </Ellipse>

                                            <Path
                                                Data="{StaticResource GameDragonBallFourStarsGeometry}"
                                                Fill="{DynamicResource GameDragonBallStarBrush}" />
                                        </Canvas>
                                    </Viewbox>
                                </Border>

                                <TextBlock
                                    VerticalAlignment="Center"
                                    Effect="{StaticResource GameTextPixelShadowLight}"
                                    FontFamily="{DynamicResource GameFont}"
                                    FontSize="12"
                                    FontWeight="ExtraBold">
                                    <Run
                                        Foreground="{DynamicResource GameTextDarkBrush}"
                                        Text="DRAGON BOY" />
                                    <Run
                                        FontSize="11"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource GameTextMutedBrush}"
                                        Text=" ACCOUNT MANAGER" />
                                </TextBlock>

                                <Border
                                    Margin="8,0,0,0"
                                    Padding="6,1.5"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource GamePillVersionBgBrush}"
                                    BorderBrush="{DynamicResource GamePillVersionBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    ToolTip="Phiên bản công cụ DBAM hiện tại">
                                    <TextBlock
                                        Effect="{StaticResource GameTextPixelShadow}"
                                        FontSize="9"
                                        FontWeight="ExtraBold"
                                        Foreground="{DynamicResource GameTextLightBrush}"
                                        Text="{Binding Guide.AppVersion, StringFormat='v{0}'}" />
                                </Border>

                                <Border
                                    Margin="6,0,0,0"
                                    Padding="6,1.5"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource GameDangerBrush}"
                                    BorderBrush="{DynamicResource GameBtnOrangeBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    ToolTip="{Binding Guide.AvailableAppUpdate.Version, StringFormat='Có bản cập nhật mới v{0}! Bấm vào tab Hướng dẫn để cập nhật.'}"
                                    Visibility="{Binding Guide.HasAppUpdate, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock
                                        Effect="{StaticResource GameTextPixelShadow}"
                                        FontSize="8.5"
                                        FontWeight="ExtraBold"
                                        Foreground="{DynamicResource GameTextLightBrush}"
                                        Text="CÓ BẢN MỚI" />
                                </Border>

                                <StackPanel
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Orientation="Vertical">
                                    <Rectangle
                                        Width="2.5"
                                        Height="2.5"
                                        Margin="0,0.8"
                                        Fill="{DynamicResource GameBorderHighlightBrush}" />
                                    <Rectangle
                                        Width="2.5"
                                        Height="2.5"
                                        Margin="0,0.8"
                                        Fill="{DynamicResource GameBorderHighlightBrush}" />
                                </StackPanel>

                            </StackPanel>
                        </Grid>
                    </Border>
                </Border>

                <Grid
                    Grid.Column="2"
                    Margin="10,0,0,0">
                    <Grid
                        Margin="0,0,104,0"
                        VerticalAlignment="Center">
                        <Rectangle
                            Height="2"
                            HorizontalAlignment="Stretch"
                            Fill="{DynamicResource GamePanelShadowBrush}" />
                        <Rectangle
                            Height="1"
                            VerticalAlignment="Top"
                            HorizontalAlignment="Stretch"
                            Fill="{DynamicResource GameBorderHighlightBrush}"
                            Opacity="0.5" />
                        <StackPanel
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <Rectangle
                                Width="3"
                                Height="3"
                                Margin="2,0"
                                Fill="{DynamicResource GameBorderHighlightBrush}" />
                            <Rectangle
                                Width="3"
                                Height="3"
                                Margin="2,0"
                                Fill="{DynamicResource GameBorderHighlightBrush}" />
                            <Rectangle
                                Width="3"
                                Height="3"
                                Margin="2,0"
                                Fill="{DynamicResource GameBorderHighlightBrush}" />
                        </StackPanel>
                    </Grid>

                    <StackPanel
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <Button
                            Margin="0,0,6,0"
                            Click="MinimizeButton_Click"
                            Style="{StaticResource GameMinimizeButton}"
                            ToolTip="Thu nhỏ" />
                        <Button
                            x:Name="MaximizeButton"
                            Margin="0,0,6,0"
                            Click="MaximizeButton_Click"
                            Style="{StaticResource GameMaximizeButton}" />
                        <Button
                            Click="CloseButton_Click"
                            Style="{StaticResource GameCloseButton}"
                            ToolTip="Đóng ứng dụng" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
