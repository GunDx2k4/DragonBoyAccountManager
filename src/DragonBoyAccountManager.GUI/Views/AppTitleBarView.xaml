<UserControl
    x:Class="DragonBoyAccountManager.GUI.Views.AppTitleBarView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="38"
    d:DesignWidth="1180"
    mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Border
        Background="{DynamicResource GameBgAltBrush}"
        BorderBrush="{DynamicResource GameBorderBrush}"
        BorderThickness="0,0,0,1.5"
        CornerRadius="4.5,4.5,0,0"
        MouseLeftButtonDown="Header_MouseLeftButtonDown">
        <Grid>
            <Border
                Height="5"
                VerticalAlignment="Top"
                Background="{DynamicResource GamePanelHighlightBrush}"
                CornerRadius="4,4,0,0" />
            <Border
                Height="2"
                VerticalAlignment="Bottom"
                Background="{DynamicResource GamePanelShadowBrush}" />

            <Grid Margin="12,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    Width="26"
                    Height="26"
                    Margin="0,0,10,0"
                    Padding="2"
                    VerticalAlignment="Center"
                    Background="{DynamicResource GameBgBrush}"
                    BorderBrush="{DynamicResource GameBorderBrush}"
                    BorderThickness="1.5"
                    ClipToBounds="True"
                    CornerRadius="5">
                    <Viewbox Stretch="Uniform">
                        <Canvas Width="40" Height="40">

                            <Ellipse
                                Canvas.Left="1"
                                Canvas.Top="1"
                                Width="38"
                                Height="38"
                                Fill="{DynamicResource GameDragonBallBallBrush}"
                                Stroke="{DynamicResource GameDragonBallBorderBrush}"
                                StrokeThickness="1.2" />

                            <Ellipse
                                Canvas.Left="6.5"
                                Canvas.Top="3.5"
                                Width="15"
                                Height="9"
                                Fill="{DynamicResource GameDragonBallGlintBrush}"
                                RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <RotateTransform Angle="-25" />
                                </Ellipse.RenderTransform>
                            </Ellipse>

                            <Path Data="{StaticResource GameDragonBallFourStarsGeometry}" Fill="{DynamicResource GameDragonBallStarBrush}" />
                        </Canvas>
                    </Viewbox>
                </Border>

                <StackPanel
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Grid VerticalAlignment="Center">
                        <TextBlock
                            Margin="1,1,0,0"
                            FontSize="13"
                            FontWeight="ExtraBold"
                            Foreground="{DynamicResource GameTitleSubtitleBrush}"
                            Text="Dragon Boy Account Manager (DBAM)" />
                        <TextBlock
                            FontSize="13"
                            FontWeight="ExtraBold"
                            Foreground="{DynamicResource GameTextDarkBrush}"
                            Text="Dragon Boy Account Manager (DBAM)" />
                    </Grid>

                    <Border
                        Margin="6,0,0,0"
                        Padding="5,1.5"
                        VerticalAlignment="Center"
                        Background="{DynamicResource GamePillVersionBgBrush}"
                        BorderBrush="{DynamicResource GamePillVersionBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="3"
                        ToolTip="Phiên bản công cụ DBAM hiện tại">
                        <TextBlock
                            FontSize="8"
                            FontWeight="ExtraBold"
                            Foreground="{DynamicResource GameTextLightBrush}"
                            Text="{Binding Guide.AppVersion, StringFormat='v{0}'}" />
                    </Border>

                    <Border
                        Margin="5,0,0,0"
                        Padding="5,1.5"
                        VerticalAlignment="Center"
                        Background="{DynamicResource GameDangerBrush}"
                        BorderBrush="{DynamicResource GameBtnOrangeBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="3"
                        ToolTip="{Binding Guide.AvailableAppUpdate.Version, StringFormat='Có bản cập nhật mới v{0}! Bấm vào tab Hướng dẫn để cập nhật.'}"
                        Visibility="{Binding Guide.HasAppUpdate, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock
                            FontSize="8"
                            FontWeight="ExtraBold"
                            Foreground="{DynamicResource GameTextLightBrush}"
                            Text="CÓ BẢN MỚI" />
                    </Border>
                </StackPanel>

                <StackPanel
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Button
                        Margin="0,0,6,0"
                        Click="MinimizeButton_Click"
                        Style="{StaticResource GameMinimizeButton}"
                        ToolTip="Thu nhỏ" />
                    <Button
                        x:Name="MaximizeButton"
                        Margin="0,0,6,0"
                        Click="MaximizeButton_Click"
                        Style="{StaticResource GameMaximizeButton}" />
                    <Button
                        Click="CloseButton_Click"
                        Style="{StaticResource GameCloseButton}"
                        ToolTip="Đóng ứng dụng" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
