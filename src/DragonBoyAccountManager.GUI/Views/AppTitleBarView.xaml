<UserControl
    x:Class="DragonBoyAccountManager.GUI.Views.AppTitleBarView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="38"
    d:DesignWidth="1180"
    mc:Ignorable="d">


    <Border
        Background="{DynamicResource GameBgAltBrush}"
        BorderBrush="{DynamicResource GameBorderBrush}"
        BorderThickness="0,0,0,1.5"
        CornerRadius="4.5,4.5,0,0"
        MouseLeftButtonDown="Header_MouseLeftButtonDown">
        <Grid>
            <Border
                Height="5"
                VerticalAlignment="Top"
                Background="{DynamicResource GamePanelHighlightBrush}"
                CornerRadius="4,4,0,0" />
            <Border
                Height="2"
                VerticalAlignment="Bottom"
                Background="{DynamicResource GamePanelShadowBrush}" />

            <Grid Margin="12,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    Width="26"
                    Height="26"
                    Margin="0,0,10,0"
                    Padding="2"
                    VerticalAlignment="Center"
                    Background="{DynamicResource GameBgBrush}"
                    BorderBrush="{DynamicResource GameBorderBrush}"
                    BorderThickness="1.5"
                    ClipToBounds="True"
                    CornerRadius="5">
                    <Image RenderOptions.BitmapScalingMode="HighQuality" Source="/Assets/app_icon.png" />
                </Border>

                <Grid
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                    <TextBlock
                        Margin="1,1,0,0"
                        FontSize="13"
                        FontWeight="ExtraBold"
                        Foreground="#C48E4E"
                        Text="Dragon Boy Account Manager (DBAM)" />
                    <TextBlock
                        FontSize="13"
                        FontWeight="ExtraBold"
                        Foreground="{DynamicResource GameTextDarkBrush}"
                        Text="Dragon Boy Account Manager (DBAM)" />
                </Grid>

                <StackPanel
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Button
                        Margin="0,0,6,0"
                        Click="MinimizeButton_Click"
                        Style="{StaticResource GameMinimizeButton}"
                        ToolTip="Thu nhỏ" />
                    <Button
                        Click="CloseButton_Click"
                        Style="{StaticResource GameCloseButton}"
                        ToolTip="Đóng ứng dụng" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
