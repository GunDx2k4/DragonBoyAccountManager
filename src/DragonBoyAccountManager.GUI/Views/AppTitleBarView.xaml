<UserControl
    x:Class="DragonBoyAccountManager.GUI.Views.AppTitleBarView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="38"
    d:DesignWidth="1180"
    mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Border
        Background="{DynamicResource GameBgAltBrush}"
        BorderBrush="{DynamicResource GameBorderBrush}"
        BorderThickness="0,0,0,1.5"
        CornerRadius="4.5,4.5,0,0"
        MouseLeftButtonDown="Header_MouseLeftButtonDown">
        <Grid>
            <Border
                Height="5"
                VerticalAlignment="Top"
                Background="{DynamicResource GamePanelHighlightBrush}"
                CornerRadius="4,4,0,0" />
            <Border
                Height="2"
                VerticalAlignment="Bottom"
                Background="{DynamicResource GamePanelShadowBrush}" />

            <Grid Margin="12,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    Width="26"
                    Height="26"
                    Margin="0,0,10,0"
                    Padding="2"
                    VerticalAlignment="Center"
                    Background="{DynamicResource GameBgBrush}"
                    BorderBrush="{DynamicResource GameBorderBrush}"
                    BorderThickness="1.5"
                    ClipToBounds="True"
                    CornerRadius="5">
                    <Viewbox Stretch="Uniform">
                        <Canvas Width="40" Height="40">

                            <Ellipse
                                Canvas.Left="1"
                                Canvas.Top="1"
                                Width="38"
                                Height="38"
                                Stroke="#261405"
                                StrokeThickness="1.2">
                                <Ellipse.Fill>
                                    <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.32,0.26" RadiusX="0.54" RadiusY="0.54">
                                        <GradientStop Offset="0.0" Color="#FFFEE8" />
                                        <GradientStop Offset="0.18" Color="#FFE750" />
                                        <GradientStop Offset="0.46" Color="#FFA200" />
                                        <GradientStop Offset="0.76" Color="#EE5800" />
                                        <GradientStop Offset="1.0" Color="#9C1E00" />
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>

                            <Ellipse
                                Canvas.Left="6.5"
                                Canvas.Top="3.5"
                                Width="15"
                                Height="9"
                                RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <RotateTransform Angle="-25" />
                                </Ellipse.RenderTransform>
                                <Ellipse.Fill>
                                    <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                                        <GradientStop Offset="0.0" Color="#95FFFFFF" />
                                        <GradientStop Offset="0.6" Color="#25FFFFFF" />
                                        <GradientStop Offset="1.0" Color="#00FFFFFF" />
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>

                            <Path Data="M 20,11.5 L 21.3,14.8 L 24.8,15.1 L 22.1,17.3 L 23,20.8 L 20,18.9 L 17,20.8 L 17.9,17.3 L 15.2,15.1 L 18.7,14.8 Z" Fill="#D81B00" />
                            <Path Data="M 14,17.5 L 15.3,20.8 L 18.8,21.1 L 16.1,23.3 L 17,26.8 L 14,24.9 L 11,26.8 L 11.9,23.3 L 9.2,21.1 L 12.7,20.8 Z" Fill="#D81B00" />
                            <Path Data="M 26,17.5 L 27.3,20.8 L 30.8,21.1 L 28.1,23.3 L 29,26.8 L 26,24.9 L 23,26.8 L 23.9,23.3 L 21.2,21.1 L 24.7,20.8 Z" Fill="#D81B00" />
                            <Path Data="M 20,23.5 L 21.3,26.8 L 24.8,27.1 L 22.1,29.3 L 23,32.8 L 20,30.9 L 17,32.8 L 17.9,29.3 L 15.2,27.1 L 18.7,26.8 Z" Fill="#D81B00" />
                        </Canvas>
                    </Viewbox>
                </Border>

                <StackPanel
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Grid VerticalAlignment="Center">
                        <TextBlock
                            Margin="1,1,0,0"
                            FontSize="13"
                            FontWeight="ExtraBold"
                            Foreground="{DynamicResource GameTitleSubtitleBrush}"
                            Text="Dragon Boy Account Manager (DBAM)" />
                        <TextBlock
                            FontSize="13"
                            FontWeight="ExtraBold"
                            Foreground="{DynamicResource GameTextDarkBrush}"
                            Text="Dragon Boy Account Manager (DBAM)" />
                    </Grid>

                    <Border
                        Margin="6,0,0,0"
                        Padding="5,1.5"
                        VerticalAlignment="Center"
                        Background="{DynamicResource GamePillVersionBgBrush}"
                        BorderBrush="{DynamicResource GamePillVersionBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="3"
                        ToolTip="Phiên bản công cụ DBAM hiện tại">
                        <TextBlock
                            FontSize="8"
                            FontWeight="ExtraBold"
                            Foreground="{DynamicResource GameTextLightBrush}"
                            Text="{Binding Guide.AppVersion, StringFormat='v{0}'}" />
                    </Border>

                    <Border
                        Margin="5,0,0,0"
                        Padding="5,1.5"
                        VerticalAlignment="Center"
                        Background="{DynamicResource GameDangerBrush}"
                        BorderBrush="{DynamicResource GameBtnOrangeBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="3"
                        ToolTip="{Binding Guide.AvailableAppUpdate.Version, StringFormat='Có bản cập nhật mới v{0}! Bấm vào tab Hướng dẫn để cập nhật.'}"
                        Visibility="{Binding Guide.HasAppUpdate, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock
                            FontSize="8"
                            FontWeight="ExtraBold"
                            Foreground="{DynamicResource GameTextLightBrush}"
                            Text="CÓ BẢN MỚI" />
                    </Border>
                </StackPanel>

                <StackPanel
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Button
                        Margin="0,0,6,0"
                        Click="MinimizeButton_Click"
                        Style="{StaticResource GameMinimizeButton}"
                        ToolTip="Thu nhỏ" />
                    <Button
                        x:Name="MaximizeButton"
                        Margin="0,0,6,0"
                        Click="MaximizeButton_Click">
                        <Button.Style>
                            <Style BasedOn="{StaticResource GameMaximizeButton}" TargetType="Button">
                                <Setter Property="ToolTip" Value="Phóng to" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                        <Setter Property="ToolTip" Value="Khôi phục" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button
                        Click="CloseButton_Click"
                        Style="{StaticResource GameCloseButton}"
                        ToolTip="Đóng ứng dụng" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
