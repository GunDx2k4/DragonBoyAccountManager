<UserControl
    x:Class="DragonBoyAccountManager.GUI.Views.UtilitiesTabView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="clr-namespace:DragonBoyAccountManager.GUI.UI.Converters"
    xmlns:models="clr-namespace:DragonBoyAccountManager.Core.Game.Objects;assembly=DragonBoyAccountManager.Core"
    xmlns:viewmodels="clr-namespace:DragonBoyAccountManager.GUI.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodels:UtilitiesTabViewModel}"
    d:DesignHeight="550"
    d:DesignWidth="435"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Margin="10,8">
        <Grid.RowDefinitions>
            <!-- 1. Khung Đổi Khu (Dropdown theo openzonemap) -->
            <RowDefinition Height="Auto" />
            <!-- 2. Khung Tốc Độ Game (Time.timeScale) -->
            <RowDefinition Height="Auto" />
            <!-- 3. Cụm phím tắt nhanh (Capsule, TDLT) -->
            <RowDefinition Height="Auto" />
            <!-- 4. Cụm các nút chuyển Waypoint (Tối đa 3 cổng, tự ẩn nếu không có) -->
            <RowDefinition Height="Auto" />
            <!-- 5. Danh sách chi tiết thực thể (Boss, Người, NPC, Auto Chat) -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ==================== 1. KHUNG ĐỔI KHU ==================== -->
        <Border
            Grid.Row="0"
            Margin="0,0,0,8"
            Padding="8,7"
            Background="{DynamicResource GameBgBrush}"
            BorderBrush="{DynamicResource GameBorderBrush}"
            BorderThickness="1.5"
            CornerRadius="6">
            <StackPanel>
                <!-- Dòng hiển thị Map hiện tại & Khu (tổng người / max người) -->
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12"
                            FontWeight="ExtraBold"
                            Foreground="{DynamicResource GameBtnOrangeFaceTopBrush}">
                            <Run Text="{Binding CurrentMapName, FallbackValue='Chưa vào game'}" />
                            <Run Foreground="{DynamicResource GameTextDarkBrush}" Text=" - Khu " />
                            <Run Text="{Binding CurrentZoneId, FallbackValue='-'}" />
                            <Run Foreground="{DynamicResource GameTextDarkBrush}" Text=" (" />
                            <Run Foreground="{DynamicResource GameTextDarkBrush}" Text="{Binding ZonePlayerDisplay, FallbackValue='0/15'}" />
                            <Run Foreground="{DynamicResource GameTextDarkBrush}" Text=")" />
                        </TextBlock>

                        <Border
                            Margin="8,0,0,0"
                            Padding="5,1"
                            VerticalAlignment="Center"
                            Background="#27AE60"
                            CornerRadius="3"
                            ToolTip="Số tài khoản đang được đồng bộ theo danh sách tích chọn ở bảng tài khoản">
                            <TextBlock
                                FontSize="9"
                                FontWeight="ExtraBold"
                                Foreground="#FFFFFF"
                                Text="{Binding SyncTargetDisplay, FallbackValue='1 tài khoản'}" />
                        </Border>
                    </StackPanel>

                    <TextBlock
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        FontSize="9.5"
                        FontWeight="Bold"
                        Foreground="{DynamicResource GameTextMutedBrush}"
                        Text="{Binding StatusText}"
                        TextTrimming="CharacterEllipsis" />
                </Grid>

                <!-- Dòng Dropdown Chọn & Đổi Khu (Không cần nút chuyển, tự đồng bộ theo openzonemap) -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        FontSize="11"
                        FontWeight="ExtraBold"
                        Foreground="{DynamicResource GameTextDarkBrush}"
                        Text="ĐỔI KHU:" />

                    <ComboBox
                        x:Name="ZoneComboBox"
                        Grid.Column="1"
                        Height="28"
                        DropDownOpened="ZoneComboBox_DropDownOpened"
                        ItemsSource="{Binding AvailableZones}"
                        SelectedItem="{Binding SelectedZone, Mode=TwoWay}"
                        Style="{StaticResource GameComboBoxStyle}"
                        ToolTip="Chọn khu từ danh sách để chuyển map ngay lập tức">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:MapZoneInfo}">
                                <Grid Margin="2,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock
                                            FontSize="11"
                                            FontWeight="Bold"
                                            Foreground="{DynamicResource GameTextDarkBrush}"
                                            Text="{Binding ZoneId, StringFormat='Khu {0}'}" />
                                        <TextBlock
                                            Margin="6,0,0,0"
                                            FontSize="10"
                                            FontWeight="SemiBold"
                                            Foreground="#27AE60"
                                            Text="{Binding NumPlayers, StringFormat='({0}'}" />
                                        <TextBlock
                                            FontSize="10"
                                            FontWeight="SemiBold"
                                            Foreground="#27AE60"
                                            Text="{Binding MaxPlayers, StringFormat='/{0})'}" />
                                    </StackPanel>
                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="8,0,0,0"
                                        FontSize="9.5"
                                        FontWeight="ExtraBold"
                                        Foreground="#E74C3C"
                                        Text="ĐẦY"
                                        VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFull}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ==================== 2. KHUNG TỐC ĐỘ GAME ==================== -->
        <Border
            Grid.Row="1"
            Margin="0,0,0,7"
            Padding="8,6"
            Background="{DynamicResource GameBgBrush}"
            BorderBrush="{DynamicResource GameBorderBrush}"
            BorderThickness="1.5"
            CornerRadius="6">
            <StackPanel>
                <Grid Margin="0,0,0,4" SnapsToDevicePixels="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="10.5"
                            FontWeight="ExtraBold"
                            Foreground="{DynamicResource GameTextDarkBrush}"
                            Text="TỐC ĐỘ GAME" />

                        <CheckBox
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Content="Toàn bộ acc"
                            FontSize="9.5"
                            FontWeight="Bold"
                            IsChecked="{Binding IsApplySpeedToAll}"
                            Style="{StaticResource GameCheckBoxStyle}"
                            ToolTip="Áp dụng tốc độ cho toàn bộ tài khoản đang chạy" />
                    </StackPanel>

                    <Border
                        Grid.Column="2"
                        Margin="0,0,2,0"
                        Padding="6,1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Background="{DynamicResource GameBtnOrangeFaceTopBrush}"
                        BorderBrush="{DynamicResource GameBorderDarkBrush}"
                        BorderThickness="1"
                        CornerRadius="3.5"
                        SnapsToDevicePixels="True">
                        <TextBlock
                            FontSize="9.5"
                            FontWeight="ExtraBold"
                            Foreground="#FFFFFF"
                            Text="{Binding GameSpeedText, FallbackValue='1.0x'}" />
                    </Border>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="150" />
                    </Grid.ColumnDefinitions>

                    <!-- Thanh kéo Slider điều chỉnh Time.timeScale -->
                    <Slider
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        LargeChange="0.5"
                        Maximum="5.0"
                        Minimum="0.1"
                        SmallChange="0.1"
                        Style="{StaticResource GameSliderStyle}"
                        TickFrequency="0.5"
                        ToolTip="Kéo để điều chỉnh Time.timeScale của game (0.1x - 5.0x)"
                        Value="{Binding GameSpeed, UpdateSourceTrigger=PropertyChanged}" />

                    <!-- Các nút bấm chọn nhanh tốc độ -->
                    <UniformGrid Grid.Column="2" Columns="4">
                        <Button
                            Height="24"
                            Margin="1,0"
                            Command="{Binding SetGameSpeedCommand}"
                            CommandParameter="1.0"
                            Content="1x"
                            Style="{StaticResource GameSpeedQuickButtonStyle}" />
                        <Button
                            Height="24"
                            Margin="1,0"
                            Command="{Binding SetGameSpeedCommand}"
                            CommandParameter="1.5"
                            Content="1.5x"
                            Style="{StaticResource GameSpeedQuickButtonStyle}" />
                        <Button
                            Height="24"
                            Margin="1,0"
                            Command="{Binding SetGameSpeedCommand}"
                            CommandParameter="2.0"
                            Content="2x"
                            Style="{StaticResource GameSpeedQuickButtonStyle}" />
                        <Button
                            Height="24"
                            Margin="1,0"
                            Command="{Binding SetGameSpeedCommand}"
                            CommandParameter="3.0"
                            Content="3x"
                            Style="{StaticResource GameSpeedQuickButtonStyle}" />
                    </UniformGrid>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ==================== 3. CỤM PHÍM TẮT NHANH VẬT PHẨM (CAPSULE, TDLT) ==================== -->
        <Grid Grid.Row="2" Margin="0,0,0,7">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button
                Grid.Column="0"
                Height="32"
                Command="{Binding UseCapsuleCommand}"
                Style="{StaticResource GameSecondaryButton}"
                ToolTip="Sử dụng Capsule bay về nhà / các map (Phím tắt: C) - Tìm ID 194/193 trong túi">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock Margin="0,0,5,0" VerticalAlignment="Center" FontSize="13" Text="💊" />
                    <TextBlock VerticalAlignment="Center" FontSize="11" FontWeight="ExtraBold" Text="Capsule" />
                    <Border Margin="5,0,0,0" Padding="4,1" VerticalAlignment="Center" Background="#350C03" CornerRadius="3">
                        <TextBlock FontSize="9" FontWeight="Bold" Foreground="#F7C934" Text="[C]" />
                    </Border>
                </StackPanel>
            </Button>

            <Button
                Grid.Column="2"
                Height="32"
                Command="{Binding UseTdltCommand}"
                Style="{StaticResource GameSecondaryButton}"
                ToolTip="Bật/Tắt Tự Động Luyện Tập (Phím tắt: X) - Tìm ID 521 trong túi">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock Margin="0,0,5,0" VerticalAlignment="Center" FontSize="13" Text="⚡" />
                    <TextBlock VerticalAlignment="Center" FontSize="11" FontWeight="ExtraBold" Text="TDLT" />
                    <Border Margin="5,0,0,0" Padding="4,1" VerticalAlignment="Center" Background="#350C03" CornerRadius="3">
                        <TextBlock FontSize="9" FontWeight="Bold" Foreground="#F7C934" Text="[X]" />
                    </Border>
                </StackPanel>
            </Button>
        </Grid>

        <!-- ==================== 4. CÁC NÚT DỊCH CHUYỂN WAYPOINT (TỐI ĐA 3 CỔNG) ==================== -->
        <ItemsControl
            Grid.Row="3"
            Margin="0,0,0,8"
            ItemsSource="{Binding WaypointButtons}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type viewmodels:WaypointButtonItem}">
                    <Button
                        Height="38"
                        Margin="2,0"
                        Padding="6,2"
                        Command="{Binding DataContext.MoveToWaypointCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}"
                        Style="{StaticResource GamePrimaryButton}"
                        ToolTip="{Binding Name, StringFormat='Chuyển tới {0}'}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="11"
                                FontWeight="ExtraBold"
                                Foreground="#FFFFFF"
                                Text="{Binding Name}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="8.5"
                                FontWeight="Bold"
                                Foreground="#FFF0A0">
                                <Run Text="(" />
                                <Run Text="{Binding X}" />
                                <Run Text=", " />
                                <Run Text="{Binding Y}" />
                                <Run Text=")" />
                            </TextBlock>
                        </StackPanel>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- ==================== 5. DANH SÁCH THỰC THỂ (SUB TABS) ==================== -->
        <Border
            Grid.Row="4"
            Background="{DynamicResource GameTabContentBrush}"
            BorderBrush="{DynamicResource GameBorderBrush}"
            BorderThickness="1.5"
            CornerRadius="6">
            <TabControl Style="{StaticResource GameTabControlStyle}">
                <!-- SUB-TAB 1: BOSS & NGƯỜI CHƠI -->
                <TabItem Style="{StaticResource GameTabItemStyle}">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="BOSS &amp; NGƯỜI (" />
                            <TextBlock Foreground="{DynamicResource GameBtnOrangeFaceTopBrush}" Text="{Binding BossCount}" />
                            <TextBlock Text="/" />
                            <TextBlock Text="{Binding PlayerCount}" />
                            <TextBlock Text=")" />
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer FocusVisualStyle="{x:Null}" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="6,4">
                            <!-- BOSS SECTION -->
                            <TextBlock
                                Margin="2,4,0,3"
                                FontSize="10.5"
                                FontWeight="ExtraBold"
                                Foreground="{DynamicResource GameBtnOrangeFaceTopBrush}"
                                Text="DANH SÁCH BOSS:" />

                            <ItemsControl ItemsSource="{Binding Bosses}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:MapBossInfo}">
                                        <Border
                                            Margin="0,1,0,3"
                                            Padding="6,4"
                                            Background="#FFEBE6"
                                            BorderBrush="#D9534F"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Cursor="Hand"
                                            MouseLeftButtonDown="EntityItem_MouseLeftButtonDown"
                                            ToolTip="Nhấn đúp chuột để chọn và click vào Boss này trong game">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock
                                                        FontSize="11.5"
                                                        FontWeight="ExtraBold"
                                                        Foreground="#C0392B"
                                                        Text="{Binding Name}" />
                                                    <TextBlock
                                                        FontSize="9.5"
                                                        Foreground="#7F8C8D">
                                                        <Run Text="HP: " />
                                                        <Run FontWeight="Bold" Text="{Binding Hp, StringFormat='{}{0:N0}'}" />
                                                    </TextBlock>
                                                </StackPanel>
                                                <Border
                                                    Grid.Column="1"
                                                    Padding="5,1"
                                                    VerticalAlignment="Center"
                                                    Background="#C0392B"
                                                    CornerRadius="3">
                                                    <TextBlock
                                                        FontSize="9.5"
                                                        FontWeight="Bold"
                                                        Foreground="#FFFFFF">
                                                        <Run Text="(" />
                                                        <Run Text="{Binding X}" />
                                                        <Run Text=", " />
                                                        <Run Text="{Binding Y}" />
                                                        <Run Text=")" />
                                                    </TextBlock>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- PLAYERS SECTION -->
                            <TextBlock
                                Margin="2,8,0,3"
                                FontSize="10.5"
                                FontWeight="ExtraBold"
                                Foreground="{DynamicResource GameTextDarkBrush}"
                                Text="NGƯỜI CHƠI TRONG KHU:" />

                            <ItemsControl ItemsSource="{Binding Players}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:MapPlayerInfo}">
                                        <Border
                                            Margin="0,1,0,3"
                                            Padding="6,3"
                                            Background="{DynamicResource GameBgBrush}"
                                            BorderBrush="{DynamicResource GameBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Cursor="Hand"
                                            MouseLeftButtonDown="EntityItem_MouseLeftButtonDown"
                                            ToolTip="Nhấn đúp chuột để chọn và click vào người chơi này trong game">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock
                                                        FontSize="11"
                                                        FontWeight="Bold"
                                                        Foreground="{DynamicResource GameTextDarkBrush}"
                                                        Text="{Binding Name}" />
                                                    <TextBlock
                                                        FontSize="9"
                                                        Foreground="{DynamicResource GameTextMutedBrush}">
                                                        <Run Text="HP: " />
                                                        <Run Text="{Binding Hp, StringFormat='{}{0:N0}'}" />
                                                    </TextBlock>
                                                </StackPanel>
                                                <Border
                                                    Grid.Column="1"
                                                    Padding="4,1"
                                                    VerticalAlignment="Center"
                                                    Background="{DynamicResource GameTabContentBrush}"
                                                    BorderBrush="{DynamicResource GameBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="3">
                                                    <TextBlock
                                                        FontSize="9.5"
                                                        FontWeight="Bold"
                                                        Foreground="{DynamicResource GameTextDarkBrush}">
                                                        <Run Text="(" />
                                                        <Run Text="{Binding X}" />
                                                        <Run Text=", " />
                                                        <Run Text="{Binding Y}" />
                                                        <Run Text=")" />
                                                    </TextBlock>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- SUB-TAB 2: QUÁI TRONG BẢN ĐỒ -->
                <TabItem Style="{StaticResource GameTabItemStyle}">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="QUÁI (" />
                            <TextBlock Foreground="#27AE60" Text="{Binding AliveMobs}" />
                            <TextBlock Text="/" />
                            <TextBlock Text="{Binding TotalMobs}" />
                            <TextBlock Text=")" />
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer FocusVisualStyle="{x:Null}" VerticalScrollBarVisibility="Auto">
                        <ItemsControl Margin="6,4" ItemsSource="{Binding Mobs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:MapMobInfo}">
                                    <Border
                                        Margin="0,1,0,3"
                                        Padding="6,4"
                                        Background="{DynamicResource GameBgBrush}"
                                        BorderBrush="{DynamicResource GameBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Cursor="Hand"
                                        MouseLeftButtonDown="EntityItem_MouseLeftButtonDown"
                                        ToolTip="Nhấn đúp chuột để chọn và click vào Quái này trong game">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Opacity" Value="1.0" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAlive}" Value="False">
                                                        <Setter Property="Opacity" Value="0.6" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock
                                                        FontSize="11"
                                                        FontWeight="Bold"
                                                        Foreground="{DynamicResource GameTextDarkBrush}"
                                                        Text="{Binding Name}" />
                                                    <Border
                                                        Margin="6,0,0,0"
                                                        Padding="4,0"
                                                        VerticalAlignment="Center"
                                                        CornerRadius="3">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#27AE60" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsAlive}" Value="False">
                                                                        <Setter Property="Background" Value="#95A5A6" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock
                                                            FontSize="8.5"
                                                            FontWeight="ExtraBold"
                                                            Foreground="#FFFFFF">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="SỐNG" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsAlive}" Value="False">
                                                                            <Setter Property="Text" Value="CHẾT" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock
                                                    FontSize="9"
                                                    Foreground="{DynamicResource GameTextMutedBrush}">
                                                    <Run Text="HP: " />
                                                    <Run FontWeight="SemiBold" Text="{Binding Hp, StringFormat='{}{0:N0}'}" />
                                                    <Run Text="/" />
                                                    <Run Text="{Binding MaxHp, StringFormat='{}{0:N0}'}" />
                                                    <Run Text=" • ID: " />
                                                    <Run Text="{Binding Id}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <Border
                                                Grid.Column="1"
                                                Padding="4,1"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource GameTabContentBrush}"
                                                BorderBrush="{DynamicResource GameBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="3">
                                                <TextBlock
                                                    FontSize="9.5"
                                                    FontWeight="Bold"
                                                    Foreground="{DynamicResource GameTextDarkBrush}">
                                                    <Run Text="(" />
                                                    <Run Text="{Binding X}" />
                                                    <Run Text=", " />
                                                    <Run Text="{Binding Y}" />
                                                    <Run Text=")" />
                                                </TextBlock>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </TabItem>

                <!-- SUB-TAB 3: NPC TRONG BẢN ĐỒ -->
                <TabItem Style="{StaticResource GameTabItemStyle}">
                    <TabItem.Header>
                        <TextBlock>
                            <Run Text="NPC (" />
                            <Run Text="{Binding NpcCount}" />
                            <Run Text=")" />
                        </TextBlock>
                    </TabItem.Header>
                    <ScrollViewer FocusVisualStyle="{x:Null}" VerticalScrollBarVisibility="Auto">
                        <ItemsControl Margin="6,4" ItemsSource="{Binding Npcs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:MapNpcInfo}">
                                    <Border
                                        Margin="0,1,0,3"
                                        Padding="6,4"
                                        Background="{DynamicResource GameBgBrush}"
                                        BorderBrush="{DynamicResource GameBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Cursor="Hand"
                                        MouseLeftButtonDown="EntityItem_MouseLeftButtonDown"
                                        ToolTip="Nhấn đúp chuột để chọn và click vào NPC này trong game">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock
                                                    FontSize="11"
                                                    FontWeight="Bold"
                                                    Foreground="{DynamicResource GameTextDarkBrush}"
                                                    Text="{Binding Name}" />
                                                <TextBlock
                                                    FontSize="9"
                                                    Foreground="{DynamicResource GameTextMutedBrush}">
                                                    <Run Text="ID: " />
                                                    <Run Text="{Binding Id}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <Border
                                                Grid.Column="1"
                                                Padding="4,1"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource GameTabContentBrush}"
                                                BorderBrush="{DynamicResource GameBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="3">
                                                <TextBlock
                                                    FontSize="9.5"
                                                    FontWeight="Bold"
                                                    Foreground="{DynamicResource GameTextDarkBrush}">
                                                    <Run Text="Tọa độ: (" />
                                                    <Run Text="{Binding X}" />
                                                    <Run Text=", " />
                                                    <Run Text="{Binding Y}" />
                                                    <Run Text=")" />
                                                </TextBlock>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </TabItem>

                <!-- SUB-TAB 4: TỰ ĐỘNG CHAT (AUTO CHAT) -->
                <TabItem Style="{StaticResource GameTabItemStyle}">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="AUTO CHAT" />
                            <Ellipse
                                Width="7"
                                Height="7"
                                Margin="6,0,0,0"
                                VerticalAlignment="Center"
                                Fill="#2ECC71"
                                ToolTip="Auto chat đang chạy"
                                Visibility="{Binding IsAutoChatRunning, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer FocusVisualStyle="{x:Null}" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10,8">
                            <!-- Khung nhập nội dung chat -->
                            <TextBlock
                                Margin="0,0,0,4"
                                FontSize="11"
                                FontWeight="ExtraBold"
                                Foreground="{DynamicResource GameTextDarkBrush}"
                                Text="NỘI DUNG CHAT (MỖI DÒNG 1 CÂU):" />

                            <TextBox
                                Height="85"
                                Padding="8,6"
                                AcceptsReturn="True"
                                Style="{StaticResource GameTextBoxStyle}"
                                Text="{Binding ChatText, UpdateSourceTrigger=PropertyChanged}"
                                TextWrapping="Wrap"
                                VerticalScrollBarVisibility="Auto" />

                            <!-- Tùy chọn gửi ngẫu nhiên & đồng bộ -->
                            <Grid Margin="0,6,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox
                                    Grid.Column="0"
                                    Content="Gửi ngẫu nhiên các dòng"
                                    FontSize="10.5"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource GameTextDarkBrush}"
                                    IsChecked="{Binding IsRandomChat}" />
                                <CheckBox
                                    Grid.Column="1"
                                    Content="Đồng bộ tất cả acc đã chọn"
                                    FontSize="10.5"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource GameTextDarkBrush}"
                                    IsChecked="{Binding AutoChatSyncAll}" />
                            </Grid>

                            <!-- Cấu hình loại chat & giãn cách -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Kênh chat -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock
                                        Margin="0,0,0,3"
                                        FontSize="10.5"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource GameTextMutedBrush}"
                                        Text="Kênh chat:" />
                                    <ComboBox
                                        Height="26"
                                        SelectedIndex="{Binding SelectedChatTypeIndex}"
                                        Style="{StaticResource GameComboBoxStyle}">
                                        <ComboBoxItem Content="Khu vực (Map)" />
                                        <ComboBoxItem Content="Thế giới (Global)" />
                                    </ComboBox>
                                </StackPanel>

                                <!-- Giãn cách gửi (giây) -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock
                                        Margin="0,0,0,3"
                                        FontSize="10.5"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource GameTextMutedBrush}"
                                        Text="Giãn cách gửi (giây):" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="50" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox
                                            Height="26"
                                            Padding="4,2"
                                            HorizontalContentAlignment="Center"
                                            Style="{StaticResource GameTextBoxStyle}"
                                            Text="{Binding ChatDelaySeconds, UpdateSourceTrigger=PropertyChanged}" />
                                        <UniformGrid Grid.Column="2" Columns="4">
                                            <Button
                                                Height="26"
                                                Margin="1,0"
                                                Command="{Binding SetChatDelayCommand}"
                                                CommandParameter="3"
                                                Content="3s"
                                                FontSize="10"
                                                FontWeight="Bold"
                                                Style="{StaticResource GameSecondaryButton}" />
                                            <Button
                                                Height="26"
                                                Margin="1,0"
                                                Command="{Binding SetChatDelayCommand}"
                                                CommandParameter="5"
                                                Content="5s"
                                                FontSize="10"
                                                FontWeight="Bold"
                                                Style="{StaticResource GameSecondaryButton}" />
                                            <Button
                                                Height="26"
                                                Margin="1,0"
                                                Command="{Binding SetChatDelayCommand}"
                                                CommandParameter="10"
                                                Content="10s"
                                                FontSize="10"
                                                FontWeight="Bold"
                                                Style="{StaticResource GameSecondaryButton}" />
                                            <Button
                                                Height="26"
                                                Margin="1,0"
                                                Command="{Binding SetChatDelayCommand}"
                                                CommandParameter="30"
                                                Content="30s"
                                                FontSize="10"
                                                FontWeight="Bold"
                                                Style="{StaticResource GameSecondaryButton}" />
                                        </UniformGrid>
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <!-- Cụm nút thao tác -->
                            <Grid Margin="0,4,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Nút test gửi 1 lần -->
                                <Button
                                    Grid.Column="0"
                                    Height="32"
                                    Command="{Binding SendChatOnceCommand}"
                                    Content="GỬI 1 LẦN"
                                    FontSize="11"
                                    FontWeight="ExtraBold"
                                    Style="{StaticResource GameSecondaryButton}"
                                    ToolTip="Gửi ngay 1 tin nhắn mà không chạy vòng lặp" />

                                <!-- Nút Bật / Tắt Auto Chat -->
                                <Button
                                    Grid.Column="2"
                                    Height="32"
                                    Command="{Binding ToggleAutoChatCommand}">
                                    <Button.Style>
                                        <Style BasedOn="{StaticResource GamePrimaryButton}" TargetType="Button">
                                            <Setter Property="Content" Value="BẬT AUTO CHAT" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAutoChatRunning}" Value="True">
                                                    <Setter Property="Content" Value="DỪNG AUTO CHAT" />
                                                    <Setter Property="Background" Value="#C0392B" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>

                            <!-- Trạng thái & thống kê -->
                            <Border
                                Padding="8,6"
                                Background="{DynamicResource GameHeaderBrush}"
                                BorderBrush="{DynamicResource GameBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        FontSize="10.5"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource GameTextDarkBrush}"
                                        Text="{Binding AutoChatStatusText}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        FontSize="10"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource GameTextMutedBrush}"
                                        Text="{Binding SyncTargetDisplay}" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Border>
    </Grid>
</UserControl>
