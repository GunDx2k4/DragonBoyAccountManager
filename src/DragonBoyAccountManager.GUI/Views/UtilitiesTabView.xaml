<UserControl
    x:Class="DragonBoyAccountManager.GUI.Views.UtilitiesTabView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:DragonBoyAccountManager.Core.Domain.Snapshots;assembly=DragonBoyAccountManager.Core"
    xmlns:viewmodels="clr-namespace:DragonBoyAccountManager.GUI.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodels:UtilitiesTabViewModel}"
    d:DesignHeight="550"
    d:DesignWidth="435"
    mc:Ignorable="d">

    <Grid Margin="10,8">
        <Grid.RowDefinitions>

            <RowDefinition Height="Auto" />

            <RowDefinition Height="Auto" />

            <RowDefinition Height="Auto" />

            <RowDefinition Height="Auto" />

            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Margin="0,0,0,8"
            Padding="8,7"
            Background="{DynamicResource GameBgBrush}"
            BorderBrush="{DynamicResource GameBorderBrush}"
            BorderThickness="1.5"
            CornerRadius="6">
            <StackPanel>

                <Grid Margin="0,0,0,6">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12"
                            FontWeight="ExtraBold"
                            Foreground="{DynamicResource GameTextYellowBrush}">
                            <Run Text="{Binding CurrentMapName, FallbackValue='Chưa vào game'}" />
                            <Run Foreground="{DynamicResource GameTextDarkBrush}" Text=" - Khu " />
                            <Run Text="{Binding CurrentZoneId, FallbackValue='-'}" />
                            <Run Foreground="{DynamicResource GameTextDarkBrush}" Text=" (" />
                            <Run Foreground="{DynamicResource GameTextDarkBrush}" Text="{Binding ZonePlayerDisplay, FallbackValue='0/15'}" />
                            <Run Foreground="{DynamicResource GameTextDarkBrush}" Text=")" />
                        </TextBlock>

                        <Border
                            Margin="8,0,0,0"
                            Padding="5,1"
                            VerticalAlignment="Center"
                            Background="{DynamicResource GameGreenBrush}"
                            CornerRadius="3"
                            ToolTip="Số tài khoản đang được đồng bộ theo danh sách tích chọn ở bảng tài khoản">
                            <TextBlock
                                FontSize="9"
                                FontWeight="ExtraBold"
                                Foreground="{DynamicResource GameTextLightBrush}"
                                Text="{Binding SyncTargetDisplay, FallbackValue='1 tài khoản'}" />
                        </Border>
                    </StackPanel>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        FontSize="11"
                        FontWeight="ExtraBold"
                        Foreground="{DynamicResource GameTextDarkBrush}"
                        Text="ĐỔI KHU:" />

                    <ComboBox
                        x:Name="ZoneComboBox"
                        Grid.Column="1"
                        Height="28"
                        DropDownOpened="ZoneComboBox_DropDownOpened"
                        ItemsSource="{Binding AvailableZones}"
                        SelectedItem="{Binding SelectedZone, Mode=TwoWay}"
                        Style="{StaticResource GameComboBoxStyle}"
                        ToolTip="Chọn khu từ danh sách để chuyển map ngay lập tức">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:WorldZoneInfo}">
                                <Grid Margin="2,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock
                                            FontSize="11"
                                            FontWeight="Bold"
                                            Foreground="{DynamicResource GameTextDarkBrush}"
                                            Text="{Binding ZoneId, StringFormat='Khu {0}'}" />
                                        <TextBlock
                                            Margin="6,0,0,0"
                                            FontSize="10"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource GameTextGreenBrush}"
                                            Text="{Binding NumPlayers, StringFormat='({0}'}" />
                                        <TextBlock
                                            FontSize="10"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource GameTextGreenBrush}"
                                            Text="{Binding MaxPlayers, StringFormat='/{0})'}" />
                                    </StackPanel>
                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="8,0,0,0"
                                        FontSize="9.5"
                                        FontWeight="ExtraBold"
                                        Foreground="{DynamicResource GameTextRedBrush}"
                                        Text="ĐẦY"
                                        VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFull}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <StackPanel
                        Grid.Column="2"
                        Margin="6,0,0,0"
                        Orientation="Horizontal">
                        <Button
                            Width="28"
                            Height="28"
                            Margin="0,0,4,0"
                            Command="{Binding PreviousZoneCommand}"
                            Style="{StaticResource GameSecondaryButton}"
                            ToolTip="Chuyển sang khu trước (Phím [)">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="{DynamicResource GameFont}"
                                FontSize="12"
                                FontWeight="ExtraBold"
                                Foreground="{DynamicResource GameBtnTanTextBrush}"
                                Text="&lt;" />
                        </Button>
                        <Button
                            Width="28"
                            Height="28"
                            Command="{Binding NextZoneCommand}"
                            Style="{StaticResource GameSecondaryButton}"
                            ToolTip="Chuyển sang khu kế tiếp (Phím ])">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="{DynamicResource GameFont}"
                                FontSize="12"
                                FontWeight="ExtraBold"
                                Foreground="{DynamicResource GameBtnTanTextBrush}"
                                Text="&gt;" />
                        </Button>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <Border
            Grid.Row="1"
            Margin="0,0,0,7"
            Padding="8,6"
            Background="{DynamicResource GameBgBrush}"
            BorderBrush="{DynamicResource GameBorderBrush}"
            BorderThickness="1.5"
            CornerRadius="6">
            <StackPanel>
                <Grid Margin="0,0,0,4" SnapsToDevicePixels="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="10.5"
                            FontWeight="ExtraBold"
                            Foreground="{DynamicResource GameTextDarkBrush}"
                            Text="TỐC ĐỘ GAME" />

                        <CheckBox
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Content="Toàn bộ acc"
                            FontSize="9.5"
                            FontWeight="Bold"
                            IsChecked="{Binding IsApplySpeedToAll}"
                            Style="{StaticResource GameCheckBoxStyle}"
                            ToolTip="Áp dụng tốc độ cho toàn bộ tài khoản đang chạy" />
                    </StackPanel>

                    <Border
                        Grid.Column="2"
                        Margin="0,0,2,0"
                        Padding="6,1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Background="{DynamicResource GameBtnOrangeFaceTopBrush}"
                        BorderBrush="{DynamicResource GameBorderDarkBrush}"
                        BorderThickness="1"
                        CornerRadius="3.5"
                        SnapsToDevicePixels="True">
                        <TextBlock
                            FontSize="9.5"
                            FontWeight="ExtraBold"
                            Foreground="{DynamicResource GameTextLightBrush}"
                            Text="{Binding GameSpeedText, FallbackValue='1.0x'}" />
                    </Border>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="150" />
                    </Grid.ColumnDefinitions>

                    <Slider
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        LargeChange="0.5"
                        Maximum="5.0"
                        Minimum="0.1"
                        SmallChange="0.1"
                        Style="{StaticResource GameSliderStyle}"
                        TickFrequency="0.5"
                        ToolTip="Kéo để điều chỉnh Time.timeScale của game (0.1x - 5.0x)"
                        Value="{Binding GameSpeed, UpdateSourceTrigger=PropertyChanged}" />

                    <UniformGrid Grid.Column="2" Columns="4">
                        <Button
                            Height="24"
                            Margin="1,0"
                            Command="{Binding SetGameSpeedCommand}"
                            CommandParameter="1.0"
                            Content="1x"
                            Style="{StaticResource GameSpeedQuickButtonStyle}" />
                        <Button
                            Height="24"
                            Margin="1,0"
                            Command="{Binding SetGameSpeedCommand}"
                            CommandParameter="1.5"
                            Content="1.5x"
                            Style="{StaticResource GameSpeedQuickButtonStyle}" />
                        <Button
                            Height="24"
                            Margin="1,0"
                            Command="{Binding SetGameSpeedCommand}"
                            CommandParameter="2.0"
                            Content="2x"
                            Style="{StaticResource GameSpeedQuickButtonStyle}" />
                        <Button
                            Height="24"
                            Margin="1,0"
                            Command="{Binding SetGameSpeedCommand}"
                            CommandParameter="3.0"
                            Content="3x"
                            Style="{StaticResource GameSpeedQuickButtonStyle}" />
                    </UniformGrid>
                </Grid>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,7">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button
                Grid.Column="0"
                Height="32"
                Command="{Binding UseCapsuleCommand}"
                Style="{StaticResource GameSecondaryButton}"
                ToolTip="Sử dụng Capsule bay về nhà / các map (Phím tắt: C) - Tìm ID 194/193 trong túi">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" FontSize="11" FontWeight="ExtraBold" Foreground="{DynamicResource GameBtnTanTextBrush}" Text="Capsule" />
                    <Border Margin="5,0,0,0" Padding="4,1" VerticalAlignment="Center" Background="{DynamicResource GameBadgeShortcutBgBrush}" CornerRadius="3">
                        <TextBlock FontSize="9" FontWeight="ExtraBold" Foreground="{DynamicResource GameBadgeShortcutTextBrush}" Text="[C]" />
                    </Border>
                </StackPanel>
            </Button>

            <Button
                Grid.Column="2"
                Height="32"
                Command="{Binding UseTdltCommand}"
                Style="{StaticResource GameSecondaryButton}"
                ToolTip="Bật/Tắt Tự Động Luyện Tập (Phím tắt: X) - Tìm ID 521 trong túi">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" FontSize="11" FontWeight="ExtraBold" Foreground="{DynamicResource GameBtnTanTextBrush}" Text="TDLT" />
                    <Border Margin="5,0,0,0" Padding="4,1" VerticalAlignment="Center" Background="{DynamicResource GameBadgeShortcutBgBrush}" CornerRadius="3">
                        <TextBlock FontSize="9" FontWeight="ExtraBold" Foreground="{DynamicResource GameBadgeShortcutTextBrush}" Text="[X]" />
                    </Border>
                </StackPanel>
            </Button>
        </Grid>

        <StackPanel Grid.Row="3" Margin="0,0,0,8">
            <Grid Margin="2,0,2,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontSize="10"
                    FontWeight="ExtraBold"
                    Foreground="{DynamicResource GameTextDarkBrush}"
                    Text="DỊCH CHUYỂN NHANH" />

                <StackPanel
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <CheckBox
                        VerticalAlignment="Center"
                        Content="Tele nhanh"
                        FontSize="9.5"
                        FontWeight="Bold"
                        IsChecked="{Binding FastTeleport}"
                        Style="{StaticResource GameCheckBoxStyle}"
                        ToolTip="Dịch chuyển tức thời đến tọa độ đích" />
                </StackPanel>
            </Grid>

            <ItemsControl ItemsSource="{Binding WaypointButtons}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type viewmodels:WaypointButtonItem}">
                        <Button
                            Height="38"
                            MinWidth="0"
                            Margin="2,0"
                            Padding="6,2"
                            Command="{Binding DataContext.MoveToWaypointCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            Style="{StaticResource GamePrimaryButton}"
                            ToolTip="{Binding Name, StringFormat='Chuyển tới {0}'}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="11"
                                    FontWeight="ExtraBold"
                                    Foreground="{DynamicResource GameTextLightBrush}"
                                    Text="{Binding Name}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="8.5"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource GameTextYellowBrush}">
                                    <Run Text="(" />
                                    <Run Text="{Binding X}" />
                                    <Run Text=", " />
                                    <Run Text="{Binding Y}" />
                                    <Run Text=")" />
                                </TextBlock>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <Border
            Grid.Row="4"
            Background="{DynamicResource GameTabContentBrush}"
            BorderBrush="{DynamicResource GameBorderBrush}"
            BorderThickness="1.5"
            CornerRadius="6">
            <TabControl Style="{StaticResource GameTabControlStyle}">

                <TabItem Style="{StaticResource GameTabItemStyle}" ToolTip="Boss và Người chơi trong khu">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="10" Text="BOSS/NGƯỜI (" />
                            <TextBlock FontSize="10" Foreground="{DynamicResource GameTextYellowBrush}" Text="{Binding BossCount}" TextTrimming="CharacterEllipsis" ToolTip="{Binding BossCount}" />
                            <TextBlock FontSize="10" Text="/" />
                            <TextBlock FontSize="10" Text="{Binding PlayerCount}" TextTrimming="CharacterEllipsis" ToolTip="{Binding PlayerCount}" />
                            <TextBlock FontSize="10" Text=")" />
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer FocusVisualStyle="{x:Null}" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="6,4">

                            <TextBlock
                                Margin="2,4,0,3"
                                FontSize="10.5"
                                FontWeight="ExtraBold"
                                Foreground="{DynamicResource GameTextYellowBrush}"
                                Text="DANH SÁCH BOSS:" />

                            <ItemsControl ItemsSource="{Binding Bosses}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:WorldBossInfo}">
                                        <Border
                                            Margin="0,1,0,3"
                                            Padding="6,4"
                                            Background="{DynamicResource GameBgBrush}"
                                            BorderBrush="{DynamicResource GameDangerBrush}"
                                            BorderThickness="1.2"
                                            CornerRadius="4"
                                            Cursor="Hand"
                                            MouseLeftButtonDown="EntityItem_MouseLeftButtonDown"
                                            ToolTip="Nhấn đúp chuột để chọn và click vào Boss này trong game">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock
                                                        FontSize="11.5"
                                                        FontWeight="ExtraBold"
                                                        Foreground="{DynamicResource GameTextRedBrush}"
                                                        Text="{Binding Name}"
                                                        TextTrimming="CharacterEllipsis"
                                                        ToolTip="{Binding Name}" />
                                                    <TextBlock
                                                        FontSize="9.5"
                                                        Foreground="{DynamicResource GameTextMutedBrush}">
                                                        <Run Text="HP: " />
                                                        <Run FontWeight="Bold" Text="{Binding Hp, StringFormat='{}{0:N0}'}" />
                                                    </TextBlock>
                                                </StackPanel>
                                                <Border
                                                    Grid.Column="1"
                                                    Padding="5,1"
                                                    VerticalAlignment="Center"
                                                    Background="{DynamicResource GameDangerBrush}"
                                                    CornerRadius="3">
                                                    <TextBlock
                                                        FontSize="9.5"
                                                        FontWeight="Bold"
                                                        Foreground="{DynamicResource GameTextLightBrush}">
                                                        <Run Text="(" />
                                                        <Run Text="{Binding X}" />
                                                        <Run Text=", " />
                                                        <Run Text="{Binding Y}" />
                                                        <Run Text=")" />
                                                    </TextBlock>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock
                                Margin="2,8,0,3"
                                FontSize="10.5"
                                FontWeight="ExtraBold"
                                Foreground="{DynamicResource GameTextDarkBrush}"
                                Text="NGƯỜI CHƠI TRONG KHU:" />

                            <ItemsControl ItemsSource="{Binding Players}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:WorldPlayerInfo}">
                                        <Border
                                            Margin="0,1,0,3"
                                            Padding="6,3"
                                            Background="{DynamicResource GameBgBrush}"
                                            BorderBrush="{DynamicResource GameBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Cursor="Hand"
                                            MouseLeftButtonDown="EntityItem_MouseLeftButtonDown"
                                            ToolTip="Nhấn đúp chuột để chọn và click vào người chơi này trong game">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock
                                                        FontSize="11"
                                                        FontWeight="Bold"
                                                        Foreground="{DynamicResource GameTextDarkBrush}"
                                                        Text="{Binding Name}"
                                                        TextTrimming="CharacterEllipsis"
                                                        ToolTip="{Binding Name}" />
                                                    <TextBlock
                                                        FontSize="9"
                                                        Foreground="{DynamicResource GameTextMutedBrush}">
                                                        <Run Text="HP: " />
                                                        <Run Text="{Binding Hp, StringFormat='{}{0:N0}'}" />
                                                    </TextBlock>
                                                </StackPanel>
                                                <Border
                                                    Grid.Column="1"
                                                    Padding="4,1"
                                                    VerticalAlignment="Center"
                                                    Background="{DynamicResource GameTabContentBrush}"
                                                    BorderBrush="{DynamicResource GameBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="3">
                                                    <TextBlock
                                                        FontSize="9.5"
                                                        FontWeight="Bold"
                                                        Foreground="{DynamicResource GameTextDarkBrush}">
                                                        <Run Text="(" />
                                                        <Run Text="{Binding X}" />
                                                        <Run Text=", " />
                                                        <Run Text="{Binding Y}" />
                                                        <Run Text=")" />
                                                    </TextBlock>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Style="{StaticResource GameTabItemStyle}">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="QUÁI (" />
                            <TextBlock Foreground="{DynamicResource GameTextGreenBrush}" Text="{Binding AliveMobs}" TextTrimming="CharacterEllipsis" ToolTip="{Binding AliveMobs}" />
                            <TextBlock Text="/" />
                            <TextBlock Text="{Binding TotalMobs}" TextTrimming="CharacterEllipsis" ToolTip="{Binding TotalMobs}" />
                            <TextBlock Text=")" />
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer FocusVisualStyle="{x:Null}" VerticalScrollBarVisibility="Auto">
                        <ItemsControl Margin="6,4" ItemsSource="{Binding Mobs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:WorldMobInfo}">
                                    <Border
                                        Margin="0,1,0,3"
                                        Padding="6,4"
                                        Background="{DynamicResource GameBgBrush}"
                                        BorderBrush="{DynamicResource GameBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Cursor="Hand"
                                        MouseLeftButtonDown="EntityItem_MouseLeftButtonDown"
                                        ToolTip="Nhấn đúp chuột để chọn và click vào Quái này trong game">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Opacity" Value="1.0" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAlive}" Value="False">
                                                        <Setter Property="Opacity" Value="0.6" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <DockPanel VerticalAlignment="Center">
                                                    <Border
                                                        DockPanel.Dock="Right"
                                                        Margin="6,0,0,0"
                                                        Padding="4,0"
                                                        VerticalAlignment="Center"
                                                        CornerRadius="3">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{DynamicResource GameGreenBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsAlive}" Value="False">
                                                                        <Setter Property="Background" Value="{DynamicResource GameGrayBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock
                                                            FontSize="8.5"
                                                            FontWeight="ExtraBold"
                                                            Foreground="{DynamicResource GameTextLightBrush}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="SỐNG" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsAlive}" Value="False">
                                                                            <Setter Property="Text" Value="CHẾT" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                    <TextBlock
                                                        FontSize="11"
                                                        FontWeight="Bold"
                                                        Foreground="{DynamicResource GameTextDarkBrush}"
                                                        Text="{Binding Name}"
                                                        TextTrimming="CharacterEllipsis"
                                                        ToolTip="{Binding Name}" />
                                                </DockPanel>
                                                <TextBlock
                                                    FontSize="9"
                                                    Foreground="{DynamicResource GameTextMutedBrush}">
                                                    <Run Text="HP: " />
                                                    <Run FontWeight="SemiBold" Text="{Binding Hp, StringFormat='{}{0:N0}'}" />
                                                    <Run Text="/" />
                                                    <Run Text="{Binding MaxHp, StringFormat='{}{0:N0}'}" />
                                                    <Run Text=" • ID: " />
                                                    <Run Text="{Binding Id}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <Border
                                                Grid.Column="1"
                                                Padding="4,1"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource GameTabContentBrush}"
                                                BorderBrush="{DynamicResource GameBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="3">
                                                <TextBlock
                                                    FontSize="9.5"
                                                    FontWeight="Bold"
                                                    Foreground="{DynamicResource GameTextDarkBrush}">
                                                    <Run Text="(" />
                                                    <Run Text="{Binding X}" />
                                                    <Run Text=", " />
                                                    <Run Text="{Binding Y}" />
                                                    <Run Text=")" />
                                                </TextBlock>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </TabItem>

                <TabItem Style="{StaticResource GameTabItemStyle}">
                    <TabItem.Header>
                        <TextBlock>
                            <Run Text="NPC (" />
                            <Run Text="{Binding NpcCount}" />
                            <Run Text=")" />
                        </TextBlock>
                    </TabItem.Header>
                    <ScrollViewer FocusVisualStyle="{x:Null}" VerticalScrollBarVisibility="Auto">
                        <ItemsControl Margin="6,4" ItemsSource="{Binding Npcs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:WorldNpcInfo}">
                                    <Border
                                        Margin="0,1,0,3"
                                        Padding="6,4"
                                        Background="{DynamicResource GameBgBrush}"
                                        BorderBrush="{DynamicResource GameBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Cursor="Hand"
                                        MouseLeftButtonDown="EntityItem_MouseLeftButtonDown"
                                        ToolTip="Nhấn đúp chuột để chọn và click vào NPC này trong game">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock
                                                    FontSize="11"
                                                    FontWeight="Bold"
                                                    Foreground="{DynamicResource GameTextDarkBrush}"
                                                    Text="{Binding Name}"
                                                    TextTrimming="CharacterEllipsis"
                                                    ToolTip="{Binding Name}" />
                                                <TextBlock
                                                    FontSize="9"
                                                    Foreground="{DynamicResource GameTextMutedBrush}">
                                                    <Run Text="ID: " />
                                                    <Run Text="{Binding Id}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <Border
                                                Grid.Column="1"
                                                Padding="4,1"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource GameTabContentBrush}"
                                                BorderBrush="{DynamicResource GameBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="3">
                                                <TextBlock
                                                    FontSize="9.5"
                                                    FontWeight="Bold"
                                                    Foreground="{DynamicResource GameTextDarkBrush}">
                                                    <Run Text="(" />
                                                    <Run Text="{Binding X}" />
                                                    <Run Text=", " />
                                                    <Run Text="{Binding Y}" />
                                                    <Run Text=")" />
                                                </TextBlock>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Border>
    </Grid>
</UserControl>
