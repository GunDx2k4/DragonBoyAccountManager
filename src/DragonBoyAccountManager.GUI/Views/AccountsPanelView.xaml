<UserControl
    x:Class="DragonBoyAccountManager.GUI.Views.AccountsPanelView"
    x:Name="RootView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:DragonBoyAccountManager.GUI.UI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:DragonBoyAccountManager.GUI.UI.Controls"
    xmlns:viewmodels="clr-namespace:DragonBoyAccountManager.GUI.ViewModels"
    xmlns:views="clr-namespace:DragonBoyAccountManager.GUI.Views"
    d:DataContext="{d:DesignInstance Type=viewmodels:AccountsPanelViewModel}"
    d:DesignHeight="550"
    d:DesignWidth="680"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:StatusToBrushConverter x:Key="StatusToBrushConverter" />
    </UserControl.Resources>

    <ui:GameCard Padding="10,8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="80" MaxWidth="220" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="105" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    Margin="0,0,6,0"
                    VerticalAlignment="Center"
                    FontWeight="Bold"
                    Foreground="{DynamicResource GameTextDarkBrush}"
                    Text="Tìm:" />
                <TextBox
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Style="{StaticResource GameTextBoxStyle}"
                    Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock
                    Grid.Column="2"
                    Margin="10,0,6,0"
                    VerticalAlignment="Center"
                    FontWeight="Bold"
                    Foreground="{DynamicResource GameTextDarkBrush}"
                    Text="Server:" />
                <ComboBox
                    Grid.Column="3"
                    VerticalAlignment="Center"
                    ItemsSource="{Binding FilterServers}"
                    SelectedItem="{Binding SelectedServerFilter}"
                    Style="{StaticResource GameComboBoxStyle}" />

                <Button
                    Grid.Column="4"
                    Height="28"
                    MinWidth="50"
                    Margin="6,0,0,0"
                    VerticalAlignment="Center"
                    Command="{Binding ClearFilterCommand}"
                    Content="Lọc lại"
                    Style="{StaticResource GameSecondaryButton}" />

                <StackPanel
                    Grid.Column="6"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Button
                        Height="28"
                        Margin="0,0,8,0"
                        Padding="8,0"
                        Command="{Binding ToggleHideAccountsCommand}"
                        Style="{StaticResource GameSecondaryButton}"
                        ToolTip="Ẩn hoặc hiển thị tên tài khoản">
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">

                            <Control
                                Width="15"
                                Height="15"
                                Margin="0,0,5,0"
                                Focusable="False"
                                IsHitTestVisible="False"
                                Template="{StaticResource DragonBallHideAccountIconTemplate}" />
                            <TextBlock
                                FontSize="11"
                                FontWeight="ExtraBold"
                                Foreground="{DynamicResource GameTextDarkBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="ẨN ACC" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsHideAccounts}" Value="True">
                                                <Setter Property="Text" Value="HIỆN ACC" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>

                    <Button
                        Height="28"
                        MinWidth="85"
                        Margin="0,0,8,0"
                        Command="{Binding OpenAddAccountCommand}"
                        Content="THÊM ACC"
                        Style="{StaticResource GamePrimaryButton}" />

                    <Button
                        Width="28"
                        Height="28"
                        Command="{Binding LoadAccountsCommand}"
                        Style="{StaticResource GameRadarRefreshButton}"
                        ToolTip="Làm mới danh sách" />
                </StackPanel>
            </Grid>

            <DataGrid
                x:Name="AccountsDataGrid"
                Grid.Row="1"
                CanUserResizeColumns="True"
                IsReadOnly="True"
                ItemsSource="{Binding AccountsView}"
                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                SelectedItem="{Binding SelectedAccount}"
                SelectionChanged="AccountsDataGrid_SelectionChanged"
                SelectionMode="Extended"
                SelectionUnit="FullRow"
                Style="{StaticResource GameDataGridStyle}">
                <DataGrid.Resources>
                    <views:AccountContextMenu x:Key="AccountRowContextMenu" x:Shared="False" />
                </DataGrid.Resources>
                <DataGrid.RowStyle>
                    <Style BasedOn="{StaticResource GameDataGridRowStyle}" TargetType="DataGridRow">
                        <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                        <EventSetter Event="MouseDoubleClick" Handler="DataGridRow_MouseDoubleClick" />
                        <EventSetter Event="PreviewMouseRightButtonDown" Handler="DataGridRow_PreviewMouseRightButtonDown" />
                        <Setter Property="ContextMenu" Value="{StaticResource AccountRowContextMenu}" />
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="46">
                        <DataGridTemplateColumn.Header>
                            <CheckBox
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Click="HeaderCheckBox_Click"
                                IsChecked="{Binding DataContext.IsAllSelected, ElementName=RootView, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource GameCheckBoxStyle}"
                                ToolTip="Chọn / Bỏ chọn tất cả" />
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Click="RowCheckBox_Click"
                                    IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Style="{StaticResource GameCheckBoxStyle}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Width="105" MinWidth="80" Header="MÁY CHỦ">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ui:GameBadge Content="{Binding Server}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Width="*" MinWidth="160" Header="TÀI KHOẢN">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,2" VerticalAlignment="Center">
                                    <TextBlock
                                        FontSize="12"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource GameTextDarkBrush}"
                                        Text="{Binding DisplayUsername}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip="{Binding DisplayUsername}" />
                                    <StackPanel Margin="0,2,0,0" Orientation="Horizontal">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasCharacterName}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>

                                        <Border
                                            Margin="0,0,4,0"
                                            Padding="3.5,0.5"
                                            VerticalAlignment="Center"
                                            BorderThickness="0.8"
                                            CornerRadius="3">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#E6D3B3" />
                                                    <Setter Property="BorderBrush" Value="#B89772" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CharacterGender}" Value="0">
                                                            <Setter Property="Background" Value="#FFE0B2" />
                                                            <Setter Property="BorderBrush" Value="#FFA726" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding CharacterGender}" Value="1">
                                                            <Setter Property="Background" Value="#C8E6C9" />
                                                            <Setter Property="BorderBrush" Value="#66BB6A" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding CharacterGender}" Value="2">
                                                            <Setter Property="Background" Value="#F8BBD0" />
                                                            <Setter Property="BorderBrush" Value="#EC407A" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock
                                                FontSize="9"
                                                FontWeight="Bold"
                                                Text="{Binding GenderDisplayName}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#6B3503" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CharacterGender}" Value="0">
                                                                <Setter Property="Foreground" Value="#E65100" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding CharacterGender}" Value="1">
                                                                <Setter Property="Foreground" Value="#1B5E20" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding CharacterGender}" Value="2">
                                                                <Setter Property="Foreground" Value="#880E4F" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>

                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            FontWeight="Bold"
                                            Text="{Binding DisplayCharacterName}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTip="{Binding DisplayCharacterName, StringFormat='Nhân vật: {0}'}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#8B2500" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CharacterGender}" Value="0">
                                                            <Setter Property="Foreground" Value="#D35400" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding CharacterGender}" Value="1">
                                                            <Setter Property="Foreground" Value="#2E7D32" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding CharacterGender}" Value="2">
                                                            <Setter Property="Foreground" Value="#880E4F" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <TextBlock
                                            Margin="2,0,0,0"
                                            VerticalAlignment="Center"
                                            FontSize="9.5"
                                            Foreground="#7D6652"
                                            Text="{Binding CharacterPower, StringFormat=' ({0:N0})'}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CharacterPower}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding CharacterPower}" Value="0">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Width="145" MinWidth="100" Header="BẢN ĐỒ / KHU">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Margin="6,2" VerticalAlignment="Center">
                                    <TextBlock
                                        FontSize="11"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource GameTextDarkBrush}"
                                        Text="{Binding DisplayMapName}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip="{Binding DisplayMapFullInfo}" />
                                    <StackPanel Margin="0,1,0,0" Orientation="Horizontal">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasMapInfo}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock
                                            FontSize="9.5"
                                            FontWeight="ExtraBold"
                                            Foreground="#D35400"
                                            Text="{Binding DisplayZone}" />
                                        <TextBlock
                                            Margin="4,0,0,0"
                                            FontSize="9"
                                            FontWeight="Bold"
                                            Foreground="#7D6652"
                                            Text="{Binding DisplayCoordinates}" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Width="115" MinWidth="90" Header="TRẠNG THÁI">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border
                                    Padding="6,2"
                                    HorizontalAlignment="Center"
                                    Background="#FAD7A0"
                                    BorderBrush="{DynamicResource GameBorderBrush}"
                                    BorderThickness="1.2"
                                    CornerRadius="4"
                                    ToolTip="{Binding StatusTooltip}">
                                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                        <ui:GameStatusOrb
                                            Margin="0,0,5,0"
                                            VerticalAlignment="Center"
                                            Status="{Binding Status}"
                                            Size="14" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            FontWeight="Bold"
                                            Foreground="{Binding Status, Converter={StaticResource StatusToBrushConverter}}"
                                            Text="{Binding StatusDisplayName}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <Grid Grid.Row="2" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <WrapPanel
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Border
                        Margin="0,0,6,0"
                        Padding="8,3"
                        Background="{DynamicResource GameBgBrush}"
                        BorderBrush="{DynamicResource GameBorderBrush}"
                        BorderThickness="1.2"
                        CornerRadius="6">
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                            <TextBlock
                                FontSize="11"
                                FontWeight="Bold"
                                Foreground="{DynamicResource GameTextMutedBrush}"
                                Text="Tổng: " />
                            <TextBlock
                                FontSize="11"
                                FontWeight="ExtraBold"
                                Foreground="{DynamicResource GameTextDarkBrush}"
                                Text="{Binding TotalAccountsCount}" />
                        </StackPanel>
                    </Border>

                    <Border
                        Margin="0,0,6,0"
                        Padding="8,3"
                        Background="{DynamicResource GameBgBrush}"
                        BorderBrush="{DynamicResource GameBorderBrush}"
                        BorderThickness="1.2"
                        CornerRadius="6">
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                            <ui:GameStatusOrb
                                Margin="0,0,5,0"
                                VerticalAlignment="Center"
                                Status="Active"
                                Size="13" />
                            <TextBlock
                                FontSize="11"
                                FontWeight="Bold"
                                Foreground="{DynamicResource GameTextMutedBrush}"
                                Text="Online: " />
                            <TextBlock
                                FontSize="11"
                                FontWeight="ExtraBold"
                                Foreground="{DynamicResource GameGreenBrush}"
                                Text="{Binding RunningAccountsCount}" />
                        </StackPanel>
                    </Border>

                    <Border
                        Margin="0,0,6,0"
                        Padding="8,3"
                        Background="{DynamicResource GameBgBrush}"
                        BorderBrush="{DynamicResource GameBorderBrush}"
                        BorderThickness="1.2"
                        CornerRadius="6">
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                            <TextBlock
                                FontSize="11"
                                FontWeight="Bold"
                                Foreground="{DynamicResource GameTextMutedBrush}"
                                Text="Đã chọn: " />
                            <TextBlock
                                FontSize="11"
                                FontWeight="ExtraBold"
                                Foreground="{DynamicResource GameTextDarkBrush}"
                                Text="{Binding SelectedAccountsCount}" />
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Button
                        Height="28"
                        MinWidth="90"
                        Margin="0,0,6,0"
                        Command="{Binding LoginSelectedAccountsCommand}"
                        Content="ĐĂNG NHẬP"
                        FontSize="11"
                        Style="{StaticResource GamePrimaryButton}"
                        ToolTip="Mở game và đăng nhập tự động cho các tài khoản đang được chọn" />

                    <Button
                        Height="28"
                        MinWidth="85"
                        Margin="0,0,6,0"
                        Command="{Binding StopSelectedAccountsCommand}"
                        Content="TẮT ĐÃ CHỌN"
                        FontSize="11"
                        Style="{StaticResource GameSecondaryButton}"
                        ToolTip="Đóng game cho các tài khoản đang được chọn" />

                    <Button
                        Height="28"
                        MinWidth="80"
                        Command="{Binding ArrangeWindowsCommand}"
                        Content="SẮP XẾP"
                        FontSize="11"
                        Style="{StaticResource GameSecondaryButton}"
                        ToolTip="Sắp xếp các cửa sổ game" />
                </StackPanel>
            </Grid>
        </Grid>
    </ui:GameCard>
</UserControl>
