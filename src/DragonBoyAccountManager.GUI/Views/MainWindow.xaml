<Window
    x:Class="DragonBoyAccountManager.GUI.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="clr-namespace:DragonBoyAccountManager.GUI.ViewModels"
    xmlns:views="clr-namespace:DragonBoyAccountManager.GUI.Views"
    Title="{Binding Guide.AppVersion, StringFormat='Dragon Boy Account Manager (DBAM) v{0}'}"
    Width="1180"
    Height="660"
    MinWidth="1060"
    MinHeight="560"
    ResizeMode="CanResize"
    d:DataContext="{d:DesignInstance Type=viewmodels:MainViewModel}"
    AllowsTransparency="True"
    Background="Transparent"
    FontFamily="Segoe UI, Tahoma, Arial"
    Icon="/Assets/app_icon.png"
    SnapsToDevicePixels="True"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType"
    UseLayoutRounding="True"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    PreviewKeyDown="Window_PreviewKeyDown"
    PreviewKeyUp="Window_PreviewKeyUp"
    mc:Ignorable="d">

    <Grid>

        <Border Background="#261302">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Margin" Value="3,6,3,2" />
                    <Setter Property="CornerRadius" Value="10" />
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>

        <Border
            Padding="1.8"
            Background="{DynamicResource GameBorderBrush}"
            SnapsToDevicePixels="True">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Margin" Value="3,2,3,6" />
                    <Setter Property="CornerRadius" Value="9" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="CornerRadius" Value="0" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Border
                Padding="0"
                Background="{DynamicResource GameBgAltBrush}"
                BorderBrush="{DynamicResource GamePanelHighlightBrush}"
                BorderThickness="1.5,1.5,1,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="7.5" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                <Setter Property="CornerRadius" Value="0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Border
                        Height="3"
                        VerticalAlignment="Bottom"
                        Background="{DynamicResource GamePanelShadowBrush}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="0,0,7,7" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                        <Setter Property="CornerRadius" Value="0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>

                    <Border
                        Margin="1,1,1,2"
                        Background="{DynamicResource GameBgBrush}"
                        BorderBrush="{DynamicResource GameBorderBrush}"
                        BorderThickness="1.5">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                        <Setter Property="CornerRadius" Value="0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="38" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="34" />
                            </Grid.RowDefinitions>

                            <views:AppTitleBarView Grid.Row="0" />

                            <Border Grid.Row="1" Background="{DynamicResource GameBgBrush}">
                                <Grid>
                                    <Border
                                        Height="3"
                                        VerticalAlignment="Top"
                                        Background="{DynamicResource GamePanelShadowBrush}" />
                                    <Grid Margin="10,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="520" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="475" MinWidth="435" MaxWidth="720" />
                                        </Grid.ColumnDefinitions>

                                        <views:AccountsPanelView Grid.Column="0" DataContext="{Binding AccountsPanel}" />

                                        <Grid Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Stretch">
                                            <Rectangle Width="1.5" Fill="{DynamicResource GameBorderBrush}" HorizontalAlignment="Center" />
                                            <Border
                                                Width="6"
                                                Height="36"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource GameBgAltBrush}"
                                                BorderBrush="{DynamicResource GameBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="3">
                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <Rectangle Width="2" Height="2" Margin="0,1" Fill="{DynamicResource GameBorderHighlightBrush}" />
                                                    <Rectangle Width="2" Height="2" Margin="0,1" Fill="{DynamicResource GameBorderHighlightBrush}" />
                                                    <Rectangle Width="2" Height="2" Margin="0,1" Fill="{DynamicResource GameBorderHighlightBrush}" />
                                                </StackPanel>
                                            </Border>
                                            <GridSplitter
                                                Width="8"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Stretch"
                                                Background="Transparent"
                                                Cursor="SizeWE"
                                                ShowsPreview="False" />
                                        </Grid>

                                        <Border
                                            Grid.Column="2"
                                            Background="{DynamicResource GameBgLightBrush}"
                                            BorderBrush="{DynamicResource GameBorderBrush}"
                                            BorderThickness="2"
                                            CornerRadius="7"
                                            SnapsToDevicePixels="True">
                                            <Grid>
                                                <Border
                                                    Height="6"
                                                    VerticalAlignment="Top"
                                                    Background="{DynamicResource GamePanelHighlightBrush}"
                                                    CornerRadius="5,5,0,0" />
                                                <Border
                                                    Height="3"
                                                    VerticalAlignment="Bottom"
                                                    Background="{DynamicResource GamePanelShadowBrush}"
                                                    CornerRadius="0,0,5,5" />

                                                <Grid Margin="10,8">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                    </Grid.RowDefinitions>

                                                    <Border
                                                        Grid.Row="0"
                                                        Height="32"
                                                        Margin="0,0,0,10"
                                                        Background="{DynamicResource GameHeaderBrush}"
                                                        BorderBrush="{DynamicResource GameBorderBrush}"
                                                        BorderThickness="1.5"
                                                        CornerRadius="5">
                                                        <TextBlock
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            FontSize="12.5"
                                                            FontWeight="ExtraBold"
                                                            Foreground="{DynamicResource GameTextDarkBrush}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="CẤU HÌNH CHO TÀI KHOẢN" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding AccountForm.IsEditing}" Value="False">
                                                                            <Setter Property="Text" Value="THÊM TÀI KHOẢN MỚI" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding SelectedIndex, ElementName=ConfigTabControl}" Value="1">
                                                                            <Setter Property="Text" Value="TIỆN ÍCH BẢN ĐỒ &amp; ĐỔI KHU" />
                                                                        </DataTrigger>
                                                                         <DataTrigger Binding="{Binding SelectedIndex, ElementName=ConfigTabControl}" Value="2">
                                                                            <Setter Property="Text" Value="TỰ ĐỘNG LUYỆN TẬP &amp; CHAT BOT" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding SelectedIndex, ElementName=ConfigTabControl}" Value="3">
                                                                            <Setter Property="Text" Value="CẤU HÌNH HỆ THỐNG" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding SelectedIndex, ElementName=ConfigTabControl}" Value="4">
                                                                            <Setter Property="Text" Value="HƯỚNG DẪN &amp; CẬP NHẬT PHIÊN BẢN" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding SelectedIndex, ElementName=ConfigTabControl}" Value="5">
                                                                            <Setter Property="Text" Value="GÓP Ý &amp; BÁO CÁO LỖI" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>

                                                    <Border
                                                        Grid.Row="1"
                                                        Background="{DynamicResource GameTabContentBrush}"
                                                        BorderBrush="{DynamicResource GameBorderBrush}"
                                                        BorderThickness="2"
                                                        CornerRadius="5"
                                                        SnapsToDevicePixels="True">
                                                        <TabControl
                                                            x:Name="ConfigTabControl"
                                                            SelectedIndex="{Binding SelectedTabIndex}"
                                                            Style="{StaticResource GameTabControlStyle}">

                                                            <TabItem Header="ACC" Style="{StaticResource GameTabItemStyle}" ToolTip="Cấu hình tài khoản game">
                                                                <views:AccountConfigTabView DataContext="{Binding AccountForm}" />
                                                            </TabItem>

                                                            <TabItem Header="TIỆN ÍCH" Style="{StaticResource GameTabItemStyle}" ToolTip="Tiện ích bản đồ, khu vực &amp; tìm kiếm">
                                                                <views:UtilitiesTabView DataContext="{Binding UtilitiesTab}" />
                                                            </TabItem>

                                                            <TabItem Header="AUTO" Style="{StaticResource GameTabItemStyle}" ToolTip="Tự động luyện tập &amp; chat bot">
                                                                <views:AutoTabView DataContext="{Binding AutoTab}" />
                                                            </TabItem>

                                                            <TabItem Header="CÀI ĐẶT" Style="{StaticResource GameTabItemStyle}" ToolTip="Cấu hình hệ thống DBAM">
                                                                <views:SettingsTabView DataContext="{Binding Settings}" />
                                                            </TabItem>

                                                            <TabItem Style="{StaticResource GameTabItemStyle}" ToolTip="Hướng dẫn sử dụng &amp; Thông tin phiên bản">
                                                                <TabItem.Header>
                                                                    <StackPanel
                                                                        HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center"
                                                                        Orientation="Vertical">
                                                                        <TextBlock
                                                                            HorizontalAlignment="Center"
                                                                            VerticalAlignment="Center"
                                                                            FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=TabItem}}"
                                                                            Text="HDSD" />
                                                                        <Border
                                                                            Margin="0,1.5,0,0"
                                                                            Padding="4,0.5"
                                                                            HorizontalAlignment="Center"
                                                                            VerticalAlignment="Center"
                                                                            Background="#DC2626"
                                                                            BorderBrush="#B91C1C"
                                                                            BorderThickness="1"
                                                                            CornerRadius="2"
                                                                            Visibility="{Binding Guide.HasAppUpdate, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                            <TextBlock
                                                                                FontSize="7.5"
                                                                                FontWeight="ExtraBold"
                                                                                Foreground="#FFFFFF"
                                                                                Text="MỚI" />
                                                                        </Border>
                                                                    </StackPanel>
                                                                </TabItem.Header>
                                                                <views:GuideTabView DataContext="{Binding Guide}" />
                                                            </TabItem>

                                                            <TabItem Header="GÓP Ý" Style="{StaticResource GameTabItemStyle}" ToolTip="Góp ý tính năng &amp; Báo lỗi phần mềm">
                                                                <views:FeedbackView DataContext="{Binding Feedback}" />
                                                            </TabItem>
                                                        </TabControl>
                                                    </Border>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>

                            <views:AppStatusBarView Grid.Row="2" DataContext="{Binding StatusBar}" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>
