<Window
    x:Class="DragonBoyAccountManager.GUI.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="clr-namespace:DragonBoyAccountManager.GUI.ViewModels"
    xmlns:views="clr-namespace:DragonBoyAccountManager.GUI.Views"
    Title="Dragon Boy Account Manager"
    Width="1180"
    Height="640"
    MinWidth="1180"
    MinHeight="640"
    MaxWidth="1180"
    MaxHeight="640"
    ResizeMode="CanMinimize"
    d:DataContext="{d:DesignInstance Type=viewmodels:MainViewModel}"
    AllowsTransparency="True"
    Background="Transparent"
    FontFamily="Segoe UI, Tahoma, Arial"
    Icon="/Assets/app_icon.png"
    SnapsToDevicePixels="True"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType"
    UseLayoutRounding="True"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="277*" />
            <RowDefinition Height="43*" />
        </Grid.RowDefinitions>
        <Border
            Grid.RowSpan="2"
            Margin="3,6,3,2"
            Background="#261302"
            CornerRadius="10" />

        <Border
            Grid.RowSpan="2"
            Margin="3,2,3,6"
            Padding="1.8"
            Background="{DynamicResource GameBorderBrush}"
            CornerRadius="9"
            SnapsToDevicePixels="True">

            <Border
                Padding="0"
                Background="{DynamicResource GameBgAltBrush}"
                BorderBrush="{DynamicResource GamePanelHighlightBrush}"
                BorderThickness="1.5,1.5,1,0"
                CornerRadius="7.5">
                <Grid>
                    <Border
                        Height="3"
                        VerticalAlignment="Bottom"
                        Background="{DynamicResource GamePanelShadowBrush}"
                        CornerRadius="0,0,7,7" />

                    <Border
                        Margin="1,1,1,2"
                        Background="{DynamicResource GameBgBrush}"
                        BorderBrush="{DynamicResource GameBorderBrush}"
                        BorderThickness="1.5"
                        CornerRadius="6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="38" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="34" />
                            </Grid.RowDefinitions>

                            <!-- ==================== 1. THANH TIÊU ĐỀ (TITLE BAR) ==================== -->
                            <views:AppTitleBarView Grid.Row="0" />

                            <!-- ==================== 2. NỘI DUNG CHÍNH (MAIN CONTENT) ==================== -->
                            <Border Grid.Row="1" Background="{DynamicResource GameBgBrush}">
                                <Grid>
                                    <Border
                                        Height="3"
                                        VerticalAlignment="Top"
                                        Background="{DynamicResource GamePanelShadowBrush}" />
                                    <Grid Margin="10,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="455" />
                                        </Grid.ColumnDefinitions>

                                        <!-- ========== CỘT TRÁI: DANH SÁCH TÀI KHOẢN ========== -->
                                        <views:AccountsPanelView Grid.Column="0" DataContext="{Binding AccountsPanel}" />

                                        <!-- ========== CỘT PHẢI: BẢNG CẤU HÌNH ========== -->
                                        <Border
                                            Grid.Column="2"
                                            Background="{DynamicResource GameBgLightBrush}"
                                            BorderBrush="{DynamicResource GameBorderBrush}"
                                            BorderThickness="2"
                                            CornerRadius="7"
                                            SnapsToDevicePixels="True">
                                            <Grid>
                                                <Border
                                                    Height="6"
                                                    VerticalAlignment="Top"
                                                    Background="{DynamicResource GamePanelHighlightBrush}"
                                                    CornerRadius="5,5,0,0" />
                                                <Border
                                                    Height="3"
                                                    VerticalAlignment="Bottom"
                                                    Background="{DynamicResource GamePanelShadowBrush}"
                                                    CornerRadius="0,0,5,5" />

                                                <Grid Margin="10,8">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                    </Grid.RowDefinitions>

                                                    <Border
                                                        Grid.Row="0"
                                                        Height="32"
                                                        Margin="0,0,0,10"
                                                        Background="{DynamicResource GameHeaderBrush}"
                                                        BorderBrush="{DynamicResource GameBorderBrush}"
                                                        BorderThickness="1.5"
                                                        CornerRadius="5">
                                                        <TextBlock
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            FontSize="12.5"
                                                            FontWeight="ExtraBold"
                                                            Foreground="{DynamicResource GameTextDarkBrush}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="CẤU HÌNH CHO TÀI KHOẢN" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding AccountForm.IsEditing}" Value="False">
                                                                            <Setter Property="Text" Value="THÊM TÀI KHOẢN MỚI" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding SelectedIndex, ElementName=ConfigTabControl}" Value="1">
                                                                            <Setter Property="Text" Value="TIỆN ÍCH BẢN ĐỒ &amp; ĐỔI KHU" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding SelectedIndex, ElementName=ConfigTabControl}" Value="2">
                                                                            <Setter Property="Text" Value="CẤU HÌNH HỆ THỐNG" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding SelectedIndex, ElementName=ConfigTabControl}" Value="3">
                                                                            <Setter Property="Text" Value="HƯỚNG DẪN &amp; CẬP NHẬT PHIÊN BẢN" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>

                                                    <Border
                                                        Grid.Row="1"
                                                        Background="{DynamicResource GameTabContentBrush}"
                                                        BorderBrush="{DynamicResource GameBorderBrush}"
                                                        BorderThickness="2"
                                                        CornerRadius="5"
                                                        SnapsToDevicePixels="True">
                                                        <TabControl
                                                            x:Name="ConfigTabControl"
                                                            SelectedIndex="{Binding SelectedTabIndex}"
                                                            Style="{StaticResource GameTabControlStyle}">

                                                            <!-- TAB 1: CẤU HÌNH TÀI KHOẢN & ĐIỀU KHIỂN NHANH -->
                                                            <TabItem Header="TÀI KHOẢN" Style="{StaticResource GameTabItemStyle}">
                                                                <views:AccountConfigTabView DataContext="{Binding AccountForm}" />
                                                            </TabItem>

                                                            <!-- TAB 2: TIỆN ÍCH -->
                                                            <TabItem Header="TIỆN ÍCH" Style="{StaticResource GameTabItemStyle}">
                                                                <views:UtilitiesTabView DataContext="{Binding UtilitiesTab}" />
                                                            </TabItem>

                                                            <!-- TAB 3: CẤU HÌNH HỆ THỐNG -->
                                                            <TabItem Header="CÀI ĐẶT" Style="{StaticResource GameTabItemStyle}">
                                                                <views:SettingsTabView DataContext="{Binding Settings}" />
                                                            </TabItem>

                                                            <!-- TAB 4: HƯỚNG DẪN & THÔNG TIN PHIÊN BẢN -->
                                                            <TabItem Header="HƯỚNG DẪN" Style="{StaticResource GameTabItemStyle}">
                                                                <views:GuideTabView DataContext="{Binding Guide}" />
                                                            </TabItem>
                                                        </TabControl>
                                                    </Border>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- ==================== 3. THANH TRẠNG THÁI DƯỚI CÙNG (STATUS BAR) ==================== -->
                            <views:AppStatusBarView Grid.Row="2" DataContext="{Binding StatusBar}" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>
