<UserControl
    x:Class="DragonBoyAccountManager.GUI.Views.GuideTabView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="clr-namespace:DragonBoyAccountManager.GUI.UI.Converters"
    xmlns:helpers="clr-namespace:DragonBoyAccountManager.GUI.Helpers"
    xmlns:ui="clr-namespace:DragonBoyAccountManager.GUI.UI.Controls"
    xmlns:viewmodels="clr-namespace:DragonBoyAccountManager.GUI.ViewModels"
    xmlns:views="clr-namespace:DragonBoyAccountManager.GUI.Views"
    d:DataContext="{d:DesignInstance Type=viewmodels:GuideViewModel}"
    d:DesignHeight="600"
    d:DesignWidth="435"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:ClientStatusToBrushConverter x:Key="ClientStatusToBrushConverter" />
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <ScrollViewer
        FocusVisualStyle="{x:Null}"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10,8,10,14">
            <ui:GameCard
                Margin="0,0,0,10"
                Header="THÔNG TIN &amp; PHIÊN BẢN">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="95" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="11"
                            FontWeight="Bold"
                            Foreground="{DynamicResource GameTextMutedBrush}"
                            Text="Tool quản lý:" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="11.5"
                                FontWeight="ExtraBold"
                                Foreground="{DynamicResource GameGreenBrush}"
                                Text="{Binding AppVersion, StringFormat='v{0}'}" />
                            <Border
                                Margin="8,0,0,0"
                                Padding="6,1.5"
                                Background="#FEF3C7"
                                BorderBrush="#D97706"
                                BorderThickness="1"
                                CornerRadius="3"
                                Visibility="{Binding HasAppUpdate, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock
                                    FontSize="10"
                                    FontWeight="Bold"
                                    Foreground="#B45309"
                                    Text="{Binding AvailableAppUpdate.Version, StringFormat='Mới: v{0}'}" />
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="95" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="11"
                            FontWeight="Bold"
                            Foreground="{DynamicResource GameTextMutedBrush}"
                            Text="Trạng thái:" />
                        <ui:GameBadge
                            Grid.Column="1"
                            HorizontalAlignment="Left"
                            Padding="6,2"
                            Background="{Binding Status, Converter={StaticResource ClientStatusToBrushConverter}, ConverterParameter=Background}"
                            BorderBrush="{Binding Status, Converter={StaticResource ClientStatusToBrushConverter}}"
                            ToolTip="{Binding AssemblyStatusTooltip}">
                            <TextBlock
                                FontSize="10"
                                FontWeight="Bold"
                                Foreground="{Binding Status, Converter={StaticResource ClientStatusToBrushConverter}}"
                                Text="{Binding AssemblyStatus}"
                                TextTrimming="CharacterEllipsis" />
                        </ui:GameBadge>
                    </Grid>

                    <!-- Update Available Box with Scrollable Release Notes -->
                    <Border
                        Margin="0,4,0,8"
                        Padding="10,9"
                        Background="#FFFBEB"
                        BorderBrush="#F59E0B"
                        BorderThickness="1.5"
                        CornerRadius="5"
                        Visibility="{Binding HasAppUpdate, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock
                                        FontSize="11.5"
                                        FontWeight="ExtraBold"
                                        Foreground="#B45309"
                                        Text="{Binding AvailableAppUpdate.Version, StringFormat='[MỚI] CÓ BẢN MỚI: v{0}'}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Margin="0,2,0,0"
                                        FontSize="10"
                                        FontWeight="SemiBold"
                                        Foreground="#92400E"
                                        Text="Nội dung cập nhật mới:"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <Button
                                    Grid.Column="1"
                                    Height="28"
                                    Margin="8,0,0,0"
                                    Padding="12,0"
                                    VerticalAlignment="Center"
                                    Command="{Binding ApplyAppUpdateCommand}"
                                    Content="Cập nhật ngay"
                                    FontSize="11"
                                    FontWeight="Bold"
                                    Style="{StaticResource GamePrimaryButton}"
                                    IsEnabled="{Binding CanApplyUpdate}" />
                            </Grid>

                            <!-- Scrollable New Version Release Notes -->
                            <Border
                                Background="#FEF3C7"
                                BorderBrush="#FDE68A"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="8,6">
                                <ScrollViewer
                                    MaxHeight="140"
                                    FocusVisualStyle="{x:Null}"
                                    HorizontalScrollBarVisibility="Disabled"
                                    VerticalScrollBarVisibility="Auto">
                                    <TextBlock
                                        helpers:MarkdownHelper.Markdown="{Binding AvailableAppUpdate.ReleaseNotes}"
                                        FontSize="11"
                                        LineHeight="17"
                                        TextWrapping="Wrap" />
                                </ScrollViewer>
                            </Border>

                            <!-- Progress Bar when downloading -->
                            <StackPanel
                                Margin="0,6,0,0"
                                Visibility="{Binding IsUpdatingApp, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ProgressBar
                                    Height="11"
                                    Minimum="0"
                                    Maximum="100"
                                    Value="{Binding UpdateProgress}"
                                    Foreground="{DynamicResource GameGreenBrush}" />
                                <TextBlock
                                    Margin="0,3,0,0"
                                    HorizontalAlignment="Right"
                                    FontSize="10"
                                    FontWeight="Bold"
                                    Foreground="#B45309"
                                    Text="{Binding AppUpdateStatusText}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock
                        Margin="0,2,0,8"
                        FontSize="11"
                        Foreground="{DynamicResource GameTextMutedBrush}"
                        Text="{Binding UpdateStatusMessage}"
                        TextWrapping="Wrap" />

                    <StackPanel Margin="0,2,0,0" Orientation="Horizontal">
                        <Button
                            Height="28"
                            MinWidth="0"
                            Padding="12,0"
                            Margin="0,0,8,0"
                            Command="{Binding CheckForUpdatesCommand}"
                            Content="Kiểm tra phiên bản"
                            FontSize="11"
                            Style="{StaticResource GamePrimaryButton}" />
                        <Button
                            Height="28"
                            MinWidth="0"
                            Padding="12,0"
                            Command="{Binding OpenGameFolderCommand}"
                            Content="Thư mục game"
                            FontSize="11"
                            Style="{StaticResource GameSecondaryButton}" />
                    </StackPanel>
                </StackPanel>
            </ui:GameCard>

            <!-- Card 2: GÓP Ý & BÁO CÁO LỖI -->
            <views:FeedbackView Margin="0,0,0,10" DataContext="{Binding Feedback}" />

            <!-- Card 3: NHẬT KÝ & CHI TIẾT CẬP NHẬT PHIÊN BẢN -->
            <ui:GameCard
                Margin="0,0,0,10"
                Header="NHẬT KÝ CẬP NHẬT PHIÊN BẢN">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock
                                FontSize="11"
                                FontWeight="Bold"
                                Foreground="{DynamicResource GameTextMutedBrush}"
                                Text="Phiên bản: " />
                            <TextBlock
                                FontSize="11.5"
                                FontWeight="ExtraBold"
                                Foreground="{DynamicResource GameGreenBrush}"
                                Text="{Binding AppVersion, StringFormat='v{0}'}" />
                        </StackPanel>
                        <TextBlock
                            Grid.Column="1"
                            Margin="6,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="10"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource GameTextMutedBrush}"
                            Text="(Cuộn xem thêm)"
                            ToolTip="Cuộn chuột để xem toàn bộ nội dung nhật ký" />
                    </Grid>

                    <Border
                        Background="#FFFFFF"
                        BorderBrush="{DynamicResource GameBorderBrush}"
                        BorderThickness="1.2"
                        CornerRadius="4"
                        Padding="10,8">
                        <ScrollViewer
                            MaxHeight="260"
                            FocusVisualStyle="{x:Null}"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                            <TextBlock
                                helpers:MarkdownHelper.Markdown="{Binding ReleaseNotes}"
                                FontSize="11"
                                LineHeight="18"
                                TextWrapping="Wrap" />
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </ui:GameCard>

            <ui:GameCard Margin="0,0,0,4" Header="HƯỚNG DẪN SỬ DỤNG NHANH">
                <StackPanel>
                    <StackPanel Margin="0,0,0,6">
                        <TextBlock
                            FontSize="11.5"
                            FontWeight="Bold"
                            Foreground="{DynamicResource GameTextDarkBrush}"
                            Text="1. Cài đặt đường dẫn game" />
                        <TextBlock
                            Margin="10,2,0,0"
                            FontSize="11"
                            Foreground="{DynamicResource GameTextMutedBrush}"
                            Text="Bấm nút 'Chọn file...' ở thanh đáy cửa sổ để chọn tệp thực thi (.exe) của game."
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Margin="0,0,0,6">
                        <TextBlock
                            FontSize="11.5"
                            FontWeight="Bold"
                            Foreground="{DynamicResource GameTextDarkBrush}"
                            Text="2. Thêm &amp; Lưu tài khoản" />
                        <TextBlock
                            Margin="10,2,0,0"
                            FontSize="11"
                            Foreground="{DynamicResource GameTextMutedBrush}"
                            Text="Nhập Tên tài khoản, Mật khẩu (bấm nút Hiện/Ẩn mật khẩu để xem), chọn Máy chủ rồi bấm LƯU."
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Margin="0,0,0,6">
                        <TextBlock
                            FontSize="11.5"
                            FontWeight="Bold"
                            Foreground="{DynamicResource GameTextDarkBrush}"
                            Text="3. Bật / Tắt game" />
                        <TextBlock
                            Margin="10,2,0,0"
                            FontSize="11"
                            Foreground="{DynamicResource GameTextMutedBrush}"
                            Text="• Nhấp đúp chuột (Double-Click) vào dòng tài khoản để Mở game hoặc Đóng game tức thì."
                            TextWrapping="Wrap" />
                        <TextBlock
                            Margin="10,2,0,0"
                            FontSize="11"
                            Foreground="{DynamicResource GameTextMutedBrush}"
                            Text="• Hoặc nhấp chuột phải vào dòng tài khoản để mở Menu thao tác nhanh."
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Margin="0,0,0,2">
                        <TextBlock
                            FontSize="11.5"
                            FontWeight="Bold"
                            Foreground="{DynamicResource GameTextDarkBrush}"
                            Text="4. Điều khiển &amp; Chỉnh tốc độ" />
                        <TextBlock
                            Margin="10,2,0,0"
                            FontSize="11"
                            Foreground="{DynamicResource GameTextMutedBrush}"
                            Text="Sử dụng thanh kéo tốc độ (0.1x - 5.0x) và cụm phím điều hướng (Lên/Xuống/Trái/Phải/Chọn) tại tab TÀI KHOẢN để tương tác trực tiếp với game."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </ui:GameCard>
        </StackPanel>
    </ScrollViewer>
</UserControl>
