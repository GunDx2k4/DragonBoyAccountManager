<UserControl
    x:Class="DragonBoyAccountManager.GUI.Views.GuideTabView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="clr-namespace:DragonBoyAccountManager.GUI.UI.Converters"
    xmlns:ui="clr-namespace:DragonBoyAccountManager.GUI.UI.Controls"
    xmlns:viewmodels="clr-namespace:DragonBoyAccountManager.GUI.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodels:GuideViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="435"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:ClientStatusToBrushConverter x:Key="ClientStatusToBrushConverter" />
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <ScrollViewer FocusVisualStyle="{x:Null}" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12,10">
            <ui:GameCard
                Margin="0,0,0,10"
                Header="THÔNG TIN &amp; PHIÊN BẢN">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="105" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="11"
                            FontWeight="Bold"
                            Foreground="{DynamicResource GameTextMutedBrush}"
                            Text="Tool quản lý:" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="11.5"
                                FontWeight="ExtraBold"
                                Foreground="{DynamicResource GameGreenBrush}"
                                Text="{Binding AppVersion, StringFormat='v{0}'}" />
                            <Border
                                Margin="8,0,0,0"
                                Padding="6,1.5"
                                Background="#FEF3C7"
                                BorderBrush="#D97706"
                                BorderThickness="1"
                                CornerRadius="3"
                                Visibility="{Binding HasAppUpdate, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock
                                    FontSize="10"
                                    FontWeight="Bold"
                                    Foreground="#B45309"
                                    Text="{Binding AvailableAppUpdate.Version, StringFormat='Mới: v{0}'}" />
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="105" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="11"
                            FontWeight="Bold"
                            Foreground="{DynamicResource GameTextMutedBrush}"
                            Text="Trạng thái Client:" />
                        <ui:GameBadge
                            Grid.Column="1"
                            Padding="6,2"
                            Background="{Binding Status, Converter={StaticResource ClientStatusToBrushConverter}, ConverterParameter=Background}"
                            BorderBrush="{Binding Status, Converter={StaticResource ClientStatusToBrushConverter}}"
                            ToolTip="{Binding AssemblyStatusTooltip}">
                            <TextBlock
                                FontSize="10.5"
                                FontWeight="Bold"
                                Foreground="{Binding Status, Converter={StaticResource ClientStatusToBrushConverter}}"
                                Text="{Binding AssemblyStatus}" />
                        </ui:GameBadge>
                    </Grid>

                    <!-- Update Available Box -->
                    <Border
                        Margin="0,2,0,8"
                        Padding="9,7"
                        Background="#FFFBEB"
                        BorderBrush="#F59E0B"
                        BorderThickness="1"
                        CornerRadius="4"
                        Visibility="{Binding HasAppUpdate, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock
                                        FontSize="11"
                                        FontWeight="Bold"
                                        Foreground="#B45309"
                                        Text="★ ĐÃ CÓ BẢN CẬP NHẬT MỚI" />
                                    <TextBlock
                                        Margin="0,2,0,0"
                                        FontSize="10.5"
                                        Foreground="#78350F"
                                        Text="{Binding AvailableAppUpdate.ReleaseNotes}"
                                        TextWrapping="Wrap"
                                        MaxHeight="60" />
                                </StackPanel>
                                <Button
                                    Grid.Column="1"
                                    Height="26"
                                    Margin="8,0,0,0"
                                    Padding="10,0"
                                    VerticalAlignment="Center"
                                    Command="{Binding ApplyAppUpdateCommand}"
                                    Content="Cập nhật ngay"
                                    FontSize="10.5"
                                    FontWeight="Bold"
                                    Style="{StaticResource GamePrimaryButton}"
                                    IsEnabled="{Binding CanApplyUpdate}" />
                            </Grid>

                            <!-- Progress Bar when downloading -->
                            <StackPanel
                                Margin="0,6,0,0"
                                Visibility="{Binding IsUpdatingApp, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ProgressBar
                                    Height="10"
                                    Minimum="0"
                                    Maximum="100"
                                    Value="{Binding UpdateProgress}"
                                    Foreground="{DynamicResource GameGreenBrush}" />
                                <TextBlock
                                    Margin="0,3,0,0"
                                    HorizontalAlignment="Right"
                                    FontSize="10"
                                    FontWeight="Bold"
                                    Foreground="#B45309"
                                    Text="{Binding AppUpdateStatusText}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock
                        Margin="0,2,0,8"
                        FontSize="11"
                        Foreground="{DynamicResource GameTextMutedBrush}"
                        Text="{Binding UpdateStatusMessage}"
                        TextWrapping="Wrap" />

                    <StackPanel Margin="0,2,0,0" Orientation="Horizontal">
                        <Button
                            Height="28"
                            MinWidth="120"
                            Margin="0,0,8,0"
                            Command="{Binding CheckForUpdatesCommand}"
                            Content="Kiểm tra phiên bản"
                            FontSize="11"
                            Style="{StaticResource GamePrimaryButton}" />
                        <Button
                            Height="28"
                            MinWidth="95"
                            Command="{Binding OpenGameFolderCommand}"
                            Content="Thư mục game"
                            FontSize="11"
                            Style="{StaticResource GameSecondaryButton}" />
                    </StackPanel>
                </StackPanel>
            </ui:GameCard>

            <ui:GameCard Header="HƯỚNG DẪN SỬ DỤNG NHANH">
                <StackPanel>
                    <StackPanel Margin="0,0,0,6">
                        <TextBlock
                            FontSize="11.5"
                            FontWeight="Bold"
                            Foreground="{DynamicResource GameTextDarkBrush}"
                            Text="1. Cài đặt đường dẫn game" />
                        <TextBlock
                            Margin="10,2,0,0"
                            FontSize="11"
                            Foreground="{DynamicResource GameTextMutedBrush}"
                            Text="Bấm nút 'Chọn file...' ở thanh đáy cửa sổ để chọn tệp thực thi (.exe) của game."
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Margin="0,0,0,6">
                        <TextBlock
                            FontSize="11.5"
                            FontWeight="Bold"
                            Foreground="{DynamicResource GameTextDarkBrush}"
                            Text="2. Thêm &amp; Lưu tài khoản" />
                        <TextBlock
                            Margin="10,2,0,0"
                            FontSize="11"
                            Foreground="{DynamicResource GameTextMutedBrush}"
                            Text="Nhập Tên tài khoản, Mật khẩu (bấm nút 👁 để xem), chọn Máy chủ rồi bấm LƯU."
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Margin="0,0,0,6">
                        <TextBlock
                            FontSize="11.5"
                            FontWeight="Bold"
                            Foreground="{DynamicResource GameTextDarkBrush}"
                            Text="3. Bật / Tắt game" />
                        <TextBlock
                            Margin="10,2,0,0"
                            FontSize="11"
                            Foreground="{DynamicResource GameTextMutedBrush}"
                            Text="• Nhấp đúp chuột (Double-Click) vào dòng tài khoản để Mở game hoặc Đóng game tức thì."
                            TextWrapping="Wrap" />
                        <TextBlock
                            Margin="10,2,0,0"
                            FontSize="11"
                            Foreground="{DynamicResource GameTextMutedBrush}"
                            Text="• Hoặc nhấp chuột phải vào dòng tài khoản để mở Menu thao tác nhanh."
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Margin="0,0,0,2">
                        <TextBlock
                            FontSize="11.5"
                            FontWeight="Bold"
                            Foreground="{DynamicResource GameTextDarkBrush}"
                            Text="4. Điều khiển &amp; Chỉnh tốc độ" />
                        <TextBlock
                            Margin="10,2,0,0"
                            FontSize="11"
                            Foreground="{DynamicResource GameTextMutedBrush}"
                            Text="Sử dụng thanh kéo tốc độ (0.1x - 5.0x) và cụm phím điều hướng (Lên/Xuống/Trái/Phải/Chọn) tại tab TÀI KHOẢN để tương tác trực tiếp với game."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </ui:GameCard>
        </StackPanel>
    </ScrollViewer>
</UserControl>
