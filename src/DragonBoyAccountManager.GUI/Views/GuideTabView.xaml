<UserControl
    x:Class="DragonBoyAccountManager.GUI.Views.GuideTabView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="clr-namespace:DragonBoyAccountManager.GUI.UI.Converters"
    xmlns:assists="clr-namespace:DragonBoyAccountManager.GUI.UI.Assists"
    xmlns:ui="clr-namespace:DragonBoyAccountManager.GUI.UI.Controls"
    xmlns:viewmodels="clr-namespace:DragonBoyAccountManager.GUI.ViewModels"
    xmlns:views="clr-namespace:DragonBoyAccountManager.GUI.Views"
    d:DataContext="{d:DesignInstance Type=viewmodels:GuideViewModel}"
    d:DesignHeight="600"
    d:DesignWidth="435"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:ClientStatusToBrushConverter x:Key="ClientStatusToBrushConverter" />
    </UserControl.Resources>

    <ScrollViewer
        FocusVisualStyle="{x:Null}"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10,8,10,14">
            <ui:GameCard
                Margin="0,0,0,10"
                Header="THÔNG TIN &amp; PHIÊN BẢN">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="95" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="11"
                            FontWeight="Bold"
                            Foreground="{DynamicResource GameTextMutedBrush}"
                            Text="Tool quản lý:" />
                        <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="11.5"
                                FontWeight="ExtraBold"
                                Foreground="{DynamicResource GameTextGreenBrush}"
                                Text="{Binding AppVersion, StringFormat='v{0}'}" />
                            <Border
                                Margin="8,1,0,1"
                                Padding="6,1.5"
                                VerticalAlignment="Center"
                                Background="{DynamicResource GameBgAltBrush}"
                                BorderBrush="{DynamicResource GameBorderHighlightBrush}"
                                BorderThickness="1"
                                CornerRadius="3"
                                Visibility="{Binding HasAppUpdate, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock
                                    FontSize="10"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource GameTextDarkBrush}"
                                    Text="{Binding AvailableAppUpdate.Version, StringFormat='Mới: v{0}'}" />
                            </Border>
                        </WrapPanel>
                    </Grid>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="95" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="11"
                            FontWeight="Bold"
                            Foreground="{DynamicResource GameTextMutedBrush}"
                            Text="Trạng thái:" />
                        <ui:GameBadge
                            Grid.Column="1"
                            HorizontalAlignment="Left"
                            Padding="6,2"
                            Background="{Binding Status, Converter={StaticResource ClientStatusToBrushConverter}, ConverterParameter=Background}"
                            BorderBrush="{Binding Status, Converter={StaticResource ClientStatusToBrushConverter}}"
                            ToolTip="{Binding AssemblyStatusTooltip}">
                            <TextBlock
                                FontSize="10"
                                FontWeight="Bold"
                                Foreground="{Binding Status, Converter={StaticResource ClientStatusToBrushConverter}}"
                                Text="{Binding AssemblyStatus}"
                                TextTrimming="CharacterEllipsis" />
                        </ui:GameBadge>
                    </Grid>

                    <Border
                        Margin="0,4,0,8"
                        Padding="10,9"
                        Background="{DynamicResource GameBgAltBrush}"
                        BorderBrush="{DynamicResource GameBorderBrush}"
                        BorderThickness="1.5"
                        CornerRadius="5"
                        Visibility="{Binding HasAppUpdate, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock
                                        FontSize="11.5"
                                        FontWeight="ExtraBold"
                                        Foreground="{DynamicResource GameTextRedBrush}"
                                        Text="{Binding AvailableAppUpdate.Version, StringFormat='[MỚI] CÓ BẢN MỚI: v{0}'}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Margin="0,2,0,0"
                                        FontSize="10"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource GameTextDarkBrush}"
                                        Text="Nội dung cập nhật mới:"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <Button
                                    Grid.Column="1"
                                    Height="28"
                                    Margin="8,0,0,0"
                                    Padding="12,0"
                                    VerticalAlignment="Center"
                                    Command="{Binding ApplyAppUpdateCommand}"
                                    Content="Cập nhật ngay"
                                    FontSize="11"
                                    FontWeight="Bold"
                                    Style="{StaticResource GamePrimaryButton}"
                                    IsEnabled="{Binding CanApplyUpdate}" />
                            </Grid>

                            <Border
                                Background="{DynamicResource GameBgLightBrush}"
                                BorderBrush="{DynamicResource GameBorderHighlightBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="8,6">
                                <ScrollViewer
                                    MaxHeight="140"
                                    FocusVisualStyle="{x:Null}"
                                    HorizontalScrollBarVisibility="Disabled"
                                    VerticalScrollBarVisibility="Auto">
                                    <TextBlock
                                        assists:MarkdownAssist.Markdown="{Binding AvailableAppUpdate.ReleaseNotes}"
                                        FontSize="11"
                                        LineHeight="17"
                                        TextWrapping="Wrap" />
                                </ScrollViewer>
                            </Border>

                            <StackPanel
                                Margin="0,6,0,0"
                                Visibility="{Binding IsUpdatingApp, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ProgressBar
                                    Height="11"
                                    Minimum="0"
                                    Maximum="100"
                                    Value="{Binding UpdateProgress}"
                                    Foreground="{DynamicResource GameGreenBrush}" />
                                <TextBlock
                                    Margin="0,3,0,0"
                                    HorizontalAlignment="Right"
                                    FontSize="10"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource GameTextDarkBrush}"
                                    Text="{Binding AppUpdateStatusText}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border
                        Margin="0,4,0,8"
                        Padding="10,9"
                        Background="{DynamicResource GameBgAltBrush}"
                        BorderBrush="{DynamicResource GameBorderBrush}"
                        BorderThickness="1.5"
                        CornerRadius="5"
                        Visibility="{Binding IsAssemblyMissing, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock
                                        FontSize="11.5"
                                        FontWeight="ExtraBold"
                                        Foreground="{DynamicResource GameTextRedBrush}"
                                        Text="[CẦN THIẾT LẬP] CHƯA KẾT NỐI FILE GAME"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Margin="0,2,0,0"
                                        FontSize="10"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource GameTextDarkBrush}"
                                        Text="Vui lòng thực hiện theo các bước sau để kết nối:"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <Button
                                    Grid.Column="1"
                                    Height="28"
                                    Margin="8,0,0,0"
                                    Padding="12,0"
                                    VerticalAlignment="Center"
                                    Command="{Binding BrowseGamePathCommand}"
                                    Content="Chọn file ngay"
                                    FontSize="11"
                                    FontWeight="Bold"
                                    Style="{StaticResource GamePrimaryButton}" />
                            </Grid>

                            <StackPanel Margin="2,2,0,0">
                                <TextBlock
                                    FontSize="10.5"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource GameTextDarkBrush}"
                                    LineHeight="16"
                                    Text="1. Tải bản game PC gốc 2.5.0 trực tiếp tại trang chủ (ngocrongonline.com) — KHÔNG dùng bản mod."
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    FontSize="10.5"
                                    Foreground="{DynamicResource GameTextDarkBrush}"
                                    LineHeight="16"
                                    Text="2. Giải nén thư mục game trên máy tính."
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    FontSize="10.5"
                                    Foreground="{DynamicResource GameTextDarkBrush}"
                                    LineHeight="16"
                                    Text="3. Bấm nút 'Chọn file ngay' ở trên rồi chọn file .exe của game."
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock
                        Margin="0,2,0,8"
                        FontSize="11"
                        Foreground="{DynamicResource GameTextMutedBrush}"
                        Text="{Binding UpdateStatusMessage}"
                        TextWrapping="Wrap" />

                    <StackPanel Margin="0,2,0,0" Orientation="Horizontal">
                        <Button
                            Height="28"
                            MinWidth="0"
                            Padding="12,0"
                            Margin="0,0,8,0"
                            Command="{Binding BrowseGamePathCommand}"
                            Content="Chọn file game"
                            FontSize="11"
                            Style="{StaticResource GamePrimaryButton}" />
                        <Button
                            Height="28"
                            MinWidth="0"
                            Padding="12,0"
                            Margin="0,0,8,0"
                            Command="{Binding CheckForUpdatesCommand}"
                            Content="Kiểm tra phiên bản"
                            FontSize="11"
                            Style="{StaticResource GameSecondaryButton}" />
                        <Button
                            Height="28"
                            MinWidth="0"
                            Padding="12,0"
                            Command="{Binding OpenGameFolderCommand}"
                            Content="Thư mục game"
                            FontSize="11"
                            Style="{StaticResource GameSecondaryButton}" />
                    </StackPanel>
                </StackPanel>
            </ui:GameCard>

            <ui:GameCard
                Margin="0,0,0,10"
                Header="HƯỚNG DẪN KẾT NỐI GAME">
                <StackPanel>
                    <Border
                        Margin="0,0,0,8"
                        Padding="10,8"
                        Background="{DynamicResource GameBgAltBrush}"
                        BorderBrush="{DynamicResource GameBorderBrush}"
                        BorderThickness="1.5"
                        CornerRadius="4">
                        <StackPanel>
                            <TextBlock
                                FontSize="11"
                                FontWeight="ExtraBold"
                                Foreground="{DynamicResource GameTextRedBrush}"
                                Text="LƯU Ý QUAN TRỌNG:" />
                            <TextBlock
                                Margin="0,3,0,0"
                                FontSize="10.5"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource GameTextDarkBrush}"
                                LineHeight="16"
                                Text="Chỉ sử dụng bản game PC gốc v2.5.0 tải tại trang chủ (ngocrongonline.com) — tuyệt đối KHÔNG dùng bản mod."
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <StackPanel Margin="0,0,0,6">
                        <TextBlock
                            FontSize="11.5"
                            FontWeight="Bold"
                            Foreground="{DynamicResource GameTextDarkBrush}"
                            Text="1. Tải và giải nén game" />
                        <TextBlock
                            Margin="10,2,0,0"
                            FontSize="11"
                            Foreground="{DynamicResource GameTextMutedBrush}"
                            Text="Tải bản game PC gốc 2.5.0 từ trang chủ rồi giải nén vào một thư mục trên máy tính."
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Margin="0,0,0,6">
                        <TextBlock
                            FontSize="11.5"
                            FontWeight="Bold"
                            Foreground="{DynamicResource GameTextDarkBrush}"
                            Text="2. Chọn file game (.exe)" />
                        <TextBlock
                            Margin="10,2,0,0"
                            FontSize="11"
                            Foreground="{DynamicResource GameTextMutedBrush}"
                            Text="Bấm nút 'Chọn file game (.exe)' bên dưới rồi trỏ đến file .exe của game."
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Margin="0,0,0,6">
                        <TextBlock
                            FontSize="11.5"
                            FontWeight="Bold"
                            Foreground="{DynamicResource GameTextDarkBrush}"
                            Text="3. Hoàn tất kết nối" />
                        <TextBlock
                            Margin="10,2,0,0"
                            FontSize="11"
                            Foreground="{DynamicResource GameTextMutedBrush}"
                            Text="Khi trạng thái hiển thị màu xanh là hoàn tất. Lúc này bạn có thể thêm tài khoản, mở game và sử dụng bình thường."
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                        <Button
                            Height="28"
                            MinWidth="0"
                            Padding="12,0"
                            Margin="0,0,8,0"
                            Command="{Binding BrowseGamePathCommand}"
                            Content="Chọn file game (.exe)"
                            FontSize="11"
                            Style="{StaticResource GamePrimaryButton}" />
                        <Button
                            Height="28"
                            MinWidth="0"
                            Padding="12,0"
                            Command="{Binding OpenGameFolderCommand}"
                            Content="Mở thư mục game"
                            FontSize="11"
                            Style="{StaticResource GameSecondaryButton}" />
                    </StackPanel>
                </StackPanel>
            </ui:GameCard>

            <ui:GameCard Margin="0,0,0,10" Header="HƯỚNG DẪN SỬ DỤNG NHANH">
                <StackPanel>
                    <StackPanel Margin="0,0,0,6">
                        <TextBlock
                            FontSize="11.5"
                            FontWeight="Bold"
                            Foreground="{DynamicResource GameTextDarkBrush}"
                            Text="1. Cài đặt đường dẫn game" />
                        <TextBlock
                            Margin="10,2,0,0"
                            FontSize="11"
                            Foreground="{DynamicResource GameTextMutedBrush}"
                            Text="Tải bản game PC gốc 2.5.0 tại trang chủ (ngocrongonline.com) — không cài bản mod. Bấm nút 'Chọn file...' ở thanh đáy cửa sổ để trỏ đến tệp thực thi (.exe) của game."
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Margin="0,0,0,6">
                        <TextBlock
                            FontSize="11.5"
                            FontWeight="Bold"
                            Foreground="{DynamicResource GameTextDarkBrush}"
                            Text="2. Thêm &amp; Lưu tài khoản" />
                        <TextBlock
                            Margin="10,2,0,0"
                            FontSize="11"
                            Foreground="{DynamicResource GameTextMutedBrush}"
                            Text="Nhập Tên tài khoản, Mật khẩu (bấm nút Hiện/Ẩn mật khẩu để xem), chọn Máy chủ rồi bấm LƯU."
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Margin="0,0,0,6">
                        <TextBlock
                            FontSize="11.5"
                            FontWeight="Bold"
                            Foreground="{DynamicResource GameTextDarkBrush}"
                            Text="3. Bật / Tắt game" />
                        <TextBlock
                            Margin="10,2,0,0"
                            FontSize="11"
                            Foreground="{DynamicResource GameTextMutedBrush}"
                            Text="• Nhấp đúp chuột (Double-Click) vào dòng tài khoản để Mở game hoặc Đóng game tức thì."
                            TextWrapping="Wrap" />
                        <TextBlock
                            Margin="10,2,0,0"
                            FontSize="11"
                            Foreground="{DynamicResource GameTextMutedBrush}"
                            Text="• Hoặc nhấp chuột phải vào dòng tài khoản để mở Menu thao tác nhanh."
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Margin="0,0,0,2">
                        <TextBlock
                            FontSize="11.5"
                            FontWeight="Bold"
                            Foreground="{DynamicResource GameTextDarkBrush}"
                            Text="4. Điều khiển &amp; Chỉnh tốc độ" />
                        <TextBlock
                            Margin="10,2,0,0"
                            FontSize="11"
                            Foreground="{DynamicResource GameTextMutedBrush}"
                            Text="Sử dụng thanh kéo tốc độ (0.1x - 5.0x) và cụm phím điều hướng (Lên/Xuống/Trái/Phải/Chọn) tại tab TÀI KHOẢN để tương tác trực tiếp với game."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </ui:GameCard>

            <ui:GameCard
                Margin="0,0,0,10"
                Header="BẢNG TRA CỨU PHÍM TẮT ĐIỀU KHIỂN">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,8"
                        FontSize="11"
                        Foreground="{DynamicResource GameTextMutedBrush}"
                        Text="Bạn có thể nhấn phím F12 tại bất kỳ màn hình nào để mở popup tra cứu nhanh."
                        TextWrapping="Wrap" />

                    <Border
                        Margin="0,0,0,6"
                        Padding="8,6"
                        Background="{DynamicResource GameBgBrush}"
                        BorderBrush="{DynamicResource GameBorderBrush}"
                        BorderThickness="1.5"
                        CornerRadius="5">
                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,4"
                                FontSize="10"
                                FontWeight="ExtraBold"
                                Foreground="{DynamicResource GameTextGreenBrush}"
                                Text="DI CHUYỂN &amp; KHU VỰC:" />
                            <TextBlock
                                Margin="4,0,0,2"
                                FontSize="10"
                                Foreground="{DynamicResource GameTextDarkBrush}"
                                Text="• W, A, S, D hoặc Mũi tên: Di chuyển 4 hướng (Giữ để chạy)" />
                            <TextBlock
                                Margin="4,0,0,0"
                                FontSize="10"
                                Foreground="{DynamicResource GameTextDarkBrush}"
                                Text="• Phím [ hoặc ]: Chuyển sang khu vực (zone) trước / kế tiếp" />
                        </StackPanel>
                    </Border>

                    <Border
                        Margin="0,0,0,6"
                        Padding="8,6"
                        Background="{DynamicResource GameBgBrush}"
                        BorderBrush="{DynamicResource GameBorderBrush}"
                        BorderThickness="1.5"
                        CornerRadius="5">
                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,4"
                                FontSize="10"
                                FontWeight="ExtraBold"
                                Foreground="{DynamicResource GameTextYellowBrush}"
                                Text="CHIẾN ĐẤU &amp; KỸ NĂNG:" />
                            <TextBlock
                                Margin="4,0,0,2"
                                FontSize="10"
                                Foreground="{DynamicResource GameTextDarkBrush}"
                                Text="• Enter: Chọn mục tiêu / Tấn công / Trò chuyện NPC" />
                            <TextBlock
                                Margin="4,0,0,2"
                                FontSize="10"
                                Foreground="{DynamicResource GameTextDarkBrush}"
                                Text="• Space: Dùng Đậu Thần hồi HP &amp; KI tức thì" />
                            <TextBlock
                                Margin="4,0,0,2"
                                FontSize="10"
                                Foreground="{DynamicResource GameTextDarkBrush}"
                                Text="• Q: Nhặt vật phẩm rơi quanh người" />
                            <TextBlock
                                Margin="4,0,0,2"
                                FontSize="10"
                                Foreground="{DynamicResource GameTextDarkBrush}"
                                Text="• Tab: Đổi mục tiêu sang quái hoặc người chơi khác" />
                            <TextBlock
                                Margin="4,0,0,0"
                                FontSize="10"
                                Foreground="{DynamicResource GameTextDarkBrush}"
                                Text="• 1 - 9, 0 (NumPad): Kích hoạt kỹ năng tại ô tương ứng" />
                        </StackPanel>
                    </Border>

                    <Border
                        Margin="0,0,0,6"
                        Padding="8,6"
                        Background="{DynamicResource GameBgBrush}"
                        BorderBrush="{DynamicResource GameBorderBrush}"
                        BorderThickness="1.5"
                        CornerRadius="5">
                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,4"
                                FontSize="10"
                                FontWeight="ExtraBold"
                                Foreground="{DynamicResource GameTextBlueBrush}"
                                Text="TIỆN ÍCH &amp; VẬT PHẨM:" />
                            <TextBlock
                                Margin="4,0,0,2"
                                FontSize="10"
                                Foreground="{DynamicResource GameTextDarkBrush}"
                                Text="• C: Dùng Capsule bay về nhà / các map (ID 193/194)" />
                            <TextBlock
                                Margin="4,0,0,2"
                                FontSize="10"
                                Foreground="{DynamicResource GameTextDarkBrush}"
                                Text="• X: Bật / Tắt Tự Động Luyện Tập (TDLT - ID 521)" />
                            <TextBlock
                                Margin="4,0,0,0"
                                FontSize="10"
                                Foreground="{DynamicResource GameTextDarkBrush}"
                                Text="• Shift + 2 (@) / - / + / . : Phím tắt nhanh bổ trợ" />
                        </StackPanel>
                    </Border>

                    <Border
                        Padding="8,6"
                        Background="{DynamicResource GameBgBrush}"
                        BorderBrush="{DynamicResource GameBorderBrush}"
                        BorderThickness="1.5"
                        CornerRadius="5">
                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,4"
                                FontSize="10"
                                FontWeight="ExtraBold"
                                Foreground="{DynamicResource GameTextDarkBrush}"
                                Text="HỆ THỐNG &amp; GIAO TIẾP:" />
                            <TextBlock
                                Margin="4,0,0,2"
                                FontSize="10"
                                Foreground="{DynamicResource GameTextDarkBrush}"
                                Text="• F1 / F2: Hiện (F1) hoặc Ẩn (F2) bảng điều khiển" />
                            <TextBlock
                                Margin="4,0,0,2"
                                FontSize="10"
                                Foreground="{DynamicResource GameTextDarkBrush}"
                                Text="• R: Mở khung nhập tin nhắn Chat" />
                            <TextBlock
                                Margin="4,0,0,2"
                                FontSize="10"
                                Foreground="{DynamicResource GameTextDarkBrush}"
                                Text="• Y: Đồng ý xác nhận hộp thoại" />
                            <TextBlock
                                Margin="4,0,0,2"
                                FontSize="10"
                                Foreground="{DynamicResource GameTextDarkBrush}"
                                Text="• Esc / Backspace: Đóng menu / Hủy bỏ / Quay lại" />
                            <TextBlock
                                Margin="4,0,0,0"
                                FontSize="10"
                                Foreground="{DynamicResource GameTextDarkBrush}"
                                Text="• F12: Mở bảng tra cứu phím tắt chi tiết" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ui:GameCard>

            <ui:GameCard
                Margin="0,0,0,4"
                Header="NHẬT KÝ CẬP NHẬT PHIÊN BẢN">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock
                                FontSize="11"
                                FontWeight="Bold"
                                Foreground="{DynamicResource GameTextMutedBrush}"
                                Text="Phiên bản: " />
                            <TextBlock
                                FontSize="11.5"
                                FontWeight="ExtraBold"
                                Foreground="{DynamicResource GameTextGreenBrush}"
                                Text="{Binding AppVersion, StringFormat='v{0}'}" />
                        </StackPanel>
                        <TextBlock
                            Grid.Column="1"
                            Margin="6,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="10"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource GameTextMutedBrush}"
                            Text="(Cuộn xem thêm)"
                            ToolTip="Cuộn chuột để xem toàn bộ nội dung nhật ký" />
                    </Grid>

                    <Border
                        Background="{DynamicResource GameBgLightBrush}"
                        BorderBrush="{DynamicResource GameBorderBrush}"
                        BorderThickness="1.2"
                        CornerRadius="4"
                        Padding="10,8">
                        <ScrollViewer
                            MaxHeight="260"
                            FocusVisualStyle="{x:Null}"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                            <TextBlock
                                assists:MarkdownAssist.Markdown="{Binding ReleaseNotes}"
                                FontSize="11"
                                LineHeight="18"
                                TextWrapping="Wrap" />
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </ui:GameCard>
        </StackPanel>
    </ScrollViewer>
</UserControl>
