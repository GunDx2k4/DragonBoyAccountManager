<UserControl
    x:Class="DragonBoyAccountManager.GUI.Presentation.Features.GameConfig.GameConfigTabView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:DragonBoyAccountManager.GUI.Presentation.DesignSystem.Controls"
    xmlns:viewmodels="clr-namespace:DragonBoyAccountManager.GUI.Presentation.Features.GameConfig"
    d:DataContext="{d:DesignInstance Type=viewmodels:GameConfigTabViewModel}"
    d:DesignHeight="550"
    d:DesignWidth="435"
    mc:Ignorable="d">

    <ScrollViewer FocusVisualStyle="{x:Null}" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12,10">

            <ui:GameCard Margin="0,0,0,10" Header="CẤU HÌNH ÂM THANH &amp; ĐỒ HỌA">
                <StackPanel>
                    <Border Style="{StaticResource GameSettingRowBorderStyle}">
                        <StackPanel>
                            <CheckBox
                                Content="Âm thanh game"
                                FontSize="11.5"
                                FontWeight="Bold"
                                IsChecked="{Binding IsPlaySound}"
                                Style="{StaticResource GameCheckBoxStyle}" />
                            <TextBlock
                                Margin="22,2,0,0"
                                FontSize="9.5"
                                Foreground="{DynamicResource GameTextMutedBrush}"
                                Style="{StaticResource GameCollapsibleDescriptionTextBlockStyle}"
                                Text="Bật hoặc tắt nhạc nền và hiệu ứng âm thanh trong game."
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GameSettingRowBorderStyle}">
                        <StackPanel>
                            <CheckBox
                                Content="Giảm đồ họa"
                                FontSize="11.5"
                                FontWeight="Bold"
                                IsChecked="{Binding LowGraphic}"
                                Style="{StaticResource GameCheckBoxStyle}" />
                            <TextBlock
                                Margin="22,2,0,0"
                                FontSize="9.5"
                                Foreground="{DynamicResource GameTextMutedBrush}"
                                Style="{StaticResource GameCollapsibleDescriptionTextBlockStyle}"
                                Text="Tắt hiệu ứng hình ảnh phụ giúp game mượt hơn và nhẹ máy."
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GameSettingRowBorderStyle}">
                        <StackPanel>
                            <TextBlock
                                FontSize="11"
                                FontWeight="Bold"
                                Foreground="{DynamicResource GameTextDarkBrush}"
                                Text="Kích thước cửa sổ và độ thu phóng" />
                            <TextBlock
                                Margin="0,1,0,4"
                                FontSize="9"
                                Foreground="{DynamicResource GameTextMutedBrush}"
                                Style="{StaticResource GameCollapsibleDescriptionTextBlockStyle}"
                                Text="Độ phân giải hiển thị và kích thước cửa sổ game khi khởi động."
                                TextWrapping="Wrap" />
                            <ComboBox
                                Height="28"
                                ItemsSource="{x:Static viewmodels:GameConfigTabViewModel.WindowSizeOptions}"
                                SelectedItem="{Binding SelectedSizeOption, UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource GameComboBoxStyle}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ui:GameCard>

            <ui:GameCard Margin="0,0,0,10" Header="HIỆU ỨNG &amp; THÔNG BÁO">
                <StackPanel>
                    <Border Style="{StaticResource GameSettingRowBorderStyle}">
                        <StackPanel>
                            <CheckBox
                                Content="Hiển thị hào quang nhân vật"
                                FontSize="11.5"
                                FontWeight="Bold"
                                IsChecked="{Binding IsPaintAura}"
                                Style="{StaticResource GameCheckBoxStyle}" />
                            <TextBlock
                                Margin="22,2,0,0"
                                FontSize="9.5"
                                Foreground="{DynamicResource GameTextMutedBrush}"
                                Style="{StaticResource GameCollapsibleDescriptionTextBlockStyle}"
                                Text="Hiển thị vòng sáng hào quang quanh nhân vật."
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GameSettingRowBorderStyle}">
                        <StackPanel>
                            <CheckBox
                                Content="Hiển thị hào quang phụ"
                                FontSize="11.5"
                                FontWeight="Bold"
                                IsChecked="{Binding IsPaintAura2}"
                                Style="{StaticResource GameCheckBoxStyle}" />
                            <TextBlock
                                Margin="22,2,0,0"
                                FontSize="9.5"
                                Foreground="{DynamicResource GameTextMutedBrush}"
                                Style="{StaticResource GameCollapsibleDescriptionTextBlockStyle}"
                                Text="Hiển thị hiệu ứng ánh sáng của trang bị hoặc danh hiệu."
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GameSettingRowBorderStyle}">
                        <StackPanel>
                            <CheckBox
                                Content="Khung chat VIP Server"
                                FontSize="11.5"
                                FontWeight="Bold"
                                IsChecked="{Binding IsPaintChatVip}"
                                Style="{StaticResource GameCheckBoxStyle}" />
                            <TextBlock
                                Margin="22,2,0,0"
                                FontSize="9.5"
                                Foreground="{DynamicResource GameTextMutedBrush}"
                                Style="{StaticResource GameCollapsibleDescriptionTextBlockStyle}"
                                Text="Hiển thị khung thông báo chat thế giới VIP phía trên màn hình."
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ui:GameCard>
        </StackPanel>
    </ScrollViewer>
</UserControl>
