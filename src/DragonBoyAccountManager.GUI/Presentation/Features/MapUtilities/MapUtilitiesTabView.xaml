<UserControl
    x:Class="DragonBoyAccountManager.GUI.Presentation.Features.MapUtilities.MapUtilitiesTabView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:DragonBoyAccountManager.Core.Telemetry.Snapshots;assembly=DragonBoyAccountManager.Core"
    xmlns:items="clr-namespace:DragonBoyAccountManager.GUI.Presentation.Features.MapUtilities.Items"
    xmlns:viewmodels="clr-namespace:DragonBoyAccountManager.GUI.Presentation.Features.MapUtilities"
    d:DataContext="{d:DesignInstance Type=viewmodels:MapUtilitiesTabViewModel}"
    d:DesignHeight="550"
    d:DesignWidth="435"
    mc:Ignorable="d">

    <Grid Margin="10,8">
        <Grid.RowDefinitions>

            <RowDefinition Height="Auto" />

            <RowDefinition Height="Auto" />

            <RowDefinition Height="Auto" />

            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Margin="0,0,0,8"
            Padding="8,7"
            Background="{DynamicResource GameBgBrush}"
            BorderBrush="{DynamicResource GameBorderBrush}"
            BorderThickness="1.5"
            CornerRadius="6">
            <StackPanel>

                <Grid Margin="0,0,0,6">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12"
                            FontWeight="ExtraBold"
                            Foreground="{DynamicResource GameTextYellowBrush}">
                            <Run Text="{Binding CurrentMapName, FallbackValue='Chưa vào game'}" />
                            <Run Foreground="{DynamicResource GameTextDarkBrush}" Text=" - Khu " />
                            <Run Text="{Binding CurrentZoneId, FallbackValue='-'}" />
                            <Run Foreground="{DynamicResource GameTextDarkBrush}" Text=" (" />
                            <Run Foreground="{DynamicResource GameTextDarkBrush}" Text="{Binding ZonePlayerDisplay, FallbackValue='0/15'}" />
                            <Run Foreground="{DynamicResource GameTextDarkBrush}" Text=")" />
                        </TextBlock>

                        <Border
                            Margin="8,0,0,0"
                            Padding="5,1"
                            VerticalAlignment="Center"
                            Background="{DynamicResource GameGreenBrush}"
                            CornerRadius="3"
                            ToolTip="Số tài khoản đang được đồng bộ theo danh sách tích chọn ở bảng tài khoản">
                            <TextBlock
                                FontSize="9"
                                FontWeight="ExtraBold"
                                Foreground="{DynamicResource GameTextLightBrush}"
                                Text="{Binding SyncTargetDisplay, FallbackValue='1 tài khoản'}" />
                        </Border>
                    </StackPanel>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        FontSize="11"
                        FontWeight="ExtraBold"
                        Foreground="{DynamicResource GameTextDarkBrush}"
                        Text="ĐỔI KHU:" />

                    <ComboBox
                        x:Name="ZoneComboBox"
                        Grid.Column="1"
                        Height="28"
                        DropDownOpened="ZoneComboBox_DropDownOpened"
                        ItemsSource="{Binding AvailableZones}"
                        SelectedItem="{Binding SelectedZone, Mode=TwoWay}"
                        Style="{StaticResource GameComboBoxStyle}"
                        ToolTip="Chọn khu từ danh sách để đổi khu ngay lập tức">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:WorldZoneInfo}">
                                <Grid Margin="2,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock
                                            FontSize="11"
                                            FontWeight="Bold"
                                            Foreground="{DynamicResource GameTextDarkBrush}"
                                            Text="{Binding ZoneId, StringFormat='Khu {0}'}" />
                                        <TextBlock
                                            Margin="6,0,0,0"
                                            FontSize="10"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource GameTextGreenBrush}"
                                            Text="{Binding NumPlayers, StringFormat='({0}'}" />
                                        <TextBlock
                                            FontSize="10"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource GameTextGreenBrush}"
                                            Text="{Binding MaxPlayers, StringFormat='/{0})'}" />
                                    </StackPanel>
                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="8,0,0,0"
                                        FontSize="9.5"
                                        FontWeight="ExtraBold"
                                        Foreground="{DynamicResource GameTextRedBrush}"
                                        Text="ĐẦY"
                                        VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFull}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <StackPanel
                        Grid.Column="2"
                        Margin="6,0,0,0"
                        Orientation="Horizontal">
                        <Button
                            Width="28"
                            Height="28"
                            Margin="0,0,4,0"
                            Command="{Binding PreviousZoneCommand}"
                            Style="{StaticResource GameSecondaryButton}"
                            ToolTip="Chuyển sang khu trước (Phím [)">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="{DynamicResource GameFont}"
                                FontSize="12"
                                FontWeight="ExtraBold"
                                Foreground="{DynamicResource GameBtnTanTextBrush}"
                                Text="&lt;" />
                        </Button>
                        <Button
                            Width="28"
                            Height="28"
                            Command="{Binding NextZoneCommand}"
                            Style="{StaticResource GameSecondaryButton}"
                            ToolTip="Chuyển sang khu kế tiếp (Phím ])">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="{DynamicResource GameFont}"
                                FontSize="12"
                                FontWeight="ExtraBold"
                                Foreground="{DynamicResource GameBtnTanTextBrush}"
                                Text="&gt;" />
                        </Button>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="0,0,0,7">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button
                Grid.Column="0"
                Height="32"
                Command="{Binding UseCapsuleCommand}"
                Style="{StaticResource GameSecondaryButton}"
                ToolTip="Sử dụng Capsule bay về nhà / các map (Phím tắt: C) - Tìm ID 194/193 trong túi">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" FontSize="11" FontWeight="ExtraBold" Foreground="{DynamicResource GameBtnTanTextBrush}" Text="Capsule" />
                    <Border Margin="5,0,0,0" Padding="4,1" VerticalAlignment="Center" Background="{DynamicResource GameBadgeShortcutBgBrush}" CornerRadius="3">
                        <TextBlock FontSize="9" FontWeight="ExtraBold" Foreground="{DynamicResource GameBadgeShortcutTextBrush}" Text="[C]" />
                    </Border>
                </StackPanel>
            </Button>

            <Button
                Grid.Column="2"
                Height="32"
                Command="{Binding UseTdltCommand}"
                Style="{StaticResource GameSecondaryButton}"
                ToolTip="Bật/Tắt Tự Động Luyện Tập (Phím tắt: X) - Tìm ID 521 trong túi">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" FontSize="11" FontWeight="ExtraBold" Foreground="{DynamicResource GameBtnTanTextBrush}" Text="TDLT" />
                    <Border Margin="5,0,0,0" Padding="4,1" VerticalAlignment="Center" Background="{DynamicResource GameBadgeShortcutBgBrush}" CornerRadius="3">
                        <TextBlock FontSize="9" FontWeight="ExtraBold" Foreground="{DynamicResource GameBadgeShortcutTextBrush}" Text="[X]" />
                    </Border>
                </StackPanel>
            </Button>
        </Grid>

        <StackPanel Grid.Row="2" Margin="0,0,0,8">
            <Grid Margin="2,0,2,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontSize="10"
                    FontWeight="ExtraBold"
                    Foreground="{DynamicResource GameTextDarkBrush}"
                    Text="DỊCH CHUYỂN NHANH" />

                <StackPanel
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <CheckBox
                        VerticalAlignment="Center"
                        Content="Tele nhanh"
                        FontSize="9.5"
                        FontWeight="Bold"
                        IsChecked="{Binding FastTeleport}"
                        Style="{StaticResource GameCheckBoxStyle}"
                        ToolTip="Dịch chuyển tức thời đến tọa độ đích" />
                </StackPanel>
            </Grid>

            <ItemsControl ItemsSource="{Binding WaypointButtons}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type items:WaypointButtonItem}">
                        <Button
                            Height="40"
                            MinWidth="0"
                            Margin="2,0"
                            Padding="4,2"
                            Command="{Binding DataContext.MoveToWaypointCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            Style="{StaticResource GamePrimaryButton}"
                            ToolTip="{Binding ToolTipText}">
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock
                                    Grid.Row="0"
                                    HorizontalAlignment="Center"
                                    FontSize="10.5"
                                    FontWeight="ExtraBold"
                                    Foreground="{DynamicResource GameTextLightBrush}"
                                    Text="{Binding Name}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTip="{Binding Name}" />

                                <Border
                                    Grid.Row="1"
                                    Margin="0,2,0,0"
                                    Padding="5,1"
                                    HorizontalAlignment="Center"
                                    Background="{DynamicResource GameBadgeShortcutBgBrush}"
                                    CornerRadius="3">
                                    <TextBlock
                                        FontSize="8.5"
                                        FontWeight="ExtraBold"
                                        Foreground="{DynamicResource GameBadgeShortcutTextBrush}"
                                        Text="{Binding DisplayCoordinates}" />
                                </Border>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <Border
            Grid.Row="3"
            Background="{DynamicResource GameTabContentBrush}"
            BorderBrush="{DynamicResource GameBorderBrush}"
            BorderThickness="1.5"
            CornerRadius="6">
            <TabControl Style="{StaticResource GameTabControlStyle}">

                <TabItem Style="{StaticResource GameTabItemStyle}" ToolTip="Boss và Người chơi trong khu">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="10" Text="BOSS/NGƯỜI (" />
                            <TextBlock FontSize="10" Foreground="{DynamicResource GameTextYellowBrush}" Text="{Binding BossCount}" TextTrimming="CharacterEllipsis" ToolTip="{Binding BossCount}" />
                            <TextBlock FontSize="10" Text="/" />
                            <TextBlock FontSize="10" Text="{Binding PlayerCount}" TextTrimming="CharacterEllipsis" ToolTip="{Binding PlayerCount}" />
                            <TextBlock FontSize="10" Text=")" />
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer FocusVisualStyle="{x:Null}" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="6,4">

                            <TextBlock
                                Margin="2,4,0,3"
                                FontSize="10.5"
                                FontWeight="ExtraBold"
                                Foreground="{DynamicResource GameTextYellowBrush}"
                                Text="DANH SÁCH BOSS:" />

                            <ItemsControl ItemsSource="{Binding Bosses}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:WorldBossInfo}">
                                        <Border
                                            Margin="0,1,0,3"
                                            Padding="6,4"
                                            Background="{DynamicResource GameBgBrush}"
                                            BorderBrush="{DynamicResource GameDangerBrush}"
                                            BorderThickness="1.2"
                                            CornerRadius="4"
                                            Cursor="Hand"
                                            MouseLeftButtonDown="EntityItem_MouseLeftButtonDown"
                                            ToolTip="Nhấn đúp chuột để chọn và click vào Boss này trong game">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock
                                                        FontSize="11.5"
                                                        FontWeight="ExtraBold"
                                                        Foreground="{DynamicResource GameTextRedBrush}"
                                                        Text="{Binding Name}"
                                                        TextTrimming="CharacterEllipsis"
                                                        ToolTip="{Binding Name}" />
                                                    <TextBlock
                                                        FontSize="9.5"
                                                        Foreground="{DynamicResource GameTextMutedBrush}">
                                                        <Run Text="HP: " />
                                                        <Run FontWeight="Bold" Text="{Binding Hp, StringFormat='{}{0:N0}'}" />
                                                    </TextBlock>
                                                </StackPanel>
                                                <Border
                                                    Grid.Column="1"
                                                    Padding="5,1"
                                                    VerticalAlignment="Center"
                                                    Background="{DynamicResource GameDangerBrush}"
                                                    CornerRadius="3">
                                                    <TextBlock
                                                        FontSize="9.5"
                                                        FontWeight="Bold"
                                                        Foreground="{DynamicResource GameTextLightBrush}">
                                                        <Run Text="(" />
                                                        <Run Text="{Binding X}" />
                                                        <Run Text=", " />
                                                        <Run Text="{Binding Y}" />
                                                        <Run Text=")" />
                                                    </TextBlock>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock
                                Margin="2,8,0,3"
                                FontSize="10.5"
                                FontWeight="ExtraBold"
                                Foreground="{DynamicResource GameTextDarkBrush}"
                                Text="NGƯỜI CHƠI TRONG KHU:" />

                            <ItemsControl ItemsSource="{Binding Players}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:WorldPlayerInfo}">
                                        <Border
                                            Margin="0,1,0,3"
                                            Padding="6,3"
                                            Background="{DynamicResource GameBgBrush}"
                                            BorderBrush="{DynamicResource GameBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Cursor="Hand"
                                            MouseLeftButtonDown="EntityItem_MouseLeftButtonDown"
                                            ToolTip="Nhấn đúp chuột để chọn và click vào người chơi này trong game">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock
                                                        FontSize="11"
                                                        FontWeight="Bold"
                                                        Foreground="{DynamicResource GameTextDarkBrush}"
                                                        Text="{Binding Name}"
                                                        TextTrimming="CharacterEllipsis"
                                                        ToolTip="{Binding Name}" />
                                                    <TextBlock
                                                        FontSize="9"
                                                        Foreground="{DynamicResource GameTextMutedBrush}">
                                                        <Run Text="HP: " />
                                                        <Run Text="{Binding Hp, StringFormat='{}{0:N0}'}" />
                                                    </TextBlock>
                                                </StackPanel>
                                                <Border
                                                    Grid.Column="1"
                                                    Padding="4,1"
                                                    VerticalAlignment="Center"
                                                    Background="{DynamicResource GameTabContentBrush}"
                                                    BorderBrush="{DynamicResource GameBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="3">
                                                    <TextBlock
                                                        FontSize="9.5"
                                                        FontWeight="Bold"
                                                        Foreground="{DynamicResource GameTextDarkBrush}">
                                                        <Run Text="(" />
                                                        <Run Text="{Binding X}" />
                                                        <Run Text=", " />
                                                        <Run Text="{Binding Y}" />
                                                        <Run Text=")" />
                                                    </TextBlock>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Style="{StaticResource GameTabItemStyle}">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="QUÁI (" />
                            <TextBlock Foreground="{DynamicResource GameTextGreenBrush}" Text="{Binding AliveMobs}" TextTrimming="CharacterEllipsis" ToolTip="{Binding AliveMobs}" />
                            <TextBlock Text="/" />
                            <TextBlock Text="{Binding TotalMobs}" TextTrimming="CharacterEllipsis" ToolTip="{Binding TotalMobs}" />
                            <TextBlock Text=")" />
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer FocusVisualStyle="{x:Null}" VerticalScrollBarVisibility="Auto" CanContentScroll="True">
                        <ItemsControl Margin="6,4" ItemsSource="{Binding Mobs}"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:WorldMobInfo}">
                                    <Border
                                        Margin="0,1,0,3"
                                        Padding="6,4"
                                        Background="{DynamicResource GameBgBrush}"
                                        BorderBrush="{DynamicResource GameBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Cursor="Hand"
                                        MouseLeftButtonDown="EntityItem_MouseLeftButtonDown"
                                        ToolTip="Nhấn đúp chuột để chọn và click vào Quái này trong game">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Opacity" Value="1.0" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAlive}" Value="False">
                                                        <Setter Property="Opacity" Value="0.6" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <DockPanel VerticalAlignment="Center">
                                                    <Border
                                                        DockPanel.Dock="Right"
                                                        Margin="6,0,0,0"
                                                        Padding="4,0"
                                                        VerticalAlignment="Center"
                                                        CornerRadius="3">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{DynamicResource GameGreenBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsAlive}" Value="False">
                                                                        <Setter Property="Background" Value="{DynamicResource GameGrayBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock
                                                            FontSize="8.5"
                                                            FontWeight="ExtraBold"
                                                            Foreground="{DynamicResource GameTextLightBrush}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="SỐNG" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsAlive}" Value="False">
                                                                            <Setter Property="Text" Value="CHẾT" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                    <TextBlock
                                                        FontSize="11"
                                                        FontWeight="Bold"
                                                        Foreground="{DynamicResource GameTextDarkBrush}"
                                                        Text="{Binding Name}"
                                                        TextTrimming="CharacterEllipsis"
                                                        ToolTip="{Binding Name}" />
                                                </DockPanel>
                                                <TextBlock
                                                    FontSize="9"
                                                    Foreground="{DynamicResource GameTextMutedBrush}">
                                                    <Run Text="HP: " />
                                                    <Run FontWeight="SemiBold" Text="{Binding Hp, StringFormat='{}{0:N0}'}" />
                                                    <Run Text="/" />
                                                    <Run Text="{Binding MaxHp, StringFormat='{}{0:N0}'}" />
                                                    <Run Text=" • ID: " />
                                                    <Run Text="{Binding Id}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <Border
                                                Grid.Column="1"
                                                Padding="4,1"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource GameTabContentBrush}"
                                                BorderBrush="{DynamicResource GameBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="3">
                                                <TextBlock
                                                    FontSize="9.5"
                                                    FontWeight="Bold"
                                                    Foreground="{DynamicResource GameTextDarkBrush}">
                                                    <Run Text="(" />
                                                    <Run Text="{Binding X}" />
                                                    <Run Text=", " />
                                                    <Run Text="{Binding Y}" />
                                                    <Run Text=")" />
                                                </TextBlock>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </TabItem>

                <TabItem Style="{StaticResource GameTabItemStyle}">
                    <TabItem.Header>
                        <TextBlock>
                            <Run Text="NPC (" />
                            <Run Text="{Binding NpcCount}" />
                            <Run Text=")" />
                        </TextBlock>
                    </TabItem.Header>
                    <ScrollViewer FocusVisualStyle="{x:Null}" VerticalScrollBarVisibility="Auto" CanContentScroll="True">
                        <ItemsControl Margin="6,4" ItemsSource="{Binding Npcs}"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:WorldNpcInfo}">
                                    <Border
                                        Margin="0,1,0,3"
                                        Padding="6,4"
                                        Background="{DynamicResource GameBgBrush}"
                                        BorderBrush="{DynamicResource GameBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Cursor="Hand"
                                        MouseLeftButtonDown="EntityItem_MouseLeftButtonDown"
                                        ToolTip="Nhấn đúp chuột để chọn và click vào NPC này trong game">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock
                                                    FontSize="11"
                                                    FontWeight="Bold"
                                                    Foreground="{DynamicResource GameTextDarkBrush}"
                                                    Text="{Binding Name}"
                                                    TextTrimming="CharacterEllipsis"
                                                    ToolTip="{Binding Name}" />
                                                <TextBlock
                                                    FontSize="9"
                                                    Foreground="{DynamicResource GameTextMutedBrush}">
                                                    <Run Text="ID: " />
                                                    <Run Text="{Binding Id}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <Border
                                                Grid.Column="1"
                                                Padding="4,1"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource GameTabContentBrush}"
                                                BorderBrush="{DynamicResource GameBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="3">
                                                <TextBlock
                                                    FontSize="9.5"
                                                    FontWeight="Bold"
                                                    Foreground="{DynamicResource GameTextDarkBrush}">
                                                    <Run Text="(" />
                                                    <Run Text="{Binding X}" />
                                                    <Run Text=", " />
                                                    <Run Text="{Binding Y}" />
                                                    <Run Text=")" />
                                                </TextBlock>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </TabItem>

                <TabItem Style="{StaticResource GameTabItemStyle}">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="XMAP" />
                        </StackPanel>
                    </TabItem.Header>
                    <Grid Margin="4,4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Margin="0,0,0,5" Padding="6,6"
                                Background="{DynamicResource GameBgBrush}"
                                BorderBrush="{DynamicResource GameBorderBrush}"
                                BorderThickness="1.5" CornerRadius="4">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <DockPanel Grid.Row="0" Margin="0,0,0,5">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                                        <Border Padding="4,1" Background="{DynamicResource GameGreenBrush}" CornerRadius="3" Margin="0,0,5,0">
                                            <TextBlock Text="VỊ TRÍ" FontSize="8.5" FontWeight="ExtraBold" Foreground="{DynamicResource GameTextLightBrush}" />
                                        </Border>
                                        <TextBlock FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource GameTextDarkBrush}">
                                            <Run Text="#" />
                                            <Run Text="{Binding CurrentMapId, FallbackValue='0'}" />
                                            <Run Text=" " />
                                            <Run Text="{Binding CurrentMapName, FallbackValue='Chưa rõ'}" />
                                        </TextBlock>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" DockPanel.Dock="Right">
                                        <Border Padding="4,1" Background="{DynamicResource GameBadgeShortcutBgBrush}" CornerRadius="3" Margin="0,0,5,0">
                                            <TextBlock Text="ĐÍCH" FontSize="8.5" FontWeight="ExtraBold" Foreground="{DynamicResource GameBadgeShortcutTextBrush}" />
                                        </Border>
                                        <TextBlock FontSize="10.5" FontWeight="ExtraBold" Foreground="{DynamicResource GameTextYellowBrush}">
                                            <Run Text="{Binding SelectedXmapTarget.DisplayText, Mode=OneWay, FallbackValue='Chưa chọn map'}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>

                                <Grid Grid.Row="1" Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0" Height="28" Margin="0,0,4,0"
                                            Command="{Binding OpenMapGraphDialogCommand}"
                                            Style="{StaticResource GamePrimaryButton}"
                                            ToolTip="Mở sơ đồ đồ thị nhánh trực quan để chọn map đích">
                                        <TextBlock Text="SƠ ĐỒ BẢN ĐỒ (CHỌN ĐÍCH)" FontSize="9.5" FontWeight="ExtraBold" Foreground="{DynamicResource GameTextLightBrush}" />
                                    </Button>

                                    <TextBox Grid.Column="1" Width="44" Height="28" Margin="0,0,4,0"
                                             Text="{Binding QuickTargetMapIdInput, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource GameTextBoxStyle}"
                                             ToolTip="Nhập nhanh mã ID map đích" />

                                    <Button Grid.Column="2" Height="28" Padding="8,0" Margin="0,0,4,0"
                                            Command="{Binding SelectQuickTargetMapIdCommand}"
                                            Style="{StaticResource GameSecondaryButton}"
                                            ToolTip="Chọn map theo ID vừa nhập">
                                        <TextBlock Text="CHỌN" FontSize="9" FontWeight="ExtraBold" Foreground="{DynamicResource GameBtnTanTextBrush}" />
                                    </Button>

                                    <Button Grid.Column="3" Height="28" Padding="8,0"
                                            Command="{Binding ResetFocalToCurrentCommand}"
                                            Style="{StaticResource GameSecondaryButton}"
                                            ToolTip="Quay trở lại bản đồ tài khoản đang đứng">
                                        <TextBlock Text="VỀ MAP ACC" FontSize="9" FontWeight="ExtraBold" Foreground="{DynamicResource GameBtnTanTextBrush}" />
                                    </Button>
                                </Grid>

                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,6,0">
                                        <TextBlock FontSize="9" Foreground="{DynamicResource GameTextMutedBrush}"
                                                   Text="{Binding XmapStatus, FallbackValue='Sẵn sàng'}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <Button Grid.Column="1" Height="28" Padding="12,0" Margin="0,0,4,0"
                                            Command="{Binding StartXmapCommand}"
                                            Style="{StaticResource GamePrimaryButton}"
                                            ToolTip="Bắt đầu di chuyển lộ trình Xmap">
                                        <TextBlock Text="BẮT ĐẦU" FontSize="10.5" FontWeight="ExtraBold" Foreground="{DynamicResource GameTextLightBrush}" />
                                    </Button>

                                    <Button Grid.Column="2" Height="28" Padding="12,0"
                                            Command="{Binding StopXmapCommand}"
                                            IsEnabled="{Binding IsNavigatingXmap}"
                                            Style="{StaticResource GameSecondaryButton}"
                                            ToolTip="Dừng di chuyển Xmap ngay lập tức">
                                        <TextBlock Text="DỪNG" FontSize="10.5" FontWeight="ExtraBold" Foreground="{DynamicResource GameBtnTanTextBrush}" />
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Margin="0,0,0,5" Padding="5,3"
                                Background="{DynamicResource GameTabContentBrush}"
                                BorderBrush="{DynamicResource GameBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentRouteSteps.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <DockPanel Margin="0,0,0,2">
                                    <TextBlock Text="LỘ TRÌNH KẾT NỐI:" FontSize="9" FontWeight="ExtraBold" Foreground="{DynamicResource GameTextYellowBrush}" DockPanel.Dock="Left" />
                                    <TextBlock Text="{Binding RouteSummary}" FontSize="8.5" Foreground="{DynamicResource GameTextMutedBrush}" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" ToolTip="{Binding RouteSummary}" />
                                </DockPanel>
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" FocusVisualStyle="{x:Null}">
                                    <ItemsControl ItemsSource="{Binding CurrentRouteSteps}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type items:XmapRouteStepItem}">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Padding="4,1" CornerRadius="3" BorderThickness="1">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{DynamicResource GameBgBrush}" />
                                                                <Setter Property="BorderBrush" Value="{DynamicResource GameBorderBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource GameGreenBrush}" />
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource GameGreenBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsLast}" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource GameBadgeShortcutBgBrush}" />
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource GameBadgeShortcutBgBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock FontSize="8.5" FontWeight="ExtraBold">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{DynamicResource GameTextDarkBrush}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                                <Setter Property="Foreground" Value="{DynamicResource GameTextLightBrush}" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsLast}" Value="True">
                                                                                <Setter Property="Foreground" Value="{DynamicResource GameBadgeShortcutTextBrush}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                                <Run Text="#" />
                                                                <Run Text="{Binding MapId}" />
                                                                <Run Text=" " />
                                                                <Run Text="{Binding MapName}" />
                                                            </TextBlock>
                                                            <TextBlock Margin="3,0,0,0" FontSize="7.5">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{DynamicResource GameTextMutedBrush}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                                <Setter Property="Foreground" Value="{DynamicResource GameTextLightBrush}" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsLast}" Value="True">
                                                                                <Setter Property="Foreground" Value="{DynamicResource GameBadgeShortcutTextBrush}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                                <Run Text="(" />
                                                                <Run Text="{Binding DirectionText}" />
                                                                <Run Text=")" />
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Border>
                                                    <TextBlock Text="&gt;" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource GameTextMutedBrush}" Margin="2,0,4,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsLast}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2"
                                Background="{DynamicResource GameTabContentBrush}"
                                BorderBrush="{DynamicResource GameBorderBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="5,5">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" Margin="0,0,0,5" Padding="6,4"
                                        Background="{DynamicResource GameBgBrush}"
                                        BorderBrush="{DynamicResource GameBorderBrush}"
                                        BorderThickness="1" CornerRadius="4">
                                    <DockPanel>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                                            <TextBlock Text="CỔNG TỪ: " FontSize="9" FontWeight="ExtraBold" Foreground="{DynamicResource GameTextMutedBrush}" />
                                            <TextBlock FontSize="10.5" FontWeight="ExtraBold" Foreground="{DynamicResource GameTextDarkBrush}">
                                                <Run Text="#" />
                                                <Run Text="{Binding FocalMapId}" />
                                                <Run Text=" " />
                                                <Run Text="{Binding FocalMapName}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding FocalPlanetName, StringFormat=' ({0})'}" FontSize="8.5" Foreground="{DynamicResource GameTextMutedBrush}" VerticalAlignment="Center" Margin="3,0,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding FocalPlanetName}" />
                                        </StackPanel>

                                        <Border DockPanel.Dock="Right" Padding="5,1" CornerRadius="3">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource GameBadgeShortcutBgBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFocalAtCurrentMap}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource GameGreenBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="8" FontWeight="ExtraBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource GameBadgeShortcutTextBrush}" />
                                                        <Setter Property="Text" Value="ĐANG DUYỆT" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsFocalAtCurrentMap}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource GameTextLightBrush}" />
                                                                <Setter Property="Text" Value="VỊ TRÍ ACC" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DockPanel>
                                </Border>

                                <ScrollViewer FocusVisualStyle="{x:Null}" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding AllAdjacentNodes}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type items:XmapConnectedNodeItem}">
                                                <Border Margin="0,0,0,4" Padding="6,5"
                                                        Background="{DynamicResource GameBgBrush}"
                                                        BorderThickness="1.2" CornerRadius="4">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource GameBorderBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsOnRoute}" Value="True">
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource GameTextYellowBrush}" />
                                                                    <Setter Property="Background" Value="{DynamicResource GameSelectionAmberTintBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <Border Grid.Column="0" Width="68" Margin="0,0,8,0" Padding="4,2"
                                                                VerticalAlignment="Center"
                                                                Background="{DynamicResource GameTabContentBrush}"
                                                                BorderBrush="{DynamicResource GameBorderBrush}"
                                                                BorderThickness="1" CornerRadius="3">
                                                            <TextBlock Text="{Binding DirectionLabel}" FontSize="8.5" FontWeight="ExtraBold"
                                                                       Foreground="{DynamicResource GameTextDarkBrush}"
                                                                       HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding DirectionLabel}" />
                                                        </Border>

                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0">
                                                            <TextBlock FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource GameTextDarkBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding TargetMapName}">
                                                                <Run Text="#" />
                                                                <Run Text="{Binding TargetMapId}" />
                                                                <Run Text=" " />
                                                                <Run Text="{Binding TargetMapName}" />
                                                            </TextBlock>
                                                            <TextBlock FontSize="8" Foreground="{DynamicResource GameTextMutedBrush}" Text="{Binding CoordinateDisplay}" TextTrimming="CharacterEllipsis" ToolTip="{Binding CoordinateDisplay}" />
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Button Height="24" Padding="10,0" Margin="0,0,4,0"
                                                                    Command="{Binding DataContext.NavigateDirectNodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Style="{StaticResource GamePrimaryButton}"
                                                                    ToolTip="Đi ngay sang map này">
                                                                <TextBlock Text="ĐI" FontSize="9" FontWeight="ExtraBold" Foreground="{DynamicResource GameTextLightBrush}" />
                                                            </Button>
                                                            <Button Width="26" Height="24"
                                                                    Command="{Binding DataContext.InspectNodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Style="{StaticResource GameSecondaryButton}"
                                                                    ToolTip="Xem các cổng tiếp theo của map này">
                                                                <TextBlock Text="&gt;" FontSize="9" FontWeight="ExtraBold" Foreground="{DynamicResource GameBtnTanTextBrush}" />
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>
    </Grid>
</UserControl>
