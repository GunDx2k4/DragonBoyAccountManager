<Window
    x:Class="DragonBoyAccountManager.GUI.Presentation.Features.MapUtilities.Dialogs.XmapNodePickerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:items="clr-namespace:DragonBoyAccountManager.GUI.Presentation.Features.MapUtilities.Items"
    xmlns:dialogs="clr-namespace:DragonBoyAccountManager.GUI.Presentation.Features.MapUtilities.Dialogs"
    Title="SƠ ĐỒ BẢN ĐỒ TOÀN CẢNH (DẠNG NHÁNH ĐỒ THỊ)"
    Width="880"
    Height="600"
    MinWidth="780"
    MinHeight="520"
    d:DataContext="{d:DesignInstance Type=dialogs:XmapNodePickerViewModel}"
    AllowsTransparency="True"
    Background="Transparent"
    FontFamily="{DynamicResource GameFont}"
    FontWeight="Bold"
    MouseLeftButtonDown="Window_MouseLeftButtonDown"
    ResizeMode="CanResizeWithGrip"
    ShowInTaskbar="False"
    SnapsToDevicePixels="True"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType"
    UseLayoutRounding="True"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None"
    mc:Ignorable="d">

    <Border
        Margin="12"
        Padding="3"
        Background="{DynamicResource GameBorderDarkBrush}"
        CornerRadius="8"
        SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect
                BlurRadius="6"
                Direction="270"
                Opacity="0.45"
                ShadowDepth="3"
                Color="{StaticResource GameShadowBackdropColor}" />
        </Border.Effect>

        <Border
            Background="{DynamicResource GameBgLightBrush}"
            BorderBrush="{DynamicResource GameHeaderBrush}"
            BorderThickness="2"
            CornerRadius="6">
            <Grid Margin="12,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Padding="6,2" Background="{DynamicResource GameBadgeShortcutBgBrush}" CornerRadius="3" Margin="0,0,8,0">
                            <TextBlock Text="XMAP" FontSize="10" FontWeight="ExtraBold" Foreground="{DynamicResource GameBadgeShortcutTextBrush}" />
                        </Border>
                        <TextBlock Text="SƠ ĐỒ BẢN ĐỒ TOÀN CẢNH (DẠNG NHÁNH ĐỒ THỊ)" FontSize="13" FontWeight="ExtraBold" Foreground="{DynamicResource GameTextRedBrush}" VerticalAlignment="Center" />
                    </StackPanel>

                    <Button Grid.Column="1" Width="26" Height="26"
                            Click="CloseButton_Click"
                            Style="{StaticResource GameSecondaryButton}"
                            ToolTip="Đóng cửa sổ">
                        <TextBlock Text="X" FontFamily="{DynamicResource GameFont}" FontSize="11" FontWeight="ExtraBold" Foreground="{DynamicResource GameBtnTanTextBrush}" />
                    </Button>
                </Grid>

                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ComboBox Grid.Column="0" Width="135" Height="26"
                              ItemsSource="{Binding Planets}"
                              SelectedItem="{Binding SelectedPlanet, Mode=TwoWay}"
                              Style="{StaticResource GameComboBoxStyle}"
                              ToolTip="Lọc theo hành tinh hoặc xem tất cả" />

                    <TextBox Grid.Column="1" Height="26" Margin="8,0,8,0"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource GameTextBoxStyle}"
                             ToolTip="Tìm nhanh bản đồ theo ID hoặc tên" />

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="10" Height="10" Background="{DynamicResource GameGreenBrush}" CornerRadius="2" Margin="0,0,4,0" />
                        <TextBlock Text="Đang đứng" FontSize="8.5" Foreground="{DynamicResource GameTextMutedBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />

                        <Border Width="10" Height="10" Background="{DynamicResource GameTextYellowBrush}" CornerRadius="2" Margin="0,0,4,0" />
                        <TextBlock Text="Mục tiêu" FontSize="8.5" Foreground="{DynamicResource GameTextMutedBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />

                        <Border Width="14" Height="3" Background="{DynamicResource GameGoldAccentBrush}" Margin="0,0,4,0" VerticalAlignment="Center" />
                        <TextBlock Text="Lộ trình đi" FontSize="8.5" Foreground="{DynamicResource GameTextMutedBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <Border Grid.Row="2"
                        Background="{DynamicResource GameTabContentBrush}"
                        BorderBrush="{DynamicResource GameBorderBrush}"
                        BorderThickness="1.5"
                        CornerRadius="5">
                    <ScrollViewer FocusVisualStyle="{x:Null}"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  CanContentScroll="False"
                                  Padding="6">
                        <Grid Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}" MinWidth="700" MinHeight="450">
                            <dialogs:XmapGraphCanvas
                                Width="{Binding CanvasWidth}"
                                Height="{Binding CanvasHeight}"
                                EdgesSource="{Binding GraphEdges}" />

                            <ItemsControl
                                Width="{Binding CanvasWidth}"
                                Height="{Binding CanvasHeight}"
                                ItemsSource="{Binding GraphNodes}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas Width="{Binding DataContext.CanvasWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                Height="{Binding DataContext.CanvasHeight, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding X}" />
                                        <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type dialogs:XmapGraphNodeViewModel}">
                                        <Border Width="{Binding Width}"
                                                Height="{Binding Height}"
                                                Padding="6,4"
                                                Background="{DynamicResource GameBgBrush}"
                                                BorderBrush="{DynamicResource GameBorderBrush}"
                                                BorderThickness="1.5"
                                                CornerRadius="4"
                                                Cursor="Hand"
                                                MouseLeftButtonDown="Node_MouseLeftButtonDown"
                                                ToolTip="{Binding DisplayText}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource GameBorderBrush}" />
                                                    <Setter Property="Background" Value="{DynamicResource GameBgBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCurrentMap}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource GameGreenBrush}" />
                                                            <Setter Property="Background" Value="{DynamicResource GameSelectionGreenTintBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource GameTextYellowBrush}" />
                                                            <Setter Property="Background" Value="{DynamicResource GameSelectionAmberTintBrush}" />
                                                        </DataTrigger>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsOnRoute}" Value="True" />
                                                                <Condition Binding="{Binding IsSelected}" Value="False" />
                                                                <Condition Binding="{Binding IsCurrentMap}" Value="False" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="BorderBrush" Value="{DynamicResource GameGoldAccentBrush}" />
                                                        </MultiDataTrigger>
                                                        <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource GameDangerBrush}" />
                                                            <Setter Property="Background" Value="{DynamicResource GameDangerBgBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>

                                            <Grid VerticalAlignment="Center">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <DockPanel Grid.Row="0">
                                                    <Border DockPanel.Dock="Left" Padding="3,0" Background="{DynamicResource GameTabContentBrush}" BorderBrush="{DynamicResource GameBorderBrush}" BorderThickness="1" CornerRadius="2">
                                                        <TextBlock FontSize="8" FontWeight="ExtraBold" Foreground="{DynamicResource GameTextYellowBrush}">
                                                            <Run Text="#" />
                                                            <Run Text="{Binding Id, Mode=OneWay}" />
                                                        </TextBlock>
                                                    </Border>

                                                    <Border DockPanel.Dock="Right" Padding="3,0" CornerRadius="2">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsCurrentMap}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                        <Setter Property="Background" Value="{DynamicResource GameGreenBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                        <Setter Property="Background" Value="{DynamicResource GameBadgeShortcutBgBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock FontSize="7" FontWeight="ExtraBold" Foreground="{DynamicResource GameTextLightBrush}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="MỤC TIÊU" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsCurrentMap}" Value="True">
                                                                            <Setter Property="Text" Value="Ở ĐÂY" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>

                                                    <TextBlock Text="{Binding ConnectionCount, StringFormat='&gt; {0}'}"
                                                               FontSize="7.5"
                                                               Foreground="{DynamicResource GameTextMutedBrush}"
                                                               HorizontalAlignment="Right"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,4,0"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding ConnectionCount, StringFormat='{}Số kết nối: {0}'}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsCurrentMap}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </DockPanel>

                                                <TextBlock Grid.Row="1"
                                                           Text="{Binding Name}"
                                                           FontSize="9.5"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource GameTextDarkBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Name}"
                                                           Margin="0,2,0,0" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </ScrollViewer>
                </Border>

                <Border Grid.Row="3" Margin="0,8,0,0" Padding="8,6"
                        Background="{DynamicResource GameBgBrush}"
                        BorderBrush="{DynamicResource GameBorderBrush}"
                        BorderThickness="1.2"
                        CornerRadius="4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,4">
                            <TextBlock Text="LỘ TRÌNH KẾT NỐI:" FontSize="9.5" FontWeight="ExtraBold" Foreground="{DynamicResource GameTextYellowBrush}" DockPanel.Dock="Left" />
                            <TextBlock Text="{Binding PreviewSummary}" FontSize="9" Foreground="{DynamicResource GameTextMutedBrush}" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" ToolTip="{Binding PreviewSummary}" />
                        </DockPanel>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" FocusVisualStyle="{x:Null}">
                                <ItemsControl ItemsSource="{Binding PreviewRouteSteps}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type items:XmapRouteStepItem}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Padding="5,2" CornerRadius="3" BorderThickness="1">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{DynamicResource GameBgBrush}" />
                                                            <Setter Property="BorderBrush" Value="{DynamicResource GameBorderBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource GameGreenBrush}" />
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource GameGreenBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsLast}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource GameBadgeShortcutBgBrush}" />
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource GameBadgeShortcutBgBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock FontSize="9" FontWeight="ExtraBold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{DynamicResource GameTextDarkBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource GameTextLightBrush}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsLast}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource GameBadgeShortcutTextBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                            <Run Text="#" />
                                                            <Run Text="{Binding MapId}" />
                                                            <Run Text=" " />
                                                            <Run Text="{Binding MapName}" />
                                                        </TextBlock>
                                                        <TextBlock Margin="4,0,0,0" FontSize="8">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{DynamicResource GameTextMutedBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource GameTextLightBrush}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsLast}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource GameBadgeShortcutTextBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                            <Run Text="(" />
                                                            <Run Text="{Binding DirectionText}" />
                                                            <Run Text=")" />
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Border>
                                                <TextBlock Text="&gt;" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource GameTextMutedBrush}" Margin="3,0,5,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsLast}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <Button Grid.Column="1" Height="28" Padding="12,0" Margin="8,0,6,0"
                                    Command="{Binding ConfirmCommand}"
                                    Style="{StaticResource GamePrimaryButton}"
                                    ToolTip="Xác nhận chọn bản đồ này làm mục tiêu">
                                <TextBlock FontSize="10.5" FontWeight="ExtraBold" Foreground="{DynamicResource GameTextLightBrush}" Text="CHỌN MAP NÀY" />
                            </Button>

                            <Button Grid.Column="2" Height="28" Padding="10,0"
                                    Command="{Binding CancelCommand}"
                                    Style="{StaticResource GameSecondaryButton}"
                                    ToolTip="Hủy bỏ">
                                <TextBlock FontSize="10.5" FontWeight="ExtraBold" Foreground="{DynamicResource GameBtnTanTextBrush}" Text="ĐÓNG" />
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>
