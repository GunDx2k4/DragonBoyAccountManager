<UserControl
    x:Class="DragonBoyAccountManager.GUI.Presentation.Features.Accounts.AccountsPanelView"
    x:Name="RootView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:DragonBoyAccountManager.GUI.Presentation.DesignSystem.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:DragonBoyAccountManager.GUI.Presentation.DesignSystem.Controls"
    xmlns:viewmodels="clr-namespace:DragonBoyAccountManager.GUI.Presentation.Features.Accounts"
    xmlns:views="clr-namespace:DragonBoyAccountManager.GUI.Presentation.Features.Accounts.Components"
    d:DataContext="{d:DesignInstance Type=viewmodels:AccountsPanelViewModel}"
    d:DesignHeight="550"
    d:DesignWidth="680"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:StatusToBrushConverter x:Key="StatusToBrushConverter" />
    </UserControl.Resources>

    <ui:GameCard Padding="10,8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                Margin="0,0,0,10"
                Padding="8,5"
                Background="{DynamicResource GameBgAltBrush}"
                BorderBrush="{DynamicResource GameBorderBrush}"
                BorderThickness="1.5"
                CornerRadius="5"
                SnapsToDevicePixels="True">
                <WrapPanel VerticalAlignment="Center">
                    <StackPanel
                        Orientation="Horizontal"
                        Margin="0,2,10,2"
                        VerticalAlignment="Center">
                        <TextBlock
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            FontSize="11"
                            FontWeight="ExtraBold"
                            Foreground="{DynamicResource GameTextDarkBrush}"
                            Text="Tìm:" />
                        <TextBox
                            Width="120"
                            Height="28"
                            VerticalAlignment="Center"
                            Style="{StaticResource GameTextBoxStyle}"
                            Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock
                            Margin="8,0,6,0"
                            VerticalAlignment="Center"
                            FontSize="11"
                            FontWeight="ExtraBold"
                            Foreground="{DynamicResource GameTextDarkBrush}"
                            Text="Server:" />
                        <ComboBox
                            Width="100"
                            Height="28"
                            VerticalAlignment="Center"
                            ItemsSource="{Binding FilterServers}"
                            SelectedItem="{Binding SelectedServerFilter}"
                            Style="{StaticResource GameComboBoxStyle}" />

                        <Button
                            Height="28"
                            MinWidth="52"
                            Margin="6,0,0,0"
                            VerticalAlignment="Center"
                            Command="{Binding ClearFilterCommand}"
                            Content="Lọc lại"
                            Style="{StaticResource GameSecondaryButton}" />
                    </StackPanel>

                    <StackPanel
                        Orientation="Horizontal"
                        Margin="0,2,0,2"
                        VerticalAlignment="Center">
                        <Button
                            Height="28"
                            Margin="0,0,6,0"
                            Padding="8,0"
                            Command="{Binding ShowGuidanceCommand}"
                            Style="{StaticResource GameSecondaryButton}"
                            ToolTip="Xem lại chỉ dẫn kết nối game &amp; Assembly"
                            Visibility="{Binding ShowGuidanceButtonVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock
                                FontSize="11"
                                FontWeight="ExtraBold"
                                Foreground="{DynamicResource GameTextRedBrush}"
                                Text="CHỈ DẪN [!]" />
                        </Button>

                        <Button
                            Height="28"
                            Margin="0,0,6,0"
                            Padding="8,0"
                            Command="{Binding ToggleHideAccountsCommand}"
                            Style="{StaticResource GameSecondaryButton}"
                            ToolTip="Ẩn hoặc hiển thị tên tài khoản">
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <Control
                                    Width="15"
                                    Height="15"
                                    Margin="0,0,5,0"
                                    Focusable="False"
                                    IsHitTestVisible="False"
                                    Template="{StaticResource DragonBallHideAccountIconTemplate}" />
                                <TextBlock
                                    FontSize="11"
                                    FontWeight="ExtraBold"
                                    Foreground="{DynamicResource GameTextDarkBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="ẨN TÀI KHOẢN" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMasked}" Value="True">
                                                    <Setter Property="Text" Value="HIỆN TÀI KHOẢN" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>

                        <Button
                            Height="28"
                            MinWidth="85"
                            Margin="0,0,6,0"
                            Command="{Binding OpenAddAccountCommand}"
                            Content="THÊM TÀI KHOẢN"
                            Style="{StaticResource GamePrimaryButton}" />

                        <Button
                            Width="28"
                            Height="28"
                            Command="{Binding LoadAccountsCommand}"
                            Style="{StaticResource GameRadarRefreshButton}"
                            ToolTip="Làm mới danh sách" />
                    </StackPanel>
                </WrapPanel>
            </Border>

            <Border
                Grid.Row="1"
                Margin="0,0,0,10"
                Padding="12,10"
                Background="{DynamicResource GameBgAltBrush}"
                BorderBrush="{DynamicResource GameBorderBrush}"
                BorderThickness="1.5"
                CornerRadius="6"
                Visibility="{Binding IsGuidanceVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border
                            Padding="6,1.5"
                            Margin="0,0,8,0"
                            Background="{DynamicResource GameBgBrush}"
                            BorderBrush="{DynamicResource GameBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="3">
                            <TextBlock
                                FontSize="10"
                                FontWeight="ExtraBold"
                                Foreground="{DynamicResource GameTextRedBrush}"
                                Text="CHỈ DẪN" />
                        </Border>
                        <TextBlock
                            FontSize="11.5"
                            FontWeight="ExtraBold"
                            Foreground="{DynamicResource GameTextRedBrush}"
                            Text="{Binding AssemblyGuidanceTitle}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <Button
                        Grid.Row="0"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Command="{Binding DismissGuidanceCommand}"
                        Style="{StaticResource GameCloseButton}"
                        ToolTip="Tạm thời ẩn thông báo này" />

                    <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,6,0,8">
                        <TextBlock
                            FontSize="11"
                            Foreground="{DynamicResource GameTextDarkBrush}"
                            LineHeight="16"
                            Text="{Binding AssemblyGuidanceMessage}"
                            TextWrapping="Wrap" />
                        <StackPanel Margin="6,4,0,0">
                            <TextBlock
                                FontSize="10.5"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource GameTextDarkBrush}"
                                LineHeight="16"
                                Text="1. Tải bản game PC gốc 2.5.0 trực tiếp tại trang chủ (ngocrongonline.com) — KHÔNG cài đặt bản mod."
                                TextWrapping="Wrap" />
                            <TextBlock
                                FontSize="10.5"
                                Foreground="{DynamicResource GameTextDarkBrush}"
                                LineHeight="16"
                                Text="2. Giải nén đầy đủ thư mục game, kiểm tra có file [TênGame].exe và thư mục [TênGame]_Data\Managed\Assembly-CSharp.dll."
                                TextWrapping="Wrap" />
                            <TextBlock
                                FontSize="10.5"
                                Foreground="{DynamicResource GameTextDarkBrush}"
                                LineHeight="16"
                                Text="3. Bấm nút 'Chọn file game (.exe)' bên dưới để liên kết. Sau đó thêm tài khoản và mở game bình thường."
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel
                        Grid.Row="2"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Orientation="Horizontal">
                        <Button
                            Height="26"
                            Margin="0,0,8,0"
                            Padding="12,0"
                            Command="{Binding BrowseGamePathCommand}"
                            Content="Chọn file game (.exe)"
                            FontSize="11"
                            FontWeight="Bold"
                            Style="{StaticResource GamePrimaryButton}" />
                        <Button
                            Height="26"
                            Padding="12,0"
                            Command="{Binding OpenGuideCommand}"
                            Content="Xem hướng dẫn chi tiết"
                            FontSize="11"
                            Style="{StaticResource GameSecondaryButton}" />
                    </StackPanel>
                </Grid>
            </Border>

            <DataGrid
                x:Name="AccountsDataGrid"
                Grid.Row="2"
                CanUserResizeColumns="True"
                IsReadOnly="True"
                ItemsSource="{Binding AccountsView}"
                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                SelectedItem="{Binding SelectedAccount}"
                SelectionChanged="AccountsDataGrid_SelectionChanged"
                SelectionMode="Extended"
                SelectionUnit="FullRow"
                Style="{StaticResource GameDataGridStyle}">
                <DataGrid.Resources>
                    <views:AccountContextMenu x:Key="AccountRowContextMenu" x:Shared="False" />
                </DataGrid.Resources>
                <DataGrid.RowStyle>
                    <Style BasedOn="{StaticResource GameDataGridRowStyle}" TargetType="DataGridRow">
                        <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                        <EventSetter Event="MouseDoubleClick" Handler="DataGridRow_MouseDoubleClick" />
                        <EventSetter Event="PreviewMouseRightButtonDown" Handler="DataGridRow_PreviewMouseRightButtonDown" />
                        <Setter Property="ContextMenu" Value="{StaticResource AccountRowContextMenu}" />
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="40">
                        <DataGridTemplateColumn.Header>
                            <CheckBox
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Click="HeaderCheckBox_Click"
                                IsChecked="{Binding DataContext.IsAllSelected, ElementName=RootView, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource GameCheckBoxStyle}"
                                ToolTip="Chọn / Bỏ chọn tất cả" />
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Click="RowCheckBox_Click"
                                    IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Style="{StaticResource GameCheckBoxStyle}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Width="95" MinWidth="75" Header="MÁY CHỦ">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border
                                    Padding="7,2"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource GameBgAltBrush}"
                                    BorderBrush="{DynamicResource GameBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="3.5"
                                    SnapsToDevicePixels="True">
                                    <TextBlock
                                        FontSize="11"
                                        FontWeight="ExtraBold"
                                        Foreground="{DynamicResource GameTextDarkBrush}"
                                        Text="{Binding Server}" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Width="*" MinWidth="220" Header="TÀI KHOẢN">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,2" VerticalAlignment="Center">
                                    <TextBlock
                                        FontSize="12"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource GameTextDarkBrush}"
                                        Text="{Binding DisplayUsername}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip="{Binding DisplayUsername}" />
                                    <StackPanel Margin="0,2,0,0" Orientation="Horizontal">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasCharacterName}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>

                                        <Border
                                            Margin="0,0,4,0"
                                            Padding="3.5,0.5"
                                            VerticalAlignment="Center"
                                            BorderThickness="0.8"
                                            CornerRadius="3">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource GameBtnTanBodyBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource GameBtnTanBorderBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CharacterGender}" Value="0">
                                                            <Setter Property="Background" Value="{DynamicResource GameBtnTanBodyBrush}" />
                                                            <Setter Property="BorderBrush" Value="{DynamicResource GameBtnTanBorderBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding CharacterGender}" Value="1">
                                                            <Setter Property="Background" Value="{DynamicResource GameBtnSpriteGreenHighlightBrush}" />
                                                            <Setter Property="BorderBrush" Value="{DynamicResource GameBtnSpriteGreenBorderBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding CharacterGender}" Value="2">
                                                            <Setter Property="Background" Value="{DynamicResource GameDangerBgBrush}" />
                                                            <Setter Property="BorderBrush" Value="{DynamicResource GameDangerBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock
                                                FontSize="9"
                                                FontWeight="Bold"
                                                Text="{Binding GenderDisplayName}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource GameTextDarkBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CharacterGender}" Value="0">
                                                                <Setter Property="Foreground" Value="{DynamicResource GameBtnTanTextBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding CharacterGender}" Value="1">
                                                                <Setter Property="Foreground" Value="{DynamicResource GameBtnSpriteGreenTextBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding CharacterGender}" Value="2">
                                                                <Setter Property="Foreground" Value="{DynamicResource GameTextPlanetSaiyanBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>

                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            FontWeight="Bold"
                                            Text="{Binding DisplayCharacterName}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTip="{Binding DisplayCharacterName, StringFormat='Nhân vật: {0}'}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource GameTextDarkBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CharacterGender}" Value="0">
                                                            <Setter Property="Foreground" Value="{DynamicResource GameTextPlanetEarthBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding CharacterGender}" Value="1">
                                                            <Setter Property="Foreground" Value="{DynamicResource GameTextPlanetNamecBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding CharacterGender}" Value="2">
                                                            <Setter Property="Foreground" Value="{DynamicResource GameTextPlanetSaiyanBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <TextBlock
                                            Margin="3,0,0,0"
                                            VerticalAlignment="Center"
                                            FontSize="10"
                                            FontWeight="Bold"
                                            Foreground="{DynamicResource GameTextMutedBrush}"
                                            Text="{Binding CharacterPower, StringFormat=' ({0:N0})'}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CharacterPower}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding CharacterPower}" Value="0">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Margin="0,2,0,0" Orientation="Horizontal">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasHpMp}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock
                                            FontSize="9.5"
                                            FontWeight="ExtraBold"
                                            Foreground="{DynamicResource GameTextRedBrush}"
                                            Text="{Binding DisplayHp, StringFormat='HP: {0}', Mode=OneWay}" />
                                        <TextBlock
                                            Margin="8,0,0,0"
                                            FontSize="9.5"
                                            FontWeight="ExtraBold"
                                            Foreground="{DynamicResource GameTextBlueBrush}"
                                            Text="{Binding DisplayMp, StringFormat='KI: {0}', Mode=OneWay}" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Width="180" MinWidth="135" Header="BẢN ĐỒ / KHU">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Margin="6,2" VerticalAlignment="Center">
                                    <TextBlock
                                        FontSize="11"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource GameTextDarkBrush}"
                                        Text="{Binding DisplayMapName}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip="{Binding DisplayMapFullInfo}" />
                                    <StackPanel Margin="0,1,0,0" Orientation="Horizontal">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasMapInfo}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock
                                            FontSize="9.5"
                                            FontWeight="ExtraBold"
                                            Foreground="{DynamicResource GameTextGreenBrush}"
                                            Text="{Binding DisplayZone}" />
                                        <TextBlock
                                            Margin="4,0,0,0"
                                            FontSize="9"
                                            FontWeight="Bold"
                                            Foreground="{DynamicResource GameTextMutedBrush}"
                                            Text="{Binding DisplayCoordinates}" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Width="115" MinWidth="95" Header="TRẠNG THÁI">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border
                                    Padding="6,2"
                                    HorizontalAlignment="Center"
                                    Background="{DynamicResource GameBgAltBrush}"
                                    BorderBrush="{DynamicResource GameBorderBrush}"
                                    BorderThickness="1.2"
                                    CornerRadius="4"
                                    ToolTip="{Binding StatusTooltip}">
                                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                        <ui:GameStatusOrb
                                            Margin="0,0,5,0"
                                            VerticalAlignment="Center"
                                            Status="{Binding Status}"
                                            Size="14" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            FontWeight="Bold"
                                            Foreground="{Binding Status, Converter={StaticResource StatusToBrushConverter}}"
                                            Text="{Binding StatusDisplayName}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <Grid Grid.Row="3" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Padding="10,4"
                    Background="{DynamicResource GameBgAltBrush}"
                    BorderBrush="{DynamicResource GameBorderBrush}"
                    BorderThickness="1.2"
                    CornerRadius="4"
                    SnapsToDevicePixels="True">
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                            <TextBlock
                                FontSize="10.5"
                                FontWeight="ExtraBold"
                                Foreground="{DynamicResource GameTextMutedBrush}"
                                Text="TỔNG: " />
                            <TextBlock
                                FontSize="11"
                                FontWeight="Black"
                                Foreground="{DynamicResource GameTextDarkBrush}"
                                Text="{Binding TotalAccountsCount}" />
                        </StackPanel>

                        <Rectangle
                            Width="1"
                            Height="12"
                            Margin="9,0"
                            Fill="{DynamicResource GameBorderBrush}"
                            SnapsToDevicePixels="True" />

                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                            <ui:GameStatusOrb
                                Margin="0,0,5,0"
                                VerticalAlignment="Center"
                                Status="Active"
                                Size="9" />
                            <TextBlock
                                FontSize="10.5"
                                FontWeight="ExtraBold"
                                Foreground="{DynamicResource GameTextMutedBrush}"
                                Text="ONLINE: " />
                            <TextBlock
                                FontSize="11"
                                FontWeight="Black"
                                Foreground="{DynamicResource GameTextGreenBrush}"
                                Text="{Binding RunningAccountsCount}" />
                        </StackPanel>

                        <Rectangle
                            Width="1"
                            Height="12"
                            Margin="9,0"
                            Fill="{DynamicResource GameBorderBrush}"
                            SnapsToDevicePixels="True" />

                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                            <TextBlock
                                FontSize="10.5"
                                FontWeight="ExtraBold"
                                Foreground="{DynamicResource GameTextMutedBrush}"
                                Text="ĐÃ CHỌN: " />
                            <TextBlock
                                FontSize="11"
                                FontWeight="Black"
                                Foreground="{DynamicResource GameTextDarkBrush}"
                                Text="{Binding SelectedAccountsCount}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Button
                        Height="28"
                        MinWidth="90"
                        Margin="0,0,6,0"
                        Command="{Binding LoginSelectedAccountsCommand}"
                        Content="ĐĂNG NHẬP"
                        FontSize="11.5"
                        FontWeight="Black"
                        Style="{StaticResource GamePrimaryButton}"
                        ToolTip="Mở game và đăng nhập tự động cho các tài khoản đang được chọn" />

                    <Button
                        Height="28"
                        MinWidth="85"
                        Margin="0,0,6,0"
                        Command="{Binding StopSelectedAccountsCommand}"
                        Content="ĐÓNG ĐÃ CHỌN"
                        FontSize="11"
                        Style="{StaticResource GameSecondaryButton}"
                        ToolTip="Đóng game cho các tài khoản đang được chọn" />

                    <Button
                        Height="28"
                        MinWidth="80"
                        Command="{Binding ArrangeWindowsCommand}"
                        Content="SẮP XẾP"
                        FontSize="11"
                        Style="{StaticResource GameSecondaryButton}"
                        ToolTip="Sắp xếp các cửa sổ game" />
                </StackPanel>
            </Grid>
        </Grid>
    </ui:GameCard>
</UserControl>
