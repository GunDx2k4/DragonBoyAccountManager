<UserControl
    x:Class="DragonBoyAccountManager.GUI.Presentation.Features.Auto.AutoTabView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="clr-namespace:DragonBoyAccountManager.GUI.Presentation.DesignSystem.Converters"
    xmlns:controls="clr-namespace:DragonBoyAccountManager.GUI.Presentation.DesignSystem.Controls"
    xmlns:items="clr-namespace:DragonBoyAccountManager.GUI.Presentation.Features.Auto.Items"
    xmlns:viewmodels="clr-namespace:DragonBoyAccountManager.GUI.Presentation.Features.Auto"
    d:DataContext="{d:DesignInstance Type=viewmodels:AutoTabViewModel}"
    d:DesignHeight="550"
    d:DesignWidth="435"
    mc:Ignorable="d">

    <Grid Margin="10,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Margin="0,0,0,8"
            Padding="8,7"
            Background="{DynamicResource GameBgBrush}"
            BorderBrush="{DynamicResource GameBorderBrush}"
            BorderThickness="1.5"
            CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource GameStatusIndicatorEllipseStyle}" />

                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="11.5"
                        FontWeight="ExtraBold"
                        Foreground="{DynamicResource GameTextDarkBrush}"
                        Text="{Binding ActiveAccountInfo}"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding ActiveAccountInfo}" />
                </StackPanel>

                <Border
                    Grid.Column="1"
                    Margin="8,0,0,0"
                    Padding="6,2"
                    VerticalAlignment="Center"
                    Background="{DynamicResource GameGreenBrush}"
                    CornerRadius="3"
                    ToolTip="Số tài khoản đang được áp dụng đồng bộ lệnh auto">
                    <TextBlock
                        FontSize="9"
                        FontWeight="ExtraBold"
                        Foreground="{DynamicResource GameTextLightBrush}"
                        Text="{Binding SyncTargetDisplay, FallbackValue='1 tài khoản'}" />
                </Border>
            </Grid>
        </Border>

        <Border
            Grid.Row="1"
            Background="{DynamicResource GameTabContentBrush}"
            BorderBrush="{DynamicResource GameBorderBrush}"
            BorderThickness="1.5"
            CornerRadius="6">
            <TabControl Style="{StaticResource GameTabControlStyle}">
                <TabControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="5" />
                    </ItemsPanelTemplate>
                </TabControl.ItemsPanel>
                <TabControl.Resources>
                    <Style TargetType="TabItem" BasedOn="{StaticResource GameTabItemStyle}">
                        <Setter Property="Height" Value="28" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0.5,1" />
                    </Style>
                </TabControl.Resources>

                <TabItem ToolTip="Cấu hình tự động tập luyện &amp; dùng đậu">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock
                                FontSize="9.5"
                                FontWeight="ExtraBold"
                                Text="TẬP LUYỆN"
                                TextTrimming="CharacterEllipsis" />
                            <Ellipse
                                Width="6"
                                Height="6"
                                Margin="4,0,0,0"
                                VerticalAlignment="Center"
                                Fill="{DynamicResource GameGreenBrush}"
                                Stroke="{DynamicResource GameBorderBrush}"
                                StrokeThickness="0.8"
                                ToolTip="Tự động tập luyện đang hoạt động"
                                Visibility="{Binding Train.IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer FocusVisualStyle="{x:Null}" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10,8,10,12" DataContext="{Binding Train}">

                            <TextBlock
                                Margin="0,0,0,6"
                                FontSize="11"
                                FontWeight="ExtraBold"
                                Foreground="{DynamicResource GameTextDarkBrush}"
                                Text="TÙY CHỌN TỰ ĐỘNG ĐÁNH:" />

                            <Border
                                Margin="0,0,0,8"
                                Padding="8,6"
                                Background="{DynamicResource GameBgBrush}"
                                BorderBrush="{DynamicResource GameBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox
                                        Grid.Column="0"
                                        Margin="0,2"
                                        Content="Bỏ qua siêu quái"
                                        FontSize="10.5"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource GameTextDarkBrush}"
                                        IsChecked="{Binding AvoidSuperMobs}"
                                        Style="{StaticResource GameCheckBoxStyle}" />
                                    <CheckBox
                                        Grid.Column="1"
                                        Margin="0,2"
                                        Content="Đổi khu khi hết quái"
                                        FontSize="10.5"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource GameTextDarkBrush}"
                                        IsChecked="{Binding ChangeZoneWhenNoMobs}"
                                        Style="{StaticResource GameCheckBoxStyle}" />
                                </Grid>
                            </Border>

                            <TextBlock
                                Margin="0,4,0,6"
                                FontSize="11"
                                FontWeight="ExtraBold"
                                Foreground="{DynamicResource GameTextDarkBrush}"
                                Text="ĐÁNH THEO HP QUÁI:" />

                            <Border
                                Margin="0,0,0,8"
                                Padding="8,6"
                                Background="{DynamicResource GameBgBrush}"
                                BorderBrush="{DynamicResource GameBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                                <StackPanel>
                                    <CheckBox
                                        Margin="0,0,0,6"
                                        Content="Kích hoạt đánh theo HP"
                                        FontSize="10.5"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource GameTextDarkBrush}"
                                        IsChecked="{Binding CheckAttackByHp}"
                                        Style="{StaticResource GameCheckBoxStyle}" />
                                    <Grid IsEnabled="{Binding CheckAttackByHp}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock
                                                Margin="0,0,0,2"
                                                FontSize="9.5"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource GameTextMutedBrush}"
                                                Text="HP Trên (Tối thiểu):" />
                                            <TextBox
                                                Height="24"
                                                Padding="4,2"
                                                FontSize="10"
                                                Style="{StaticResource GameTextBoxStyle}"
                                                Text="{Binding MinMobHp, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock
                                                Margin="0,0,0,2"
                                                FontSize="9.5"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource GameTextMutedBrush}"
                                                Text="HP Dưới (Tối đa):" />
                                            <TextBox
                                                Height="24"
                                                Padding="4,2"
                                                FontSize="10"
                                                Style="{StaticResource GameTextBoxStyle}"
                                                Text="{Binding MaxMobHp, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock
                                Margin="0,4,0,6"
                                FontSize="11"
                                FontWeight="ExtraBold"
                                Foreground="{DynamicResource GameTextDarkBrush}"
                                Text="TỰ DÙNG ĐẬU THẦN:" />

                            <Border
                                Margin="0,0,0,8"
                                Padding="8,6"
                                Background="{DynamicResource GameBgBrush}"
                                BorderBrush="{DynamicResource GameBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                                <StackPanel>
                                    <CheckBox
                                        Margin="0,0,0,6"
                                        Content="Kích hoạt tự dùng đậu"
                                        FontSize="10.5"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource GameTextDarkBrush}"
                                        IsChecked="{Binding AutoUsePean}"
                                        Style="{StaticResource GameCheckBoxStyle}" />
                                    <Grid IsEnabled="{Binding AutoUsePean}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock
                                                Margin="0,0,0,2"
                                                FontSize="9.5"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource GameTextMutedBrush}"
                                                Text="% HP dùng đậu:" />
                                            <TextBox
                                                Height="24"
                                                Padding="4,2"
                                                FontSize="10"
                                                Style="{StaticResource GameTextBoxStyle}"
                                                Text="{Binding PeanHpPercent, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock
                                                Margin="0,0,0,2"
                                                FontSize="9.5"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource GameTextMutedBrush}"
                                                Text="% MP dùng đậu:" />
                                            <TextBox
                                                Height="24"
                                                Padding="4,2"
                                                FontSize="10"
                                                Style="{StaticResource GameTextBoxStyle}"
                                                Text="{Binding PeanMpPercent, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock
                                Margin="0,4,0,6"
                                FontSize="11"
                                FontWeight="ExtraBold"
                                Foreground="{DynamicResource GameTextDarkBrush}"
                                Text="CHỌN QUÁI THEO TÊN:" />

                            <Border
                                Margin="0,0,0,8"
                                Padding="8,6"
                                Background="{DynamicResource GameBgBrush}"
                                BorderBrush="{DynamicResource GameBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox
                                            Grid.Column="0"
                                            VerticalAlignment="Center"
                                            Content="Tất cả quái trong map"
                                            FontSize="10.5"
                                            FontWeight="Bold"
                                            Foreground="{DynamicResource GameTextDarkBrush}"
                                            IsChecked="{Binding CheckAllMobs}"
                                            Style="{StaticResource GameCheckBoxStyle}" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Visibility="{Binding CheckAllMobs, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}">
                                            <Button
                                                Height="20"
                                                Padding="6,0"
                                                Margin="0,0,4,0"
                                                Command="{Binding SelectAllMobsCommand}"
                                                Content="TẤT CẢ"
                                                FontSize="8.5"
                                                FontWeight="Bold"
                                                Style="{StaticResource GameSecondaryButton}" />
                                            <Button
                                                Height="20"
                                                Padding="6,0"
                                                Command="{Binding DeselectAllMobsCommand}"
                                                Content="BỎ CHỌN"
                                                FontSize="8.5"
                                                FontWeight="Bold"
                                                Style="{StaticResource GameSecondaryButton}" />
                                        </StackPanel>
                                    </Grid>

                                    <Border
                                        Background="{DynamicResource GameTabContentBrush}"
                                        BorderBrush="{DynamicResource GameBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="4,3"
                                        MaxHeight="150"
                                        Visibility="{Binding CheckAllMobs, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}">
                                        <ScrollViewer FocusVisualStyle="{x:Null}" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding AvailableMobTypes}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type items:MobFilterItem}">
                                                        <Border
                                                            Margin="0,1,0,2"
                                                            Padding="5,4"
                                                            Background="{DynamicResource GameBgBrush}"
                                                            BorderBrush="{DynamicResource GameBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="3"
                                                            ToolTip="{Binding DisplayText}">
                                                            <CheckBox
                                                                VerticalAlignment="Center"
                                                                Content="{Binding Name}"
                                                                FontSize="10.5"
                                                                FontWeight="Bold"
                                                                Foreground="{DynamicResource GameTextDarkBrush}"
                                                                IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                Style="{StaticResource GameCheckBoxStyle}" />
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <TextBlock
                                Margin="0,4,0,6"
                                FontSize="11"
                                FontWeight="ExtraBold"
                                Foreground="{DynamicResource GameTextDarkBrush}"
                                Text="DANH SÁCH SKILL TỰ ĐÁNH:" />

                            <Border
                                Margin="0,0,0,8"
                                Padding="8,6"
                                Background="{DynamicResource GameBgBrush}"
                                BorderBrush="{DynamicResource GameBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="10"
                                            FontWeight="Bold"
                                            Foreground="{DynamicResource GameTextMutedBrush}"
                                            Text="Chọn các chiêu xoay tua:"
                                            TextTrimming="CharacterEllipsis" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button
                                                Height="20"
                                                Padding="6,0"
                                                Margin="0,0,4,0"
                                                Command="{Binding SelectAllSkillsCommand}"
                                                Content="TẤT CẢ"
                                                FontSize="8.5"
                                                FontWeight="Bold"
                                                Style="{StaticResource GameSecondaryButton}" />
                                            <Button
                                                Height="20"
                                                Padding="6,0"
                                                Command="{Binding DeselectAllSkillsCommand}"
                                                Content="BỎ CHỌN"
                                                FontSize="8.5"
                                                FontWeight="Bold"
                                                Style="{StaticResource GameSecondaryButton}" />
                                        </StackPanel>
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding AutoTrainSkills}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="5" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type items:SkillButtonItem}">
                                                <CheckBox
                                                    IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                    PreviewMouseLeftButtonDown="SkillSlot_PreviewMouseLeftButtonDown"
                                                    Style="{StaticResource GameSkillSlotCheckBoxStyle}"
                                                    ToolTip="{Binding ToolTipText}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Button
                                Height="34"
                                Margin="0,0,0,8"
                                Command="{Binding ToggleAutoTrainCommand}"
                                Style="{StaticResource GameAutoTrainToggleButtonStyle}" />

                            <Border
                                Padding="8,6"
                                Background="{DynamicResource GameHeaderBrush}"
                                BorderBrush="{DynamicResource GameBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        FontSize="10.5"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource GameTextDarkBrush}"
                                        Text="{Binding StatusText}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip="{Binding StatusText}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="4,0,0,0"
                                        FontSize="10"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource GameTextMutedBrush}"
                                        Text="{Binding SyncTargetDisplay}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip="{Binding SyncTargetDisplay}" />
                                </Grid>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem ToolTip="Cấu hình tự động dùng bùa &amp; vật phẩm">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock
                                FontSize="9.5"
                                FontWeight="ExtraBold"
                                Text="VẬT PHẨM"
                                TextTrimming="CharacterEllipsis" />
                            <Ellipse
                                Width="6"
                                Height="6"
                                Margin="4,0,0,0"
                                VerticalAlignment="Center"
                                Fill="{DynamicResource GameGreenBrush}"
                                Stroke="{DynamicResource GameBorderBrush}"
                                StrokeThickness="0.8"
                                ToolTip="Có vật phẩm được chọn tự động dùng"
                                Visibility="{Binding Train.HasSelectedAutoItems, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer FocusVisualStyle="{x:Null}" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10,8,10,12" DataContext="{Binding Train}">

                            <TextBlock
                                Margin="0,0,0,6"
                                FontSize="11"
                                FontWeight="ExtraBold"
                                Foreground="{DynamicResource GameTextDarkBrush}"
                                Text="DANH SÁCH VẬT PHẨM TỰ DÙNG:" />

                            <Border
                                Margin="0,0,0,8"
                                Padding="8,6"
                                Background="{DynamicResource GameBgBrush}"
                                BorderBrush="{DynamicResource GameBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="10"
                                            FontWeight="Bold"
                                            Foreground="{DynamicResource GameTextMutedBrush}"
                                            Text="Tự dùng khi hết hiệu ứng:"
                                            TextTrimming="CharacterEllipsis" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button
                                                Height="20"
                                                Padding="6,0"
                                                Margin="0,0,4,0"
                                                Command="{Binding SelectAllItemsCommand}"
                                                Content="TẤT CẢ"
                                                FontSize="8.5"
                                                FontWeight="Bold"
                                                Style="{StaticResource GameSecondaryButton}" />
                                            <Button
                                                Height="20"
                                                Padding="6,0"
                                                Command="{Binding DeselectAllItemsCommand}"
                                                Content="BỎ CHỌN"
                                                FontSize="8.5"
                                                FontWeight="Bold"
                                                Style="{StaticResource GameSecondaryButton}" />
                                        </StackPanel>
                                    </Grid>

                                    <Border
                                        Background="{DynamicResource GameTabContentBrush}"
                                        BorderBrush="{DynamicResource GameBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="4,3">
                                        <ItemsControl ItemsSource="{Binding AutoTrainItems}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="2" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type items:AutoItemSlotItem}">
                                                    <Border
                                                        Margin="2,2"
                                                        Padding="5,4"
                                                        Background="{DynamicResource GameBgBrush}"
                                                        BorderBrush="{DynamicResource GameBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="3"
                                                        ToolTip="{Binding ToolTipText}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <CheckBox
                                                                Grid.Column="0"
                                                                VerticalAlignment="Center"
                                                                IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                Style="{StaticResource GameCheckBoxStyle}" />
                                                            <Image
                                                                Grid.Column="1"
                                                                Width="18"
                                                                Height="18"
                                                                Margin="4,0,4,0"
                                                                VerticalAlignment="Center"
                                                                RenderOptions.BitmapScalingMode="NearestNeighbor"
                                                                Source="{Binding Icon}"
                                                                Stretch="Uniform"
                                                                Visibility="{Binding HasIcon, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                            <TextBlock
                                                                Grid.Column="2"
                                                                VerticalAlignment="Center"
                                                                FontSize="10"
                                                                FontWeight="Bold"
                                                                Foreground="{DynamicResource GameTextDarkBrush}"
                                                                Text="{Binding Name}"
                                                                TextTrimming="CharacterEllipsis"
                                                                ToolTip="{Binding ToolTipText}" />
                                                            <Border
                                                                Grid.Column="3"
                                                                Margin="4,0,0,0"
                                                                Padding="4,1"
                                                                VerticalAlignment="Center"
                                                                Background="{DynamicResource GameHeaderBrush}"
                                                                BorderBrush="{DynamicResource GameBorderBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="2">
                                                                <TextBlock
                                                                    FontSize="9"
                                                                    FontWeight="ExtraBold"
                                                                    Foreground="{DynamicResource GameTextDarkBrush}"
                                                                    Text="{Binding QuantityDisplay}"
                                                                    TextTrimming="CharacterEllipsis"
                                                                    ToolTip="{Binding ToolTipText}" />
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Border
                                Padding="8,6"
                                Background="{DynamicResource GameHeaderBrush}"
                                BorderBrush="{DynamicResource GameBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        FontSize="10.5"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource GameTextDarkBrush}"
                                        Text="{Binding ItemStatusText}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip="{Binding ItemStatusText}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="4,0,0,0"
                                        FontSize="10"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource GameTextMutedBrush}"
                                        Text="{Binding SyncTargetDisplay}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip="{Binding SyncTargetDisplay}" />
                                </Grid>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem ToolTip="Cấu hình tự động nhặt &amp; vứt bỏ vật phẩm">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock
                                FontSize="9.5"
                                FontWeight="ExtraBold"
                                Text="NHẶT ĐỒ"
                                TextTrimming="CharacterEllipsis" />
                            <Ellipse
                                Width="6"
                                Height="6"
                                Margin="4,0,0,0"
                                VerticalAlignment="Center"
                                Fill="{DynamicResource GameGreenBrush}"
                                Stroke="{DynamicResource GameBorderBrush}"
                                StrokeThickness="0.8"
                                ToolTip="Tự động nhặt đang bật"
                                Visibility="{Binding Train.AutoPick, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer FocusVisualStyle="{x:Null}" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10,8,10,12" DataContext="{Binding Train}">

                            <TextBlock
                                Margin="0,0,0,6"
                                FontSize="11"
                                FontWeight="ExtraBold"
                                Foreground="{DynamicResource GameTextDarkBrush}"
                                Text="TÙY CHỌN TỰ ĐỘNG NHẶT:" />

                            <Border
                                Margin="0,0,0,8"
                                Padding="8,6"
                                Background="{DynamicResource GameBgBrush}"
                                BorderBrush="{DynamicResource GameBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                                <StackPanel>
                                    <CheckBox
                                        Margin="0,2,0,6"
                                        Content="Tự động nhặt vật phẩm rơi"
                                        FontSize="10.5"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource GameTextDarkBrush}"
                                        IsChecked="{Binding AutoPick}"
                                        Style="{StaticResource GameCheckBoxStyle}" />

                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox
                                            Grid.Column="0"
                                            Margin="0,2"
                                            Content="Nhặt đồ người khác"
                                            FontSize="10.5"
                                            FontWeight="Bold"
                                            Foreground="{DynamicResource GameTextDarkBrush}"
                                            IsChecked="{Binding PickOthersItems}"
                                            IsEnabled="{Binding AutoPick}"
                                            Style="{StaticResource GameCheckBoxStyle}" />
                                        <CheckBox
                                            Grid.Column="1"
                                            Margin="0,2"
                                            Content="Nhặt toàn map"
                                            FontSize="10.5"
                                            FontWeight="Bold"
                                            Foreground="{DynamicResource GameTextDarkBrush}"
                                            IsChecked="{Binding PickAllMap}"
                                            IsEnabled="{Binding AutoPick}"
                                            Style="{StaticResource GameCheckBoxStyle}" />
                                    </Grid>

                                    <CheckBox
                                        Margin="0,6,0,2"
                                        Content="Tự động vứt bỏ vật phẩm chỉ định"
                                        FontSize="10.5"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource GameTextDarkBrush}"
                                        IsChecked="{Binding AutoDropItems}"
                                        Style="{StaticResource GameCheckBoxStyle}" />
                                </StackPanel>
                            </Border>

                            <TextBlock
                                Margin="0,4,0,6"
                                FontSize="11"
                                FontWeight="ExtraBold"
                                Foreground="{DynamicResource GameTextDarkBrush}"
                                Text="LỌC VẬT PHẨM THEO ID (PHÂN CÁCH BẰNG DẤU PHẨY):" />

                            <Border
                                Margin="0,0,0,8"
                                Padding="8,6"
                                Background="{DynamicResource GameBgBrush}"
                                BorderBrush="{DynamicResource GameBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                                <StackPanel>
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock
                                            Margin="0,0,0,2"
                                            FontSize="9.5"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource GameTextMutedBrush}"
                                            Text="ID chỉ định nhặt (để trống = nhặt tất cả):" />
                                        <TextBox
                                            Height="24"
                                            Padding="4,2"
                                            FontSize="10"
                                            Style="{StaticResource GameTextBoxStyle}"
                                            Text="{Binding FilterPickIds, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>

                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock
                                            Margin="0,0,0,2"
                                            FontSize="9.5"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource GameTextMutedBrush}"
                                            Text="ID loại trừ (bỏ qua không nhặt):" />
                                        <TextBox
                                            Height="24"
                                            Padding="4,2"
                                            FontSize="10"
                                            Style="{StaticResource GameTextBoxStyle}"
                                            Text="{Binding FilterExcludeIds, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>

                                    <StackPanel Margin="0,0,0,2">
                                        <TextBlock
                                            Margin="0,0,0,2"
                                            FontSize="9.5"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource GameTextMutedBrush}"
                                            Text="ID tự động vứt bỏ khỏi hành trang:" />
                                        <TextBox
                                            Height="24"
                                            Padding="4,2"
                                            FontSize="10"
                                            IsEnabled="{Binding AutoDropItems}"
                                            Style="{StaticResource GameTextBoxStyle}"
                                            Text="{Binding FilterDropIds, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock
                                Margin="0,4,0,6"
                                FontSize="11"
                                FontWeight="ExtraBold"
                                Foreground="{DynamicResource GameTextDarkBrush}"
                                Text="TỰ ĐỘNG MUA BÙA HỖ TRỢ (IN-GAME AUTO BÙA):" />

                            <Border
                                Margin="0,0,0,8"
                                Padding="8,6"
                                Background="{DynamicResource GameBgBrush}"
                                BorderBrush="{DynamicResource GameBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                                <ItemsControl ItemsSource="{Binding AutoTrainBuas}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="2" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type items:AutoItemSlotItem}">
                                            <Border
                                                Margin="2,2"
                                                Padding="5,4"
                                                Background="{DynamicResource GameTabContentBrush}"
                                                BorderBrush="{DynamicResource GameBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="3"
                                                ToolTip="{Binding Name}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <CheckBox
                                                        Grid.Column="0"
                                                        Margin="0,0,6,0"
                                                        VerticalAlignment="Center"
                                                        IsChecked="{Binding IsSelected}"
                                                        Style="{StaticResource GameCheckBoxStyle}" />

                                                    <Border
                                                        Grid.Column="1"
                                                        Width="20"
                                                        Height="20"
                                                        Margin="0,0,6,0"
                                                        Background="{DynamicResource GameHeaderBrush}"
                                                        BorderBrush="{DynamicResource GameBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="2">
                                                        <Image
                                                            Width="16"
                                                            Height="16"
                                                            RenderOptions.BitmapScalingMode="NearestNeighbor"
                                                            Source="{Binding Icon}"
                                                            Stretch="Uniform" />
                                                    </Border>

                                                    <TextBlock
                                                        Grid.Column="2"
                                                        VerticalAlignment="Center"
                                                        FontSize="10.5"
                                                        FontWeight="Bold"
                                                        Foreground="{DynamicResource GameTextDarkBrush}"
                                                        Text="{Binding Name}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>

                            <Border
                                Padding="8,6"
                                Background="{DynamicResource GameHeaderBrush}"
                                BorderBrush="{DynamicResource GameBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        FontSize="10.5"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource GameTextDarkBrush}"
                                        Text="{Binding PickStatusText}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip="{Binding PickStatusText}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="4,0,0,0"
                                        FontSize="10"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource GameTextMutedBrush}"
                                        Text="{Binding SyncTargetDisplay}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip="{Binding SyncTargetDisplay}" />
                                </Grid>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem ToolTip="Cấu hình tự động gửi tin nhắn chat">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock
                                FontSize="9.5"
                                FontWeight="ExtraBold"
                                Text="AUTO CHAT"
                                TextTrimming="CharacterEllipsis" />
                            <Ellipse
                                Width="6"
                                Height="6"
                                Margin="4,0,0,0"
                                VerticalAlignment="Center"
                                Fill="{DynamicResource GameGreenBrush}"
                                Stroke="{DynamicResource GameBorderBrush}"
                                StrokeThickness="0.8"
                                ToolTip="Auto chat đang hoạt động"
                                Visibility="{Binding Chat.IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer FocusVisualStyle="{x:Null}" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10,8,10,12" DataContext="{Binding Chat}">

                            <TextBlock
                                Margin="0,0,0,4"
                                FontSize="11"
                                FontWeight="ExtraBold"
                                Foreground="{DynamicResource GameTextDarkBrush}"
                                Text="NỘI DUNG CHAT (MỖI DÒNG 1 CÂU):" />

                            <TextBox
                                Height="85"
                                Padding="8,6"
                                AcceptsReturn="True"
                                Style="{StaticResource GameTextBoxStyle}"
                                Text="{Binding ChatText, UpdateSourceTrigger=PropertyChanged}"
                                TextWrapping="Wrap"
                                VerticalScrollBarVisibility="Auto" />

                            <CheckBox
                                Margin="0,6,0,8"
                                Content="Gửi ngẫu nhiên các dòng"
                                FontSize="10.5"
                                FontWeight="Bold"
                                Foreground="{DynamicResource GameTextDarkBrush}"
                                IsChecked="{Binding IsRandomChat}"
                                Style="{StaticResource GameCheckBoxStyle}" />

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock
                                        Margin="0,0,0,3"
                                        FontSize="10.5"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource GameTextMutedBrush}"
                                        Text="Kênh chat:" />
                                    <ComboBox
                                        Height="26"
                                        SelectedIndex="{Binding SelectedChatTypeIndex}"
                                        Style="{StaticResource GameComboBoxStyle}">
                                        <ComboBoxItem Content="Khu vực (Map)" />
                                        <ComboBoxItem Content="Thế giới (Global)" />
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock
                                        Margin="0,0,0,3"
                                        FontSize="10.5"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource GameTextMutedBrush}"
                                        Text="Giãn cách gửi (giây):" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="50" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox
                                            Height="26"
                                            Padding="4,2"
                                            HorizontalContentAlignment="Center"
                                            Style="{StaticResource GameTextBoxStyle}"
                                            Text="{Binding ChatDelaySeconds, UpdateSourceTrigger=PropertyChanged}" />
                                        <UniformGrid Grid.Column="2" Columns="4">
                                            <Button
                                                Height="26"
                                                Margin="1,0"
                                                Padding="0"
                                                MinWidth="0"
                                                Command="{Binding SetChatDelayCommand}"
                                                CommandParameter="3"
                                                Content="3s"
                                                FontSize="10"
                                                FontWeight="Bold"
                                                Style="{StaticResource GameSecondaryButton}" />
                                            <Button
                                                Height="26"
                                                Margin="1,0"
                                                Padding="0"
                                                MinWidth="0"
                                                Command="{Binding SetChatDelayCommand}"
                                                CommandParameter="5"
                                                Content="5s"
                                                FontSize="10"
                                                FontWeight="Bold"
                                                Style="{StaticResource GameSecondaryButton}" />
                                            <Button
                                                Height="26"
                                                Margin="1,0"
                                                Padding="0"
                                                MinWidth="0"
                                                Command="{Binding SetChatDelayCommand}"
                                                CommandParameter="10"
                                                Content="10s"
                                                FontSize="10"
                                                FontWeight="Bold"
                                                Style="{StaticResource GameSecondaryButton}" />
                                            <Button
                                                Height="26"
                                                Margin="1,0"
                                                Padding="0"
                                                MinWidth="0"
                                                Command="{Binding SetChatDelayCommand}"
                                                CommandParameter="30"
                                                Content="30s"
                                                FontSize="10"
                                                FontWeight="Bold"
                                                Style="{StaticResource GameSecondaryButton}" />
                                        </UniformGrid>
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,4,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Button
                                    Grid.Column="0"
                                    Height="32"
                                    Command="{Binding SendChatOnceCommand}"
                                    Content="GỬI 1 LẦN"
                                    FontSize="11"
                                    FontWeight="ExtraBold"
                                    Style="{StaticResource GameSecondaryButton}"
                                    ToolTip="Gửi ngay 1 tin nhắn mà không chạy vòng lặp" />

                                <Button
                                    Grid.Column="2"
                                    Height="32"
                                    Command="{Binding ToggleAutoChatCommand}"
                                    Style="{StaticResource GameAutoChatToggleButtonStyle}" />
                            </Grid>

                            <Border
                                Padding="8,6"
                                Background="{DynamicResource GameHeaderBrush}"
                                BorderBrush="{DynamicResource GameBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        FontSize="10.5"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource GameTextDarkBrush}"
                                        Text="{Binding StatusText}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip="{Binding StatusText}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="4,0,0,0"
                                        FontSize="10"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource GameTextMutedBrush}"
                                        Text="{Binding SyncTargetDisplay}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip="{Binding SyncTargetDisplay}" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem ToolTip="Cấu hình tự động tìm kiếm &amp; săn Boss">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock
                                FontSize="9.5"
                                FontWeight="ExtraBold"
                                Text="SĂN BOSS"
                                TextTrimming="CharacterEllipsis" />
                            <Ellipse
                                Width="6"
                                Height="6"
                                Margin="4,0,0,0"
                                VerticalAlignment="Center"
                                Fill="{DynamicResource GameGreenBrush}"
                                Stroke="{DynamicResource GameBorderBrush}"
                                StrokeThickness="0.8"
                                ToolTip="Tự động săn Boss đang hoạt động"
                                Visibility="{Binding Boss.IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer FocusVisualStyle="{x:Null}" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10,8,10,12" DataContext="{Binding Boss}">

                            <TextBlock
                                Margin="0,0,0,6"
                                FontSize="11"
                                FontWeight="ExtraBold"
                                Foreground="{DynamicResource GameTextDarkBrush}"
                                Text="TÙY CHỌN SĂN BOSS &amp; MỤC TIÊU:" />

                            <Border
                                Margin="0,0,0,8"
                                Padding="8,6"
                                Background="{DynamicResource GameBgBrush}"
                                BorderBrush="{DynamicResource GameBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                                <StackPanel>
                                    <Grid Margin="0,2,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="10.5"
                                            FontWeight="Bold"
                                            Foreground="{DynamicResource GameTextDarkBrush}"
                                            Text="Tên Boss / Quái:" />
                                        <TextBox
                                            Grid.Column="1"
                                            Height="24"
                                            Padding="4,2"
                                            FontSize="10"
                                            Style="{StaticResource GameTextBoxStyle}"
                                            Text="{Binding TargetBossName, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>

                                    <Grid Margin="0,2,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Grid Grid.Column="0" Margin="0,0,4,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Margin="0,0,6,0"
                                                FontSize="10"
                                                FontWeight="Bold"
                                                Foreground="{DynamicResource GameTextDarkBrush}"
                                                Text="Khu từ:" />
                                            <TextBox
                                                Grid.Column="1"
                                                Height="24"
                                                Padding="4,2"
                                                FontSize="10"
                                                HorizontalContentAlignment="Center"
                                                Style="{StaticResource GameTextBoxStyle}"
                                                Text="{Binding MinZone, UpdateSourceTrigger=PropertyChanged}" />
                                        </Grid>

                                        <Grid Grid.Column="1" Margin="4,0,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Margin="0,0,6,0"
                                                FontSize="10"
                                                FontWeight="Bold"
                                                Foreground="{DynamicResource GameTextDarkBrush}"
                                                Text="Đổi khu (giây):" />
                                            <TextBox
                                                Grid.Column="1"
                                                Height="24"
                                                Padding="4,2"
                                                FontSize="10"
                                                HorizontalContentAlignment="Center"
                                                Style="{StaticResource GameTextBoxStyle}"
                                                Text="{Binding ZoneChangeDelaySeconds, UpdateSourceTrigger=PropertyChanged}" />
                                        </Grid>
                                    </Grid>

                                    <Grid Margin="0,4,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox
                                            Grid.Column="0"
                                            Margin="0,2"
                                            Content="Dịch chuyển nhanh"
                                            FontSize="10.5"
                                            FontWeight="Bold"
                                            Foreground="{DynamicResource GameTextDarkBrush}"
                                            IsChecked="{Binding IsFastTeleport}"
                                            Style="{StaticResource GameCheckBoxStyle}" />
                                        <CheckBox
                                            Grid.Column="1"
                                            Margin="0,2"
                                            Content="Nhặt đồ người khác"
                                            FontSize="10.5"
                                            FontWeight="Bold"
                                            Foreground="{DynamicResource GameTextDarkBrush}"
                                            IsChecked="{Binding PickOthersItems}"
                                            Style="{StaticResource GameCheckBoxStyle}" />
                                    </Grid>

                                    <Grid Margin="0,4,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="10"
                                            FontWeight="Bold"
                                            Foreground="{DynamicResource GameTextDarkBrush}"
                                            Text="Lọc tên nhặt:" />
                                        <TextBox
                                            Grid.Column="1"
                                            Height="24"
                                            Padding="4,2"
                                            FontSize="10"
                                            Style="{StaticResource GameTextBoxStyle}"
                                            Text="{Binding FilterPickNames, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock
                                Margin="0,4,0,6"
                                FontSize="11"
                                FontWeight="ExtraBold"
                                Foreground="{DynamicResource GameTextDarkBrush}"
                                Text="KỸ NĂNG TẤN CÔNG:" />

                            <Border
                                Margin="0,0,0,8"
                                Padding="8,6"
                                Background="{DynamicResource GameBgBrush}"
                                BorderBrush="{DynamicResource GameBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="10"
                                            FontWeight="Bold"
                                            Foreground="{DynamicResource GameTextMutedBrush}"
                                            Text="Chọn các chiêu xoay tua:"
                                            TextTrimming="CharacterEllipsis" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button
                                                Height="20"
                                                Padding="6,0"
                                                Margin="0,0,4,0"
                                                Command="{Binding SelectAllSkillsCommand}"
                                                Content="TẤT CẢ"
                                                FontSize="8.5"
                                                FontWeight="Bold"
                                                Style="{StaticResource GameSecondaryButton}" />
                                            <Button
                                                Height="20"
                                                Padding="6,0"
                                                Command="{Binding DeselectAllSkillsCommand}"
                                                Content="BỎ CHỌN"
                                                FontSize="8.5"
                                                FontWeight="Bold"
                                                Style="{StaticResource GameSecondaryButton}" />
                                        </StackPanel>
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding BossSkills}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="5" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type items:SkillButtonItem}">
                                                <CheckBox
                                                    IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                    Style="{StaticResource GameSkillSlotCheckBoxStyle}"
                                                    ToolTip="{Binding ToolTipText}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <TextBlock
                                Margin="0,4,0,6"
                                FontSize="11"
                                FontWeight="ExtraBold"
                                Foreground="{DynamicResource GameTextDarkBrush}"
                                Text="DANH SÁCH BẢN ĐỒ SĂN (XOAY TUA):" />

                            <Border
                                Margin="0,0,0,8"
                                Padding="8,6"
                                Background="{DynamicResource GameBgBrush}"
                                BorderBrush="{DynamicResource GameBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="10"
                                            FontWeight="Bold"
                                            Foreground="{DynamicResource GameTextMutedBrush}">
                                            <Run Text="Đã chọn: " />
                                            <Run FontWeight="ExtraBold" Foreground="{DynamicResource GameGreenBrush}" Text="{Binding SelectedMapCount, Mode=OneWay}" />
                                            <Run Text=" bản đồ" />
                                        </TextBlock>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button
                                                Height="20"
                                                Padding="6,0"
                                                Margin="0,0,4,0"
                                                Command="{Binding SelectCurrentMapCommand}"
                                                Content="+ MAP HIỆN TẠI"
                                                FontSize="8.5"
                                                FontWeight="Bold"
                                                Style="{StaticResource GameSecondaryButton}" />
                                            <Button
                                                Height="20"
                                                Padding="6,0"
                                                Margin="0,0,4,0"
                                                Command="{Binding SelectAllFilteredMapsCommand}"
                                                Content="CHỌN TẤT CẢ"
                                                FontSize="8.5"
                                                FontWeight="Bold"
                                                Style="{StaticResource GameSecondaryButton}" />
                                            <Button
                                                Height="20"
                                                Padding="6,0"
                                                Command="{Binding ClearAllMapsCommand}"
                                                Content="BỎ CHỌN"
                                                FontSize="8.5"
                                                FontWeight="Bold"
                                                Style="{StaticResource GameSecondaryButton}" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox
                                            Grid.Column="0"
                                            Height="24"
                                            Margin="0,0,6,0"
                                            FontSize="10"
                                            ItemsSource="{Binding PlanetFilters}"
                                            SelectedItem="{Binding SelectedPlanetFilter, Mode=TwoWay}"
                                            Style="{StaticResource GameComboBoxStyle}" />
                                        <TextBox
                                            Grid.Column="1"
                                            Height="24"
                                            Padding="4,2"
                                            FontSize="10"
                                            Style="{StaticResource GameTextBoxStyle}"
                                            Text="{Binding MapSearchText, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>

                                    <Border
                                        Background="{DynamicResource GameTabContentBrush}"
                                        BorderBrush="{DynamicResource GameBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="4,3"
                                        MaxHeight="160">
                                        <ScrollViewer FocusVisualStyle="{x:Null}" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding FilteredMaps}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type items:BossMapItem}">
                                                        <Border
                                                            Margin="0,1,0,2"
                                                            Padding="5,4"
                                                            Background="{DynamicResource GameBgBrush}"
                                                            BorderBrush="{DynamicResource GameBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="3"
                                                            ToolTip="{Binding DisplayText}">
                                                            <CheckBox
                                                                VerticalAlignment="Center"
                                                                Content="{Binding DisplayText}"
                                                                FontSize="10.5"
                                                                FontWeight="Bold"
                                                                Foreground="{DynamicResource GameTextDarkBrush}"
                                                                IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                Style="{StaticResource GameCheckBoxStyle}" />
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Button
                                    Grid.Column="0"
                                    Height="30"
                                    Margin="0,0,8,0"
                                    Command="{Binding ToggleAutoBossCommand}"
                                    FontSize="10"
                                    FontWeight="ExtraBold"
                                    Style="{StaticResource GameAutoBossToggleButtonStyle}" />

                                <Border
                                    Grid.Column="1"
                                    Padding="8,4"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource GameBgBrush}"
                                    BorderBrush="{DynamicResource GameBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="3">
                                    <TextBlock
                                        FontSize="9.5"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource GameTextMutedBrush}"
                                        Text="{Binding StatusText}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip="{Binding StatusText}" />
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Border>
    </Grid>
</UserControl>
