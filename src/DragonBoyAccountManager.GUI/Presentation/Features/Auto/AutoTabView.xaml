<UserControl
    x:Class="DragonBoyAccountManager.GUI.Presentation.Features.Auto.AutoTabView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="clr-namespace:DragonBoyAccountManager.GUI.Presentation.DesignSystem.Converters"
    xmlns:controls="clr-namespace:DragonBoyAccountManager.GUI.Presentation.DesignSystem.Controls"
    xmlns:items="clr-namespace:DragonBoyAccountManager.GUI.Presentation.Features.Auto.Items"
    xmlns:viewmodels="clr-namespace:DragonBoyAccountManager.GUI.Presentation.Features.Auto"
    d:DataContext="{d:DesignInstance Type=viewmodels:AutoTabViewModel}"
    d:DesignHeight="550"
    d:DesignWidth="435"
    mc:Ignorable="d">

    <Grid Margin="10,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Margin="0,0,0,8"
            Padding="8,7"
            Background="{DynamicResource GameBgBrush}"
            BorderBrush="{DynamicResource GameBorderBrush}"
            BorderThickness="1.5"
            CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource GameStatusIndicatorEllipseStyle}" />

                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="11.5"
                        FontWeight="ExtraBold"
                        Foreground="{DynamicResource GameTextDarkBrush}"
                        Text="{Binding ActiveAccountInfo}"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding ActiveAccountInfo}" />
                </StackPanel>

                <Border
                    Grid.Column="1"
                    Margin="8,0,0,0"
                    Padding="6,2"
                    VerticalAlignment="Center"
                    Background="{DynamicResource GameGreenBrush}"
                    CornerRadius="3"
                    ToolTip="Số tài khoản đang được áp dụng đồng bộ lệnh auto">
                    <TextBlock
                        FontSize="9"
                        FontWeight="ExtraBold"
                        Foreground="{DynamicResource GameTextLightBrush}"
                        Text="{Binding SyncTargetDisplay, FallbackValue='1 tài khoản'}" />
                </Border>
            </Grid>
        </Border>

        <Border
            Grid.Row="1"
            Background="{DynamicResource GameTabContentBrush}"
            BorderBrush="{DynamicResource GameBorderBrush}"
            BorderThickness="1.5"
            CornerRadius="6">
            <TabControl Style="{StaticResource GameTabControlStyle}">

                <TabItem Style="{StaticResource GameTabItemStyle}">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="AUTO ĐÁNH" />
                            <Ellipse
                                Width="7"
                                Height="7"
                                Margin="6,0,0,0"
                                VerticalAlignment="Center"
                                Fill="{DynamicResource GameDangerBrush}"
                                ToolTip="Auto đánh đang hoạt động"
                                Visibility="{Binding Train.IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer FocusVisualStyle="{x:Null}" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10,8" DataContext="{Binding Train}">

                            <TextBlock
                                Margin="0,0,0,6"
                                FontSize="11"
                                FontWeight="ExtraBold"
                                Foreground="{DynamicResource GameTextDarkBrush}"
                                Text="TÙY CHỌN TỰ ĐỘNG ĐÁNH:" />

                            <Border
                                Margin="0,0,0,8"
                                Padding="8,6"
                                Background="{DynamicResource GameBgBrush}"
                                BorderBrush="{DynamicResource GameBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox
                                        Grid.Column="0"
                                        Margin="0,2"
                                        Content="Bỏ qua siêu quái"
                                        FontSize="10.5"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource GameTextDarkBrush}"
                                        IsChecked="{Binding AvoidSuperMobs}"
                                        Style="{StaticResource GameCheckBoxStyle}" />
                                    <CheckBox
                                        Grid.Column="1"
                                        Margin="0,2"
                                        Content="Đổi khu khi hết quái"
                                        FontSize="10.5"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource GameTextDarkBrush}"
                                        IsChecked="{Binding ChangeZoneWhenNoMobs}"
                                        Style="{StaticResource GameCheckBoxStyle}" />
                                </Grid>
                            </Border>

                            <TextBlock
                                Margin="0,4,0,6"
                                FontSize="11"
                                FontWeight="ExtraBold"
                                Foreground="{DynamicResource GameTextDarkBrush}"
                                Text="ĐÁNH THEO HP QUÁI:" />

                            <Border
                                Margin="0,0,0,8"
                                Padding="8,6"
                                Background="{DynamicResource GameBgBrush}"
                                BorderBrush="{DynamicResource GameBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                                <StackPanel>
                                    <CheckBox
                                        Margin="0,0,0,6"
                                        Content="Kích hoạt đánh theo HP"
                                        FontSize="10.5"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource GameTextDarkBrush}"
                                        IsChecked="{Binding CheckAttackByHp}"
                                        Style="{StaticResource GameCheckBoxStyle}" />
                                    <Grid IsEnabled="{Binding CheckAttackByHp}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock
                                                Margin="0,0,0,2"
                                                FontSize="9.5"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource GameTextMutedBrush}"
                                                Text="HP Trên (Tối thiểu):" />
                                            <TextBox
                                                Height="24"
                                                Padding="4,2"
                                                FontSize="10"
                                                Style="{StaticResource GameTextBoxStyle}"
                                                Text="{Binding MinMobHp, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock
                                                Margin="0,0,0,2"
                                                FontSize="9.5"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource GameTextMutedBrush}"
                                                Text="HP Dưới (Tối đa):" />
                                            <TextBox
                                                Height="24"
                                                Padding="4,2"
                                                FontSize="10"
                                                Style="{StaticResource GameTextBoxStyle}"
                                                Text="{Binding MaxMobHp, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock
                                Margin="0,4,0,6"
                                FontSize="11"
                                FontWeight="ExtraBold"
                                Foreground="{DynamicResource GameTextDarkBrush}"
                                Text="TỰ DÙNG ĐẬU THẦN:" />

                            <Border
                                Margin="0,0,0,8"
                                Padding="8,6"
                                Background="{DynamicResource GameBgBrush}"
                                BorderBrush="{DynamicResource GameBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                                <StackPanel>
                                    <CheckBox
                                        Margin="0,0,0,6"
                                        Content="Kích hoạt tự dùng đậu"
                                        FontSize="10.5"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource GameTextDarkBrush}"
                                        IsChecked="{Binding AutoUsePean}"
                                        Style="{StaticResource GameCheckBoxStyle}" />
                                    <Grid IsEnabled="{Binding AutoUsePean}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock
                                                Margin="0,0,0,2"
                                                FontSize="9.5"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource GameTextMutedBrush}"
                                                Text="% HP dùng đậu:" />
                                            <TextBox
                                                Height="24"
                                                Padding="4,2"
                                                FontSize="10"
                                                Style="{StaticResource GameTextBoxStyle}"
                                                Text="{Binding PeanHpPercent, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock
                                                Margin="0,0,0,2"
                                                FontSize="9.5"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource GameTextMutedBrush}"
                                                Text="% MP dùng đậu:" />
                                            <TextBox
                                                Height="24"
                                                Padding="4,2"
                                                FontSize="10"
                                                Style="{StaticResource GameTextBoxStyle}"
                                                Text="{Binding PeanMpPercent, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock
                                Margin="0,4,0,6"
                                FontSize="11"
                                FontWeight="ExtraBold"
                                Foreground="{DynamicResource GameTextDarkBrush}"
                                Text="CHỌN QUÁI THEO TÊN:" />

                            <Border
                                Margin="0,0,0,8"
                                Padding="8,6"
                                Background="{DynamicResource GameBgBrush}"
                                BorderBrush="{DynamicResource GameBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox
                                            Grid.Column="0"
                                            VerticalAlignment="Center"
                                            Content="Tất cả quái trong map"
                                            FontSize="10.5"
                                            FontWeight="Bold"
                                            Foreground="{DynamicResource GameTextDarkBrush}"
                                            IsChecked="{Binding CheckAllMobs}"
                                            Style="{StaticResource GameCheckBoxStyle}" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Visibility="{Binding CheckAllMobs, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}">
                                            <Button
                                                Height="20"
                                                Padding="6,0"
                                                Margin="0,0,4,0"
                                                Command="{Binding SelectAllMobsCommand}"
                                                Content="TẤT CẢ"
                                                FontSize="8.5"
                                                FontWeight="Bold"
                                                Style="{StaticResource GameSecondaryButton}" />
                                            <Button
                                                Height="20"
                                                Padding="6,0"
                                                Command="{Binding DeselectAllMobsCommand}"
                                                Content="BỎ CHỌN"
                                                FontSize="8.5"
                                                FontWeight="Bold"
                                                Style="{StaticResource GameSecondaryButton}" />
                                        </StackPanel>
                                    </Grid>

                                    <Border
                                        Background="{DynamicResource GameTabContentBrush}"
                                        BorderBrush="{DynamicResource GameBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="4,3"
                                        MaxHeight="150"
                                        Visibility="{Binding CheckAllMobs, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}">
                                        <ScrollViewer FocusVisualStyle="{x:Null}" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding AvailableMobTypes}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type items:MobFilterItem}">
                                                        <Border
                                                            Margin="0,1,0,2"
                                                            Padding="5,4"
                                                            Background="{DynamicResource GameBgBrush}"
                                                            BorderBrush="{DynamicResource GameBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="3">
                                                            <CheckBox
                                                                VerticalAlignment="Center"
                                                                Content="{Binding Name}"
                                                                FontSize="10.5"
                                                                FontWeight="Bold"
                                                                Foreground="{DynamicResource GameTextDarkBrush}"
                                                                IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                Style="{StaticResource GameCheckBoxStyle}" />
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <TextBlock
                                Margin="0,4,0,6"
                                FontSize="11"
                                FontWeight="ExtraBold"
                                Foreground="{DynamicResource GameTextDarkBrush}"
                                Text="DANH SÁCH SKILL TỰ ĐÁNH:" />

                            <Border
                                Margin="0,0,0,8"
                                Padding="8,6"
                                Background="{DynamicResource GameBgBrush}"
                                BorderBrush="{DynamicResource GameBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="10"
                                            FontWeight="Bold"
                                            Foreground="{DynamicResource GameTextMutedBrush}"
                                            Text="Chọn các chiêu xoay tua:"
                                            TextTrimming="CharacterEllipsis" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button
                                                Height="20"
                                                Padding="6,0"
                                                Margin="0,0,4,0"
                                                Command="{Binding SelectAllSkillsCommand}"
                                                Content="TẤT CẢ"
                                                FontSize="8.5"
                                                FontWeight="Bold"
                                                Style="{StaticResource GameSecondaryButton}" />
                                            <Button
                                                Height="20"
                                                Padding="6,0"
                                                Command="{Binding DeselectAllSkillsCommand}"
                                                Content="BỎ CHỌN"
                                                FontSize="8.5"
                                                FontWeight="Bold"
                                                Style="{StaticResource GameSecondaryButton}" />
                                        </StackPanel>
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding AutoTrainSkills}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="5" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type items:SkillButtonItem}">
                                                <CheckBox
                                                    IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                    PreviewMouseLeftButtonDown="SkillSlot_PreviewMouseLeftButtonDown"
                                                    Style="{StaticResource GameSkillSlotCheckBoxStyle}"
                                                    ToolTip="{Binding ToolTipText}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <CheckBox
                                Margin="0,0,0,10"
                                Content="Đồng bộ tất cả tài khoản đã chọn"
                                FontSize="10.5"
                                FontWeight="Bold"
                                Foreground="{DynamicResource GameTextDarkBrush}"
                                IsChecked="{Binding SyncAll}"
                                Style="{StaticResource GameCheckBoxStyle}" />

                            <Button
                                Height="34"
                                Margin="0,0,0,8"
                                Command="{Binding ToggleAutoTrainCommand}"
                                Style="{StaticResource GameAutoTrainToggleButtonStyle}" />

                            <Border
                                Padding="8,6"
                                Background="{DynamicResource GameHeaderBrush}"
                                BorderBrush="{DynamicResource GameBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        FontSize="10.5"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource GameTextDarkBrush}"
                                        Text="{Binding StatusText}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip="{Binding StatusText}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="4,0,0,0"
                                        FontSize="10"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource GameTextMutedBrush}"
                                        Text="{Binding SyncTargetDisplay}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip="{Binding SyncTargetDisplay}" />
                                </Grid>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Style="{StaticResource GameTabItemStyle}">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="AUTO CHAT" />
                            <Ellipse
                                Width="7"
                                Height="7"
                                Margin="6,0,0,0"
                                VerticalAlignment="Center"
                                Fill="{DynamicResource GameGreenBrush}"
                                ToolTip="Auto chat đang hoạt động"
                                Visibility="{Binding Chat.IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer FocusVisualStyle="{x:Null}" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10,8" DataContext="{Binding Chat}">

                            <TextBlock
                                Margin="0,0,0,4"
                                FontSize="11"
                                FontWeight="ExtraBold"
                                Foreground="{DynamicResource GameTextDarkBrush}"
                                Text="NỘI DUNG CHAT (MỖI DÒNG 1 CÂU):" />

                            <TextBox
                                Height="85"
                                Padding="8,6"
                                AcceptsReturn="True"
                                Style="{StaticResource GameTextBoxStyle}"
                                Text="{Binding ChatText, UpdateSourceTrigger=PropertyChanged}"
                                TextWrapping="Wrap"
                                VerticalScrollBarVisibility="Auto" />

                            <Grid Margin="0,6,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox
                                    Grid.Column="0"
                                    Content="Gửi ngẫu nhiên các dòng"
                                    FontSize="10.5"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource GameTextDarkBrush}"
                                    IsChecked="{Binding IsRandomChat}"
                                    Style="{StaticResource GameCheckBoxStyle}" />
                                <CheckBox
                                    Grid.Column="1"
                                    Content="Đồng bộ tất cả tài khoản đã chọn"
                                    FontSize="10.5"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource GameTextDarkBrush}"
                                    IsChecked="{Binding SyncAll}"
                                    Style="{StaticResource GameCheckBoxStyle}" />
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock
                                        Margin="0,0,0,3"
                                        FontSize="10.5"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource GameTextMutedBrush}"
                                        Text="Kênh chat:" />
                                    <ComboBox
                                        Height="26"
                                        SelectedIndex="{Binding SelectedChatTypeIndex}"
                                        Style="{StaticResource GameComboBoxStyle}">
                                        <ComboBoxItem Content="Khu vực (Map)" />
                                        <ComboBoxItem Content="Thế giới (Global)" />
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock
                                        Margin="0,0,0,3"
                                        FontSize="10.5"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource GameTextMutedBrush}"
                                        Text="Giãn cách gửi (giây):" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="50" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox
                                            Height="26"
                                            Padding="4,2"
                                            HorizontalContentAlignment="Center"
                                            Style="{StaticResource GameTextBoxStyle}"
                                            Text="{Binding ChatDelaySeconds, UpdateSourceTrigger=PropertyChanged}" />
                                        <UniformGrid Grid.Column="2" Columns="4">
                                            <Button
                                                Height="26"
                                                Margin="1,0"
                                                Padding="0"
                                                MinWidth="0"
                                                Command="{Binding SetChatDelayCommand}"
                                                CommandParameter="3"
                                                Content="3s"
                                                FontSize="10"
                                                FontWeight="Bold"
                                                Style="{StaticResource GameSecondaryButton}" />
                                            <Button
                                                Height="26"
                                                Margin="1,0"
                                                Padding="0"
                                                MinWidth="0"
                                                Command="{Binding SetChatDelayCommand}"
                                                CommandParameter="5"
                                                Content="5s"
                                                FontSize="10"
                                                FontWeight="Bold"
                                                Style="{StaticResource GameSecondaryButton}" />
                                            <Button
                                                Height="26"
                                                Margin="1,0"
                                                Padding="0"
                                                MinWidth="0"
                                                Command="{Binding SetChatDelayCommand}"
                                                CommandParameter="10"
                                                Content="10s"
                                                FontSize="10"
                                                FontWeight="Bold"
                                                Style="{StaticResource GameSecondaryButton}" />
                                            <Button
                                                Height="26"
                                                Margin="1,0"
                                                Padding="0"
                                                MinWidth="0"
                                                Command="{Binding SetChatDelayCommand}"
                                                CommandParameter="30"
                                                Content="30s"
                                                FontSize="10"
                                                FontWeight="Bold"
                                                Style="{StaticResource GameSecondaryButton}" />
                                        </UniformGrid>
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,4,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Button
                                    Grid.Column="0"
                                    Height="32"
                                    Command="{Binding SendChatOnceCommand}"
                                    Content="GỬI 1 LẦN"
                                    FontSize="11"
                                    FontWeight="ExtraBold"
                                    Style="{StaticResource GameSecondaryButton}"
                                    ToolTip="Gửi ngay 1 tin nhắn mà không chạy vòng lặp" />

                                <Button
                                    Grid.Column="2"
                                    Height="32"
                                    Command="{Binding ToggleAutoChatCommand}"
                                    Style="{StaticResource GameAutoChatToggleButtonStyle}" />
                            </Grid>

                            <Border
                                Padding="8,6"
                                Background="{DynamicResource GameHeaderBrush}"
                                BorderBrush="{DynamicResource GameBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        FontSize="10.5"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource GameTextDarkBrush}"
                                        Text="{Binding StatusText}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip="{Binding StatusText}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="4,0,0,0"
                                        FontSize="10"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource GameTextMutedBrush}"
                                        Text="{Binding SyncTargetDisplay}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip="{Binding SyncTargetDisplay}" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Border>
    </Grid>
</UserControl>
