<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
    mc:Ignorable="po">

    <Style x:Key="GameDialogButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="34" />
        <Setter Property="MinWidth" Value="108" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontFamily" Value="{DynamicResource GameFont}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Foreground" Value="#381300" />
        <Setter Property="Padding" Value="16,3" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="rootGrid" SnapsToDevicePixels="True">

                        <Border
                            x:Name="outerBorder"
                            Padding="1.8"
                            Background="#501500"
                            CornerRadius="13">

                            <Border
                                x:Name="innerRim"
                                Padding="1.2"
                                Background="#FEE599"
                                CornerRadius="11.2">
                                <Grid>

                                    <Border x:Name="faceBase" CornerRadius="10">
                                        <Border.Background>
                                            <LinearGradientBrush po:Freeze="True" StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Offset="0.0" Color="#F38D2F" />
                                                <GradientStop Offset="0.45" Color="#E9771F" />
                                                <GradientStop Offset="1.0" Color="#D75C0F" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>

                                    <Border
                                        x:Name="faceGloss"
                                        Height="8"
                                        Margin="2,1,2,0"
                                        VerticalAlignment="Top"
                                        Background="#FFA64E"
                                        CornerRadius="9,9,4,4"
                                        Opacity="0.45" />

                                    <ContentPresenter
                                        Margin="{TemplateBinding Padding}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        RecognizesAccessKey="True" />
                                </Grid>
                            </Border>
                        </Border>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="faceBase" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush po:Freeze="True" StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Offset="0.0" Color="#FFA547" />
                                        <GradientStop Offset="0.45" Color="#F5882E" />
                                        <GradientStop Offset="1.0" Color="#E46917" />
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="faceGloss" Property="Opacity" Value="0.65" />
                            <Setter TargetName="innerRim" Property="Background" Value="#FFF1B8" />
                            <Setter Property="Foreground" Value="#250C00" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="faceBase" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush po:Freeze="True" StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Offset="0.0" Color="#D0560A" />
                                        <GradientStop Offset="1.0" Color="#C14902" />
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="faceGloss" Property="Opacity" Value="0.15" />
                            <Setter TargetName="outerBorder" Property="Background" Value="#3D0F00" />
                            <Setter TargetName="rootGrid" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform Y="1" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="outerBorder" Property="Opacity" Value="0.5" />
                            <Setter Property="Cursor" Value="No" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GameToolTipStyle" TargetType="ToolTip">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Foreground" Value="#000000" />
        <Setter Property="FontFamily" Value="Segoe UI, Tahoma, Arial" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock
                        MaxWidth="320"
                        HorizontalAlignment="Center"
                        LineHeight="16"
                        Text="{Binding}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border
                        Margin="4"
                        Padding="12,7"
                        Background="#FFFFFF"
                        BorderBrush="#000000"
                        BorderThickness="2.4"
                        CornerRadius="8"
                        SnapsToDevicePixels="True">
                        <Border.Effect>
                            <DropShadowEffect
                                BlurRadius="10"
                                Direction="270"
                                Opacity="0.22"
                                ShadowDepth="3"
                                Color="#000000" />
                        </Border.Effect>
                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            RecognizesAccessKey="False" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource GameToolTipStyle}" TargetType="ToolTip" />

</ResourceDictionary>
